{
  "scripts": {
    "sudo_claude": "claude --dangerously-skip-permissions",
    "sudo_codex": "codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust",
    "sudo_claude_fork": "claude --dangerously-skip-permissions --continue --fork-session",
    "sudo_claude_resume": "claude --dangerously-skip-permissions --continue",
    "reinstall": "rm -rf node_modules renderer/node_modules && npm install && npm install --prefix renderer",
    "typecheck": "tsc --noEmit",
    "test:bug-solving": "bash renderer/structured-prompts/bug_solving/run-tests.sh",
    "test:e2e": "bash renderer/structured-prompts/bug_solving/run-tests.sh --e2e",
    "test:jail-claude": "RUN_CLAUDE_JAIL=1 npx tsx renderer/structured-prompts/bug_solving/claude-in-jail.e2e.test.ts",
    "solve:clusters": "npx tsx renderer/structured-prompts/bug_solving/generate-clusters.ts --retry-budget 5 --write",
    "solve": "bash renderer/structured-prompts/bug_solving/solve.sh --model opus --engine claude",
    "build": "npm run typecheck && npm run build:browser && npm run build:addon",
    "build:browser": "npx tsx renderer/html2slides/browser/build.ts",
    "build:addon": "npx tsx renderer/html2slides/browser/build-addon.ts",
    "deploy:addon": "npm run build:addon && npx tsx renderer/html2slides/addon/deploy.ts",
    "deploy": "bash renderer/html2slides/addon-server/deploy/deploy-sashaslides.sh",
    "regen:basics": "cd renderer/html2slides && bash regen-basics.sh",
    "regen:complex": "cd renderer/html2slides && bash regen-complex.sh",
    "regen": "npm run regen:basics && npm run regen:complex",
    "rate:basics": "lsof -ti:3456 | xargs -r kill; npx tsx renderer/html2slides/rating-server.ts /tmp/sxs --port 3456",
    "rate:complex": "lsof -ti:3457 | xargs -r kill; npx tsx renderer/html2slides/rating-server.ts /tmp/sxs-complex --port 3457",
    "rate": "lsof -ti:3456,3457 | xargs -r kill; npm run rate:basics & npm run rate:complex",
    "push_all": "./.agent/skills/push_all_submodules.sh",
    "pull_all": "./.agent/skills/pull_all_submodules.sh"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "esbuild": "^0.28.0",
    "googleapis": "^171.4.0",
    "jszip": "^3.10.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postcss-value-parser": "^4.2.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typia": "^12.1.1"
  }
}