{
  "scripts": {
    "sudo_claude": "claude --dangerously-skip-permissions",
    "sudo_claude_fork": "claude --dangerously-skip-permissions --continue --fork-session",
    "sudo_claude_resume": "claude --dangerously-skip-permissions --continue",
    "regen:basics": "cd analysis/renderer/html2slides && bash regen-basics.sh",
    "regen:complex": "cd analysis/renderer/html2slides && bash regen-complex.sh",
    "regen": "npm run regen:basics && npm run regen:complex",
    "rate:basics": "lsof -ti:3456 | xargs -r kill; npx tsx analysis/renderer/html2slides/rating-server.ts /tmp/sxs --port 3456",
    "rate:complex": "lsof -ti:3457 | xargs -r kill; npx tsx analysis/renderer/html2slides/rating-server.ts /tmp/sxs-complex --port 3457",
    "rate": "lsof -ti:3456,3457 | xargs -r kill; npm run rate:basics & npm run rate:complex"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "esbuild": "^0.28.0",
    "googleapis": "^171.4.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postcss-value-parser": "^4.2.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "typescript": "^6.0.3",
    "typia": "^12.1.1"
  }
}