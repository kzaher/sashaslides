{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/api/**/*.ts",
    "src/server/**/*.ts",
    "src/index.ts",
    "example/**/*.ts",
    "build.ts",
    "../renderer/structured-prompts/**/*.ts"
  ],
  "exclude": ["src/client/**"]
}
