/dist/

# Local SxS ratings backups (survive /tmp wipes; user-specific, not committed)
renderer/html2slides/e2e/.ratings-backup/

.sxs-complex/
# bug_solving persistent rating ledger
.bug-solving-history/
.bug-solving-history-reverse/

# full-deck re-rate scratch
.sxs-recheck/

# reverse round trip results (Google Slides -> Sasha import -> HTML), rated in the SxS UI;
# regenerated by renderer/html2slides/reverse-sxs.sh, never reviewed in git.
.sxs-reverse/

# fork-migration scratch (renders/diffs) — keep in /tmp normally
.fork-*/

# git worktrees used by bug_solving / parallel experiments (exp1, exp2, review)
.worktrees/
# core dumps — a 5 GB core.8162 from Oct 1 was sitting at the repo root
core.*

# OAuth token backups
.auth/tokens.json.bak-*

# SxS output of mcp/sasha-slides/converter/calibration/sxs-candidates.ts (regenerated, never reviewed in git).
.sxs-candidates/

# Forward SxS results for the user to rate (copied from a regen run; never reviewed in git).
.sxs-forward/
