+/**
+ * Attach per-item bullet COLOURS (`<a:buClr>`) to native list paragraphs.
+ * pptxgenjs 4.0.1 has no `bullet` colour option — every native `<a:buChar>`
+ * marker inherits the paragraph's text colour. CSS lists that colour their
+ * marker independently (slide_11 SWOT `li::before{content:'•';color:…}`,
+ * slide_30 Key Priorities `li::before{content:'';background:…}`) therefore
+ * used to abandon the native list and type the marker as a coloured text run.
+ *
+ * The emit path now keeps the native list and tags the textbox
+ * `objectName="BUCLR:rrggbb,rrggbb,…"` — one hex per list paragraph, in
+ * document order. Here we find each tagged `<p:sp>` and, for each bulleted
+ * paragraph (identified by its `<a:buSzPct>`, which pptxgenjs emits exactly
+ * once per `<a:buChar>` paragraph), insert
+ * `<a:buClr><a:srgbClr val="RRGGBB"/></a:buClr>` immediately before it. OOXML
+ * `CT_TextParagraphProperties` requires the bullet-colour element before the
+ * bullet-size element, so inserting before `<a:buSzPct>` yields the valid
+ * order buClr → buSzPct → buChar. Google Slides imports `<a:buClr>` as a
+ * native coloured bullet. Runs once per build (not repeatedly), so no
+ * idempotency guard is needed.
+ */
+export async function injectBulletColorsIntoZip(zip: JSZip): Promise<number> {
+  const slideFiles = Object.keys(zip.files).filter(n => /^ppt\/slides\/slide\d+\.xml$/.test(n));
+  let patched = 0;
+  for (const name of slideFiles) {
+    let xml = await zip.file(name)!.async("string");
+    let slidePatched = 0;
+    xml = xml.replace(/<p:sp>[\s\S]*?<\/p:sp>/g, (spBlock: string) => {
+      const m = spBlock.match(/name="BUCLR:([^"]*)"/);
+      if (!m) return spBlock;
+      const colors = m[1].split(",");
+      let idx = 0;
+      return spBlock.replace(/<a:buSzPct\b/g, (bu: string) => {
+        const c = colors[idx++];
+        if (!c || !/^[0-9a-fA-F]{6}$/.test(c)) return bu;
+        slidePatched++;
+        return `<a:buClr><a:srgbClr val="${c}"/></a:buClr>${bu}`;
+      });
+    });
+    if (slidePatched > 0) { zip.file(name, xml); patched += slidePatched; }
+  }
+  return patched;
+}
