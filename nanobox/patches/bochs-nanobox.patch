+    else if (op == A_ADD || op == A_ADC) setFlagsArith(size, op1, op2, res, false, false);
+    else if (op == A_SUB || op == A_CMP || op == A_SBB) setFlagsArith(size, op1, op2, res, true, false);
+    else setFlagsLogic(size, res);
+    return true;
+  }
