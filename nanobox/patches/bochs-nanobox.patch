+  // ---------------------------------------------------------------- more templates
+  // (the top dynamic fallbacks of the agent-CLI startups; each mirrors its Bochs handler exactly)
+  bool realHandler(unsigned k, BxExecutePtr_tR h) { return ins[k].execute1 == h; }
+  bool emitTemplateMore(unsigned k, bxInstruction_c *i, unsigned ia, bool R, bool last) {
+    unsigned dst = i->dst(), src = i->src(), seg = i->seg();
+    uint32_t t0 = T[0], t1 = T[1], t2 = T[2], t3 = T[3];
+    (void) last;
+    switch (ia) {
+
+    // ---- 16/8-bit shifts, register destination
+    case BX_IA_SHL_EwIb: case BX_IA_SHL_EwI1: case BX_IA_SHR_EwIb: case BX_IA_SHR_EwI1: case BX_IA_SAR_EwIb: case BX_IA_SAR_EwI1:
+    case BX_IA_SHL_Ew: case BX_IA_SHR_Ew: case BX_IA_SAR_Ew:
+    case BX_IA_SHL_EbIb: case BX_IA_SHL_EbI1: case BX_IA_SHR_EbIb: case BX_IA_SHR_EbI1: case BX_IA_SAR_EbIb: case BX_IA_SAR_EbI1:
+    case BX_IA_SHL_Eb: case BX_IA_SHR_Eb: case BX_IA_SAR_Eb: {
