+
+  static unsigned jccCond(unsigned ia) {
+    switch (ia) {
+      case BX_IA_JO_Jq: case BX_IA_JO_Jbq: return CC_O;     case BX_IA_JNO_Jq: case BX_IA_JNO_Jbq: return CC_NO;
+      case BX_IA_JB_Jq: case BX_IA_JB_Jbq: return CC_B;     case BX_IA_JNB_Jq: case BX_IA_JNB_Jbq: return CC_NB;
+      case BX_IA_JZ_Jq: case BX_IA_JZ_Jbq: return CC_Z;     case BX_IA_JNZ_Jq: case BX_IA_JNZ_Jbq: return CC_NZ;
+      case BX_IA_JBE_Jq: case BX_IA_JBE_Jbq: return CC_BE;  case BX_IA_JNBE_Jq: case BX_IA_JNBE_Jbq: return CC_NBE;
+      case BX_IA_JS_Jq: case BX_IA_JS_Jbq: return CC_S;     case BX_IA_JNS_Jq: case BX_IA_JNS_Jbq: return CC_NS;
+      case BX_IA_JP_Jq: case BX_IA_JP_Jbq: return CC_P;     case BX_IA_JNP_Jq: case BX_IA_JNP_Jbq: return CC_NP;
+      case BX_IA_JL_Jq: case BX_IA_JL_Jbq: return CC_L;     case BX_IA_JNL_Jq: case BX_IA_JNL_Jbq: return CC_NL;
+      case BX_IA_JLE_Jq: case BX_IA_JLE_Jbq: return CC_LE;  default: return CC_NLE;
+    }
+  }
+  static unsigned setccCond(unsigned ia) {
+    switch (ia) {
+      case BX_IA_SETO_Eb: return CC_O;   case BX_IA_SETNO_Eb: return CC_NO;
+      case BX_IA_SETB_Eb: return CC_B;   case BX_IA_SETNB_Eb: return CC_NB;
+      case BX_IA_SETZ_Eb: return CC_Z;   case BX_IA_SETNZ_Eb: return CC_NZ;
+      case BX_IA_SETBE_Eb: return CC_BE; case BX_IA_SETNBE_Eb: return CC_NBE;
+      case BX_IA_SETS_Eb: return CC_S;   case BX_IA_SETNS_Eb: return CC_NS;
+      case BX_IA_SETP_Eb: return CC_P;   case BX_IA_SETNP_Eb: return CC_NP;
