+    const bool needRes = writesDst || !defer;   // deferred CMP/TEST: the result is computed only where it is observed
+    if (needRes) {
+      em->get(op1); em->get(op2);
+      switch (op) {
+        case A_ADD: em->op(I64_ADD); break;
+        case A_ADC: em->op(I64_ADD); em->get(T[4]); em->op(I64_ADD); break;   // sum = op1 + op2 + CF; flags: SET_FLAGS_OSZAPC_ADD(op1, op2, sum)
+        case A_SBB: em->get(T[4]); em->op(I64_ADD); em->op(I64_SUB); break;   // diff = op1 - (op2 + CF); flags: SET_FLAGS_OSZAPC_SUB(op1, op2, diff)
+        case A_SUB: case A_CMP: em->op(I64_SUB); break;
+        case A_AND: case A_TEST: em->op(I64_AND); break;
+        case A_OR: em->op(I64_OR); break;
+        case A_XOR: em->op(I64_XOR); break;
+      }
+      if (size < 8) { em->i64c((1LL << (size * 8)) - 1); em->op(I64_AND); }
+      em->set(res);
+    }
+    // write back
+    if (writesDst) {
+      if (R || form == 0) writeRegSz(dst, size, ext, res);
+      else emitRMWWrite(rmwKind, size, res);
+    }
+    // flags
+    if (defer) {
+      if (!flagsLive) pfKillDead();
+      else pfSet(op == A_ADD ? PF_ADD : (op == A_SUB || op == A_CMP) ? PF_SUB : PF_LOGIC, size, needRes);
+    }
+    else if (op == A_ADD || op == A_ADC) setFlagsArith(size, op1, op2, res, false, false);
+    else if (op == A_SUB || op == A_CMP || op == A_SBB) setFlagsArith(size, op1, op2, res, true, false);
+    else setFlagsLogic(size, res);
+    return true;
+  }
+
+  // ---- INC/DEC/NEG/NOT
+  bool emitUnary(unsigned k, bxInstruction_c *i, unsigned ia, bool R) {
+    unsigned size = (ia == BX_IA_INC_Eq || ia == BX_IA_DEC_Eq || ia == BX_IA_NEG_Eq || ia == BX_IA_NOT_Eq) ? 8 : 4;
+    bool inc = (ia == BX_IA_INC_Eq || ia == BX_IA_INC_Ed), dec = (ia == BX_IA_DEC_Eq || ia == BX_IA_DEC_Ed);
+    bool neg = (ia == BX_IA_NEG_Eq || ia == BX_IA_NEG_Ed);
+    unsigned dst = i->dst(), seg = i->seg();
+    uint32_t op1 = T[0], op2 = T[1], res = T[2], ea = T[3];
+    MemKind rmwKind = (size == 8) ? MK_RMW_LIN : MK_RMW_VIRT;
+    if (R) { if (size == 8) regGet(dst); else pushReg32(dst); em->set(op1); }
+    else { pushEA(k); em->set(ea); emitRMWRead(k, rmwKind, seg, size, ea); em->set(op1); }
+    if (inc || dec) {
+      em->get(op1); em->i64c(1); em->op(inc ? I64_ADD : I64_SUB);
+      if (size == 4) { em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); }
+      em->set(res);
+      em->i64c(0); em->set(op2);
+      if (R) { em->get(res); regSetFromStack(dst); } else emitRMWWrite(rmwKind, size, res);
+      // INC: SET_FLAGS_OSZAP_ADD_n(rrx-1, 0, rrx); DEC: SET_FLAGS_OSZAP_SUB_n(rrx+1, 0, rrx)
+      setFlagsArith(size, op1, op2, res, dec, true);
+    } else if (neg) {
+      // op1 = -(Bit64s)op1; write; SET_FLAGS_OSZAPC_SUB_n(0, orig, -orig)
+      em->i64c(0); em->get(op1); em->op(I64_SUB);
+      if (size == 4) { em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); }
+      em->set(res);
+      if (R) { em->get(res); regSetFromStack(dst); } else emitRMWWrite(rmwKind, size, res);
+      em->get(op1); em->set(op2);   // orig
+      em->i64c(0); em->set(op1);
+      setFlagsArith(size, op1, op2, res, true, false);
+    } else { // NOT
+      em->get(op1); em->i64c(-1); em->op(I64_XOR);
+      if (size == 4) { em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); }
+      em->set(res);
+      if (R) { em->get(res); regSetFromStack(dst); } else emitRMWWrite(rmwKind, size, res);
+    }
+    return true;
+  }
+
+  // ---- shifts (register destination)
+  bool emitShift(unsigned k, bxInstruction_c *i, unsigned ia) {
+    unsigned size; int kind; // 0=shl 1=shr 2=sar
+    bool useCL;
+    switch (ia) {
+      case BX_IA_SHL_Eq: size = 8; kind = 0; useCL = true; break;
+      case BX_IA_SHL_EqIb: case BX_IA_SHL_EqI1: size = 8; kind = 0; useCL = false; break;
+      case BX_IA_SHR_Eq: size = 8; kind = 1; useCL = true; break;
+      case BX_IA_SHR_EqIb: case BX_IA_SHR_EqI1: size = 8; kind = 1; useCL = false; break;
+      case BX_IA_SAR_Eq: size = 8; kind = 2; useCL = true; break;
+      case BX_IA_SAR_EqIb: case BX_IA_SAR_EqI1: size = 8; kind = 2; useCL = false; break;
+      case BX_IA_SHL_Ed: size = 4; kind = 0; useCL = true; break;
+      case BX_IA_SHL_EdIb: case BX_IA_SHL_EdI1: size = 4; kind = 0; useCL = false; break;
+      case BX_IA_SHR_Ed: size = 4; kind = 1; useCL = true; break;
+      case BX_IA_SHR_EdIb: case BX_IA_SHR_EdI1: size = 4; kind = 1; useCL = false; break;
+      case BX_IA_SAR_Ed: size = 4; kind = 2; useCL = true; break;
+      case BX_IA_SAR_EdIb: case BX_IA_SAR_EdI1: size = 4; kind = 2; useCL = false; break;
+      default: return false;
+    }
+    unsigned dst = i->dst();
+    uint32_t op1 = T[0], res = T[1], cnt = T[2]; uint32_t cf = T32[3], of = T32[4];
+    unsigned mask = (size == 8) ? 0x3f : 0x1f;
+    // count
+    if (useCL) { regGet(R_RCX); em->i64c(mask); em->op(I64_AND); em->set(cnt); }
+    else {
+      unsigned c = i->Ib() & mask;
+      if (c == 0) { // flags untouched; 32-bit forms still zero-extend the destination
+        if (size == 4) { pushReg32(dst); regSetFromStack(dst); }
+        return true;
+      }
+      em->i64c(c); em->set(cnt);
+    }
+    // 32-bit forms clear the upper half of the register even for a zero count
+    if (useCL && size == 4) { pushReg32(dst); regSetFromStack(dst); }
+    // count == 0: nothing happens (incl. flags). The update is runtime-conditional, so make sure
+    // the cached locals hold the current values on the not-taken path: load them first, update
+    // inside the `if`, and mark them dirty for both paths.
+    if (useCL) { lfLoad(); regEnsureLoaded(dst); em->get(cnt); em->i64c(0); em->op(I64_NE); iff(); }
+    if (size == 8) regGet(dst); else pushReg32(dst);
+    em->set(op1);
+    if (kind == 0) {
+      // result = op1 << count; cf = (op1 >> (bits - count)) & 1; of = cf ^ (result >> (bits-1))
+      em->get(op1); em->get(cnt); em->op(I64_SHL); if (size == 4) { em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); } em->set(res);
+      em->get(op1); em->i64c(size * 8); em->get(cnt); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+      em->get(res); em->i64c(size * 8 - 1); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->get(cf); em->op(I32_XOR); em->set(of);
+    } else if (kind == 1) {
+      // result = op1 >> count; cf = (op1 >> (count-1)) & 1; of = ((result << 1) ^ result) >> (bits-1)
+      em->get(op1); em->get(cnt); em->op(I64_SHR_U); em->set(res);
+      em->get(op1); em->get(cnt); em->i64c(1); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+      em->get(res); em->i64c(1); em->op(I64_SHL); em->get(res); em->op(I64_XOR); em->i64c(size * 8 - 1); em->op(I64_SHR_U);
+      em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND);
+      em->set(of);
+    } else {
+      // result = (signed)op1 >> count; cf = (op1 >> (count-1)) & 1; of = 0
+      em->get(op1); if (size == 4) em->op(I64_EXTEND32_S); em->get(cnt); em->op(I64_SHR_S); if (size == 4) { em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); } em->set(res);
+      em->get(op1); em->get(cnt); em->i64c(1); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+      em->i32c(0); em->set(of);
+    }
+    em->get(res); regSetFromStack(dst);
+    setFlagsLogic(size, res);
+    setFlagsOxxxxC(of, cf);
+    if (useCL) endb();
+    return true;
+  }
+
+  // ---- IMUL (2 and 3 operand forms)
+  bool emitImul(unsigned k, bxInstruction_c *i, unsigned ia, bool R) {
+    unsigned size = (ia == BX_IA_IMUL_GqEq || ia == BX_IA_IMUL_GqEqId || ia == BX_IA_IMUL_GqEqsIb) ? 8 : 4;
+    bool imm = (ia == BX_IA_IMUL_GqEqId || ia == BX_IA_IMUL_GqEqsIb || ia == BX_IA_IMUL_GdEdId || ia == BX_IA_IMUL_GdEdsIb);
+    unsigned dst = i->dst(), src = i->src(), seg = i->seg();
+    uint32_t a = T[0], b = T[1], lo = T[2], hi = T[3];
+    // operand E (register or memory via LOAD_Eq/LOAD_Ed)
+    if (R) { if (size == 8) regGet(src); else pushReg32(src); }
+    else { pushEA(k); em->set(T[4]); emitRead(k, size == 8 ? MK_RD_LIN : MK_RD_VIRT, seg, size, T[4]); }
+    em->set(a);
+    if (imm) { em->i64c((Bit64s)(Bit32s) i->Id()); em->set(b); }
+    else { if (size == 8) regGet(dst); else pushReg32(dst); em->set(b); }
+    if (size == 4) {
+      // 32x32 -> 64 signed product
+      em->get(a); em->op(I64_EXTEND32_S); em->get(b); em->op(I64_EXTEND32_S); em->op(I64_MUL); em->set(lo);
+      em->get(lo); em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); em->set(a);
+      em->get(a); regSetFromStack(dst);
+      setFlagsLogic(4, a);
+      em->get(lo); em->get(lo); em->op(I64_EXTEND32_S); em->op(I64_NE);
+      iff(); assertFlagsOxxxxC(); endb();
+    } else {
+      // signed 64x64 -> 128: lo = a*b; hi = mulhs(a,b)
+      em->get(a); em->get(b); em->op(I64_MUL); em->set(lo);
+      emitMulhs(a, b, hi);
+      em->get(lo); regSetFromStack(dst);
+      setFlagsLogic(8, lo);
+      // if ((Bit64u)hi + (lo >> 63) != 0) assert_flags_OxxxxC
+      em->get(hi); em->get(lo); em->i64c(63); em->op(I64_SHR_U); em->op(I64_ADD); em->i64c(0); em->op(I64_NE);
+      iff(); assertFlagsOxxxxC(); endb();
+    }
+    return true;
+  }
+  // signed high 64 bits of a*b -> local out (uses X[] scratch)
+  void emitMulhs(uint32_t a, uint32_t b, uint32_t out) {
+    uint32_t a0 = X[0], a1 = X[1], b0 = X[2], b1 = X[3];
+    em->get(a); em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); em->set(a0);
+    em->get(a); em->i64c(32); em->op(I64_SHR_U); em->set(a1);
+    em->get(b); em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); em->set(b0);
+    em->get(b); em->i64c(32); em->op(I64_SHR_U); em->set(b1);
+    // t = a0*b0; u = a1*b0 + (t>>32); v = a0*b1 + (u & 0xffffffff); hi = a1*b1 + (u>>32) + (v>>32)
+    em->get(a0); em->get(b0); em->op(I64_MUL); em->i64c(32); em->op(I64_SHR_U);
+    em->get(a1); em->get(b0); em->op(I64_MUL); em->op(I64_ADD); em->set(out); // u
+    em->get(a0); em->get(b1); em->op(I64_MUL); em->get(out); em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); em->op(I64_ADD); em->set(a0); // v
+    em->get(a1); em->get(b1); em->op(I64_MUL); em->get(out); em->i64c(32); em->op(I64_SHR_U); em->op(I64_ADD);
+    em->get(a0); em->i64c(32); em->op(I64_SHR_U); em->op(I64_ADD); em->set(out);
+    // signed correction: hi -= (a<0 ? b : 0) + (b<0 ? a : 0)
+    em->get(out);
+    em->get(b); em->i64c(0); em->get(a); em->i64c(63); em->op(I64_SHR_S); em->op(I32_WRAP_I64); em->select(); em->op(I64_SUB);
+    em->get(a); em->i64c(0); em->get(b); em->i64c(63); em->op(I64_SHR_S); em->op(I32_WRAP_I64); em->select(); em->op(I64_SUB);
+    em->set(out);
+  }
+
+  // ---------------------------------------------------------------- driver
+  // region mode: make block j the current block (instructions, offsets, entry copy)
+  int blockPage(unsigned j) { return (int) reg->b[j].page; }
+  void setBlock(unsigned j) {
+    curBlock = j; ins = reg->b[j].ins; n = reg->b[j].n; boff = reg->b[j].boff; e = &reg->b[j].ent;
+    off[0] = 0;
+    for (unsigned k = 0; k < n; k++) off[k + 1] = off[k] + ins[k].ilen();
+  }
+  bool compile() {
+    if (reg) { setBlock(0); regionKernel = (BX_CPU_THIS_PTR user_pl == 0); }
+    else {
+      for (n = 0; n < e->tlen; n++) {
+        if (ins[n].getIaOpcode() == BX_INSERTED_OPCODE) break;
+      }
+      off[0] = 0;
+      for (unsigned k = 0; k < n; k++) off[k + 1] = off[k] + ins[k].ilen();
+    }
+    if (n == 0 || n > nanobox_jit_maxlen) return false;
+    mode64 = (BX_CPU_THIS_PTR cpu_mode == BX_MODE_LONG_64);
+    // flag entry classes (depend on the instructions only)
+    for (unsigned j = 0; j <= NB_REGION_MAX_BLOCKS; j++) blockFlagEntry[j] = FE_OTHER;
+    if (reg) { for (unsigned j = 0; j < reg->nblocks; j++) { setBlock(j); blockFlagEntry[j] = (Bit8u) flagEntryClass(0); if (blockFlagEntry[j] == FE_SLOW) fsc(FS_BLOCKS_SLOW); } setBlock(0); }
+    else { blockFlagEntry[0] = (Bit8u) flagEntryClass(0); if (blockFlagEntry[0] == FE_SLOW) fsc(FS_BLOCKS_SLOW); }
+    for (unsigned r = 0; r < 16; r++) usedReg[r] = headerReg[r] = writtenReg[r] = headerWritten[r] = regionWritten[r] = false;
+    usedLf = headerLf = writtenLf = headerWrittenLf = regionWrittenLf = false;
+    // pass 1: discover which registers/flags the trace touches (loop header set, region block entry
+    // states) and how many exit-chain positions each body needs
+    passNo = 1; nedges = 0;
+    for (unsigned j = 0; j <= (unsigned) BX_MAX_TRACE_LENGTH; j++) tplWrap[j] = 0;
+    usedAcm = usedUpl = usedInlineProbe = usedStk = false;
+    usedAcmTotal = usedUplTotal = usedInlineProbeTotal = usedStkTotal = true;   // pass 1 emits everything
+    siteTags = false; nsiteTotal = 0; ninvalTotal = 0; nElig = 0;
+    for (unsigned j = 0; j <= NB_REGION_MAX_BLOCKS; j++) blockInval[j] = blockElig[j] = 0;
+    if (!compilePass()) return false;
+    // pass 1 counted the memory sites and the mid-function invalidations and recorded the CFG:
+    // pass 2 declares one (tag, host) pair per ELIGIBLE site and poisons exactly those.
+    nsiteTotal = nsite; ninvalTotal = ninval;
+    usedAcmTotal = usedAcm; usedUplTotal = usedUpl; usedInlineProbeTotal = usedInlineProbe; usedStkTotal = usedStk;
+    computeEligibleBlocks();
+    passNo = 2;
+    siteTags = siteWanted();
+    if (reg) {
+      // pass 2 for regions: block entry states D_j are known now; transitions keep them in locals
+      for (unsigned r = 0; r < 16; r++) regionWritten[r] = writtenReg[r];
+      regionWrittenLf = writtenLf;
+      computeEntryDirty();
+      m.beginFunc();
+      depth = 0; loopDepth = -1; bodyDepth = -1; dispatchDepth = -1;
+      regionPass2 = true;
+      setBlock(0);           // the prologue derives L_base from block 0's first instruction
+      if (!compilePass()) return false;
+      nanobox_phase_flush(true);
+      return true;
+    }
+    if (loopWanted) {
+      // pass 2: recompile with the loop header keeping those in locals across iterations
+      for (unsigned r = 0; r < 16; r++) { headerReg[r] = usedReg[r]; headerWritten[r] = writtenReg[r]; }
+      headerLf = usedLf && blockFlagEntry[0] == FE_OTHER; headerWrittenLf = writtenLf;
+    }
+    if (loopWanted || spillChain() || siteTags) {
+      // pass 2 (a plain trace re-emits identically; only the exit chain sizes come from pass 1)
+      m.beginFunc();
+      depth = 0; loopDepth = -1; bodyDepth = -1;
+      if (!compilePass()) return false;
+    }
+    nanobox_phase_flush(true);
+    return true;
+  }
+  bool loopWanted;
+  int passNo;
+  // exit-chain size for body j in this pass: pass 1 gets room for every possible position, pass 2
+  // what pass 1 used (+1: the loop header / region entry set can add one dirtying event up front)
+  unsigned chainM(unsigned j) {
+    if (passNo == 1) return 17;
+    unsigned M = chainUsed[j] + ((reg || loopWanted) ? 1 : 0);
+    return M > 17 ? 17 : M;
+  }
+  void declareLocals() {
+    // grouped by type so the local-declaration section is two runs instead of ~60 entries
+    L_i = 0;
+    L_base = em->addLocal(I64); L_ic0 = em->addLocal(I64); L_acm = em->addLocal(I64); L_xic = em->addLocal(I64);
+    for (unsigned r = 0; r < 16; r++) L_reg[r] = em->addLocal(I64);
+    L_lfr = em->addLocal(I64); L_lfa = em->addLocal(I64);
+    for (unsigned t = 0; t < 8; t++) T[t] = em->addLocal(I64);
+    for (unsigned t = 0; t < 4; t++) X[t] = em->addLocal(I64);
+    P_op1 = em->addLocal(I64); P_op2 = em->addLocal(I64); P_res = em->addLocal(I64);
+    W = em->addLocal(I64);
+    K_stk = (nanobox_jit_stacktag != 0) ? em->addLocal(I64) : 0;
+    C_lpf = em->addLocal(I64);
+    D_lpf = em->addLocal(I64);
+    if (flagsProbeLink() && nanobox_tlbfold && shortSig()) { C_tagR = 1; C_tagW = 2; C_ppf = em->addLocal(I64); D_ppf = em->addLocal(I64); D_tagR = em->addLocal(I64); D_tagW = em->addLocal(I64); }
+    else if (flagsProbeLink() && nanobox_tlbfold) { C_tagR = 1; C_tagW = 2; C_ppf = 3; D_tagR = 4; D_tagW = 5; D_ppf = 6; }
+    else { C_ppf = em->addLocal(I64); D_ppf = em->addLocal(I64); C_tagR = em->addLocal(I64); C_tagW = em->addLocal(I64); D_tagR = em->addLocal(I64); D_tagW = em->addLocal(I64); }
+    S_tagBase = S_hostBase = 0;
+    if (siteTags) { S_tagBase = em->addLocal(I64); for (unsigned i = 1; i < nElig; i++) em->addLocal(I64); }
+    L_upl = em->addLocal(I32);
+    L_pob = em->addLocal(I32);
+    L_stkb = (nanobox_jit_stacktag & 4) ? em->addLocal(I32) : 0;
+    L_cpu = em->addLocal(I32);
+    L_tick = em->addLocal(I32);   // AOT: iterations left before the next full back-edge sync
+    L_direct = L_dcs = L_dcf = 0xffffffffu;   // direct calls: declared on first use (see unitHasRet / dcallLocals)
+    for (unsigned t = 0; t < 6; t++) T32[t] = em->addLocal(I32);
+    C_bits = em->addLocal(I32); D_bits = em->addLocal(I32);
+    if (flagsProbeLink() && nanobox_tlbfold && shortSig()) { C_host = 3; C_free = em->addLocal(I32); D_host = em->addLocal(I32); D_free = em->addLocal(I32); }
+    else if (flagsProbeLink() && nanobox_tlbfold) { C_host = 7; C_free = 8; D_host = 9; D_free = 10; }
+    else { C_host = em->addLocal(I32); C_free = em->addLocal(I32); D_host = em->addLocal(I32); D_free = em->addLocal(I32); }
+    if (siteTags) { S_hostBase = em->addLocal(I32); for (unsigned i = 1; i < nElig; i++) em->addLocal(I32); }
+    P_bits = em->addLocal(I32); P_off = em->addLocal(I32);
+    L_pfk = em->addLocal(I32);
+    L_cur = em->addLocal(I32);
+    L_regp = em->addLocal(I32);
+    V[0] = V[1] = 0xffffffffu;   // v128 temps: allocated by vloc() when a SIMD template needs one
+    curHost = C_host;
+  }
+  // The trace-linking epilogue as a function of its own (shared by every trace: it is ~600 bytes
+  // of code that used to be duplicated per trace, dominating module size and compile time). Traces
+  // tail-call it after committing their state; it tail-calls the next trace.
+  // Every JIT function (trace, region, link epilogue) has the same type: (arg i32, probe cache:
+  // C_tagR C_tagW C_ppf D_tagR D_tagW D_ppf i64, C_host C_free D_host D_free i32). The probe cache
+  // travels through the link tail call (nanobox_jit_flags bit 2) so the next trace starts with the
+  // pages the previous one probed; cpu_loop entries pass the poison (-1 tags).
+  // bit 6: the short signature (arg, C_tagR, C_tagW, C_host) — 4 params, all in registers on x64;
+  // the second entry starts poisoned in every function (C_ppf/C_free are only read in the fill arm
+  // of the probe that computes them, so they need not travel)
