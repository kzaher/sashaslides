+      // sync + the handler + the "did it end the trace" test as ONE call: the emitted form is the
+      // instruction pointer, L_base, the icount base and two packed constants
+      { ColdArm _ca(this); spillAll(true); }
+      csInvalidate();
+      if (reg) em->get(L_regp); else em->get(L_i);
+      coldArgs(k, reg ? (((Bit32u) curBlock << 9) | 0x4000u) : 0u);
+      em->call(fn(FNIDX(&nanobox_helper_step_all), "illii>i"));
