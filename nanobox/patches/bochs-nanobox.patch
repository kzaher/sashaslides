+// linear -> physical for a call target, without touching any guest-visible state: the ITLB first
+// (the same lookup the link epilogue inlines), then the page walk the debugger interface uses.
+static bool nanobox_dcall_xlate(bx_address lin, bx_phy_address *pa)
+{
+  bx_TLB_entry *te = &BX_CPU_THIS_PTR ITLB.entry[(((Bit32u) lin & ((BX_ITLB_SIZE - 1) << 12)) >> 12)];
+  if (te->lpf == (lin & LPF_MASK) && (te->accessBits & (1 << BX_CPU_THIS_PTR user_pl))) { *pa = te->ppf + (bx_phy_address)(lin & 0xfff); return true; }
+  return BX_CPU_THIS_PTR dbg_xlate_linear2phy(lin, pa);
+}
+// Fill a direct-call site: which translation, entered with which argument, is the code at `va`?
+// Read-only with respect to the guest. fn == 0 afterwards = "no translation": the caller takes the
+// ordinary exit path and the negative answer is remembered for 64 executions (an untranslatable
+// callee must not pay a page walk per call).
+static void nanobox_dcall_resolve(unsigned sitep, Bit64u va)
+{
+  NbDcallSite *s = (NbDcallSite *)(uintptr_t) sitep;
+  s->va = 0; s->fn = 0; s->arg = 0; s->ilen = 0; s->ent = 0; s->pa = 0; s->miss = 16;   // no answer: stay stale, ask again in 16
+  nanobox_aot_stats[15]++;
+  // 48 attempts, 49 gave up, 50 of those because the callee is not decoded, 51 because it is decoded
+  // but carries no translation. This is how the detform x direct-call interaction is measured: a
+  // callee whose translation is its FUNCTION's region should be resolvable far more often than one
+  // rooted wherever the guest happened to enter it.
+  nanobox_region_stats[48]++;
+  bx_phy_address pa = 0;
+  if (!nanobox_dcall_xlate((bx_address) va, &pa)) { nanobox_region_stats[49]++; nanobox_region_stats[50]++; return; }
+  bxICacheEntry_c *e = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+  if (!e || e->pAddr != pa || e->tlen == 0) { nanobox_region_stats[49]++; nanobox_region_stats[50]++; return; }
+  if (!e->jitfn) { nanobox_region_stats[49]++; nanobox_region_stats[51]++; return; }
+  s->va = va; s->cr3 = (Bit64u) BX_CPU_THIS_PTR cr3;
+  s->ent = (Bit32u)(uintptr_t) e; s->pa = (Bit64u) pa;
+  s->fn = e->jitfn; s->arg = e->jitarg; s->ilen = e->i[0].ilen(); s->miss = 0;
+}
+
+// Outlined direct-call site check (nanobox_jit_outline bit 2). Every CALL_Jq inlined the same
+// ~40-op validity test (site address, address space, the callee's iCache entry and its translation)
+// plus the cold arm that resolves or counts down. It is the same code at every call site, so it
+// lives here: the site emits `local.get site; local.get target; call` and gets the callee's
+// function index (0 = take the ordinary exit path). Byte for byte the emitted test, including its
+// unconditional (non-short-circuiting) loads through a possibly-zero entry pointer -- hence the
+// volatile integer-to-pointer reads rather than a bxICacheEntry_c *.
+static unsigned nanobox_dcall_check(unsigned sitep, Bit64u va)
+{
+  NbDcallSite *s = (NbDcallSite *)(uintptr_t) sitep;
+  const Bit64u epa = *(volatile Bit64u *)(uintptr_t)(s->ent + ICE_OFF(pAddr));
+  const Bit32u ejf = *(volatile Bit32u *)(uintptr_t)(s->ent + ICE_OFF(jitfn));
+  const unsigned stale = (unsigned)(s->va != va) | (unsigned)(s->cr3 != (Bit64u) BX_CPU_THIS_PTR cr3)
+                       | (unsigned)(epa != s->pa) | (unsigned)(ejf != s->fn);
+  if (stale) {
+    if (s->miss == 0) nanobox_dcall_resolve(sitep, va);
+    else { s->miss--; s->fn = 0; }   // stale: its slot must not be used
+  }
+  // ... and the host-stack depth guard, which was two more inline loads at every call site
+  return nanobox_dcall_depth < nanobox_dcall_max ? s->fn : 0;
+}
+// ... and the return side: leave the direct-call frame and read the address the callee returned to.
+static Bit64u nanobox_dcall_after(void)
+{
+  nanobox_dcall_depth--;
+  return nanobox_dcall_ret;
+}
