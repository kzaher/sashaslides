+          em->set(T32[4]);
+          pfMaterializeHelper();
+          em->i32c((int32_t) cc); em->call(fn(FNIDX(&nanobox_helper_cond), "i>i")); em->set(T32[3]);
+          em->get(T32[4]); em->get(T32[3]); em->op(I32_NE);
+          iff(); em->i32c(0); em->i32c((int32_t) pfKind()); em->i32c((int32_t) cc); em->get(pfO1()); em->get(pfO2()); em->get(P_res); em->get(T32[4]); em->op(I64_EXTEND_I32_U); em->get(T32[3]); em->op(I64_EXTEND_I32_U); em->call(fn(FNIDX(&nanobox_helper_flagbug), "iiillllll>v")); endb();
+          em->get(T32[4]);
+        }
+        return;
+      }
+    }
+    lfLoad();
+    switch (cc & ~1u) {
+      case CC_O: pushOF(); break;
+      case CC_B: pushCF(); break;
+      case CC_Z: pushZF(); break;
+      case CC_BE: pushCF(); pushZF(); em->op(I32_OR); break;
+      case CC_S: pushSF(); break;
+      case CC_P: pushPF(); break;
+      case CC_L: pushSF(); pushOF(); em->op(I32_XOR); break;
+      case CC_LE: pushZF(); pushSF(); pushOF(); em->op(I32_XOR); em->op(I32_OR); break;
+    }
