+// ---------------------------------------------------------------- regions
+// A region is one hot iCache trace (the entry) plus every trace it can reach through direct
+// control transfers (JMP/Jcc/CALL immediates, fall-through) inside the SAME physical page, all
+// compiled into one wasm function with a dispatch loop. Blocks are copied out of the iCache, so
+// the region does not depend on iCache entry lifetime; it depends only on the code bytes, which
+// Bochs' SMC machinery guards: the entry's traceMask is widened to the union of all block masks so
+// a write to any block flushes the entry (and with it the region's jitfn).
+// AOT phase 0 (TASKS.md K/J): regions are formed from a STATIC control-flow walk that decodes ahead of
+// execution and may span several pages (kernel text: fixed mapping); see nanobox_form_region.
+enum { NB_REGION_MAX_BLOCKS = 24, NB_REGION_MAX_INSTR = 320, NB_REGION_MAX_PAGES = 8 };
+struct RegionBlock {
+  bxICacheEntry_c ent;      // copy of the iCache entry (pAddr, traceMask, tlen; i -> ins)
+  bxInstruction_c *ins;     // owned copy of the decoded instructions
+  unsigned n;               // real instructions
+  Bit32s boff;              // offset of the block's first instruction from the region entry (negative for the previous page)
+  unsigned page;            // index into Region::pdelta/ppf/pmask
+};
+struct Region {
+  // The compiled function receives the address of this object as its parameter (entry->jitarg)
+  // and reads the per-block instruction pointers from `insptr`, so the module itself contains no
+  // absolute addresses of the copies -> the same module serves any region with the same content
+  // (in-process cache hits and pre-computed bundles).
+  bxInstruction_c *insptr[NB_REGION_MAX_BLOCKS];
+  bxICacheEntry_c *entptr[NB_REGION_MAX_BLOCKS];   // for the divergence finder's fingerprint hook
+  // Every block is an entry point: block j's iCache entry gets jitarg = &entry[j] = {this region,
+  // block index, RIP delta (boff_j + ilen of its first instruction)}; the prologue derives L_base
+  // and the initial dispatch target from it.
+  struct EntryDesc { struct Region *reg; Bit32u block; Bit32u delta; };
+  EntryDesc entry[NB_REGION_MAX_BLOCKS];
+  bxICacheEntry_c *srcEntry[NB_REGION_MAX_BLOCKS];   // the iCache entries the blocks were taken from (validated by pAddr/i before use)
+  bxInstruction_c *srcI[NB_REGION_MAX_BLOCKS];
+  unsigned nblocks;
+  RegionBlock b[NB_REGION_MAX_BLOCKS];
+  Bit32u mask;              // union of the blocks' traceMasks in the entry's page (128-byte chunks) (= pmask[0])
+  Bit64u key;               // content key (site + blocks' offsets + instructions)
+  // Pages of the region: page 0 is the entry's; the others are the linear pages pdelta[p] pages away
+  // from it, with the physical frame ppf[p] they had at formation and the SMC chunk mask pmask[p] of
+  // the region's blocks there. Cross-page transitions verify through the ITLB that the linear page is
+  // still mapped executable (and, for non-kernel regions, still to ppf[p]) and switch the fetch window
+  // like prefetch() would. Writes to any page's pmask chunks reach the region through the attach
+  // registry (nanobox_jit_page_written) and drop it.
+  unsigned npages; Bit32s pdelta[NB_REGION_MAX_PAGES]; Bit64u ppf[NB_REGION_MAX_PAGES]; Bit32u pmask[NB_REGION_MAX_PAGES];
+  // pending[j]: block j has not executed since the region was last attached. Its first execution
+  // calls nanobox_region_first(), which marks the reference write-stamp mapping exactly when the
+  // interpreter would have decoded the trace (see icache.h refMapping) and refuses to run a block of
+  // a region whose bytes were written since the attach (dead) -> leave to cpu_loop, which re-decodes.
+  Bit8u pending[NB_REGION_MAX_BLOCKS];
+  // direct-call site cache, one per block (a block ends at its CALL, so a block has at most one)
+  NbDcallSite dcall[NB_REGION_MAX_BLOCKS];
+  Bit64u lin0;              // guest LINEAR address the region was formed from: block j lives at
+                            // lin0 + b[j].boff. A physical page can be mapped at different linear
+                            // addresses in different processes, and the block offsets and page deltas
+                            // in this descriptor are LINEAR -- so a member may only be attached where
+                            // the linear placement matches, not merely where the bytes do.
+  Bit8u dead;               // a member's bytes were written after the attach (registry) -> members' jitfn cleared, pending blocks must not run
+  Bit8u ahead;              // any block was decoded ahead of execution
+  Bit32u regEpoch;          // == nb_attach_epoch iff the region has attach-registry records (the registry is reset with the JIT cache)
+  unsigned fn;              // installed function (set at attach)
+  Region() : nblocks(0), mask(0), key(0), npages(1), lin0(0), dead(0), ahead(0), regEpoch(0), fn(0) {
+    for (unsigned j = 0; j < NB_REGION_MAX_BLOCKS; j++) { insptr[j] = NULL; entptr[j] = NULL; srcEntry[j] = NULL; srcI[j] = NULL; entry[j].reg = NULL; entry[j].block = 0; entry[j].delta = 0; pending[j] = 0; }
+    for (unsigned p = 0; p < NB_REGION_MAX_PAGES; p++) { pdelta[p] = 0; ppf[p] = 0; pmask[p] = 0; }
+    memset(dcall, 0, sizeof(dcall));
+    for (unsigned j = 0; j < NB_REGION_MAX_BLOCKS; j++) dcall[j].miss = nanobox_dcall_warmup;
+  }
+  ~Region() { for (unsigned j = 0; j < nblocks; j++) delete[] b[j].ins; }
+};
+static Region nanobox_region_layout_probe;
+// first execution of block j since the attach (called from the region prologue / an in-region
+// transition): 0 = the region is dead, leave to cpu_loop with the state committed
+static int nanobox_region_first(unsigned regp, unsigned j)
+{
+  Region *r = (Region *) (uintptr_t) regp;
+  if (r->dead) { nanobox_region_stats[22]++; return 0; }
+  r->pending[j] = 0;
+  pageWriteStampTable.nanobox_ref_mark(r->b[j].ent.pAddr, r->b[j].ent.traceMask);
+  nanobox_region_stats[23]++;
+  return 1;
+}
+#define REGION_OFF(field) ((uint32_t)((uintptr_t)&nanobox_region_layout_probe.field - (uintptr_t)&nanobox_region_layout_probe))
