+/////////////////////////////////////////////////////////////////////////
+// Compiled-trace cache. iCache entries are short-lived (the trace pool wraps every ~600K decoded
+// instructions and every entry is a direct-mapped slot), but the code they hold is not: the same
+// bytes get decoded into the same instruction stream again and again. Compiled functions are
+// therefore owned by this cache, keyed by a hash of the decoded instructions, and handed back to
+// any entry that decodes the same trace — no threshold wait, no recompilation.
+/////////////////////////////////////////////////////////////////////////
+#define JITCACHE_SIZE (1u << 18)
+#define JITCACHE_LIMIT (JITCACHE_SIZE / 2)
+struct JitCacheEntry { Bit64u key; Bit32u fn; Bit32u len; Bit32u mask; Region *region; }; // mask/region: only for region translations
+static JitCacheEntry jitcache[JITCACHE_SIZE];
+static unsigned jitcache_count = 0;
+static Bit64u jitcache_hits = 0, jitcache_clears = 0;
+
+// ---- cache-clear safety (docs/aot-size-and-coverage.md plan item 11, TASKS.md V.8) --------------
+// nanobox_jit_cache_clear() frees EVERY Region in the jitcache, frees every Region still listed in
+// nb_pending (through nanobox_jit_batch_drop) and, through hook_release_all(), invalidates every
+// function-table index the engine installed. It is reachable from two places that sit INSIDE a
+// producer which is half way through publishing a translation:
+//   * nanobox_jit_cache_put   -- the content cache reached JITCACHE_LIMIT
+//   * nanobox_region_attach   -- the attach-registry pool is full and a sweep did not free enough
+// and the batch flush calls BOTH, once per queued entry. Three faults follow, all fixed below and
+// all restored bit for bit by nanobox_jit_clearfix = 0 (A/B inside one binary):
+//   1 DOUBLE FREE. nanobox_jit_batch_flush hands nb_pending[i].reg to the jitcache as it walks the
+//     batch, but leaves the pointer in nb_pending. A clear at entry i therefore frees entries
+//     0..i-1 twice: once through nanobox_jit_batch_drop, once through the jitcache sweep.
+//   2 A RELEASED FUNCTION INDEX PUBLISHED INTO THE FRESH CACHE. Both the flush and the non-batched
+//     compile call nanobox_jit_attach BEFORE nanobox_jit_cache_put. A clear inside the attach
+//     releases `fn` with everything else, and the put then re-publishes that dead index under its
+//     content key in the now-empty cache. The next entry that looks the key up gets
+//     e->jitfn = <released slot> and its call_indirect traps -- "null function or function
+//     signature mismatch" if the slot is still null, silent wrong code if it has been recycled.
+//   3 A DANGLING Region PUBLISHED. The same put also stores pd.reg, already freed by (1).
+unsigned nanobox_jit_clearfix = 1;
+// Diagnostic only (docs plan item 11): the number of live content-cache entries at which
+// nanobox_jit_cache_put clears the cache. Default JITCACHE_LIMIT = the shipping value; a small value
+// reproduces in seconds what a long session reaches on its own. Never set outside a debug run.
+unsigned nanobox_jit_cache_lim = JITCACHE_LIMIT;
+NB_EXPORT(nanobox_set_jit_cache_limit) void nanobox_set_jit_cache_limit(unsigned n) { nanobox_jit_cache_lim = n ? n : JITCACHE_LIMIT; }
+NB_EXPORT(nanobox_set_jit_clearfix) void nanobox_set_jit_clearfix(unsigned on) { nanobox_jit_clearfix = on; }
+// [0] clears from nanobox_jit_cache_put (cache full)  [1] clears from nanobox_region_attach (pool full)
+// [2] clears reached while a batch flush was on the stack
+// [3] regions that flush had already handed to the jitcache when such a clear happened (= double frees)
+// [4] released fn indices NOT published because the attach cleared under the producer
+// [5] batch flushes abandoned after a clear           [6] clears from anywhere else (AOT mode switch)
+static Bit64u nb_clear_diag[8];
+static unsigned nb_clear_why = 6;        // set by the caller immediately before it calls the clear
+static unsigned nb_in_flush = 0;         // nanobox_jit_batch_flush is on the stack
+static unsigned nb_flush_published = 0;  // regions of the current flush already stored in the jitcache
+static bool nb_put_stored = false;       // did the last nanobox_jit_cache_put actually store its region?
+
+static Bit64u nanobox_jit_hash(bxICacheEntry_c *e, unsigned &nreal)
+{
+  Bit64u h = 0xcbf29ce484222325ull ^ (nanobox_jit_level * 0x9E3779B97F4A7C15ull);
+  nreal = 0;
+  for (unsigned k = 0; k < e->tlen; k++) {
+    if (e->i[k].getIaOpcode() == BX_INSERTED_OPCODE) break;
+    nreal++;
+    // 8 bytes at a time (bxInstruction_c is a multiple of 8 bytes)
+    const Bit64u *p = (const Bit64u *) &e->i[k];
+    for (unsigned w = 0; w < sizeof(bxInstruction_c) / 8; w++) { h ^= p[w]; h *= 0x100000001b3ull; h ^= h >> 29; }
+  }
+  h ^= nreal;
+  h = h ? h : 1;
+  // Bit 0 of the content key IS the tier. A translation is only ever handed to an entry that asks
+  // for the same tier, and every attach can read the tier back out of the key it was found under --
+  // which is what lets the two forms share the cache, the bundle and the batch with no side table.
+  return (h & ~1ull) | (nb_tier0_now ? 1ull : 0ull);
+}
+static JitCacheEntry *nanobox_jit_cache_slot(Bit64u key)
+{
+  unsigned idx = (unsigned)(key ^ (key >> 29)) & (JITCACHE_SIZE - 1);
+  for (unsigned probe = 0; probe < JITCACHE_SIZE; probe++) {
+    JitCacheEntry *c = &jitcache[(idx + probe) & (JITCACHE_SIZE - 1)];
+    if (c->key == key || c->key == 0) return c;
+  }
+  return NULL;
+}
+static void nanobox_jit_batch_drop(void);
+static void nanobox_jit_cache_clear(void);
+static void nanobox_attach_pool_reset(void);
+static void nanobox_jit_cache_clear(void)
+{
+  nb_clear_diag[nb_clear_why < 8 ? nb_clear_why : 6]++;
+  if (nb_in_flush) { nb_clear_diag[2]++; nb_clear_diag[3] += nb_flush_published; }
+  nb_clear_why = 6;
+  nanobox_jit_batch_drop();
+  hook_release_all();
+  nanobox_link_fn = 0;
+  nanobox_attach_pool_reset();   // records point at the regions deleted below
+  for (unsigned i = 0; i < JITCACHE_SIZE; i++) if (jitcache[i].region) delete jitcache[i].region;
+  memset(jitcache, 0, sizeof(jitcache));
+  jitcache_count = 0;
+  jitcache_clears++;
+  // every iCache entry pointing at released code must forget it
+  for (unsigned n = 0; n < BxICacheEntries; n++) BX_CPU(0)->iCache.entry[n].jitfn = 0;
+}
+NB_EXPORT(nanobox_jit_cache_stat) double nanobox_jit_cache_stat(unsigned which)
+{
+  switch (which) { case 0: return jitcache_count; case 1: return (double) jitcache_hits; case 2: return (double) jitcache_clears;
+                   default: return which >= 3 && which < 11 ? (double) nb_clear_diag[which - 3] : 0; }
+}
+
+/////////////////////////////////////////////////////////////////////////
+// Region formation (AOT phase 0): a static control-flow walk from the entry over direct successors
+// (JMP/Jcc targets, fall-through, the continuation after a direct CALL -- never the callee), decoding
+// ahead of execution where the successor has not been decoded yet and, for kernel text (fixed
+// physical mapping), across page boundaries. Regions stop at RET / indirect transfers / SYSCALL and
+// the budgets. A trace decoded from address X is a function of the code bytes and the CPU mode only
+// (Bochs' mergeTraces preserves natural trace ends), so a trace decoded ahead is exactly the trace
+// the interpreter will run from X; the only history in the iCache that is guest-visible is the
+// write-stamp marks (STOP_TRACE placement), which the reference mapping keeps exact (icache.h).
+/////////////////////////////////////////////////////////////////////////
+extern Bit64u nanobox_aot_stats[16];
+// guest function boundaries (--aot-fnmap System.map), defined with the AOT precompile API below
+static Bit64u nb_fn_start(bx_address lin);
+static bool nb_fn_range(bx_address lin, Bit64u *lo, Bit64u *hi);
+unsigned nanobox_jit_region_max = NB_REGION_MAX_BLOCKS;   // regions on by default (--jit-region 1 turns them off) (nanobox_set_jit_region / --jit-region N / page ?region=N)
+// AOT mode (TASKS.md R; harness NANOBOX_AOT=1, page ?aot=1, cfg.aot): 0 = the shipping engine (trace
+// regions from decoded successors on the entry page +/-1, threshold as configured, every in-region
+// edge a full trace boundary). 1 = function-scope static regions (decode ahead over direct targets /
+// fall-through / CALL continuations, kernel multi-page), compile on FIRST touch (threshold 1) when
+// nothing precompiled exists, timer/async tests only at loop back-edges / region exits / handler
+// steps, direct conditions (nanobox_jit_flags bits 0|1) on. Identity with the interpreter's trace
+// boundaries is NOT kept in this mode by design; guest RAM may differ from the reference engine's.
+unsigned nanobox_jit_stackify = 1;   // density: stack scheduling over the emitted stream (nbw::Module::stackify)
+unsigned nanobox_jit_aot = 0;
+// AOT: decode successors that are not in the iCache YET and pull them into the region. Default 0
+// since 2026-08-19 (work/prof/boot.md): speculative growth is what the R.3 size wall and the boot cost are
+// made of, and it also costs the hot loop -- a loop whose exit block has never run stays a
+// single-block region (a single-trace loop, registers in locals across iterations, periodic timer
+// check), while decode-ahead makes it a 2-block region whose back edge goes through the region's
+// dispatch and pays the full inter-trace sync EVERY iteration. Measured on work/fib at n = 1e9,
+// AOT: 1.78 ns/iteration with decode-ahead, 0.59 ns without (3x), with the codex boot and the
+// keystroke medians unchanged and 30 MB translated instead of 39 MB.
+// nanobox_aot_compile_function turns it back on for its own sweep: an offline translator has to
+// decode ahead by definition -- it translates code that has never executed.
+unsigned nanobox_jit_aot_ahead = 0;
+unsigned nanobox_jit_aot_minhot = 0;  // AOT: a decoded successor joins only if its slot has executed at least this often (0: any)
+unsigned nanobox_jit_aot_dedupe = 0;  // AOT: a successor that already carries a translation (member of another region / plain trace) is not copied in again (its edge stays an external link)
+// AOT (TASKS.md S.4/S.11): DETERMINISTIC FORMATION, as a bitmask so each piece can be A/B'd without a
+// rebuild. A region has to be a function of (entry address, guest code bytes) alone, or the offline
+// translator and the runtime build different regions at the same address and a precompiled artifact is
+// never found (measured: 90 % of kernel lookups missed).
+//   1  state independence: the walk consults neither dedupe (does the successor already carry a
+//      translation) nor minhot (how often its slot ran) nor the ITLB (cross-page frames come from the
+//      page tables), and nanobox_jit_after_decode stops handing an entry a translation compiled for a
+//      DIFFERENT address that decoded to the same bytes;
+//   2  the walk stops at the containing function's boundary (nb_fn_range), and the first touch of any
+//      address in a function builds the WHOLE function with the same sweep the offline driver runs;
+//   4  a block that is already a member of a live region attaches to it instead of rooting a second,
+//      overlapping region of its own;
+//   8  no mergeTraces: a decoded trace stops depending on what the iCache holds after it;
+//  16  extend 4 to user space (off: a user physical page can be mapped by several processes and
+//      recycled underneath, so equal bytes at equal physical address is not the same code object).
+// 0 = the state-dependent former (shipped default); 15 = everything the kernel artifact needs.
+unsigned nanobox_jit_aot_detform = 0;
+// detform bit 2: build the whole containing function at the first touch of any of its addresses.
+unsigned nanobox_jit_aot_sweep = 1;
+// detform, OFFLINE sweeps only: reset the iCache instruction pool between functions (see
+// nb_aot_sweep_function). The kernel artifact is generated with it on.
+unsigned nanobox_jit_aot_poolreset = 0;
+// DETERMINISTIC DEDUPE (detform bit 32). The old dedupe asked `se->jitfn` -- "does this successor
+// already carry a translation" -- which is a property of whatever the engine happens to have compiled,
+// so the two sides disagreed and key agreement fell 98.7 % -> 83.1 %. The rule that does the same job
+// without consulting engine state: a successor already claimed by an EARLIER REGION OF THE SAME SWEEP
+// does not join. The sweep visits a function's sites in a fixed order from its first byte, so the claim
+// map is a function of (function bytes, sweep order) only -- identical offline and at runtime.
+static Bit8u *nb_claim = NULL;          // one byte per address of the function being swept
+static bx_address nb_claim_lin = 0;
+static unsigned nb_claim_len = 0;
+static bool nb_claimed(bx_address lin)
+{
+  return nb_claim && lin >= nb_claim_lin && lin < nb_claim_lin + nb_claim_len && nb_claim[lin - nb_claim_lin];
+}
+static void nb_claim_mark(bx_address lin)
+{
+  if (nb_claim && lin >= nb_claim_lin && lin < nb_claim_lin + nb_claim_len) nb_claim[lin - nb_claim_lin] = 1;
+}
+// AOT: how many times a self-loop may take its back edge before it runs the full inter-trace sync
+// (guest timer, async_event, fetch window). Identity is waived under the flag, so the interrupt is
+// seen up to this many iterations late -- at 64 iterations of a 6-instruction loop that is <400 guest
+// instructions, well under a microsecond of guest time. 1 = the identity behaviour (check every time).
+unsigned nanobox_jit_aot_tick = 64;
+unsigned nanobox_jit_tickexact = 0;   // AOT tick-exactness mask, default 0 = today's AOT engine
+// AOT, on the user's instruction: a guest CALL need not write its return address into emulated RAM
+// and a guest RET need not read it back -- both are a TLB probe plus a memory access (~20 and ~15
+// wasm instructions) for a value the engine already knows. With this on, the pair is kept on a HOST
+// shadow stack instead: CALL records (rsp_after, return VA), RET takes the top entry when the guest's
+// rsp still matches it. RSP itself is still adjusted -- it is architecturally visible and the callee
+// addresses its locals through it; only the 8 bytes it points at are not written.
+//
+// THE HAZARD, stated plainly: guest code reads those bytes. Rust and C++ unwinders walk .eh_frame and
+// read return addresses off the stack on every panic; call/pop PIC idioms, setjmp/longjmp and a
+// kernel reading a user stack do the same. Those reads get whatever was in that memory before. The
+// mismatch counter (nanobox_stat 19) shows every RET whose rsp did not match the shadow entry --
+// non-zero means the guest is manipulating return addresses and this mode is not safe for it.
+// MEASURED 2026-08-18: with this on the guest does not survive its own boot -- the kernel changes
+// stacks constantly (interrupts, syscalls, context switches), so the shadow entry's rsp stops
+// matching, and the return address the guest then needs was never written. Storing the return
+// address is the floor; what can go is everything AROUND the store (see emitStackWrite under AOT).
+// Kept as a knob for experiments only; default OFF.
+unsigned nanobox_jit_aot_nostack = 0;
+// direct calls between translated functions (nanobox_jit_flags bit 9)
+unsigned nanobox_dcall_depth = 0;
+unsigned nanobox_dcall_max = 200;
+Bit64u nanobox_dcall_ret = 0;
+unsigned nanobox_dcall_warmup = 0;
+NB_EXPORT(nanobox_set_jit_dcall_max) void nanobox_set_jit_dcall_max(unsigned n) { nanobox_dcall_max = n; }
+NB_EXPORT(nanobox_set_jit_dcall_warmup) void nanobox_set_jit_dcall_warmup(unsigned n) { nanobox_dcall_warmup = n; }
+NbShadowEnt nanobox_shadow[NB_SHADOW_MAX];
+unsigned nanobox_shadow_n = 0;
+Bit64u nanobox_shadow_miss = 0;
+NB_EXPORT(nanobox_set_jit_region) void nanobox_set_jit_region(unsigned maxBlocks) { nanobox_jit_region_max = maxBlocks; }
+// nanobox_set_jit_aot(1) after nanobox_set_jit(level, threshold): threshold -> 1 and the direct-condition
+// bits go on (nanobox_set_jit_flags / NANOBOX_FLAGS afterwards can still override the mask)
+NB_EXPORT(nanobox_set_jit_aot) void nanobox_set_jit_aot(unsigned on)
+{
+  // A MID-RUN mode change (harness --aot-mode-at: boot on the trace JIT, run the session compiled --
+  // TASKS.md R.5 says a boot is millions of one-shot entries and each costs ~400 ns more compiled
+  // than interpreted) must release everything compiled so far. The two modes give a compiled function
+  // DIFFERENT wasm signatures -- bit 9 passes rip/ic0 as parameters -- and both the shared link
+  // function's tail call and a direct-call site reach a translation through the function table by
+  // type, so a table holding both shapes traps on the first cross-mode call. Clearing is also the
+  // only way the region former's rules apply uniformly: a region formed under the trace rules keeps
+  // its trace boundaries forever.
+  // ...and only when there is something to release. At start-up the mode is selected before anything
+  // is compiled, and clearing there would also release the modules a preloaded --jit-bundle just
+  // instantiated (hook_release_all does not distinguish them).
+  if ((on != 0) != (nanobox_jit_aot != 0) && nanobox_jit_level >= 2 && (jitcache_count || nanobox_link_fn)) { nanobox_jit_cache_clear(); nb_link_fresh = 1; }
+  nanobox_jit_aot = on;
+  // dedupe is ON in AOT mode: with every block an entry point, a successor that already carries a
+  // translation was being copied into each region that reaches it -- 652 MB of wasm for one codex
+  // boot, 193 k of the 216 k regions duplicates of code already translated. Turning it on measured
+  // 652 -> 304 MB and boot 28.6 -> 23.0 s with nothing else changed (TASKS.md R.2); the offline
+  // artifact holds one translation per block, which is what the runtime should attach to.
+  // NANOBOX_AOT_DEDUPE=0 restores the copying former for an A/B.
+  // bit 9 = direct calls between translated functions (a guest CALL becomes a wasm call, the matching
+  // RET a wasm return). Measured: a call+ret pair goes 36-42 ns -> 15.8-18.7 ns (2.2x), 99.59 % of
+  // direct-CALL sites take it, the call-free loop is slightly FASTER (0.96 vs 1.03 ns/iteration), and
+  // the guest clock stays exact. Boot costs ~5 %, inside this scenario's round-to-round spread.
+  // nanobox_set_jit_dcall_max(0) forces every CALL back down the old exit path without a rebuild.
+  // THRESHOLD: AOT mode used to force 1 ("everything precompiled, no interpreter dispatch"). Measured
+  // 2026-08-19 (work/prof/boot.md) on the codex scenario, one round each:
+  //   threshold |  boot  | keystroke median / median of the last half / max | wasm translated
+  //         1   | 35.4 s |  25 / 54 /  399 ms                              | 600 MB
+  //        16   | 21.6 s |  22 / 23 / 1059 ms                              | 235 MB
+  //        64   | 19.5 s |  17 / 15 /  195 ms                              | 154 MB
+  //      2000   |  8.6 s |  12 / 16 /   39 ms                              |  36 MB
+  //   trace JIT |  7.1 s |  12 / 15 /   32 ms                              |  23 MB
+  // Threshold 1 does not just cost boot time: it puts a synchronous region translation in FRONT of
+  // every newly reached code path, which is what the second-long keystroke stalls are. Our own
+  // translator is the cost, not V8 -- of the 248 MB a threshold-1 session emits, V8 compiles it in
+  // 1.0 s while the engine spends ~15 s producing it. So AOT mode now changes the CODEGEN only and
+  // leaves the compile policy to nanobox_set_jit(); nanobox_set_jit_aot_threshold(1) (harness
+  // NANOBOX_AOT_THRESHOLD=1, page ?aotthreshold=1) restores "compile at the first touch".
+  if (on) { nanobox_jit_flags |= 1 | 2 | 512; nanobox_jit_aot_dedupe = 1; }
+  // the census counters live in the wizer snapshot too (the pre-init boot ran ~95 M interpreted traces
+  // with the JIT off): start them from zero for this run
+  nanobox_stats.interp_traces = 0; nanobox_stats.interp_icount = 0; nanobox_stats.jit_intrans = 0;
+  memset(nanobox_aot_stats, 0, sizeof(nanobox_aot_stats));
+}
+// AOT compile policy: the hot-count a block must reach before it is formed + translated. 1 = the
+// original AOT behaviour (translate at the first touch, nothing interpreted, 35 s to a codex prompt).
+NB_EXPORT(nanobox_set_jit_aot_threshold) void nanobox_set_jit_aot_threshold(unsigned n) { nanobox_jit_threshold = n ? n : 1; }
+NB_EXPORT(nanobox_set_jit_aot_ahead) void nanobox_set_jit_aot_ahead(unsigned on) { nanobox_jit_aot_ahead = on; }
