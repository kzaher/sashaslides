@@ -0,0 +1,520 @@
+/////////////////////////////////////////////////////////////////////////
+// nanobox: a tiny WebAssembly binary emitter used by the trace JIT.
+//
+// Builds a single-function module:
+//   (import "e" "m" (memory 0))                ; the engine's own linear memory
+//   (import "h" "<k>" (func ...))              ; helper functions (Bochs handlers / runtime)
+//   (func (export "r") (param i32) ...)        ; the compiled trace
+// The host instantiates it against the engine instance and drops the export into the engine's
+// function table so the C++ side can call it through a plain function pointer.
+/////////////////////////////////////////////////////////////////////////
+
+#ifndef NANOBOX_WASM_H
+#define NANOBOX_WASM_H
+
+#include <stdint.h>
+#include <string.h>
+#include <stdlib.h>
+
+extern unsigned nanobox_jit_stackify;   // density: stack scheduling of the emitted stream (0 disables; defined in nanobox_jit.cc)
+
+namespace nbw {
+
+enum ValType : uint8_t { I32 = 0x7f, I64 = 0x7e, F32 = 0x7d, F64 = 0x7c, V128 = 0x7b, EXNREF = 0x69, VOID = 0x40 };
+
+// -- opcodes -----------------------------------------------------------------------------------
+enum Op : uint8_t {
+  UNREACHABLE = 0x00, NOP = 0x01, BLOCK = 0x02, LOOP = 0x03, IF = 0x04, ELSE = 0x05,
+  THROW = 0x08, RETHROW = 0x09, THROW_REF = 0x0a, END = 0x0b, BR = 0x0c, BR_IF = 0x0d, BR_TABLE = 0x0e,
+  RETURN = 0x0f, CALL = 0x10, CALL_INDIRECT = 0x11, RETURN_CALL = 0x12, RETURN_CALL_INDIRECT = 0x13, TRY_TABLE = 0x1f,
+  DROP = 0x1a, SELECT = 0x1b,
+  LOCAL_GET = 0x20, LOCAL_SET = 0x21, LOCAL_TEE = 0x22, GLOBAL_GET = 0x23, GLOBAL_SET = 0x24,
+  I32_LOAD = 0x28, I64_LOAD = 0x29, F32_LOAD = 0x2a, F64_LOAD = 0x2b,
+  I32_LOAD8_S = 0x2c, I32_LOAD8_U = 0x2d, I32_LOAD16_S = 0x2e, I32_LOAD16_U = 0x2f,
+  I64_LOAD8_S = 0x30, I64_LOAD8_U = 0x31, I64_LOAD16_S = 0x32, I64_LOAD16_U = 0x33, I64_LOAD32_S = 0x34, I64_LOAD32_U = 0x35,
+  I32_STORE = 0x36, I64_STORE = 0x37, F32_STORE = 0x38, F64_STORE = 0x39,
+  I32_STORE8 = 0x3a, I32_STORE16 = 0x3b, I64_STORE8 = 0x3c, I64_STORE16 = 0x3d, I64_STORE32 = 0x3e,
+  I32_CONST = 0x41, I64_CONST = 0x42, F32_CONST = 0x43, F64_CONST = 0x44,
+  I32_EQZ = 0x45, I32_EQ = 0x46, I32_NE = 0x47, I32_LT_S = 0x48, I32_LT_U = 0x49, I32_GT_S = 0x4a, I32_GT_U = 0x4b,
+  I32_LE_S = 0x4c, I32_LE_U = 0x4d, I32_GE_S = 0x4e, I32_GE_U = 0x4f,
+  I64_EQZ = 0x50, I64_EQ = 0x51, I64_NE = 0x52, I64_LT_S = 0x53, I64_LT_U = 0x54, I64_GT_S = 0x55, I64_GT_U = 0x56,
+  I64_LE_S = 0x57, I64_LE_U = 0x58, I64_GE_S = 0x59, I64_GE_U = 0x5a,
+  I32_CLZ = 0x67, I32_CTZ = 0x68, I32_POPCNT = 0x69, I32_ADD = 0x6a, I32_SUB = 0x6b, I32_MUL = 0x6c,
+  I32_DIV_S = 0x6d, I32_DIV_U = 0x6e, I32_REM_S = 0x6f, I32_REM_U = 0x70, I32_AND = 0x71, I32_OR = 0x72, I32_XOR = 0x73,
+  I32_SHL = 0x74, I32_SHR_S = 0x75, I32_SHR_U = 0x76, I32_ROTL = 0x77, I32_ROTR = 0x78,
+  I64_CLZ = 0x79, I64_CTZ = 0x7a, I64_POPCNT = 0x7b, I64_ADD = 0x7c, I64_SUB = 0x7d, I64_MUL = 0x7e,
+  I64_DIV_S = 0x7f, I64_DIV_U = 0x80, I64_REM_S = 0x81, I64_REM_U = 0x82, I64_AND = 0x83, I64_OR = 0x84, I64_XOR = 0x85,
+  I64_SHL = 0x86, I64_SHR_S = 0x87, I64_SHR_U = 0x88, I64_ROTL = 0x89, I64_ROTR = 0x8a,
+  I32_WRAP_I64 = 0xa7, I64_EXTEND_I32_S = 0xac, I64_EXTEND_I32_U = 0xad,
+  I32_EXTEND8_S = 0xc0, I32_EXTEND16_S = 0xc1, I64_EXTEND8_S = 0xc2, I64_EXTEND16_S = 0xc3, I64_EXTEND32_S = 0xc4,
+};
+// SIMD (128-bit) sub-opcodes, all behind the 0xfd prefix (Emit::simd / v128_load / v128_store)
+enum SimdOp : uint32_t {
+  V128_LOAD = 0x00, V128_LOAD8_SPLAT = 0x07, V128_STORE = 0x0b, V128_CONST = 0x0c,
+  I8X16_SWIZZLE = 0x0e, I8X16_SPLAT = 0x0f, I16X8_SPLAT = 0x10, I32X4_SPLAT = 0x11, I64X2_SPLAT = 0x12,
+  I8X16_EXTRACT_LANE_U = 0x16, I32X4_EXTRACT_LANE = 0x1b, I64X2_EXTRACT_LANE = 0x1d, I64X2_REPLACE_LANE = 0x1e,
+  I8X16_EQ = 0x23, I8X16_LT_S = 0x25, I16X8_EQ = 0x2d, I32X4_EQ = 0x37,
+  V128_NOT = 0x4d, V128_AND = 0x4e, V128_ANDNOT = 0x4f, V128_OR = 0x50, V128_XOR = 0x51, V128_BITSELECT = 0x52, V128_ANY_TRUE = 0x53,
+  I8X16_ALL_TRUE = 0x63, I8X16_BITMASK = 0x64, I8X16_SHR_U = 0x6d, I16X8_BITMASK = 0x84,
+};
+
+// -- growable byte buffer ---------------------------------------------------------------------------
+struct Buf {
+  uint8_t *p; uint32_t n, cap;
+  Buf() : p(NULL), n(0), cap(0) {}
+  ~Buf() { free(p); }
+  void reserve(uint32_t need) {
+    if (n + need <= cap) return;
+    uint32_t c = cap ? cap : 1024;
+    while (c < n + need) c *= 2;
+    p = (uint8_t *) realloc(p, c); cap = c;
+  }
+  void b8(uint32_t b) { reserve(1); p[n++] = (uint8_t) b; }
+  void raw(const void *src, uint32_t len) { reserve(len); memcpy(p + n, src, len); n += len; }
+  void uleb(uint32_t v) { do { uint8_t b = v & 0x7f; v >>= 7; if (v) b |= 0x80; b8(b); } while (v); }
+  void sleb32(int32_t v) { for (;;) { uint8_t b = v & 0x7f; v >>= 7; if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40))) { b8(b); return; } b8(b | 0x80); } }
+  void sleb64(int64_t v) { for (;;) { uint8_t b = v & 0x7f; v >>= 7; if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40))) { b8(b); return; } b8(b | 0x80); } }
+  // 5-byte fixed-width u32 (patchable)
+  void u32_fixed5(uint32_t v) { for (int i = 0; i < 5; i++) { uint8_t b = v & 0x7f; v >>= 7; if (i < 4) b |= 0x80; b8(b); } }
+  void patch_u32_fixed5(uint32_t at, uint32_t v) { for (int i = 0; i < 5; i++) { uint8_t b = v & 0x7f; v >>= 7; if (i < 4) b |= 0x80; p[at + i] = b; } }
+  void clear() { n = 0; }
+  void swap(Buf &o) { uint8_t *tp = p; uint32_t tn = n, tc = cap; p = o.p; n = o.n; cap = o.cap; o.p = tp; o.n = tn; o.cap = tc; }
+};
+
+// -- function types ---------------------------------------------------------------------------------
+struct FuncType {
+  uint8_t nparams, nresults;
+  ValType params[24];   // 12 overflowed silently on a 15-parameter signature: the type section came
+                        // out malformed, V8 rejected EVERY module ("invalid value type 0x0"), the JIT
+                        // fell back to the interpreter and the run presented as a HANG, not an error.
+  ValType results[2];
+  bool operator==(const FuncType &o) const {
+    if (nparams != o.nparams || nresults != o.nresults) return false;
+    for (int i = 0; i < nparams; i++) if (params[i] != o.params[i]) return false;
+    for (int i = 0; i < nresults; i++) if (results[i] != o.results[i]) return false;
+    return true;
+  }
+};
+
+
+// -- stack scheduling ("RegStackify") ---------------------------------------------------------
+// The templates write every intermediate through a local (`local.get a; local.get b; i64.add;
+// local.set c` ... `local.get c`). When the produced value is consumed later in the SAME
+// straight-line region, the value can simply stay on the operand stack instead:
+//
+//     local.set X ; C ; local.get X      ->      local.tee X ; C
+//
+// is valid whenever C is stack-neutral at its top level, never dips below the value, writes
+// neither X nor a label outside C, and the consuming `local.get X` sits at C's top level. The
+// `local.set` becomes a `local.tee`, so X is still written and no liveness analysis is needed:
+// the rewrite is a pure win of one instruction per pair and is semantics-preserving.
+
+struct Ins {
+  uint32_t at, len, a, a2;
+  uint8_t op, cls;      // cls: see CL_* below
+  int16_t pops, pushes;
+};
+enum { CL_PLAIN = 0, CL_BLOCK, CL_IF, CL_ELSE, CL_END, CL_BR, CL_BRIF, CL_BRTAB, CL_TERM, CL_GET, CL_SET, CL_TEE, CL_BARRIER };
+
+// -- module builder -------------------------------------------------------------------------------
+class Module {
+public:
+  enum { MAX_TYPES = 64, MAX_IMPORTS = 512 };   // outline: the shared helpers add signatures; addType() has no bounds check, so keep headroom
+  FuncType types[MAX_TYPES]; uint32_t ntypes;
+  struct Import { uint32_t typeIdx; uint32_t key; } imports[MAX_IMPORTS]; uint32_t nimports;
+  uint32_t importKeys[MAX_IMPORTS]; // e.g. Bochs function-table index of the imported function
+  Buf code;                          // CURRENT function body (locals + expr), filled by the emitter
+  Buf locals;                        // local declarations (count, type)*, run-length grouped
+  uint32_t nlocalDecls;
+  int32_t lastRunPos; uint8_t lastRunType; uint32_t lastRunCount;   // open run in `locals`
+  uint32_t nparams;                  // params of the exported function
+  uint32_t funcTypeIdx;
+  // finished functions (a module may hold many: batched traces): serialised bodies + their types
+  enum { MAX_FUNCS = 64 };
+  Buf codeSec;                       // concatenated (size-prefixed) bodies
+  uint32_t funcTypes[MAX_FUNCS]; uint32_t nfuncs;
+
+  Module() : ntypes(0), nimports(0), nlocalDecls(0), lastRunPos(-1), lastRunType(0), lastRunCount(0), nparams(0), funcTypeIdx(0), nfuncs(0) {}
+
+  // start a new function body (the emitter writes into code/locals)
+  void beginFunc() { code.clear(); locals.clear(); nlocalDecls = 0; lastRunPos = -1; lastRunCount = 0; }
+  // seal the current body as local function #nfuncs (function index nimports + nfuncs); returns its local index
+  uint32_t endFunc(uint32_t typeIdx) {
+    stackify();
+    Buf body; body.uleb(nlocalDecls); body.raw(locals.p, locals.n); body.raw(code.p, code.n); body.b8(END);
+    codeSec.uleb(body.n); codeSec.raw(body.p, body.n);
+    funcTypes[nfuncs] = typeIdx;
+    beginFunc();
+    return nfuncs++;
+  }
+  bool funcsFull() const { return nfuncs >= MAX_FUNCS; }
+
+  uint32_t addType(const FuncType &t) {
+    for (uint32_t i = 0; i < ntypes; i++) if (types[i] == t) return i;
+    types[ntypes] = t; return ntypes++;
+  }
+  static FuncType ft(uint8_t np, const ValType *ps, uint8_t nr, const ValType *rs) {
+    FuncType t; t.nparams = np; t.nresults = nr;
+    for (int i = 0; i < np; i++) t.params[i] = ps[i];
+    for (int i = 0; i < nr; i++) t.results[i] = rs[i];
+    return t;
+  }
+  // returns the function index of the import (imports are numbered before the local function)
+  uint32_t addImport(uint32_t key, const FuncType &t) {
+    for (uint32_t i = 0; i < nimports; i++) if (imports[i].key == key && types[imports[i].typeIdx] == t) return i;
+    imports[nimports].typeIdx = addType(t); imports[nimports].key = key; importKeys[nimports] = key;
+    return nimports++;
+  }
+  bool importsFull() const { return nimports >= MAX_IMPORTS - 2; }
+  uint32_t localFuncIndex() const { return nimports; }
+
+  // ---- stack scheduling (see the note above Ins) ----------------------------------------------
+  enum { STK_MAX_INS = 65536, STK_WINDOW = 48 };
+  static uint32_t rdU(const uint8_t *p, uint32_t &i) { uint32_t v = 0, sh = 0; for (;;) { uint8_t b = p[i++]; v |= (uint32_t)(b & 0x7f) << sh; if (!(b & 0x80)) break; sh += 7; } return v; }
+  static void skS(const uint8_t *p, uint32_t &i) { while (p[i++] & 0x80) {} }
+  // decode the current body; false = an opcode this decoder does not model (pass skipped)
+  bool decodeBody(Ins *out, uint32_t maxN, uint32_t &nOut) {
+    const uint8_t *p = code.p; uint32_t i = 0; nOut = 0;
+    while (i < code.n) {
+      if (nOut >= maxN) return false;
+      Ins &s = out[nOut]; s.at = i; s.a = s.a2 = 0; s.cls = CL_PLAIN; s.pops = 0; s.pushes = 0;
+      uint8_t op = p[i++]; s.op = op;
+      switch (op) {
+        case NOP: break;
+        case UNREACHABLE: s.cls = CL_TERM; break;
+        case BLOCK: case LOOP: { uint8_t bt = p[i++]; s.cls = CL_BLOCK; s.a = (bt == VOID) ? 0 : 1; break; }
+        case IF: { uint8_t bt = p[i++]; s.cls = CL_IF; s.a = (bt == VOID) ? 0 : 1; s.pops = 1; break; }
+        case ELSE: s.cls = CL_ELSE; break;
+        case END: s.cls = CL_END; break;
+        case BR: s.a = rdU(p, i); s.cls = CL_BR; break;
+        case BR_IF: s.a = rdU(p, i); s.cls = CL_BRIF; s.pops = 1; break;
+        case BR_TABLE: { uint32_t n = rdU(p, i); uint32_t mx = 0; for (uint32_t k = 0; k <= n; k++) { uint32_t t = rdU(p, i); if (t > mx) mx = t; } s.a = mx; s.cls = CL_BRTAB; s.pops = 1; break; }
+        case RETURN: s.cls = CL_TERM; break;
+        case CALL: { uint32_t f = rdU(p, i); if (f >= nimports) return false; const FuncType &t = types[imports[f].typeIdx]; s.pops = t.nparams; s.pushes = t.nresults; break; }
+        case CALL_INDIRECT: { uint32_t ti = rdU(p, i); rdU(p, i); if (ti >= ntypes) return false; const FuncType &t = types[ti]; s.pops = (int16_t)(t.nparams + 1); s.pushes = t.nresults; break; }
+        case RETURN_CALL: { rdU(p, i); s.cls = CL_TERM; break; }
+        case RETURN_CALL_INDIRECT: { rdU(p, i); rdU(p, i); s.cls = CL_TERM; break; }
+        case TRY_TABLE: { i++; uint32_t n = rdU(p, i); for (uint32_t k = 0; k < n; k++) { i++; rdU(p, i); } s.cls = CL_BARRIER; break; }
+        case THROW: { rdU(p, i); s.cls = CL_BARRIER; break; }
+        case RETHROW: { rdU(p, i); s.cls = CL_BARRIER; break; }
+        case THROW_REF: s.cls = CL_BARRIER; break;
+        case DROP: s.pops = 1; break;
+        case SELECT: s.pops = 3; s.pushes = 1; break;
+        case LOCAL_GET: s.a = rdU(p, i); s.cls = CL_GET; s.pushes = 1; break;
+        case LOCAL_SET: s.a = rdU(p, i); s.cls = CL_SET; s.pops = 1; break;
+        case LOCAL_TEE: s.a = rdU(p, i); s.cls = CL_TEE; s.pops = 1; s.pushes = 1; break;
+        case GLOBAL_GET: rdU(p, i); s.pushes = 1; break;
+        case GLOBAL_SET: rdU(p, i); s.pops = 1; break;
+        case I32_CONST: skS(p, i); s.pushes = 1; break;
+        case I64_CONST: skS(p, i); s.pushes = 1; break;
+        case F32_CONST: i += 4; s.pushes = 1; break;
+        case F64_CONST: i += 8; s.pushes = 1; break;
+        case 0xfc: { uint32_t sub = rdU(p, i);
+          if (sub == 0x0a) { i += 2; s.pops = 3; }           // memory.copy
+          else if (sub == 0x0b) { i += 1; s.pops = 3; }      // memory.fill
+          else return false;
+          break; }
+        case 0xfd: { uint32_t sub = rdU(p, i);
+          switch (sub) {
+            case V128_LOAD: case V128_LOAD8_SPLAT: rdU(p, i); rdU(p, i); s.pops = 1; s.pushes = 1; break;
+            case V128_STORE: rdU(p, i); rdU(p, i); s.pops = 2; break;
+            case V128_CONST: i += 16; s.pushes = 1; break;
+            case I8X16_SPLAT: case I16X8_SPLAT: case I32X4_SPLAT: case I64X2_SPLAT:
+            case V128_NOT: case V128_ANY_TRUE: case I8X16_ALL_TRUE: case I8X16_BITMASK: case I16X8_BITMASK:
+              s.pops = 1; s.pushes = 1; break;
+            case I8X16_EXTRACT_LANE_U: case I32X4_EXTRACT_LANE: case I64X2_EXTRACT_LANE: i += 1; s.pops = 1; s.pushes = 1; break;
+            case I64X2_REPLACE_LANE: i += 1; s.pops = 2; s.pushes = 1; break;
+            case I8X16_SWIZZLE: case I8X16_EQ: case I8X16_LT_S: case I16X8_EQ: case I32X4_EQ:
+            case V128_AND: case V128_ANDNOT: case V128_OR: case V128_XOR: case I8X16_SHR_U:
+              s.pops = 2; s.pushes = 1; break;
+            case V128_BITSELECT: s.pops = 3; s.pushes = 1; break;
+            default: return false;
+          }
+          break; }
+        default: {
+          if (op >= I32_LOAD && op <= I64_LOAD32_U) { rdU(p, i); rdU(p, i); s.pops = 1; s.pushes = 1; break; }        // 0x28..0x35
+          if (op >= I32_STORE && op <= I64_STORE32) { rdU(p, i); rdU(p, i); s.pops = 2; break; }                      // 0x36..0x3e
+          if (op == I32_EQZ || op == I64_EQZ || (op >= 0x67 && op <= 0x69) || (op >= 0x79 && op <= 0x7b) ||
+              (op >= 0x8b && op <= 0x91) || (op >= 0x99 && op <= 0x9f) || (op >= 0xa7 && op <= 0xc4)) { s.pops = 1; s.pushes = 1; break; }
+          if ((op >= 0x46 && op <= 0x4f) || (op >= 0x51 && op <= 0x66) || (op >= 0x6a && op <= 0x78) ||
+              (op >= 0x7c && op <= 0x8a) || (op >= 0x92 && op <= 0x98) || (op >= 0xa0 && op <= 0xa6)) { s.pops = 2; s.pushes = 1; break; }
+          return false;
+        }
+      }
+      s.len = i - s.at; nOut++;
+    }
+    return i == code.n;
+  }
+  // Every template is emitted inside its own `block` so it can `br` out of itself; almost none do,
+  // and the wrapper is what stops a value from staying on the operand stack across two guest
+  // instructions. Delete every `block` no branch targets, renumbering the labels that escape it.
+  // (`loop`/`if` frames are real control flow and are left alone.) The decoded stream is compacted
+  // in place so the pairing pass below does not have to decode the body a second time.
+  bool dropDeadBlocks(Ins *ins, uint32_t &n) {
+    static uint8_t drop[STK_MAX_INS];
+    static uint8_t targeted[STK_MAX_INS];
+    static int32_t stk[256];
+    static int32_t surviving[256];
+    for (uint32_t k = 0; k < n; k++) { drop[k] = 0; if (ins[k].cls == CL_BARRIER) return false; }
+    unsigned d = 0, ndel = 0;
+    for (uint32_t k = 0; k < n; k++) {          // pass A: which frames are branch targets
+      const Ins &q = ins[k];
+      if (q.cls == CL_BLOCK || q.cls == CL_IF) { if (d >= 256) return false; targeted[k] = 0; stk[d++] = (int32_t) k; continue; }
+      if (q.cls == CL_END) { if (!d) return false; d--; continue; }
+      if (q.cls == CL_BR || q.cls == CL_BRIF) { if (q.a > 200) return false; if (q.a < d) targeted[stk[d - 1 - q.a]] = 1; continue; }
+      if (q.cls == CL_BRTAB) {
+        if (q.a > 200) return false;
+        uint32_t i = q.at + 1; uint32_t cnt = rdU(code.p, i);
+        for (uint32_t t = 0; t <= cnt; t++) { uint32_t lb = rdU(code.p, i); if (lb < d) targeted[stk[d - 1 - lb]] = 1; }
+        continue;
+      }
+    }
+    if (d != 0) return false;
+    d = 0;
+    for (uint32_t k = 0; k < n; k++) {          // pass B: mark the deletable frames and their `end`
+      const Ins &q = ins[k];
+      if (q.cls == CL_BLOCK || q.cls == CL_IF) {
+        stk[d++] = (int32_t) k;
+        if (q.op == BLOCK && q.a == 0 && !targeted[k]) { drop[k] = 1; ndel++; }
+        continue;
+      }
+      if (q.cls == CL_END) { d--; if (drop[stk[d]]) drop[k] = 1; continue; }
+    }
+    if (!ndel) return true;
+    static Buf out; out.clear();                // pass C: rebuild, renumbering escaping branches
+    d = 0; uint32_t w = 0;
+    for (uint32_t k = 0; k < n; k++) {
+      Ins q = ins[k];
+      if (q.cls == CL_BLOCK || q.cls == CL_IF) {
+        surviving[d] = (d ? surviving[d - 1] : 0) + (drop[k] ? 0 : 1);
+        stk[d++] = (int32_t) k;
+        if (drop[k]) continue;
+      } else if (q.cls == CL_END) {
+        d--;
+        if (drop[k]) continue;
+      } else if (q.cls == CL_BR || q.cls == CL_BRIF || q.cls == CL_BRTAB) {
+        int32_t sv = d ? surviving[d - 1] : 0;
+        uint32_t at = out.n;
+        if (q.cls == CL_BRTAB) {
+          uint32_t i = q.at + 1; uint32_t cnt = rdU(code.p, i);
+          out.b8(q.op); out.uleb(cnt); uint32_t mx = 0;
+          for (uint32_t t = 0; t <= cnt; t++) { uint32_t lb = rdU(code.p, i);
+            uint32_t nb = (uint32_t)(sv - (lb < d ? surviving[d - 1 - lb] : 0)); if (nb > mx) mx = nb; out.uleb(nb); }
+          q.a = mx;
+        } else {
+          uint32_t nb = (uint32_t)(sv - (q.a < d ? surviving[d - 1 - q.a] : 0));
+          out.b8(q.op); out.uleb(nb); q.a = nb;
+        }
+        q.at = at; q.len = out.n - at; ins[w++] = q;
+        continue;
+      }
+      q.at = out.n; out.raw(code.p + ins[k].at, q.len); ins[w++] = q;
+    }
+    code.swap(out);   // O(1): the old body buffer becomes next translation's scratch
+    n = w;
+    return true;
+  }
+  // The pairing pass:  local.set X ; C ; local.get X  ->  local.tee X ; C
+  void pairLocals(Ins *ins, uint32_t n) {
+    enum { MAXLOC = 1024 };
+    static uint32_t nxtUse[STK_MAX_INS], nxtDef[STK_MAX_INS];
+    static uint32_t lastUse[MAXLOC], lastDef[MAXLOC];
+    for (uint32_t x = 0; x < MAXLOC; x++) { lastUse[x] = n; lastDef[x] = n; }
+    for (uint32_t k = n; k-- > 0;) {
+      const Ins &q = ins[k];
+      if (q.cls == CL_GET || q.cls == CL_SET || q.cls == CL_TEE) {
+        if (q.a >= MAXLOC) return;
+        nxtUse[k] = lastUse[q.a]; nxtDef[k] = lastDef[q.a];
+        if (q.cls == CL_GET) lastUse[q.a] = k; else lastDef[q.a] = k;
+      }
+    }
+    uint32_t openEnd[64]; unsigned nopen = 0, nrew = 0;
+    static uint8_t del[STK_MAX_INS];
+    for (uint32_t k = 0; k < n; k++) del[k] = 0;
+    for (uint32_t d = 0; d < n; d++) {
+      while (nopen && openEnd[nopen - 1] < d) nopen--;
+      if (ins[d].cls != CL_SET) continue;
+      const uint32_t X = ins[d].a, g = nxtUse[d];
+      if (g >= n || g > nxtDef[d] || g - d > STK_WINDOW) continue;   // redefined first / too far: nothing to check
+      int depth = 0, net = 0, pendArity = 0; bool ok = false, fail = false;
+      for (uint32_t j = d + 1; j <= g && !fail; j++) {
+        const Ins &q = ins[j];
+        switch (q.cls) {
+          case CL_END:
+            if (depth == 0) { fail = true; break; }
+            depth--; if (depth == 0) net += pendArity;
+            break;
+          case CL_ELSE: if (depth == 0) fail = true; break;
+          case CL_BLOCK: if (depth == 0) pendArity = (int) q.a; depth++; break;
+          case CL_IF:
+            if (depth == 0) { net -= 1; if (net < 0) { fail = true; break; } pendArity = (int) q.a; }
+            depth++; break;
+          case CL_BR: case CL_BRIF: case CL_BRTAB:
+            if ((int) q.a >= depth) { fail = true; break; }
+            if (depth == 0) { net -= q.pops; if (net < 0) fail = true; }
+            break;
+          case CL_TERM: case CL_BARRIER: fail = true; break;
+          case CL_SET: case CL_TEE:
+            if (q.a == X) { fail = true; break; }
+            if (depth == 0) { net += q.pushes - q.pops; if (net < 0) fail = true; }
+            break;
+          case CL_GET:
+            if (q.a == X) { if (depth == 0 && net == 0) ok = true; fail = true; break; }
+            if (depth == 0) net += 1;
+            break;
+          default:
+            if (depth == 0) { net += q.pushes - q.pops; if (net < 0) fail = true; }
+            break;
+        }
+      }
+      if (!ok) continue;
+      if (nopen && g >= openEnd[nopen - 1]) continue;   // would interleave with an open pair
+      if (nopen >= 64) continue;
+      code.p[ins[d].at] = LOCAL_TEE;
+      del[g] = 1; openEnd[nopen++] = g; nrew++;
+    }
+    if (!nrew) return;
+    uint32_t w = 0;
+    for (uint32_t k = 0; k < n; k++) {
+      if (del[k]) continue;
+      if (w != ins[k].at) memmove(code.p + w, code.p + ins[k].at, ins[k].len);
+      w += ins[k].len;
+    }
+    code.n = w;
+  }
+  void stackify() {
+    if (!nanobox_jit_stackify || code.n < 4) return;
+    static Ins ins[STK_MAX_INS];
+    uint32_t n = 0;
+    if (!decodeBody(ins, STK_MAX_INS, n) || n == 0) return;
+    if (!dropDeadBlocks(ins, n)) return;
+    pairLocals(ins, n);
+  }
+  // Serialise the whole module into `out`.
+  void finish(Buf &out) {
+    out.clear();
+    static const uint8_t hdr[8] = { 0, 'a', 's', 'm', 1, 0, 0, 0 };
+    out.raw(hdr, 8);
+    Buf s;
+    // type section
+    s.clear(); s.uleb(ntypes);
+    for (uint32_t i = 0; i < ntypes; i++) {
+      s.b8(0x60); s.uleb(types[i].nparams); for (int k = 0; k < types[i].nparams; k++) s.b8(types[i].params[k]);
+      s.uleb(types[i].nresults); for (int k = 0; k < types[i].nresults; k++) s.b8(types[i].results[k]);
+    }
+    section(out, 1, s);
+    // import section: memory + function table + helpers
+    s.clear(); s.uleb(2 + nimports);
+    s.uleb(1); s.b8('e'); s.uleb(1); s.b8('m'); s.b8(0x02); s.b8(0x00); s.uleb(0); // memory, limits min 0
+    s.uleb(1); s.b8('e'); s.uleb(1); s.b8('t'); s.b8(0x01); s.b8(0x70); s.b8(0x00); s.uleb(0); // table funcref, min 0
+    for (uint32_t i = 0; i < nimports; i++) {
+      char name[12]; int len = 0; uint32_t v = i; char tmp[12]; int tl = 0;
+      do { tmp[tl++] = '0' + (v % 10); v /= 10; } while (v);
+      while (tl) name[len++] = tmp[--tl];
+      s.uleb(1); s.b8('h'); s.uleb(len); s.raw(name, len); s.b8(0x00); s.uleb(imports[i].typeIdx);
+    }
+    section(out, 2, s);
+    // functions: either the sealed ones (batch) or, if none was sealed, the current body as "r"
+    if (nfuncs == 0) {
+      stackify();
+      s.clear(); s.uleb(1); s.uleb(funcTypeIdx); section(out, 3, s);
+      s.clear(); s.uleb(1); s.uleb(1); s.b8('r'); s.b8(0x00); s.uleb(localFuncIndex()); section(out, 7, s);
+      s.clear(); s.uleb(1);
+      Buf body; body.uleb(nlocalDecls); body.raw(locals.p, locals.n); body.raw(code.p, code.n); body.b8(END);
+      s.uleb(body.n); s.raw(body.p, body.n);
+      section(out, 10, s);
+      return;
+    }
+    s.clear(); s.uleb(nfuncs); for (uint32_t i = 0; i < nfuncs; i++) s.uleb(funcTypes[i]); section(out, 3, s);
+    // exports: sealed functions (a batch, even of one) are "f0".."fN-1"; the never-sealed single
+    // body above is "r" (the host's single-install path)
+    s.clear(); s.uleb(nfuncs);
+    for (uint32_t i = 0; i < nfuncs; i++) {
+      char name[12]; int len = 0; uint32_t v = i; char tmp[12]; int tl = 0;
+      do { tmp[tl++] = '0' + (v % 10); v /= 10; } while (v);
+      name[len++] = 'f'; while (tl) name[len++] = tmp[--tl];
+      s.uleb(len); s.raw(name, len);
+      s.b8(0x00); s.uleb(nimports + i);
+    }
+    section(out, 7, s);
+    s.clear(); s.uleb(nfuncs); s.raw(codeSec.p, codeSec.n); section(out, 10, s);
+  }
+private:
+  static void section(Buf &out, uint8_t id, const Buf &content) { out.b8(id); out.uleb(content.n); out.raw(content.p, content.n); }
+};
+
+// -- instruction emitter (writes into Module::code) ------------------------------------------------
+class Emit {
+public:
+  Module &m; Buf &c;
+  uint32_t nlocals; // total locals incl. params
+  Emit(Module &mod) : m(mod), c(mod.code), nlocals(mod.nparams), nest(0), watch(-1), watchHit(false) {}
+
+  // wasm allows (count, type) runs: declaring 54 locals one at a time costs 108 bytes per
+  // function, grouping the consecutive same-type ones costs a handful
+  uint32_t addLocal(ValType t) {
+    if (m.lastRunPos >= 0 && m.lastRunType == (uint8_t) t && m.lastRunCount < 127) {
+      m.locals.p[m.lastRunPos] = (uint8_t) (++m.lastRunCount);
+    } else {
+      m.lastRunPos = (int32_t) m.locals.n; m.locals.uleb(1); m.locals.b8(t);
+      m.lastRunType = (uint8_t) t; m.lastRunCount = 1; m.nlocalDecls++;
+    }
+    return nlocals++;
+  }
+
+  void op(Op o) { c.b8(o); }
+  void i32c(int32_t v) { c.b8(I32_CONST); c.sleb32(v); }
+  void i64c(int64_t v) { c.b8(I64_CONST); c.sleb64(v); }
+  void get(uint32_t l) { c.b8(LOCAL_GET); c.uleb(l); }
+  void set(uint32_t l) { c.b8(LOCAL_SET); c.uleb(l); }
+  void tee(uint32_t l) { c.b8(LOCAL_TEE); c.uleb(l); }
+  void mem(Op o, uint32_t offset, uint32_t align) { c.b8(o); c.uleb(align); c.uleb(offset); }
+  // SIMD: 0xfd prefix + LEB sub-opcode (+ memarg / lane index / 16 immediate bytes)
+  void simd(SimdOp o) { c.b8(0xfd); c.uleb((uint32_t) o); }
+  void v128_load(uint32_t offset, uint32_t align) { simd(V128_LOAD); c.uleb(align); c.uleb(offset); }
+  void v128_store(uint32_t offset, uint32_t align) { simd(V128_STORE); c.uleb(align); c.uleb(offset); }
+  void v128_load8_splat(uint32_t offset) { simd(V128_LOAD8_SPLAT); c.uleb(0); c.uleb(offset); }
+  void v128_const(const uint8_t *bytes16) { simd(V128_CONST); c.raw(bytes16, 16); }
+  void v128_zero() { static const uint8_t z[16] = { 0 }; v128_const(z); }
+  void lane(SimdOp o, uint32_t l) { simd(o); c.b8((uint8_t) l); }
+  // bulk memory: memory.fill (dst, val, len) / memory.copy (dst, src, len), memory 0
+  void memory_fill() { c.b8(0xfc); c.uleb(0x0b); c.b8(0x00); }
+  void memory_copy() { c.b8(0xfc); c.uleb(0x0a); c.b8(0x00); c.b8(0x00); }
+  // absolute-address load/store helpers: push i32.const 0 as base, offset = address
+  void ldabs(Op o, uint32_t addr, uint32_t align) { i32c(0); mem(o, addr, align); }
+  void stabs_begin() { i32c(0); }                    // then push value, then stabs_end
+  void stabs_end(Op o, uint32_t addr, uint32_t align) { mem(o, addr, align); }
+  void call(uint32_t f) { c.b8(CALL); c.uleb(f); }
+  void return_call(uint32_t f) { c.b8(RETURN_CALL); c.uleb(f); }
+  void call_indirect(uint32_t typeIdx) { c.b8(CALL_INDIRECT); c.uleb(typeIdx); c.uleb(0); }
+  void return_call_indirect(uint32_t typeIdx) { c.b8(RETURN_CALL_INDIRECT); c.uleb(typeIdx); c.uleb(0); }
+  // label-depth bookkeeping so a caller can ask "did anything branch OUT of the label I opened
+  // here?" (the per-instruction template wrapper is only needed when something does)
+  int nest;                 // labels open at this point
+  int watch;               // -1 = off, else the nest level of the watched label
+  bool watchHit;
+  void watchOpen() { watch = nest; watchHit = false; }
+  bool watchClose() { bool h = watchHit; watch = -1; return h; }
+  // conservative: a branch to the watched label OR to anything enclosing it keeps the label
+  void noteBr(uint32_t d) { if (watch >= 0 && nest - (int) d <= watch) watchHit = true; }
+  void block(ValType t = VOID) { c.b8(BLOCK); c.b8(t); nest++; }
+  void loop(ValType t = VOID) { c.b8(LOOP); c.b8(t); nest++; }
+  void if_(ValType t = VOID) { c.b8(IF); c.b8(t); nest++; }
+  void else_() { c.b8(ELSE); }
+  void end() { c.b8(END); nest--; }
+  void br(uint32_t d) { noteBr(d); c.b8(BR); c.uleb(d); }
+  void br_if(uint32_t d) { noteBr(d); c.b8(BR_IF); c.uleb(d); }
+  void ret() { c.b8(RETURN); }
+  void unreachable() { c.b8(UNREACHABLE); }
+  void drop() { c.b8(DROP); }
+  void select() { c.b8(SELECT); }
+  // try_table (result void) with a single catch_all_ref -> label `depth`
+  void try_table_catch_all_ref(uint32_t labelDepth) { c.b8(TRY_TABLE); c.b8(VOID); c.uleb(1); c.b8(0x03); c.uleb(labelDepth); }
+  void throw_ref() { c.b8(THROW_REF); }
+  // br_table: n targets + default
+  void br_table(const uint32_t *targets, uint32_t n, uint32_t def) { for (uint32_t i = 0; i < n; i++) noteBr(targets[i]); noteBr(def); c.b8(BR_TABLE); c.uleb(n); for (uint32_t i = 0; i < n; i++) c.uleb(targets[i]); c.uleb(def); }
+};
+
+} // namespace nbw
