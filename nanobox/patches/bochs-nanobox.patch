+    }
+    case BX_IA_MOVUPS_WpsVps: case BX_IA_MOVUPD_WpdVpd: case BX_IA_MOVDQU_WdqVdq: case BX_IA_MOVAPS_WpsVps: case BX_IA_MOVAPD_WpdVpd: case BX_IA_MOVDQA_WdqVdq: {
