+  Bit64u h = 0xcbf29ce484222325ull ^ (nanobox_jit_level * 0x9E3779B97F4A7C15ull) ^ 0x5245474e00000000ull ^ (Bit64u)(kernel ? 0x4b : 0x55); // 'REGN'
+  // AOT mode: the key is CONTENT ONLY. The site (entry pAddr) is what a precompiled artifact cannot
+  // know for user code -- a PIE lands on different physical pages in every boot -- so keying by it
+  // means the offline translation of codex/agy is never found again (measured: the deduped kernel
+  // bundle hit, the user code missed and 326 MB was recompiled at runtime, TASKS.md R.2). The code
+  // is position independent (page deltas, no absolute frames) and the per-site state lives in the
+  // EntryDesc built at the attach, not in the module, so two sites that decoded the same bytes may
+  // share one translation. The default engine keeps the site in the key (identity-preserving path).
+  if (!nanobox_jit_aot) { h ^= (Bit64u) e->pAddr * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29; }
+  for (unsigned p = 0; p < r->npages; p++) { h ^= (Bit64u)(Bit64s) r->pdelta[p] * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29; }
+  for (unsigned j = 0; j < nb; j++) {
+    h ^= (Bit64u)(Bit64s) r->b[j].boff * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29;
+    h ^= (Bit64u) r->b[j].page * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29;
+    for (unsigned k = 0; k < r->b[j].n; k++) {
+      const Bit64u *p = (const Bit64u *) &r->b[j].ins[k];
+      for (unsigned w = 0; w < sizeof(bxInstruction_c) / 8; w++) { h ^= p[w]; h *= 0x100000001b3ull; h ^= h >> 29; }
+    }
+  }
+  r->key = h ? h : 1;
+  if (nanobox_jit_aot_detform & 32)
+    for (unsigned j = 0; j < nb; j++) nb_claim_mark(entryLin + (bx_address)(Bit64s) r->b[j].boff);
+  // key log (TASKS.md S.3): (entry address, content key, blocks) for the last NB_KEYLOG regions, so a
+  // run's keys can be diffed against the ones the offline translator produced for the same addresses
+  if (nb_keylog_on && nb_keylog_n < NB_KEYLOG) { nb_keylog[nb_keylog_n][0] = (Bit64u) entryLin; nb_keylog[nb_keylog_n][1] = r->key; nb_keylog[nb_keylog_n][2] = nb; nb_keylog_n++; }
+  nanobox_region_stats[0]++; nanobox_region_stats[1] += nb;
+  return r;
+}
+// Attach registry: (physical page -> region) records so that a write into ANY page of a region drops
+// the region (all member entries lose the translation; a running region leaves at its next transition
+// into a not-yet-executed block, see nanobox_region_first). Bochs' own flushSMC only reaches entries
+// hashed in the written page and only through their own (natural) traceMask -- member masks are NOT
+// widened any more, so the fine granularity mapping stays a superset of the reference mapping only by
+// the ahead-decoded chunks. Records are removed when the region is dropped; the pool is swept when
+// full, and if still full the JIT cache is cleared (which resets the registry).
+// Functions already swept: the first touch of a guest function builds the WHOLE function the way the
+// offline translator did, once. Reset with the attach registry (i.e. whenever the JIT cache is cleared
+// and every translation is gone).
+enum { NB_FNSWEPT = 1 << 16 };
+static Bit64u *nb_fnswept = NULL;
+static void nb_fnswept_reset(void) { if (nb_fnswept) memset(nb_fnswept, 0, NB_FNSWEPT * sizeof(Bit64u)); }
+static bool nb_fnswept_mark(Bit64u a)          // true = not seen before (and now recorded)
+{
+  if (!a) return false;
+  if (!nb_fnswept) { nb_fnswept = (Bit64u *) calloc(NB_FNSWEPT, sizeof(Bit64u)); if (!nb_fnswept) return false; }
+  unsigned i = (unsigned)((a * 0x9E3779B97F4A7C15ull) >> 40) & (NB_FNSWEPT - 1);
+  for (unsigned p = 0; p < 128; p++) {
+    Bit64u *slot = &nb_fnswept[(i + p) & (NB_FNSWEPT - 1)];
+    if (*slot == a) return false;
+    if (*slot == 0) { *slot = a; return true; }
+  }
+  return false;                                 // table crowded: never sweep this one again
+}
+struct AttachRec { Bit64u ppage; Region *r; Bit32u mask; int next; };
+enum { NB_ATTACH_POOL = 131072, NB_ATTACH_BUCKETS = 8192 };
+static AttachRec *nb_attach = NULL; static int nb_attach_head[NB_ATTACH_BUCKETS]; static int nb_attach_free = -1; static bool nb_attach_init = false; static unsigned nb_attach_used = 0;
+static Bit32u nb_attach_epoch = 1;   // bumped on every reset: a region's records exist iff r->regEpoch == nb_attach_epoch (0 = never registered)
+static void nanobox_attach_pool_reset(void)
+{
+  if (!nb_attach) nb_attach = (AttachRec *) calloc(NB_ATTACH_POOL, sizeof(AttachRec));
+  for (int i = 0; i < NB_ATTACH_POOL; i++) nb_attach[i].next = (i + 1 < NB_ATTACH_POOL) ? i + 1 : -1;
+  nb_attach_free = 0; nb_attach_used = 0;
+  for (int b = 0; b < NB_ATTACH_BUCKETS; b++) nb_attach_head[b] = -1;
+  nb_attach_init = true;
+  nb_fnswept_reset();
+  if (++nb_attach_epoch == 0) nb_attach_epoch = 1;
+}
+static bool nanobox_attach_registered(const Region *r) { return nb_attach_init && r->regEpoch != 0 && r->regEpoch == nb_attach_epoch; }
+static unsigned nanobox_attach_bucket(Bit64u ppage) { return (unsigned)(ppage * 0x9E3779B97F4A7C15ull >> 51) & (NB_ATTACH_BUCKETS - 1); }
+static void nanobox_attach_unlink_region(Region *r)
+{
+  for (unsigned p = 0; p < r->npages; p++) {
+    int *pp = &nb_attach_head[nanobox_attach_bucket(r->ppf[p])];
+    while (*pp >= 0) {
+      AttachRec &a = nb_attach[*pp];
+      if (a.r == r) { int idx = *pp; *pp = a.next; a.next = nb_attach_free; nb_attach_free = idx; nb_attach_used--; }
+      else pp = &a.next;
+    }
+  }
+  r->regEpoch = 0;
+}
+static void nanobox_attach_sweep(void)
+{
+  for (int b = 0; b < NB_ATTACH_BUCKETS; b++) {
+    int *pp = &nb_attach_head[b];
+    while (*pp >= 0) {
+      AttachRec &a = nb_attach[*pp];
+      if (!nanobox_attach_registered(a.r)) { int idx = *pp; *pp = a.next; a.next = nb_attach_free; nb_attach_free = idx; nb_attach_used--; }
+      else pp = &a.next;
+    }
+  }
+}
+// members lose the translation; a running region notices at its next first-execution check
+static void nanobox_region_drop(Region *r)
+{
+  for (unsigned j = 0; j < r->nblocks; j++) {
+    bxICacheEntry_c *se = r->srcEntry[j];
+    if (se && se->pAddr == r->b[j].ent.pAddr && se->jitfn == r->fn && r->fn) { se->jitfn = 0; *BX_CPU_THIS_PTR iCache.hotOf(se) = 0; }
+  }
+  r->dead = 1;
+  if (nanobox_attach_registered(r)) nanobox_attach_unlink_region(r);
+}
+static bool nanobox_attach_register(Region *r)
+{
+  if (!nb_attach_init) nanobox_attach_pool_reset();
+  if (nanobox_attach_registered(r)) return true;
+  if (nb_attach_used + r->npages > NB_ATTACH_POOL) nanobox_attach_sweep();
+  if (nb_attach_used + r->npages > NB_ATTACH_POOL) return false;
+  for (unsigned p = 0; p < r->npages; p++) {
+    int idx = nb_attach_free; nb_attach_free = nb_attach[idx].next; nb_attach_used++;
+    AttachRec &a = nb_attach[idx];
+    a.ppage = r->ppf[p]; a.r = r; a.mask = r->pmask[p];
+    unsigned b = nanobox_attach_bucket(r->ppf[p]);
+    a.next = nb_attach_head[b]; nb_attach_head[b] = idx;
+    // the chunks are marked already (their decode did it); re-marking is private (never a reference mark)
+    nanobox_marks_private = true; pageWriteStampTable.markICacheMask((bx_phy_address) r->ppf[p] << 12, r->pmask[p]); nanobox_marks_private = false;
+  }
+  r->regEpoch = nb_attach_epoch;
+  return true;
+}
+// called from handleSMC() for every write into a page that carries code marks
+void nanobox_jit_page_written(bx_phy_address pAddr, Bit32u mask)
+{
+  if (!nb_attach_init || nb_attach_used == 0) return;
+  Bit64u pp = pAddr >> 12;
+  int *ptr = &nb_attach_head[nanobox_attach_bucket(pp)];
+  while (*ptr >= 0) {
+    AttachRec &a = nb_attach[*ptr];
+    if (a.ppage == pp && (a.mask & mask)) {
+      Region *r = a.r;
+      nanobox_region_stats[21]++;
+      nanobox_region_drop(r);   // unlinks all of r's records, possibly including *ptr: restart this bucket
+      ptr = &nb_attach_head[nanobox_attach_bucket(pp)];
+      continue;
+    }
+    ptr = &a.next;
+  }
+}
+// interpreter path: an entry decoded ahead executes for the first time -> the reference would decode it now
+void nanobox_jit_ahead_first(bxICacheEntry_c *e)
+{
+  e->nbahead = 0;
+  pageWriteStampTable.nanobox_ref_mark(e->pAddr, e->traceMask);
+  nanobox_region_stats[23]++;
+}
+// attach the region to entry e (block 0: regions are formed from e) and to every other member block
+// whose iCache entry still holds the same trace (validated by pAddr + content: the region may come
+// from the cache and the entries may have been re-decoded since)
+static void nanobox_region_attach(bxICacheEntry_c *e, unsigned fn, Bit32u mask, Region *r)
+{
+  (void) mask;
+  if (nanobox_attach_registered(r) && r->fn != fn) nanobox_attach_unlink_region(r);
+  r->fn = fn; r->dead = 0;
+  memset(r->dcall, 0, sizeof(r->dcall));   // a re-attached region may sit at another linear base
+  for (unsigned j = 0; j < NB_REGION_MAX_BLOCKS; j++) r->dcall[j].miss = nanobox_dcall_warmup;
+  if (!nanobox_attach_register(r)) { nb_clear_why = 1; nanobox_jit_cache_clear(); return; }   // (clears everything incl. e->jitfn)
+  for (unsigned j = 0; j < r->nblocks; j++) {
+    bx_phy_address pa = r->b[j].ent.pAddr;
+    bxICacheEntry_c *se = (r->srcEntry[j] == e || (j == 0 && e->pAddr == pa)) ? e : BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+    r->srcEntry[j] = se; r->pending[j] = 1;
+    if (se->pAddr != pa || se->tlen != r->b[j].ent.tlen) continue;
+    // REAL instructions only: serveICacheMiss appends the end-of-trace marker with
+    // genDummyICacheEntry(), which writes three fields and leaves the rest of that pool slot holding
+    // whatever an earlier decode left there. A full-length compare therefore rejects blocks that are
+    // in fact identical -- 88,945 such refusals in one boot, against 18 once this was fixed.
+    if (se != e && memcmp(se->i, r->b[j].ins, (size_t) nanobox_real_len(se) * sizeof(bxInstruction_c)) != 0) continue;
+    if (se->jitfn && se != e) continue; // already has its own translation
+    se->jitfn = fn; se->jitarg = (Bit32u)(uintptr_t) &r->entry[j];
+  }
+}
+
+// Is `e` already a MEMBER block of a live, attached region? A region wires every member block's iCache
+// entry at attach time, but only the entries that exist then, and an entry loses its wiring whenever
+// its slot is reused. When the guest later reaches such a block, maybe_compile used to root a SECOND
+// region there -- one the offline translator never built, so its key is absent from the artifact.
+// Every block is an entry point (entry[j] carries its own delta), so the answer is to attach to the
+// region that already covers this address.
+static Region *nanobox_region_find_member(bxICacheEntry_c *e, bx_address eLin, unsigned *blockOut, bool kern)
+{
+  if (!nb_attach_init || nb_attach_used == 0) return NULL;
+  Bit64u pp = (Bit64u) e->pAddr >> 12;
+  unsigned onPage = 0, sameAddr = 0;
+  for (int idx = nb_attach_head[nanobox_attach_bucket(pp)]; idx >= 0; idx = nb_attach[idx].next) {
+    AttachRec &a = nb_attach[idx];
+    if (a.ppage != pp) continue;
+    Region *r = a.r;
+    if (!r || r->dead || !r->fn || !nanobox_attach_registered(r)) continue;
+    onPage++;
+    for (unsigned j = 0; j < r->nblocks; j++) {
+      if (r->b[j].ent.pAddr != e->pAddr) continue;
+      if ((Bit64u)(r->lin0 + (Bit64u)(Bit64s) r->b[j].boff) != (Bit64u) eLin) continue;   // same bytes, other linear placement
+      sameAddr++;
+      if (r->b[j].ent.tlen != e->tlen) { nanobox_region_stats[47]++; continue; }
+      if (memcmp(e->i, r->b[j].ins, (size_t) nanobox_real_len(e) * sizeof(bxInstruction_c)) != 0) continue;
+      *blockOut = j;
+      return r;
+    }
+  }
+  { unsigned base = kern ? 39 : 42;
+    if (!onPage) nanobox_region_stats[base]++; else if (!sameAddr) nanobox_region_stats[base + 1]++; else nanobox_region_stats[base + 2]++; }
+  return NULL;
+}
+// Attach e as a member of r. This goes through the ordinary attach rather than hand-wiring the one
+// entry, and that is not cosmetic: nanobox_region_attach re-REGISTERS the region, which re-marks the
+// write stamps for every page it covers, so a later write to the code still reaches handleSMC and
+// drops the region. Hand-wiring skipped that; the region then survived writes to its own bytes and was
+// called forever through the direct-call inline caches, which the guest showed as an endless spin in
+// delay_tsc. (Bisected with the NANOBOX_AOT_DETFORM bitmask: masks 1 and 3 boot, mask 7 did not.)
+static void nanobox_region_attach_member(bxICacheEntry_c *e, Region *r, unsigned j)
+{
+  (void) j;
+  nanobox_region_attach(e, r->fn, r->mask, r);
+}
+
+// Which tier should this entry be compiled at? Tier 0 is a plain-trace form only: it forms no
+// region, resolves no direct call and does not link, which is also what makes cpu_loop see every
+// one of its executions and so able to promote it.
+static bool nb_tier0_pick(bxICacheEntry_c *e)
+{
+  if (!(nanobox_jit_tier & 1) || nanobox_jit_aot) return false;
+  if (!(nanobox_jit_tier & 2)) return true;                       // single-tier: everything compact
+  return *BX_CPU_THIS_PTR iCache.hotOf(e) < nanobox_jit_tier1_thr;
+}
+// the entry cpu_loop must recompile at tier 1 the next time it dispatches it
+bxICacheEntry_c *nanobox_t0_running = NULL;
+bxICacheEntry_c *nanobox_t0_promote = NULL;
+// Recompile e at tier 1. Called from cpu_loop at exactly the point the ordinary compile happens
+// (RIP already past the first instruction), because the tier-1 path derives the region entry from
+// RIP and decodes ahead.
+void nanobox_jit_promote(bxICacheEntry_c *e)
+{
+  Bit32u oldfn = e->jitfn, oldarg = e->jitarg;
+  const Bit64u gen = jitcache_clears;
+  e->jitfn = 0;
+  nanobox_jit_maybe_compile(e);
+  // ... unless the compile cleared the cache under us: hook_release_all() released oldfn too, and
+  // putting it back would leave the entry pointing at a dead (or recycled) table slot.
+  if (nanobox_jit_clearfix && jitcache_clears != gen) return;
+  if (!e->jitfn) { e->jitfn = oldfn; e->jitarg = oldarg; }   // queued in a batch, or declined: stay at tier 0
+  else nanobox_tier_stats[1]++;
+}
+// called by serveICacheMiss() once a trace has been decoded into `e`
+void nanobox_jit_after_decode(bxICacheEntry_c *e)
+{
+  nb_tier0_now = nb_tier0_pick(e);
+  // (the slot's hotness counter is deliberately kept: a re-decoded trace inherits it)
+  if (!nanobox_jit_level || nanobox_dbg_mode) return;
+  if (nanobox_marks_private) return;   // decoded ahead: no translation before its first execution has been seen (reference marks)
+  // Deterministic formation: this hands a freshly decoded entry a translation compiled for a DIFFERENT
+  // address that happened to decode to the same bytes (the plain-trace key is content only). Whether
+  // it lands depends on what the cache holds, and it then keeps the entry out of maybe_compile
+  // entirely -- so the site never joins the region its function was translated as, and the two sides
+  // disagree about which addresses carry a region at all.
+  if (nanobox_jit_aot && (nanobox_jit_aot_detform & 1)) return;
+  unsigned nreal;
+  Bit64u key = nanobox_jit_hash(e, nreal);
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  if (c && c->key == key && !c->region) { e->jitfn = c->fn; e->jitarg = (Bit32u)(uintptr_t)((key & 1) ? (void *) e : (void *) e->i); jitcache_hits++; }
+}
+
+
+/////////////////////////////////////////////////////////////////////////
+// Compile driver with batching. Hot traces are compiled into a shared module as they show up and
+// the module is handed to the host once it holds NB_BATCH functions (or has waited long enough):
+// V8's per-module cost (~60-100 us) then amortises over the batch, and the shared link function
+// keeps every function small.
+/////////////////////////////////////////////////////////////////////////
+enum { NB_BATCH = 32, NB_BATCH_MAX_TRACES_WAIT = 20000 };
+struct Pending { bxICacheEntry_c *e; bx_phy_address pAddr; bxInstruction_c *i; Region *reg; Bit64u key; unsigned local; };
+static Module *nb_batch = NULL;
+static Pending nb_pending[NB_BATCH];
+static unsigned nb_npending = 0;
+static Bit64u nb_batch_since = 0;
+static Bit64u nb_batch_since_interp = 0;   // AOT mode: interpreted cpu_loop traces when the batch was opened (bounded wait, see maybe_compile)
+Bit64u nanobox_aot_stats[16];   // 0 functions (precompile API), 1 regions/traces compiled, 2 starts, 3 not mapped, 4 gap starts, 5 already compiled, 6 maybe_compile: still pending in the batch, 7 maybe_compile: compile failed, 8 region cache/bundle hit, 9 region compiled (queued), 10 plain trace path, 11 cpu_loop: interpreted with hot < threshold, 12 cpu_loop: interpreted right after maybe_compile, 13 region compile_one false, 14 plain compile_one true, 15 direct-call site resolutions
+static Bit64u nanobox_batch_stats[3]; // batches flushed, functions, stale entries at flush
+
+// does the host implement install_batch? (probe once: len 0 / nfuncs 0 -> a host answers 1, the placeholder 0)
+static int nb_batch_cap = -1;
+static bool nanobox_batching(void)
+{
+  if (nanobox_dbg_mode) return false;
+  if (nb_batch_cap < 0) nb_batch_cap = hook_install_batch(NULL, 0, NULL, 0, 0, NULL) ? 1 : 0;
+  return nb_batch_cap == 1;
+}
+
+// The link function's table index is baked into every trace module, so a pre-computed bundle is
+// only valid together with the link function it was recorded with: the host pins it under the
+// reserved content key LINK_KEY (ffffffff:ffffffff) — ask before installing, tell after.
+static bool nanobox_ensure_link_fn(void)
+{
+  if (nanobox_link_fn || nanobox_dbg_mode) return true;
+  if (nb_link_fresh) nb_link_fresh = 0;   // after a mode change: never adopt the previous mode's link function
+  else { unsigned pre = hook_lookup(0xffffffffu, 0xffffffffu); if (pre) { nanobox_link_fn = pre; return true; } }
+  Module lm;
+  static bxICacheEntry_c dummy;
+  TraceCompiler tc(&dummy, lm);
+  tc.emitLinkFn();
+  Buf bytes; lm.finish(bytes);
+  nanobox_link_fn = hook_install(bytes.p, bytes.n, lm.importKeys, lm.nimports);
+  if (nanobox_link_fn) hook_note(nanobox_link_fn, 0xffffffffu, 0xffffffffu);
+  return nanobox_link_fn != 0;
+}
+
+// give (or cache) a translation to entry e
+static void nanobox_jit_attach(bxICacheEntry_c *e, unsigned fn, Region *reg, Bit64u key)
+{
+  if (reg) nanobox_region_attach(e, fn, reg->mask, reg);
+  else { e->jitfn = fn; e->jitarg = (Bit32u)(uintptr_t)((key & 1) ? (void *) e : (void *) e->i); }
+}
+static void nanobox_jit_cache_put(Bit64u key, unsigned fn, unsigned len, Region *reg)
+{
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  nb_put_stored = false;
+  if (jitcache_count >= nanobox_jit_cache_lim || c == NULL) { nb_clear_why = 0; nanobox_jit_cache_clear(); return; }  // (the fn was released with everything else)
+  if (c->key == key) return;
+  c->key = key; c->fn = fn; c->len = len; c->mask = reg ? reg->mask : 0; c->region = reg; jitcache_count++;
+  nb_put_stored = true;
+}
+static void nanobox_jit_batch_drop(void)
+{
+  // Diagnostic (runs only here, i.e. only on a cache clear / mode switch): a queued region that the
+  // in-progress nanobox_jit_batch_flush has ALREADY handed to the content cache is owned twice --
+  // this delete is its first free and the clear's own jitcache sweep is its second. Counting it here
+  // is the direct measurement of fault 1; with nanobox_jit_clearfix on it can never fire, because the
+  // flush empties nb_pending before it publishes anything.
+  for (unsigned i = 0; i < nb_npending; i++) {
+    if (!nb_pending[i].reg) continue;
+    JitCacheEntry *c = nanobox_jit_cache_slot(nb_pending[i].key);
+    if (c && c->key == nb_pending[i].key && c->region == nb_pending[i].reg) nb_clear_diag[7]++;
+  }
+  for (unsigned i = 0; i < nb_npending; i++) if (nb_pending[i].reg) delete nb_pending[i].reg;
+  nb_npending = 0;
+  if (nb_batch) { delete nb_batch; nb_batch = NULL; }
+}
+static void nanobox_jit_batch_flush(void)
+{
+  if (!nb_batch || nb_npending == 0) return;
+  Buf bytes; nb_batch->finish(bytes);
+  unsigned out[NB_BATCH];
+  const unsigned n = nb_npending;
+  Module *mod = nb_batch;
+  // Take the batch OUT of the globals before anything below can re-enter nanobox_jit_cache_clear():
+  // its nanobox_jit_batch_drop() would free exactly the regions this loop is handing to the jitcache
+  // (which then frees them a second time). With the batch detached, the regions below are owned by
+  // this frame alone and every exit path disposes of them once.
+  if (nanobox_jit_clearfix) { nb_npending = 0; nb_batch = NULL; }
+  unsigned ok = hook_install_batch(bytes.p, bytes.n, mod->importKeys, mod->nimports, n, out);
+  nanobox_batch_stats[0]++;
+  const Bit64u gen = jitcache_clears;
+  nb_in_flush++; nb_flush_published = 0;
+  for (unsigned i = 0; i < (nanobox_jit_clearfix ? n : nb_npending); i++) {
+    Pending &pd = nb_pending[i];
+    if (!ok || out[i] == 0) { if (pd.reg) delete pd.reg; if (pd.e->pAddr == pd.pAddr) *BX_CPU_THIS_PTR iCache.hotOf(pd.e) = 0; continue; }
+    unsigned fn = out[i];
+    hook_note(fn, (unsigned)(pd.key & 0xffffffffu), (unsigned)(pd.key >> 32));
+    nanobox_stats.jit_compiled++; nanobox_batch_stats[1]++;
+    if (pd.reg) nanobox_region_stats[2]++;
+    // the entry may have been evicted/re-decoded/flushed while the batch was open
+    if (pd.e->pAddr == pd.pAddr && pd.e->i == pd.i && pd.e->jitfn == 0) nanobox_jit_attach(pd.e, fn, pd.reg, pd.key);
+    else nanobox_batch_stats[2]++;
+    if (nanobox_jit_clearfix && jitcache_clears != gen) {
+      // the ATTACH cleared (attach-registry pool full). hook_release_all() took `fn` -- and every
+      // other out[] of this batch -- with it, so nothing here may be published; the entry's jitfn
+      // was zeroed by the clear too. pd.reg is still ours (the batch is detached).
+      nb_clear_diag[4]++; nb_clear_diag[5]++;
+      if (pd.reg) delete pd.reg;
+      for (unsigned j = i + 1; j < n; j++) if (nb_pending[j].reg) delete nb_pending[j].reg;
+      nb_in_flush--; delete mod; return;
+    }
+    nanobox_jit_cache_put(pd.key, fn, 0, pd.reg);
+    if (nanobox_jit_clearfix) {
+      if (jitcache_clears != gen) {   // the PUT cleared: it stored nothing, so pd.reg is orphaned
+        nb_clear_diag[5]++;
+        if (pd.reg) delete pd.reg;
+        for (unsigned j = i + 1; j < n; j++) if (nb_pending[j].reg) delete nb_pending[j].reg;
+        nb_in_flush--; delete mod; return;
+      }
+      if (pd.reg && nb_put_stored) nb_flush_published++;
+      continue;
+    }
+    if (pd.reg && nb_put_stored) nb_flush_published++;
+    if (jitcache_count == 0) { for (unsigned j = i + 1; j < nb_npending; j++) if (nb_pending[j].reg) delete nb_pending[j].reg; break; }
+  }
+  nb_in_flush--;
+  if (nanobox_jit_clearfix) { delete mod; return; }
+  nb_npending = 0;
+  delete nb_batch; nb_batch = NULL;
+}
+NB_EXPORT(nanobox_jit_batch_stat) double nanobox_jit_batch_stat(unsigned i) { return i < 3 ? (double) nanobox_batch_stats[i] : 0; }
+NB_EXPORT(nanobox_jit_flush_batch) void nanobox_jit_flush_batch(void) { nanobox_jit_batch_flush(); }
+
+// try to give e a translation for (reg, key) without compiling: in-process cache or host bundle
+static bool nanobox_jit_try_cached(bxICacheEntry_c *e, Region *reg, Bit64u key)
+{
+  if (nanobox_dbg_mode) return false;
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  if (c && c->key == key) {
+    if (c->region && reg && (c->region->npages != reg->npages || memcmp(c->region->ppf, reg->ppf, sizeof(reg->ppf)) != 0)) return false; // same code, other page frames: needs its own descriptor -> compile
+    if (c->region) nanobox_region_attach(e, c->fn, c->mask, c->region); else { e->jitfn = c->fn; e->jitarg = (Bit32u)(uintptr_t)((key & 1) ? (void *) e : (void *) e->i); }
+    jitcache_hits++; if (reg) { nanobox_region_stats[3]++; delete reg; }
+    return true;
+  }
+  // pre-computed translation (bundle)? modules are position independent (the region descriptor
+  // travels in the call argument), so a bundle hit is attached exactly like a fresh compile
+  unsigned pre = hook_lookup((unsigned)(key & 0xffffffffu), (unsigned)(key >> 32));
+  // split the answer by address space: a precompiled artifact holds every function of the KERNEL, so
+  // a kernel miss means the keys do not line up, while a user miss just means the artifact does not
+  // cover that program (TASKS.md S.3). 28/29 = kernel hit/miss, 30/31 = user hit/miss.
+  { bool kern = (Bit64u) nb_lookup_lin >= 0xffff800000000000ull;
+    nanobox_region_stats[(pre ? 28 : 29) + (kern ? 0 : 2)]++; }
+  if (pre) {
+    nanobox_jit_attach(e, pre, reg, key);
+    nanobox_jit_cache_put(key, pre, 0, reg);
+    if (jitcache_count == 0) { e->jitfn = 0; hook_release(pre); if (reg) delete reg; return true; }
+    if (reg) nanobox_region_stats[3]++;
+    return true;
+  }
+  return false;
+}
+
+// already queued in the open batch?
+static bool nanobox_jit_pending(bxICacheEntry_c *e)
+{
+  for (unsigned i = 0; i < nb_npending; i++) {
+    if (nb_pending[i].e == e && nb_pending[i].pAddr == e->pAddr) return true;
+    // AOT mode (threshold 1): a MEMBER block of a queued region reached before the batch is flushed
+    // would otherwise start an overlapping region of its own
+    if (nanobox_jit_aot && nb_pending[i].reg) {
+      Region *r = nb_pending[i].reg;
+      for (unsigned j = 1; j < r->nblocks; j++) if (r->b[j].ent.pAddr == e->pAddr) return true;
+    }
+  }
+  return false;
+}
+
+static bool nanobox_jit_compile_one(bxICacheEntry_c *e, Region *reg, Bit64u key)
+{
+  if (nanobox_jit_try_cached(e, reg, key)) return true;
+  if (!nanobox_ensure_link_fn()) { if (reg) delete reg; return false; }
+  if (!nanobox_batching()) {
+    Module sm;
+    TraceCompiler tc(e, sm);
+    tc.reg = reg;
+    if (!tc.compile()) { if (reg) delete reg; return false; }
+    Buf bytes; sm.finish(bytes);
+    unsigned fn = hook_install(bytes.p, bytes.n, sm.importKeys, sm.nimports);
+    if (fn == 0) { if (reg) delete reg; return false; }
+    hook_note(fn, (unsigned)(key & 0xffffffffu), (unsigned)(key >> 32));
+    nanobox_stats.jit_compiled++;
+    if (reg) nanobox_region_stats[2]++;
+    const Bit64u gen = jitcache_clears;
+    nanobox_jit_attach(e, fn, reg, key);
+    if (nanobox_dbg_mode) { nanobox_dbg_compiled(e, fn, bytes.n); return true; }  // dbg mode: no cache (region objects are leaked on purpose)
+    if (nanobox_jit_clearfix && jitcache_clears != gen) {
+      // the attach cleared: `fn` was released with everything else, so it must NOT be published
+      nb_clear_diag[4]++; e->jitfn = 0; if (reg) delete reg; return true;
+    }
+    nanobox_jit_cache_put(key, fn, bytes.n, reg);
+    if (jitcache_count == 0) { e->jitfn = 0; if (nanobox_jit_clearfix && reg) delete reg; }
+    return true;
+  }
+  // batched: compile into the open module, attach at flush time
+  if (!nb_batch) { nb_batch = new Module(); nb_batch_since = nanobox_stats.traces; nb_batch_since_interp = nanobox_stats.interp_traces; }
+  nb_batch->beginFunc();
+  TraceCompiler tc(e, *nb_batch);
+  tc.reg = reg;
+  if (!tc.compile()) { nb_batch->beginFunc(); if (reg) delete reg; return false; }
+  unsigned local = nb_batch->endFunc(nb_batch->funcTypeIdx);
+  Pending &pd = nb_pending[nb_npending++];
+  pd.e = e; pd.pAddr = e->pAddr; pd.i = e->i; pd.reg = reg; pd.key = key; pd.local = local;
+  if (nb_npending >= NB_BATCH || nb_batch->funcsFull() || nb_batch->importsFull() || nb_batch->codeSec.n > (1u << 18)) nanobox_jit_batch_flush();
+  return true;
+}
+
+// Page-eager mode (bundle recordings): when a trace gets hot, decode and compile every trace that
+// is statically reachable from it inside the same physical page (branch targets, fall-throughs,
+// callees, call continuations), so a bundle recorded from a run covers whole pages, not only the
+// paths taken. Decoding is host-only (iCache entries), so it does not change guest behaviour.
+unsigned nanobox_jit_eager = 0;
+unsigned nanobox_jit_probe2 = 1;   // two-entry probe cache in JIT'd traces (default on; nanobox_set_jit_probe2(0) for A/B)
+NB_EXPORT(nanobox_set_jit_probe2) void nanobox_set_jit_probe2(unsigned on) { nanobox_jit_probe2 = on; }
+unsigned nanobox_jit_merge = 0;    // merge runs of register pushes / pops into one probed span (experiment flag)
+// A/B switch inside one binary: the harness turns this on with NANOBOX_JIT_MERGE=1. In this tree
+// it selects the ORIGINAL TLB fast path (explicit permission / alignment-check / write-stamp
+// tests) instead of the folded-tag one, so both arms can be measured from the same build with the
+// same engine tag (and therefore the same .nbjb bundle keying).
+NB_EXPORT(nanobox_set_jit_merge) void nanobox_set_jit_merge(unsigned on) { nanobox_tlbfold = on ? 0 : 1; }
+NB_EXPORT(nanobox_set_jit_eager) void nanobox_set_jit_eager(unsigned on) { nanobox_jit_eager = on; }
+static Bit64u nb_swept[4096]; static unsigned nb_swept_n = 0; static Bit64u nanobox_eager_stats[2];
+NB_EXPORT(nanobox_jit_eager_stat) double nanobox_jit_eager_stat(unsigned i) { return i < 2 ? (double) nanobox_eager_stats[i] : 0; }
+static bool nanobox_page_swept(bx_phy_address page)
+{
+  Bit64u pp = page >> 12;
+  for (unsigned i = 0; i < nb_swept_n; i++) if (nb_swept[i] == pp) return true;
+  if (nb_swept_n < 4096) nb_swept[nb_swept_n++] = pp;
+  return false;
+}
+static void nanobox_jit_maybe_compile_inner(bxICacheEntry_c *e);
+static void nanobox_jit_maybe_compile_at(bxICacheEntry_c *e, bx_address entryLin, Region **formed);
+static void nanobox_eager_sweep(bxICacheEntry_c *e)
+{
+  bx_phy_address page = e->pAddr & ~(bx_phy_address) 0xfff;
+  if (nanobox_page_swept(page)) return;
+  // this page is the current fetch page (we are executing e): eipBiased maps its offsets
+  bx_address pageLin = RIP - e->i[0].ilen(); pageLin &= ~(bx_address) 0xfff;
+  if ((BX_CPU_THIS_PTR pAddrFetchPage & ~(bx_phy_address) 0xfff) != page) return;
+  Bit8u seen[4096]; memset(seen, 0, sizeof seen);
+  Bit16u queue[4096]; unsigned qh = 0, qt = 0;
+  queue[qt++] = (Bit16u)(e->pAddr & 0xfff); seen[e->pAddr & 0xfff] = 1;
+  while (qh < qt) {
+    unsigned off = queue[qh++];
+    if (off > 4096 - 16) continue;   // a first instruction that may cross the page would make the decoder fetch the next page (can fault)
+    bx_phy_address pa = page + off;
+    bxICacheEntry_c *se = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+    if (se->pAddr != pa) {
+      Bit32u eipBiased = (Bit32u)((pageLin + off) + BX_CPU_THIS_PTR eipPageBias);
+      se = BX_CPU_THIS_PTR serveICacheMiss(eipBiased, pa);
+      if (!se || se->pAddr != pa) continue;
+      nanobox_eager_stats[0]++;
+    }
+    unsigned n = nanobox_real_len(se);
+    if (n == 0) continue;
+    // The entry's LINEAR address, not the CPU's current RIP. nanobox_jit_maybe_compile_inner()
+    // derives it from RIP (correct only for the trace cpu_loop is executing); the sweep hands the
+    // compiler a foreign entry, so the region former was told the wrong linear base and resolved
+    // every successor as entryLin + offset -> blocks pulled from the WRONG offsets of the page (and,
+    // when the bogus base straddled a page, from a wrong frame). The region attached to `se` then ran
+    // code that was never at those addresses: with regions on, the eager kernel recording stalled the
+    // boot for good (the guest spun in the tsc.c page, ~3e9 instructions, never opening a file);
+    // with `--jit-region 1` the very same eager run reproduced the interpreter's icount exactly.
+    if (!se->jitfn) { nanobox_jit_maybe_compile_at(se, pageLin + off, NULL); nanobox_eager_stats[1]++; }
+    // successors inside the page: direct targets + callee entry + continuation after a call
+    Bit64s t[3]; unsigned nt = 0;
+    nanobox_direct_targets(se, n, 0, t, nt);
+    Bit32u len = 0; for (unsigned k = 0; k < n; k++) len += se->i[k].ilen();
+    const bxInstruction_c *l = &se->i[n - 1];
+    if (l->getIaOpcode() == BX_IA_CALL_Jq) { t[nt++] = (Bit64s) len; t[nt++] = (Bit64s) len + (Bit64s)(Bit32s) l->Id(); }
+    for (unsigned q = 0; q < nt; q++) {
+      Bit64s so = (Bit64s) off + t[q];
+      if (so < 0 || so >= 4096 || seen[so]) continue;
+      seen[so] = 1; if (qt < 4096) queue[qt++] = (Bit16u) so;
+    }
+  }
+}
+
+void nanobox_jit_maybe_compile(bxICacheEntry_c *e)
+{
+  if (e->jitfn) return;
+  nanobox_jit_maybe_compile_inner(e);
+  if (nanobox_jit_eager && !nanobox_dbg_mode) nanobox_eager_sweep(e);
+}
+// ---- function boundaries (AOT, TASKS.md S.3) ---------------------------------------------------
+// The offline translator walks from FUNCTION STARTS; the runtime used to root a region at whatever
+// block the guest entered first (a loop head, the landing site of a return). Different entry means
+// different block offsets means a different content key, so a precompiled artifact matched 2-3 % of
+// what the runtime asked for. Given the function boundaries -- which the artifact's producer already
+// has (System.map for the kernel, .eh_frame_hdr for a program) -- the runtime roots the region at the
+// containing function instead, and the two formers describe the same object by construction. Every
+// block of a region is wired to its own entry descriptor by nanobox_region_attach, so entering in the
+// middle costs nothing.
+static Bit64u *nb_fnmap = NULL;          // sorted function start addresses
+// ...interleaved with END sentinels. One map now holds several text regions -- the kernel plus every
+// user program whose boundaries were loaded -- and the space between them belongs to no function, so
+// an address there must not be given the range [last function of region N, first of region N+1).
+// nb_fnmap_gap[i] = 1 marks entry i as "this is where a text region ENDS".
+static Bit8u *nb_fnmap_gap = NULL;
+static unsigned nb_fnmap_n = 0, nb_fnmap_cap = 0;
+static Bit64u nb_fnmap_lo = 0, nb_fnmap_hi = 0;
+NB_EXPORT(nanobox_aot_fnmap_reset) void nanobox_aot_fnmap_reset(void) { nb_fnmap_n = 0; nb_fnmap_lo = nb_fnmap_hi = 0; }
+NB_EXPORT(nanobox_aot_fnmap_add) void nanobox_aot_fnmap_add(unsigned linLo, unsigned linHi)
+{
+  Bit64u a = ((Bit64u) linHi << 32) | (Bit64u) linLo;
+  if (nb_fnmap_n && a <= nb_fnmap[nb_fnmap_n - 1]) return;   // host must add in ascending order
+  if (nb_fnmap_n == nb_fnmap_cap) {
+    unsigned cap = nb_fnmap_cap ? nb_fnmap_cap * 2 : 4096;
+    Bit64u *p = (Bit64u *) realloc(nb_fnmap, cap * sizeof(Bit64u));
+    if (!p) return;
+    Bit8u *g = (Bit8u *) realloc(nb_fnmap_gap, cap);
+    if (!g) return;
+    nb_fnmap = p; nb_fnmap_gap = g; nb_fnmap_cap = cap;
+  }
+  nb_fnmap_gap[nb_fnmap_n] = 0;
+  if (!nb_fnmap_n) nb_fnmap_lo = a;
+  nb_fnmap[nb_fnmap_n++] = a; nb_fnmap_hi = a;
+}
+// mark the end of a text region: addresses from here to the next entry are inside no function
+NB_EXPORT(nanobox_aot_fnmap_gap) void nanobox_aot_fnmap_gap(unsigned linLo, unsigned linHi)
+{
+  nanobox_aot_fnmap_add(linLo, linHi);
+  if (nb_fnmap_n) nb_fnmap_gap[nb_fnmap_n - 1] = 1;
+}
+NB_EXPORT(nanobox_aot_fnmap_count) unsigned nanobox_aot_fnmap_count(void) { return nb_fnmap_n; }
+NB_EXPORT(nanobox_keylog_count) unsigned nanobox_keylog_count(void) { return nb_keylog_n; }
+NB_EXPORT(nanobox_keylog_reset) void nanobox_keylog_reset(void) { nb_keylog_n = 0; }
+NB_EXPORT(nanobox_keylog_enable) void nanobox_keylog_enable(unsigned on) { nb_keylog_on = on; nb_keylog_n = 0; }
+NB_EXPORT(nanobox_keylog_at) double nanobox_keylog_at(unsigned i, unsigned which) { return i < nb_keylog_n && which < 3 ? (double) nb_keylog[i][which] : 0; }
+// 64-bit safe reader: a double cannot hold a 64-bit address or content key (its ulp is 2048 up there),
+// and reading the key log through one quantised every address into a 2 KB bucket -- which is how the
+// first diff concluded "214 distinct addresses out of 4000 functions" when there were thousands.
+// which = 2*field + half (field 0 addr, 1 key, 2 blocks; half 0 = low 32 bits).
+NB_EXPORT(nanobox_keylog_word) unsigned nanobox_keylog_word(unsigned i, unsigned which)
+{
+  if (i >= nb_keylog_n || which >= 6) return 0;
+  Bit64u v = nb_keylog[i][which >> 1];
+  return (which & 1) ? (unsigned)(v >> 32) : (unsigned)(v & 0xffffffffu);
+}
+// the start of the function containing `lin`, or 0
+static Bit64u nb_fn_start(bx_address lin)
+{
+  if (!nb_fnmap_n || lin < nb_fnmap_lo || lin > nb_fnmap_hi) return 0;
+  unsigned lo = 0, hi = nb_fnmap_n;                 // greatest start <= lin
+  while (lo + 1 < hi) { unsigned mid = (lo + hi) / 2; if (nb_fnmap[mid] <= (Bit64u) lin) lo = mid; else hi = mid; }
+  if (nb_fnmap_gap && nb_fnmap_gap[lo]) return 0;   // past the end of that text region
+  return nb_fnmap[lo];
+}
+// [start, end) of the function containing `lin` (end = the next function's start; false when `lin` is
+// outside the map). The former uses it to keep a region inside ONE function: the static walk follows
+// fall-through and CALL continuations, which at the tail of a function run straight into the next one,
+// so without a boundary a region rooted in F swallows the entry of F+1 -- and F+1 then never gets a
+// region of its own. Which functions get swallowed depends on the ORDER the walks run in, so the
+// offline translator (ascending addresses) and the runtime (execution order) produced different
+// regions at the same address. Measured before this bound: the artifact held a region at only 2,887 of
+// 29,013 kernel function starts.
+static bool nb_fn_range(bx_address lin, Bit64u *lo, Bit64u *hi)
+{
+  if (!nb_fnmap_n || lin < nb_fnmap_lo || lin > nb_fnmap_hi) return false;
+  unsigned a = 0, b = nb_fnmap_n;
+  while (a + 1 < b) { unsigned mid = (a + b) / 2; if (nb_fnmap[mid] <= (Bit64u) lin) a = mid; else b = mid; }
+  if (nb_fnmap_gap && nb_fnmap_gap[a]) return false;   // between two text regions: no function here
+  *lo = nb_fnmap[a];
+  *hi = (a + 1 < nb_fnmap_n) ? nb_fnmap[a + 1] : (Bit64u) -1;
+  return true;
+}
+static void nanobox_jit_maybe_compile_at(bxICacheEntry_c *e, bx_address entryLin, Region **formed);
+// depth of the "the function's region did not reach the block the guest is at" recursion: the retarget
+// is tried once per call site, never again inside the fallback
+static unsigned nb_retarget_depth = 0;
+static unsigned nb_sweeping = 0;              // inside a whole-function sweep (no nested sweeps)
+static int nb_aot_sweep_function(bx_address lin, unsigned len, unsigned flags);
+static void nanobox_jit_maybe_compile_inner(bxICacheEntry_c *e)
+{
+  nanobox_jit_maybe_compile_at(e, RIP - e->i[0].ilen(), NULL);
+}
+// formed (optional, AOT driver): receives a COPY of the region descriptor formed for e (caller frees), NULL if none
+static void nanobox_jit_maybe_compile_at(bxICacheEntry_c *e, bx_address entryLin, Region **formed)
+{
+  if (formed) *formed = NULL;
+  if (e->jitfn) return;
+  if (nanobox_batching()) {
+    // an entry that is queued keeps calling here (its hot counter stays over the threshold): use
+    // those calls as flush ticks so a small batch does not wait forever
+    // (AOT mode, threshold 1: an entry -- or a member block of a queued region -- that runs again while
+    //  its batch is open runs INTERPRETED; nanobox_stats.traces barely advances when the rest of the
+    //  guest is JIT'd, so bound the wait by interpreted traces too, else a small batch starves the guest)
+    if (nb_npending && (nanobox_stats.traces - nb_batch_since > NB_BATCH_MAX_TRACES_WAIT ||
+                        (nanobox_jit_aot && nanobox_stats.interp_traces - nb_batch_since_interp > 256))) nanobox_jit_batch_flush();
+    if (nanobox_jit_pending(e)) { nanobox_aot_stats[6]++; return; }
+  }
+  nb_tier0_now = nb_tier0_pick(e);
+  if (nb_tier0_now) {
+    // tier 0: the compact call form, plain traces only
+    unsigned nreal0 = 0;
+    Bit64u k0 = nanobox_jit_hash(e, nreal0);
+    if (!nanobox_jit_compile_one(e, NULL, k0)) { *BX_CPU_THIS_PTR iCache.hotOf(e) = 0; nanobox_aot_stats[7]++; }
+    else nanobox_tier_stats[0]++;
+    return;
+  }
+  // If this block already belongs to a LIVE region -- formed at the containing function, its members
+  // wired at the attach -- attach to that region instead of rooting a second one here.
+  if (nanobox_jit_aot && (nanobox_jit_aot_detform & 4)) {
+    unsigned mj = 0;
+    bool kern = (Bit64u) entryLin >= 0xffff800000000000ull;
+    if (kern || (nanobox_jit_aot_detform & 16)) {
+      Region *mr = nanobox_region_find_member(e, entryLin, &mj, kern);
+      if (mr) { nanobox_region_attach_member(e, mr, mj); nanobox_region_stats[kern ? 32 : 45]++; return; }
+      nanobox_region_stats[kern ? 33 : 46]++;
+    }
+  }
+  // 1. region (entry + reachable traces in this page), unless the entry loops on itself (the
+  //    single-trace loop compile keeps registers in locals across iterations)
+  // AOT: root the region at the containing FUNCTION, not at the block the guest happened to enter,
+  // so the region is the same object the offline translator built (TASKS.md S.3). If the function's
+  // region turns out not to cover this block (a budget cut short of it), fall back to forming here.
+  bxICacheEntry_c *origE = e; bx_address origLin = entryLin;
+  // The guest has touched an address in a function nothing covers yet -> build the WHOLE function
+  // exactly the way the offline translator builds it (the same queue from the function's first byte,
+  // the same gap sweep, the same budgets). The regions that come out carry the artifact's keys and are
+  // FOUND instead of compiled. Rooting a region at whatever block the guest happened to enter is what
+  // made the two disagree. It also gives the direct-call inline caches a stable callee: a CALL resolves
+  // by address, and the callee's translation is now its FUNCTION's region.
+  if (nanobox_jit_aot && (nanobox_jit_aot_detform & 2) && nanobox_jit_aot_sweep && nb_fnmap_n && !nb_sweeping && nb_retarget_depth == 0) {
+    Bit64u flo = 0, fhi = 0;
+    if (nb_fn_range(entryLin, &flo, &fhi) && fhi > flo && nb_fnswept_mark(flo)) {
+      Bit64u flen = fhi - flo; if (flen > (1u << 20)) flen = 1u << 20;
+      nanobox_region_stats[36]++;
+      nb_protect_entry = origE;
+      nb_sweeping++;
+      nb_aot_sweep_function((bx_address) flo, (unsigned) flen, 1);
+      nb_sweeping--;
+      nb_protect_entry = NULL;
+      if (e->jitfn) { nanobox_region_stats[37]++; return; }
+      nanobox_region_stats[38]++;
+    }
+  }
+  if (nanobox_jit_aot && nb_fnmap_n && nb_retarget_depth == 0 && !(nanobox_jit_aot_detform & 2)) {
+    Bit64u fstart = nb_fn_start(entryLin);
+    if (fstart && fstart != (Bit64u) entryLin) {
+      bx_phy_address fpa = 0;
+      if (nanobox_aot_xlate((bx_address) fstart, &fpa)) {
+        const Bit8u *fhost = nanobox_host_page(fpa & ~(bx_phy_address) 0xfff);
+        if (fhost) {
+          bxICacheEntry_c *fe = BX_CPU_THIS_PTR iCache.get_entry(fpa, BX_CPU_THIS_PTR fetchModeMask);
+          bxICacheEntry_c *avoid1[1] = { origE };   // never reuse the slot cpu_loop is running out of
+          if (fe->pAddr != fpa || fe->tlen == 0) fe = nanobox_decode_ahead(fpa, fhost, avoid1, 1);
+          if (fe && nanobox_real_len(fe) && !fe->jitfn && !nanobox_jit_pending(fe)) {
+            nanobox_region_stats[26]++;
+            e = fe; entryLin = (bx_address) fstart;
+          }
+        }
+      }
+    }
+  }
+  nb_lookup_lin = entryLin;
+  Region *reg = nanobox_form_region(e, entryLin);
+  if (e != origE && !reg) { e = origE; entryLin = origLin; reg = nanobox_form_region(e, entryLin); }   // no function region: form here
+  if (reg && formed) { Region *c = new Region(); c->nblocks = reg->nblocks; for (unsigned j = 0; j < reg->nblocks; j++) { c->b[j].boff = reg->b[j].boff; c->b[j].n = reg->b[j].n; c->b[j].ins = new bxInstruction_c[reg->b[j].ent.tlen]; memcpy(c->b[j].ins, reg->b[j].ins, reg->b[j].ent.tlen * sizeof(bxInstruction_c)); c->b[j].ent = reg->b[j].ent; c->b[j].ent.i = c->b[j].ins; } *formed = c; }
+  if (reg) {
+    if (nanobox_jit_try_cached(e, reg, reg->key)) {
+      nanobox_aot_stats[8]++;
+      if (e != origE && !origE->jitfn && !nanobox_jit_pending(origE)) { nanobox_region_stats[27]++; nb_retarget_depth++; nanobox_jit_maybe_compile_at(origE, origLin, NULL); nb_retarget_depth--; }
+      return;
+    }
+    // region keys depend on which neighbours the iCache happens to hold; a pre-computed bundle
+    // recorded under other timing may still have the plain trace: prefer that over compiling
+    // (not in AOT mode: there the region IS the unit -- a missing precompiled region is compiled)
+    if (!nanobox_dbg_mode && !nanobox_jit_aot) {
+      unsigned nreal0 = 0; Bit64u tkey = nanobox_jit_hash(e, nreal0);
+      unsigned pre = hook_lookup((unsigned)(tkey & 0xffffffffu), (unsigned)(tkey >> 32));
+      if (pre) { delete reg; nanobox_jit_attach(e, pre, NULL, tkey); nanobox_jit_cache_put(tkey, pre, 0, NULL); if (jitcache_count == 0) { e->jitfn = 0; hook_release(pre); } return; }
+    }
+    if (nanobox_jit_compile_one(e, reg, reg->key)) {
+      nanobox_aot_stats[9]++;
+      // the guest is at origE: if the function's region did not reach that block, translate it too
+      if (e != origE && !origE->jitfn && !nanobox_jit_pending(origE)) { nanobox_region_stats[27]++; nb_retarget_depth++; nanobox_jit_maybe_compile_at(origE, origLin, NULL); nb_retarget_depth--; }
+      return;
+    }
+    nanobox_aot_stats[13]++;
+  }
+  // 2. plain trace -- of the site the guest is actually at, not of the function entry we retargeted to
+  if (e != origE) { e = origE; entryLin = origLin; if (e->jitfn) return; }
+  nanobox_aot_stats[10]++;
+  unsigned nreal = 0;
+  Bit64u key = nanobox_jit_hash(e, nreal);
+  if (!nanobox_jit_compile_one(e, NULL, key)) { *BX_CPU_THIS_PTR iCache.hotOf(e) = 0; nanobox_aot_stats[7]++; }
+  else nanobox_aot_stats[14]++;
+}
+
+/////////////////////////////////////////////////////////////////////////
+// AOT precompile API (TASKS.md R; consumed by the offline "precompile everything" driver, work/j/aotpre)
+//
+//   int nanobox_aot_compile_function(unsigned linLo, unsigned linHi, unsigned len, unsigned cpl, unsigned flags)
+//
+// Forms and compiles every region the RUNTIME former would form inside one guest function, and records
+// the translations exactly like normal installs (hook_note -> the harness' --jit-bundle-out bundle):
+//   * a region is formed from the function's first byte (lin = linHi:linLo) with the same static walk
+//     the runtime uses at first touch (direct targets / fall-through / CALL continuations, decode-ahead,
+//     budgets, page rules), then from every direct successor of a formed region that lies inside
+//     [lin, lin+len) and is not yet a member of one -- this is the order in which the runtime meets
+//     them (function entry first, then the blocks its regions exit to), so the content keys match;
+//   * flags bit 0: afterwards also start regions at every byte range inside the function the walk left
+//     uncovered (linear sweep from the end of the last covered block: blocks reached only through
+//     jump tables / indirect jumps). Spurious starts cost bundle bytes, never correctness (a region is
+//     keyed by its entry pAddr + content and only ever attached to an entry that decoded the same);
+//   * cpl selects the region class (0: kernel text, fixed mapping, regions may span pages; 3: user,
+//     entry page +/-1) and is applied to the CPU's user_pl for the duration of the call.
+// Returns the number of regions/traces compiled or found precompiled (>= 0), -1 when the JIT or AOT
+// mode is off (nanobox_set_jit(2+, *) and nanobox_set_jit_aot(1) first), -2 when the function's first
+// byte is not mapped under the current CR3 (translate the process' code with its CR3 live), -3 when
+// the CPU is not in 64-bit mode. Call between traces (from the host, with the guest stopped) and
+// nanobox_jit_flush_batch() once at the end of a sweep. Traces are decoded ahead into the iCache
+// (host-only state), nothing in guest RAM changes.
+/////////////////////////////////////////////////////////////////////////
+NB_EXPORT(nanobox_aot_stat) double nanobox_aot_stat(unsigned i) { return i < 16 ? (double) nanobox_aot_stats[i] : 0; }
+// The offline byte source: the host writes the program's own bytes into the buffer and says which
+// guest linear range they are. len 0 switches back to reading guest RAM.
+NB_EXPORT(nanobox_aot_srcbuf_addr) unsigned nanobox_aot_srcbuf_addr(void) { return (unsigned)(uintptr_t) nanobox_aot_srcbuf; }
+NB_EXPORT(nanobox_aot_srcbuf_size) unsigned nanobox_aot_srcbuf_size(void) { return NB_AOT_SRC_MAX; }
+NB_EXPORT(nanobox_aot_source) void nanobox_aot_source(unsigned linLo, unsigned linHi, unsigned len)
+{
+  nanobox_aot_src_lin = ((bx_address) linHi << 32) | (bx_address) linLo;
+  nanobox_aot_src_len = len > NB_AOT_SRC_MAX ? NB_AOT_SRC_MAX : len;
+  // entries decoded from an earlier window share the synthetic physical range: drop them so a new
+  // window cannot be read through a stale iCache entry
+  BX_CPU_THIS_PTR iCache.flushICacheEntries();
+}
+// The sweep itself, shared by the offline driver's export and by the runtime's first touch of a
+// function: running the SAME walk from the SAME start is what makes the two produce the same regions at
+// the same addresses, and therefore the same keys.
+static int nb_aot_sweep_function(bx_address lin, unsigned len, unsigned flags)
+{
+  // Decode ahead for the duration: a sweep translates code that has not executed yet, which is exactly
+  // what nanobox_jit_aot_ahead gates (it is off by default at runtime).
+  unsigned saveAhead = nanobox_jit_aot_ahead; nanobox_jit_aot_ahead = 1;
+  // The iCache instruction pool never empties by itself in an OFFLINE sweep: nanobox_decode_ahead
+  // refuses to let serveICacheMiss flush it (the caller holds entries) and nothing else decodes. Once
+  // it fills, every successor decode fails, regions collapse to a single block and whole functions come
+  // out as plain traces -- measured on the full kernel: 15,968 refusals, and mas_alloc_nodes, which
+  // yields five regions translated on its own, yielded NONE inside the 29,013-function run. Between
+  // functions nothing is held, so reset it there. Host driven only (nb_protect_entry == NULL): with the
+  // guest running, cpu_loop is interpreting out of that pool and a flush would rewrite it underneath.
+  if (nanobox_jit_aot_poolreset && !nb_protect_entry && BX_CPU_THIS_PTR iCache.mpindex > BxICacheMemPool / 2)
+    BX_CPU_THIS_PTR iCache.flushICacheEntries();
+  Bit8u *saveClaim = nb_claim; bx_address saveClaimLin = nb_claim_lin; unsigned saveClaimLen = nb_claim_len;
+  if (nanobox_jit_aot_detform & 32) { nb_claim = (Bit8u *) calloc(len, 1); nb_claim_lin = lin; nb_claim_len = nb_claim ? len : 0; }
+  Bit8u *covered = (Bit8u *) calloc(len, 1);   // byte coverage of [lin, lin+len)
+  enum { QMAX = 8192 };
+  Bit32u *queue = (Bit32u *) malloc(QMAX * sizeof(Bit32u)); unsigned qh = 0, qt = 0;
+  Bit8u *started = (Bit8u *) calloc(len, 1);
+  auto push = [&](bx_address la) { if (la < lin || la >= lin + len) return; Bit32u o = (Bit32u)(la - lin); if (started[o] || qt >= QMAX) return; started[o] = 1; queue[qt++] = o; };
+  int done = 0;
+  push(lin);
+  for (;;) {
+    while (qh < qt) {
+      bx_address la = lin + queue[qh++];
+      nanobox_aot_stats[2]++;
+      bx_phy_address pa = 0;
+      if (!nanobox_aot_xlate(la, &pa)) { nanobox_aot_stats[3]++; continue; }
+      const Bit8u *host = nanobox_host_page(pa & ~(bx_phy_address) 0xfff);
+      if (!host) continue;
+      bxICacheEntry_c *e = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+      if (e->pAddr != pa || e->tlen == 0) { e = nanobox_decode_ahead(pa, host, NULL, 0); if (!e) continue; }
+      unsigned n = nanobox_real_len(e);
+      if (n == 0) continue;
+      Region *formed = NULL;
+      if (e->jitfn) nanobox_aot_stats[5]++;   // already translated (member of an earlier region, or a previous call): its own bytes + successors still drive the sweep
+      else { nanobox_jit_maybe_compile_at(e, la, &formed); if (e->jitfn || nanobox_jit_pending(e)) { done++; nanobox_aot_stats[1]++; } }
+      // coverage + successors: the trace itself, plus the region's other blocks when one was formed
+      { Bit32u blen = 0; for (unsigned k = 0; k < n; k++) blen += e->i[k].ilen();
+        for (Bit32u o = 0; o < blen; o++) if (la + o < lin + len) covered[la + o - lin] = 1;
+        Bit64s t[4]; unsigned nt = 0;
+        nanobox_direct_targets(e, n, 0, t, nt);
+        for (unsigned q = 0; q < nt; q++) push(la + (bx_address) t[q]); }
+      if (formed) {
+        for (unsigned j = 1; j < formed->nblocks; j++) {
+          bx_address bl = la + (bx_address)(Bit64s) formed->b[j].boff; Bit32u blen = 0;
+          if (bl >= lin && bl < lin + len) started[bl - lin] = 1;   // a member never starts a region of its own
+          for (unsigned k = 0; k < formed->b[j].n; k++) blen += formed->b[j].ins[k].ilen();
+          for (Bit32u o = 0; o < blen; o++) if (bl + o >= lin && bl + o < lin + len) covered[bl + o - lin] = 1;
+          Bit64s t[4]; unsigned nt = 0;
+          nanobox_direct_targets(&formed->b[j].ent, formed->b[j].n, 0, t, nt);
+          for (unsigned q = 0; q < nt; q++) push(bl + (bx_address) t[q]);
+        }
+        delete formed;
+      }
+    }
+    if (!(flags & 1)) break;
+    // linear sweep: the first uncovered byte after a covered run (or the function start) starts a region
+    bx_address gap = 0; bool found = false;
+    for (Bit32u o = 0; o < len; o++) {
+      if (covered[o] || started[o]) continue;
+      if (o == 0 || covered[o - 1]) { gap = lin + o; found = true; break; }
+    }
+    if (!found) break;
+    nanobox_aot_stats[4]++;
+    push(gap);
+    if (qh >= qt) break;   // could not be queued (started / queue full)
+  }
+  free(covered); free(queue); free(started);
+  if (nb_claim) free(nb_claim);
+  nb_claim = saveClaim; nb_claim_lin = saveClaimLin; nb_claim_len = saveClaimLen;
+  nanobox_jit_aot_ahead = saveAhead;
+  return done;
+}
+NB_EXPORT(nanobox_aot_compile_function) int nanobox_aot_compile_function(unsigned linLo, unsigned linHi, unsigned len, unsigned cpl, unsigned flags)
+{
+  if (!nanobox_jit_aot || nanobox_jit_level < 2 || nanobox_dbg_mode) return -1;
+  if (BX_CPU_THIS_PTR cpu_mode != BX_MODE_LONG_64) return -3;
+  bx_address lin = ((bx_address) linHi << 32) | (bx_address) linLo;
+  if (len == 0) len = 1;
+  { bx_phy_address phy = 0; if (!nanobox_aot_xlate(lin, &phy)) { nanobox_aot_stats[3]++; return -2; } }
+  nanobox_aot_stats[0]++;
+  Bit8u saveUpl = BX_CPU_THIS_PTR user_pl; BX_CPU_THIS_PTR user_pl = (cpl == 3) ? 1 : 0;
+  nb_sweeping++;                                  // the sites inside must not start sweeps of their own
+  nb_fnswept_mark((Bit64u) lin);
+  int done = nb_aot_sweep_function(lin, len, flags);
+  nb_sweeping--;
+  BX_CPU_THIS_PTR user_pl = saveUpl;
+  return done;
+}
+
+void nanobox_jit_entry_invalidate(bxICacheEntry_c *e)
+{
+  // compiled code is owned by the cache (or, in dbg mode, by nobody in particular): just forget it.
+  // (dbg mode used to release the function here; a region function is shared by all its member
+  // entries, so releasing it for one would break the others -> dbg mode simply leaks translations)
+  e->jitfn = 0;
+  *BX_CPU_THIS_PTR iCache.hotOf(e) = 0;
+}
+
+void nanobox_jit_flush_all(void)
+{
+  if (nanobox_dbg_mode) hook_release_all();
+}
diff --git a/bochs/nanobox_jit.h b/bochs/nanobox_jit.h
new file mode 100644
index 000000000..eb044a300
--- /dev/null
+++ b/bochs/nanobox_jit.h
@@ -0,0 +1,70 @@
+/////////////////////////////////////////////////////////////////////////
+// nanobox trace JIT — public interface used by the CPU loop and the iCache.
+//
+// A JIT-compiled trace is a wasm function `void run(bxInstruction_c *trace)` that performs
+// exactly what Bochs' chained handlers would do for the iCache trace: it is entered after
+// cpu_loop already did `RIP += i->ilen()` for the first instruction, and it returns whenever the
+// handler chain would have returned to cpu_loop (trace end, taken branch / BX_NEXT_TRACE,
+// async_event, or — via longjmp — an exception).
+/////////////////////////////////////////////////////////////////////////
+
+#ifndef NANOBOX_JIT_H
+#define NANOBOX_JIT_H
+
+struct bxICacheEntry_c;
+class bxInstruction_c;
+
+// runtime configuration (set by the host through nanobox.cc exports before the CPU starts)
+extern unsigned nanobox_jit_level;      // 0 = interpreter only, 1 = handler-call JIT, 2+ = templates
+extern unsigned nanobox_jit_threshold;  // executions of a trace before it gets compiled
+
+// interpreter <-> JIT hand-shake (see BX_NEXT_INSTR / BX_NEXT_TRACE in cpu.h)
+extern Bit8u nanobox_single_step;       // 1 while a JIT'd trace single-steps a handler: BX_NEXT_INSTR returns instead of chaining
+extern Bit8u nanobox_trace_end;         // set by BX_NEXT_TRACE so the JIT knows the trace ended
+
+// (arg, probe cache: 6 x i64 tags/frames + 4 x i32 host/free — see TraceCompiler::jitFuncType)
+typedef void (*nanobox_jitfn_t)(bxInstruction_c *trace, Bit64u, Bit64u, Bit64u, Bit64u, Bit64u, Bit64u, unsigned, unsigned, unsigned, unsigned);
+typedef void (*nanobox_jitfn4_t)(bxInstruction_c *trace, Bit64u, Bit64u, unsigned);   // short signature (nanobox_jit_flags bit 6)
+// direct calls (bit 9): the signature also carries the entry state (RIP past the first instruction,
+// icount at entry) so a call between two translations hands it over in registers instead of memory
+typedef void (*nanobox_jitfn6_t)(bxInstruction_c *trace, Bit64u, Bit64u, unsigned, Bit64u, Bit64u);
+typedef void (*nanobox_jitfn13_t)(bxInstruction_c *trace, Bit64u, Bit64u, Bit64u, Bit64u, Bit64u, Bit64u, unsigned, unsigned, unsigned, unsigned, Bit64u, Bit64u);
+extern unsigned nanobox_jit_flags;
+extern unsigned nanobox_jit_aot;
+extern unsigned nanobox_jit_tickexact;   // AOT tick-exactness mask (bit 8 turns direct calls off, changing the shared signature)
+
+void nanobox_jit_maybe_compile(bxICacheEntry_c *e);   // compile e (called by cpu_loop when e got hot)
+// two-tier emission (work/prof/tier.md): tier 0 is the compact call form
+extern unsigned nanobox_jit_tier;          // bit 0 tier-0 codegen, bit 1 promote to tier 1 when hot
+extern unsigned nanobox_jit_tier1_thr;
+extern Bit64u nanobox_tier_stats[4];
+extern bxICacheEntry_c *nanobox_t0_running;   // set by a tier-0 function's prologue: which entry is executing
+extern bxICacheEntry_c *nanobox_t0_promote;   // cpu_loop: recompile this entry at tier 1 next time it dispatches it
+void nanobox_jit_promote(bxICacheEntry_c *e);
+void nanobox_jit_entry_invalidate(bxICacheEntry_c *e); // e is being reused/invalidated: drop its code
+void nanobox_jit_flush_all(void);                      // iCache flushed: drop everything
+void nanobox_jit_after_decode(bxICacheEntry_c *e);     // trace freshly decoded: attach cached code
+
+extern unsigned nanobox_dbg_mode;
+extern bxICacheEntry_c *nanobox_dbg_cur_entry;
+extern unsigned nanobox_pages_on;                       // instruction-address profile (nanobox.cc)
+void nanobox_pages_account(Bit64u rip, Bit64u paddr, Bit64u n, unsigned user);
+void nanobox_dbg_trace(bxICacheEntry_c *entry, bool jitted);
+
+extern Bit64u nanobox_probe_mem[4];
+BX_CPP_INLINE void nanobox_jit_call(bxICacheEntry_c *e)
+{
+  nanobox_stats.jit_traces++;
+  nanobox_probe_mem[0] = nanobox_probe_mem[1] = (Bit64u) -1;   // memory-resident probe cache (flags bit 5): only a linking trace may hand one over
+  nanobox_single_step = 1;
+  const bool dc = (nanobox_jit_flags & 512) && nanobox_jit_aot && !nanobox_dbg_mode && !(nanobox_jit_tickexact & 8);
+  if (nanobox_jit_flags & 64) {
+    if (dc) ((nanobox_jitfn6_t)(uintptr_t) e->jitfn)((bxInstruction_c *)(uintptr_t) e->jitarg, (Bit64u) -1, (Bit64u) -1, 0, BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx, BX_CPU_THIS_PTR icount);
+    else ((nanobox_jitfn4_t)(uintptr_t) e->jitfn)((bxInstruction_c *)(uintptr_t) e->jitarg, (Bit64u) -1, (Bit64u) -1, 0);
+  }
+  else if (dc) ((nanobox_jitfn13_t)(uintptr_t) e->jitfn)((bxInstruction_c *)(uintptr_t) e->jitarg, (Bit64u) -1, (Bit64u) -1, 0, (Bit64u) -1, (Bit64u) -1, 0, 0, 0, 0, 0, BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx, BX_CPU_THIS_PTR icount);
+  else ((nanobox_jitfn_t)(uintptr_t) e->jitfn)((bxInstruction_c *)(uintptr_t) e->jitarg, (Bit64u) -1, (Bit64u) -1, 0, (Bit64u) -1, (Bit64u) -1, 0, 0, 0, 0, 0);
+  nanobox_single_step = 0;
+}
+
+#endif
