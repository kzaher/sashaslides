+    // cpu_loop does BETWEEN traces, and on a self-loop it ran on every iteration: 39 of the 59 wasm
+    // instructions the fib loop executed. None of it can change as a result of the loop itself, so
+    // run it every nanobox_jit_aot_tick iterations instead and make the back edge a countdown.
+    // The cost of being late: an interrupt is taken up to tick-1 iterations after it was raised, and
+    // icount (our own clock bookkeeping, not guest-visible state) lags by the same amount between
+    // syncs. Identity mode keeps the per-iteration form.
+    const unsigned tick = aotRelaxed() ? (nanobox_jit_aot_tick ? nanobox_jit_aot_tick : 1) : 1;
+    if (tick > 1) {
+      em->get(L_tick); em->i32c(1); em->op(I32_SUB); em->tee(L_tick); em->op(I32_EQZ);
+      iff();
+    }
+    em->get(L_ic0); em->i64c((Bit64s)(k + 1) * (Bit64s) tick); em->op(I64_ADD); em->set(now);
+    em->get(now); em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR icount_last_sync), 3); em->op(I64_SUB); em->op(I32_WRAP_I64); em->set(delta);
