+  // level-3 census measured as 48 % of all accesses taking the full DTLB lookup. Each site gets
+  // its own (tag, host) locals instead, numbered in emission order and allocated as two contiguous
+  // runs once pass 1 has counted them. The tags are the OR form (la | ~LPF_MASK), whose poison is
+  // ZERO -- what a fresh wasm local already holds -- so a function entry costs nothing; only the
+  // mid-function invalidations (handler step, return from a direct call) have to store the poison.
+  uint32_t S_tagBase, S_hostBase;
+  unsigned nsite;        // sites emitted so far in this pass
+  unsigned nsiteTotal;   // sites pass 1 found
+  unsigned nsiteElig;    // ELIGIBLE sites emitted so far in this pass (= the local index)
+  unsigned nElig;        // eligible sites pass 1 found (= how many pairs pass 2 declared)
+  unsigned ninval, ninvalTotal;   // mid-function probe-cache invalidations
