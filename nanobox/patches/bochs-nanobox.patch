+    }
+    case BX_IA_CMOVO_GqEq: case BX_IA_CMOVNO_GqEq: case BX_IA_CMOVB_GqEq: case BX_IA_CMOVNB_GqEq: case BX_IA_CMOVZ_GqEq: case BX_IA_CMOVNZ_GqEq:
+    case BX_IA_CMOVBE_GqEq: case BX_IA_CMOVNBE_GqEq: case BX_IA_CMOVS_GqEq: case BX_IA_CMOVNS_GqEq: case BX_IA_CMOVP_GqEq: case BX_IA_CMOVNP_GqEq:
+    case BX_IA_CMOVL_GqEq: case BX_IA_CMOVNL_GqEq: case BX_IA_CMOVLE_GqEq: case BX_IA_CMOVNLE_GqEq: {
