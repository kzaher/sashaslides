+  // ---------------------------------------------------------------- effective addresses
+  // push the effective address (i64) of instruction k's memory operand
+  void pushEA(unsigned k) {
+    bxInstruction_c *i = &ins[k];
+    unsigned base = i->sibBase(), index = i->sibIndex();
+    if (base == BX_64BIT_REG_RIP) pushVA(off[k + 1]);
+    else if (base == BX_NIL_REGISTER) em->i64c(0);
+    else regGet(base);
+    if (i->displ32s()) { em->i64c((Bit64s)(Bit32s) i->displ32s()); em->op(I64_ADD); }
+    if (index != 4) { regGet(index); if (i->sibScale()) { em->i64c(i->sibScale()); em->op(I64_SHL); } em->op(I64_ADD); }
+    if (!i->as64L()) { em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); } // BxResolve32: modulo 2^32
+  }
+  // offset (i64 on stack) -> linear address (get_laddr64)
+  void pushLaddrFromOffset(unsigned seg) {
+    if (seg >= SEG_FS) { em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR sregs[seg].cache.u.segment.base), 3); em->op(I64_ADD); }
+  }
