+/////////////////////////////////////////////////////////////////////////
+// Outlined DTLB probe (work/j/outline).
+//
+// Every memory site used to inline its whole miss path: the second probe-cache candidate, the DTLB
+// lookup and the refill that recomputes the folded tags — ~90 wasm ops that only ever run when the
+// first candidate missed, repeated at ~830 k sites. It is the same code everywhere, so it moves
+// here, into one C++ helper per (size, permission, write-stamp) shape. A site keeps candidate 1
+// inline (the hot case: same page as its last access) and, on a miss, emits a call plus the three
+// loads of the values the probe cache has to keep in wasm locals.
+//
+// The helper reproduces the emitted sequence exactly, in the same order, so the change is
+// identity-preserving: same DTLB index, same tag/permission tests, same folded tags, same
+// write-stamp decrement (and the same fine-granularity test in front of it).
+//   returns 0 = probe succeeded (nanobox_probe_out filled), 1 = take the slow path
+struct NbProbeOut { Bit64u tagR, tagW, tagRo, tagWo; Bit32u host, freeb; };
+NbProbeOut nanobox_probe_out;
+unsigned nanobox_jit_outline = 1 | 2 | 8 | 64 | 128 | 256 | 512 | 1024 | 2048 | 16384 | 32768 | 65536 | 131072 | 262144;
+// Default 5 (bits 0|2) since the gate-green merge: -33 % on AOT call+ret, -21 % full DTLB lookups,
+// -2.9 % session wasm (TASKS.md V.6). NANOBOX_STACKTAG=0 restores the pre-merge emission exactly;
+// bit 1 (the 8-byte SS-segment operands) is left off because it is not anchored in stackPrefetch.
+unsigned nanobox_jit_stacktag = 1 | 4;
+// ---- NANOBOX_FAULTARM (docs/aot-size-and-coverage.md item 5): the per-site fault/exit arm.
+// nanobox_jit_outline has no free bit (19 is oneTag, 20-31 are siteBudget()), so this is its own
+// word, exactly as NANOBOX_STACKTAG had to be. 0 = today's engine, bit for bit.
+//   bit 0  widen the outlined cold-path spill from 3-10 registers to 2-18
+//   bit 1  outline the cold-path spill of a cold EXIT arm as well as of a slow/handler arm
+//          (nanobox_jit_outline bit 13 does this for the 3-10 range only, and ships OFF)
+//   bit 2  the exit descriptor carries the RIP as an OFFSET from L_base instead of the absolute
+//          VA, so a constant-RIP exit is `i64.const off; local.set T7` instead of
+//          `local.get L_base; i64.const off; i64.add; local.set T7`. The common tail adds L_base
+//          back, once per unit. The three exits whose RIP is computed at run time (indirect JMP /
+//          CALL, RET) pay one `local.get L_base; i64.sub` each.
+unsigned nanobox_jit_faultarm = 0;
+// Two-tier emission. Default 0 = tier 1 only (today's engine, bit for bit).
+//   bit 0  tier-0 codegen exists at all
+//   bit 1  ... and is used for a translation whose entry has not yet reached nanobox_jit_tier1_thr
+//   bit 2  tier-0 traces keep the inline templates for register-only instructions (hybrid form)
+unsigned nanobox_jit_tier = 0;
+unsigned nanobox_jit_tier1_thr = 0;
+Bit64u nanobox_tier_stats[4];   // 0 tier-0 compiles, 1 promotions to tier 1, 2 promotion attempts, 3 tier-0 executions
+// set by the compile driver around a compilation: "emit this one at tier 0"
+static bool nb_tier0_now = false;
+// bit 0 outlined DTLB probe + refill, 1 out-of-line syncBefore,
+// 8  = in-region transition boundary out of line (nanobox_trans_check): one call + ONE exit arm
+//      instead of BX_SYNC_TIME + async + first-execution + fetch-window inline with four exit arms,
+// 9  = trim the entry prologue to what pass 1 proved the unit uses (alignment mask, user_pl, the
+//      second probe-cache pair),
+// 10 = slim the probe miss arm (page offset hoisted in front of the candidates, nanobox_probe_out
+//      addressed through a base local),
+// 11 = cold-path register spill out of line (mask + values, one call),
+// 12 = with bit 6: a site with a private tag does not refresh the function-wide pair on a refill,
+// 13 = with bit 11: also outline the spill of a cold EXIT arm
+// 2 outlined direct-call site check (OFF: 3.6 % of the emitted bytes but +20 % on the AOT call+ret benchmark),
+// 3 outlined handler-step prologue/epilogue, 4 (off) AOT: keep self-looping successors inside a region,
+// 5 (off) keep a slimmed second probe candidate inline (measured: 3 % of the misses, not worth 13 points of size)
+// 6 = PER-SITE probe tags: every memory site keeps its own (tag, host) pair in fresh locals instead of
+//     sharing one pair per function (the level-3 census found 48 % of all accesses missing the shared
+//     pair -- two sites in one loop evict each other's page every iteration),
+// 7 = with bit 6: the function-global pair stays as the SECOND candidate, so a site that has not run
+//     yet in this activation still finds the page the caller handed over through the link parameters
+
+template <unsigned SIZE, unsigned BIT, bool STAMP>
+static BX_CPP_INLINE unsigned nanobox_probe_impl(Bit64u la, Bit64u acm, unsigned upl)
+{
+  // acm / upl come from the caller's locals, NOT from the CPU struct: the emitted probe read them
+  // once at trace entry (L_acm / L_upl) and a helper reading them fresh would be a different
+  // program wherever they changed under a trace that kept running (agy diverged on exactly that).
+  if (nanobox_jit_level >= 3) nanobox_flags_stats[FD_PROBE_FULL]++;
+  bx_TLB_entry *e = &BX_CPU_THIS_PTR DTLB.entry[(((Bit32u) la + (SIZE - 1)) & ((BX_DTLB_SIZE - 1) << 12)) >> 12];
+  const Bit64u want = SIZE > 1 ? (la & (LPF_MASK | (acm & (SIZE - 1)))) : (la & LPF_MASK);
+  if (e->lpf != want) return 1;
+  if (!(e->accessBits & (BIT << upl))) return 1;
+  const Bit32u host = (Bit32u) e->hostPageAddr;
+  const Bit64u ppf = (Bit64u) e->ppf;
+  const Bit32u *fgm = pageWriteStampTable.nanobox_fgm();
+  const unsigned freeb = fgm[((Bit32u) ppf) >> 12] == 0;
+  const Bit64u W = (acm == 0) ? (la & LPF_MASK) : (Bit64u) -1;
+  const Bit32u pb = e->accessBits >> upl;
+  nanobox_probe_out.tagR = (pb & 1) ? W : (Bit64u) -1;
+  nanobox_probe_out.tagW = (pb & 4) ? (freeb ? W : (Bit64u) -1) : (Bit64u) -1;
+  // OR-form twins for the per-site tags (nanobox_jit_outline bit 6): the tag is (la | ~LPF_MASK)
+  // instead of (la & LPF_MASK), so every valid tag is >= 0xfff and ZERO is the poison. That is what
+  // wasm gives a fresh local for free -- a per-site cache would otherwise need an explicit poison
+  // store per site at every function entry.
+  const Bit64u Wo = (acm == 0) ? (la | (Bit64u) ~LPF_MASK) : (Bit64u) 0;
+  nanobox_probe_out.tagRo = (pb & 1) ? Wo : (Bit64u) 0;
+  nanobox_probe_out.tagWo = (pb & 4) ? (freeb ? Wo : (Bit64u) 0) : (Bit64u) 0;
+  nanobox_probe_out.host = host;
+  nanobox_probe_out.freeb = freeb;
+  if (STAMP && !freeb) {                      // page carries iCache write stamps: the SMC dance
+    const Bit64u pA = ppf | (la & 0xfff);
+    if (fgm[((Bit32u) pA) >> 12]) {
+      if (nanobox_jit_level >= 3) nanobox_stats.link_fail[6]++;
+      pageWriteStampTable.decWriteStamp((bx_phy_address) pA, SIZE);
+    }
+  }
+  return 0;
+}
+extern "C" {
+#define NB_PROBE_FN(name, SIZE, BIT, STAMP) \
+  static unsigned name(Bit64u la, Bit64u acm, unsigned upl) { return nanobox_probe_impl<SIZE, BIT, STAMP>(la, acm, upl); }
+NB_PROBE_FN(nanobox_probe_r1,   1, 1, false)
+NB_PROBE_FN(nanobox_probe_r2,   2, 1, false)
+NB_PROBE_FN(nanobox_probe_r4,   4, 1, false)
+NB_PROBE_FN(nanobox_probe_r8,   8, 1, false)
+NB_PROBE_FN(nanobox_probe_r16, 16, 1, false)
+NB_PROBE_FN(nanobox_probe_r32, 32, 1, false)
+NB_PROBE_FN(nanobox_probe_w1,   1, 4, false)
+NB_PROBE_FN(nanobox_probe_w2,   2, 4, false)
+NB_PROBE_FN(nanobox_probe_w4,   4, 4, false)
+NB_PROBE_FN(nanobox_probe_w8,   8, 4, false)
+NB_PROBE_FN(nanobox_probe_w16, 16, 4, false)
+NB_PROBE_FN(nanobox_probe_w32, 32, 4, false)
+NB_PROBE_FN(nanobox_probe_s1,   1, 4, true)
+NB_PROBE_FN(nanobox_probe_s2,   2, 4, true)
+NB_PROBE_FN(nanobox_probe_s4,   4, 4, true)
+NB_PROBE_FN(nanobox_probe_s8,   8, 4, true)
+NB_PROBE_FN(nanobox_probe_s16, 16, 4, true)
+NB_PROBE_FN(nanobox_probe_s32, 32, 4, true)
+#undef NB_PROBE_FN
+}
+// index of `size` in the helper tables, or -1 = no helper (the site keeps the inline probe).
+// The AVX 256-bit accessors probe with size 32; mapping them onto the 16-byte helper is exactly the
+// bug that made agy diverge while codex stayed identical, so unknown sizes must NOT be folded in.
+static int nanobox_probe_size_idx(unsigned size)
+{
+  switch (size) { case 1: return 0; case 2: return 1; case 4: return 2; case 8: return 3; case 16: return 4; case 32: return 5; default: return -1; }
+}
+static unsigned nanobox_probe_fnidx(unsigned size, unsigned bit, unsigned stamp)
+{
+  const int s = nanobox_probe_size_idx(size);
+  if (s < 0) return 0;
+  if (bit == 1) { static unsigned f[6] = { (unsigned)(uintptr_t) nanobox_probe_r1, (unsigned)(uintptr_t) nanobox_probe_r2, (unsigned)(uintptr_t) nanobox_probe_r4, (unsigned)(uintptr_t) nanobox_probe_r8, (unsigned)(uintptr_t) nanobox_probe_r16, (unsigned)(uintptr_t) nanobox_probe_r32 }; return f[s]; }
+  if (!stamp)   { static unsigned f[6] = { (unsigned)(uintptr_t) nanobox_probe_w1, (unsigned)(uintptr_t) nanobox_probe_w2, (unsigned)(uintptr_t) nanobox_probe_w4, (unsigned)(uintptr_t) nanobox_probe_w8, (unsigned)(uintptr_t) nanobox_probe_w16, (unsigned)(uintptr_t) nanobox_probe_w32 }; return f[s]; }
+  static unsigned f[6] = { (unsigned)(uintptr_t) nanobox_probe_s1, (unsigned)(uintptr_t) nanobox_probe_s2, (unsigned)(uintptr_t) nanobox_probe_s4, (unsigned)(uintptr_t) nanobox_probe_s8, (unsigned)(uintptr_t) nanobox_probe_s16, (unsigned)(uintptr_t) nanobox_probe_s32 };
+  return f[s];
+}
