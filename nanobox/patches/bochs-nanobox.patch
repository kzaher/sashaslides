+// ---------------------------------------------------------------------------------------------
+// In-region transition boundary, out of line (nanobox_jit_outline bit 8).
+//
+// Every in-region edge used to inline the whole cpu_loop-between-traces sequence -- BX_SYNC_TIME,
+// async_event, the block's first-execution mark, the cross-page fetch-window refill and the fetch
+// window test -- each with its own commit-and-leave arm. That is ~200 wasm bytes at every edge and
+// it is the same program everywhere (a plain `JMP rel8` compiled to 255 bytes). It moves here.
+//
+// The sequence, its side effects and their ORDER are reproduced exactly, so the change is
+// identity-preserving: a caller that returns 1 takes the SAME single exit the inline arms took,
+// with the same state already committed to memory by whichever steps ran before the exit.
+//   flags: s | doSync<<8 | crossPage<<9 | needPpf<<10 | doWindow<<11 | ppfIdx<<12 | countTraces<<16
+//   returns 1 = leave the region (the caller commits and exits), 0 = continue into block s
+extern "C" {
+static unsigned nanobox_trans_check(Bit32u regp, Bit32u flags, Bit64u now, Bit64u targetVA, Bit32u upl)
+{
+  const unsigned s = flags & 0xff;
+  if (flags & 0x100) {
+    // BX_SYNC_TIME fast path (the timers run in cpu_loop when the budget is spent)
+    Bit32u *countdown = (Bit32u *)(uintptr_t) nanobox_pc_system_access::countdownAddr();
+    const Bit32u delta = (Bit32u)(now - BX_CPU_THIS_PTR icount_last_sync);
+    if (delta >= *countdown) return 1;
+    *countdown -= delta;
+    BX_CPU_THIS_PTR icount_last_sync = now;
+    if (BX_CPU_THIS_PTR async_event) return 1;
+  }
+  Region *r = (Region *)(uintptr_t) regp;
+  if (r->pending[s]) { if (!nanobox_region_first(regp, s)) return 1; }
+  if (flags & 0x200) {
+    // target in the region's other page: prefetch()'s common case (ITLB hit, execute permission,
+    // and -- outside kernel text -- still the physical frame the region was formed on)
+    bx_TLB_entry *e = &BX_CPU_THIS_PTR ITLB.entry[(((Bit32u) targetVA) & ((BX_ITLB_SIZE - 1) << 12)) >> 12];
+    if (e->lpf != (targetVA & LPF_MASK)) return 1;
+    if (!(e->accessBits & (1u << upl))) return 1;
+    if (flags & 0x400) { if ((((Bit64u) e->ppf) >> 12) != r->ppf[(flags >> 12) & 0xf]) return 1; }
+    BX_CPU_THIS_PTR eipPageBias = (bx_address)((targetVA & 0xfff) - targetVA);
+    BX_CPU_THIS_PTR eipPageWindowSize = 4096;
+    BX_CPU_THIS_PTR eflags &= ~0x10000u;                       // clear_RF
+    BX_CPU_THIS_PTR pAddrFetchPage = e->ppf;
+    BX_CPU_THIS_PTR eipFetchPtr = (const Bit8u *)(uintptr_t) e->hostPageAddr;
+  }
+  if (flags & 0x800) {
+    if ((Bit64u)(targetVA + (Bit64u) BX_CPU_THIS_PTR eipPageBias) >= (Bit64u) BX_CPU_THIS_PTR eipPageWindowSize) return 1;
+  }
+  if (flags & 0x10000) nanobox_stats.traces++;
+  return 0;
+}
