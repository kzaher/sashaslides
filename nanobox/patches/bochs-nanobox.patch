+    }
+    case SK_VMOV_R: // VMOVAPS_VpsWpsR: BX_WRITE_AVX_REGZ(dst, vmm[src], VL)
+      for (unsigned n = 0; n < 2; n++) { em->i32c(0); if (n < vl) pushXmm(i->src(), n); else em->v128_zero(); em->v128_store(xmmAddr(dst, n), 4); }
+      return true;
+    case SK_VMOV_LD:
+      pushEA(k); em->set(T[3]);
+      emitReadVec(k, seg, T[3], xmmAddr(dst), vl == BX_VL256 ? 32 : 16, d.aligned ? 1 : 0);
+      if (vl == BX_VL128) { em->i32c(0); em->v128_zero(); em->v128_store(xmmAddr(dst, 1), 4); }
+      return true;
+    case SK_VMOV_ST:
+      pushEA(k); em->set(T[3]);
+      emitWriteVec(k, seg, T[3], xmmAddr(i->src()), (d.op == 1 || vl != BX_VL256) ? 16 : 32, d.aligned);
+      return true;
+    case SK_MOVD_R: case SK_MOVD_LD: {
+      // op.lo = zero-extended dword, op.hi = 0; BX_WRITE_XMM_REGZ(dst, op, VL): VL != 0 clears the upper lane
+      if (d.kind == SK_MOVD_R) pushReg32(i->src()); else { pushEA(k); em->set(T[3]); emitRead(k, MK_RD_VIRT, seg, 4, T[3]); }
+      em->set(T[2]);
+      em->i32c(0); em->get(T[2]); em->mem(I64_STORE, xmmAddr(dst), 3);
+      em->i32c(0); em->i64c(0); em->mem(I64_STORE, xmmAddr(dst) + 8, 3);
+      if (vl) { em->i32c(0); em->v128_zero(); em->v128_store(xmmAddr(dst, 1), 4); }
+      return true;
+    }
+    case SK_MOVD_ST:
+      if (d.op == 0) { em->i32c(0); em->mem(I64_LOAD32_U, xmmAddr(i->src()), 2); regSetFromStack(dst); return true; }   // BX_WRITE_32BIT_REGZ
+      pushEA(k); em->set(T[3]); em->i32c(0); em->mem(I64_LOAD32_U, xmmAddr(i->src()), 2); em->set(T[2]);
+      emitWrite(k, MK_WR_VIRT, seg, 4, T[3], T[2]);
+      return true;
+    case SK_MOVQ_EqVq:
+      em->i32c(0); em->mem(I64_LOAD, xmmAddr(i->src()), 3); regSetFromStack(dst);
+      return true;
+    case SK_VPBROADCASTB: {
+      unsigned s = i->src();
+      if (d.ld == SL_WB) s = emitSimdLoadPrefix(k, d, vl, s);
+      em->i32c(0); em->v128_load8_splat(xmmAddr(s)); em->set(vloc(0));
+      for (unsigned n = 0; n < 2; n++) { em->i32c(0); if (n < vl) em->get(V[0]); else em->v128_zero(); em->v128_store(xmmAddr(dst, n), 4); }
+      return true;
+    }
+    default:
+      return false;
+    }
+  }
+  // setEFlagsOSZAPC(flags32) applied to the lazy state EXACTLY as the interpreter's sequence of
+  // set_OF / set_SF / set_ZF / set_AF(0) / set_PF(0) / set_CF does (each step reads the state the
+  // previous one left, so the resulting representation depends on the prior one; mirrored bit for bit).
+  // bits: local `b` (i32) with CF at bit 8, ZF at 9, SF at 10, OF at 11.
+  void emitSetEFlagsOSZAPCFromBits(uint32_t b) {
+    lfLoad();
+    uint32_t of = T32[4], t = X[0];
+    // set_OF(of): temp_cf = getB_CF(); set_flags_OxxxxC(of, temp_cf)
+    em->get(b); em->i32c(11); em->op(I32_SHR_U); em->i32c(1); em->op(I32_AND); em->set(of);
+    em->get(L_lfa); em->i64c(31); em->op(I64_SHR_U); em->i64c(1); em->op(I64_AND); em->set(t);          // temp_cf
+    em->get(L_lfa); em->i64c(0x3fffffffLL); em->op(I64_AND);
+    em->get(of); em->op(I64_EXTEND_I32_U); em->get(t); em->op(I64_XOR); em->i64c(30); em->op(I64_SHL); em->op(I64_OR);
+    em->get(t); em->i64c(31); em->op(I64_SHL); em->op(I64_OR); em->set(L_lfa);
+    // set_SF(sf): temp_sf = ((result >> 63) ^ aux) & 1; aux ^= temp_sf ^ sf
+    em->get(L_lfr); em->i64c(63); em->op(I64_SHR_U); em->get(L_lfa); em->op(I64_XOR); em->i64c(1); em->op(I64_AND);
+    em->get(b); em->i32c(10); em->op(I32_SHR_U); em->i32c(1); em->op(I32_AND); em->op(I64_EXTEND_I32_U); em->op(I64_XOR);
+    em->get(L_lfa); em->op(I64_XOR); em->set(L_lfa);
+    // set_ZF(zf): zf ? assert_ZF() : clear_ZF()
+    em->get(b); em->i32c(9); em->op(I32_SHR_U); em->i32c(1); em->op(I32_AND);
+    iff();
+      em->get(L_lfa); em->get(L_lfr); em->i64c(63); em->op(I64_SHR_U); em->i64c(1); em->op(I64_AND); em->op(I64_XOR);
+      em->get(L_lfr); em->i64c(255); em->op(I64_AND); em->i64c(8); em->op(I64_SHL); em->op(I64_XOR); em->set(L_lfa);
+      em->i64c(0); em->set(L_lfr);
+    els();
+      em->get(L_lfr); em->i64c(0x100); em->op(I64_OR); em->set(L_lfr);
+    endb();
+    // set_AF(0): auxbits &= ~LF_MASK_AF (32-bit mask)
+    em->get(L_lfa); em->i64c(0xfffffff7LL); em->op(I64_AND); em->set(L_lfa);
+    // set_PF(0): temp_pdb = (255 & result) ^ 1; aux = (aux & ~LF_MASK_PDB) | (temp_pdb << 8)
+    em->get(L_lfa); em->i64c(0xffff00ffLL); em->op(I64_AND);
+    em->get(L_lfr); em->i64c(255); em->op(I64_AND); em->i64c(1); em->op(I64_XOR); em->i64c(8); em->op(I64_SHL); em->op(I64_OR); em->set(L_lfa);
+    // set_CF(cf): temp_of = getB_OF(); set_flags_OxxxxC(temp_of, cf)
+    em->get(L_lfa); em->i64c(0x40000000LL); em->op(I64_ADD); em->i64c(31); em->op(I64_SHR_U); em->i64c(1); em->op(I64_AND); em->set(t);   // temp_of
+    em->get(b); em->i32c(8); em->op(I32_SHR_U); em->i32c(1); em->op(I32_AND); em->set(of);                                                // cf
+    em->get(L_lfa); em->i64c(0x3fffffffLL); em->op(I64_AND);
+    em->get(t); em->get(of); em->op(I64_EXTEND_I32_U); em->op(I64_XOR); em->i64c(30); em->op(I64_SHL); em->op(I64_OR);
+    em->get(of); em->op(I64_EXTEND_I32_U); em->i64c(31); em->op(I64_SHL); em->op(I64_OR); em->set(L_lfa);
+    lfMarkSet();
+  }
+  // ================================================================ REP STOS / MOVS single-chunk fast paths
+  // The interpreter runs a REP through repeat(): per iteration STOSB64/MOVSB64/MOVSD64/MOVSQ64 first
+  // try FastRepSTOSB/FastRepMOVSB, which transfers count = min(ECX*g, bytes left in the source
+  // page, bytes left in the destination page, currCountdown) bytes through host addresses when
+  // both v2h probes hit (TLB hit + permission; the destination page's iCache stamps are dropped
+  // wholesale), ticks currCountdown by iterations-1 and advances RCX/RSI/RDI; repeat() then
+  // decrements RCX once more and returns when it hits zero. This template handles exactly the case
+  // where that first chunk is the WHOLE count (so repeat() never loops, never touches icount, never
+  // re-checks async_event) and the destination page carries no code marks; anything else deopts
+  // to the handler BEFORE any side effect, which then does the same computation the interpreter would.
+  bool emitTemplateRep(unsigned k, bxInstruction_c *i, unsigned ia, bool last) {
+    unsigned g; bool movs; BxExecutePtr_tR h;
+    switch (ia) {
+      case BX_IA_REP_STOSB_YbAL: g = 1; movs = false; h = &BX_CPU_C::REP_STOSB_YbAL; break;
+      case BX_IA_REP_MOVSB_YbXb: g = 1; movs = true; h = &BX_CPU_C::REP_MOVSB_YbXb; break;
+      case BX_IA_REP_MOVSD_YdXd: g = 4; movs = true; h = &BX_CPU_C::REP_MOVSD_YdXd; break;
+      case BX_IA_REP_MOVSQ_YqXq: g = 8; movs = true; h = &BX_CPU_C::REP_MOVSQ_YqXq; break;
+      default: return false;
+    }
+    if (!i->as64L() || !i->repUsedL() || !realHandler(k, h)) return false;
+    unsigned seg = i->seg();
+    uint32_t cnt = T[0], la = T[1], sla = T[2];
+    uint32_t hd = T32[2], hs = T32[3];
+    regEnsureLoaded(R_RCX); regEnsureLoaded(R_RDI); if (movs) regEnsureLoaded(R_RSI); else regEnsureLoaded(R_RAX);
+    CacheState s0 = snapshot();   // state on entry to both paths (all loads above, no writes yet)
+    blk();  // D: done
+     blk(); // F: any failed condition -> deopt to the handler
+      // repeat(): RCX == 0 does nothing (left to the handler: rare); the fast functions take ECX, so
+      // RCX must fit 32 bits for one chunk to be the whole count
+      regGet(R_RCX); em->i64c(32); em->op(I64_SHR_U); em->i64c(0); em->op(I64_NE); em->br_if(0);
+      regGet(R_RCX); em->op(I64_EQZ); em->br_if(0);
+      // !get_DF() && !async_event
+      zaddr(ADDR(BX_CPU_THIS_PTR eflags)); em->mem(I32_LOAD, zoff(ADDR(BX_CPU_THIS_PTR eflags)), 2); em->i32c(0x400); em->op(I32_AND); em->br_if(0);
+      zaddr(ADDR(BX_CPU_THIS_PTR async_event)); em->mem(I32_LOAD, zoff(ADDR(BX_CPU_THIS_PTR async_event)), 2); em->br_if(0);
+      // byte count = ECX * g (a Bit32u in the interpreter: must not wrap)
+      regGet(R_RCX); if (g > 1) { em->i64c(g); em->op(I64_MUL); } em->set(cnt);
+      if (g > 1) { em->get(cnt); em->i64c(32); em->op(I64_SHR_U); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+      // whole count fits the rest of the destination page and the countdown
+      regGet(R_RDI); em->set(la);
+      em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->op(I64_EXTEND_I32_U); em->get(cnt); em->op(I64_ADD); em->i64c(0x1000); em->op(I64_GT_U); em->br_if(0);
+      em->get(cnt); zaddr(nanobox_pc_system_access::countdownAddr()); em->mem(I32_LOAD, zoff(nanobox_pc_system_access::countdownAddr()), 2); em->op(I64_EXTEND_I32_U); em->op(I64_GT_U); em->br_if(0);
+      // v2h_write_byte(rdi): DTLB hit with write permission; the page must be free of code marks
+      // (the interpreter would decWriteStamp the whole page and go on: leave that to it)
+      tlbProbe(la, 1, 4, 0, 0, true);
+      em->get(C_free); em->op(I32_EQZ); em->br_if(0);
+      pushHostAddr(la); em->set(hd);
+      if (movs) {
+        regGet(R_RSI); pushLaddrFromOffset(seg); em->set(sla);
+        em->get(sla); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->op(I64_EXTEND_I32_U); em->get(cnt); em->op(I64_ADD); em->i64c(0x1000); em->op(I64_GT_U); em->br_if(0);
+        tlbProbe(sla, 1, 1, 0);
+        pushHostAddr(sla); em->set(hs);
+        // the interpreter copies byte by byte, forward: with the destination inside the source span
+        // (host addresses: aliasing pages count too) that replicates rather than moves -> handler
+        em->get(hd); em->get(hs); em->op(I32_SUB); em->get(cnt); em->op(I32_WRAP_I64); em->op(I32_LT_U); em->br_if(0);
+        em->get(hd); em->get(hs); em->get(cnt); em->op(I32_WRAP_I64); em->memory_copy();
+      } else {
+        em->get(hd); regGet(R_RAX); em->op(I32_WRAP_I64); em->i32c(0xff); em->op(I32_AND); em->get(cnt); em->op(I32_WRAP_I64); em->memory_fill();
+      }
+      // BX_TICKN(iterations - 1): iterations - 1 < currCountdown here, so tickn() is a plain decrement
+      em->i32c(0); em->i32c(0); em->mem(I32_LOAD, nanobox_pc_system_access::countdownAddr(), 2);
+      regGet(R_RCX); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_SUB); em->op(I32_SUB); em->mem(I32_STORE, nanobox_pc_system_access::countdownAddr(), 2);
+      // RCX -= iterations-1, then repeat()'s RCX-- -> 0; RDI (RSI) += bytes
+      em->i64c(0); regSetFromStack(R_RCX);
+      em->get(la); em->get(cnt); em->op(I64_ADD); regSetFromStack(R_RDI);
+      if (movs) { regGet(R_RSI); em->get(cnt); em->op(I64_ADD); regSetFromStack(R_RSI); }
+      profCount(&nanobox_simd_stats[1]);
+      em->br(1);
+     endb();  // F
+     // Deopt: run the handler for this ONE instruction and REJOIN the trace, exactly like an untemplated
+     // instruction does (emitHandlerStep with cont): repeat() that completes returns into BX_NEXT_INSTR
+     // and the interpreter goes on to the next instruction of the trace, so the trace must not end
+     // here (an extra boundary would be an extra async_event/timer check point = a divergence); a
+     // repeat() interrupted mid-count restores RIP and sets STOP_TRACE, which the step's
+     // trace_end/async_event test turns into the same return the interpreter does. The runtime
+     // locals on this path are those of s0 (no fast-path write executed), so compile with s0; the
+     // step spills/invalidates, then everything the fast path holds in locals is reloaded (the
+     // handler committed the truth to memory) so both paths meet in the fast path's state.
+     CacheState sFast = snapshot();
+     restore(s0);
+     profCount(&nanobox_simd_stats[2]);
+     emitHandlerStep(k, false, true);
+     for (unsigned r = 0; r < 16; r++) if (sFast.regLoaded[r] && !cs.regLoaded[r]) { zaddr(regAddr(r)); em->mem(I64_LOAD, zoff(regAddr(r)), 3); em->set(L_reg[r]); cs.regLoaded[r] = true; }
+     if (sFast.lfLoaded && !cs.lfLoaded) lfLoad();
+     bool acmBoth = sFast.acmLoaded && cs.acmLoaded, clearedBoth = sFast.cleared && cs.cleared;
+     restore(sFast);   // dirty set: the fast path's (a superset is safe here: locals == memory on the handler path)
+     cs.acmLoaded = acmBoth; cs.cleared = clearedBoth;
+    endb();   // D
+    needAsyncCheck = true;
+    return true;
+  }
+
+  // ================================================================ misc ALU templates
+  bool emitTemplateMisc(unsigned k, bxInstruction_c *i, unsigned ia, bool R, bool last) {
+    (void) last;
+    unsigned dst = i->dst(), src = i->src(), seg = i->seg();
+    uint32_t t0 = T[0], t1 = T[1], t2 = T[2], t3 = T[3];
+    switch (ia) {
+    // ---- LEAVE (64-bit): temp = stack_read_qword(RBP); RSP = RBP + 8; RBP = temp
+    case BX_IA_LEAVE_Op64:
+      if (!realHandler(k, &BX_CPU_C::LEAVE64)) return false;
+      regGet(R_RBP); em->set(t0);
+      emitStackRead(k, t0); em->set(t1);
+      em->get(t0); em->i64c(8); em->op(I64_ADD); regSetFromStack(R_RSP);
+      em->get(t1); regSetFromStack(R_RBP);
+      return true;
+    // ---- MUL r/m64: RDX:RAX = RAX * op; SET_FLAGS_OSZAPC_LOGIC_64(lo); hi != 0 -> assert_flags_OxxxxC
+    case BX_IA_MUL_RAXEq: {
+      if (!realHandler(k, R ? &BX_CPU_C::MUL_RAXEqR : &BX_CPU_C::LOAD_Eq)) return false;
+      if (!R && i->execute2() != &BX_CPU_C::MUL_RAXEqR) return false;
+      uint32_t a = t0, b = t1, lo = t2, hi = t3;
+      if (R) regGet(src); else { pushEA(k); em->set(T[4]); emitRead(k, MK_RD_LIN, seg, 8, T[4]); }
+      em->set(b);
+      regGet(R_RAX); em->set(a);
+      em->get(a); em->get(b); em->op(I64_MUL); em->set(lo);
+      emitMulhu(a, b, hi);
+      em->get(lo); regSetFromStack(R_RAX);
+      em->get(hi); regSetFromStack(R_RDX);
+      setFlagsLogic(8, lo);
+      em->get(hi); em->i64c(0); em->op(I64_NE);
+      iff(); assertFlagsOxxxxC(); endb();
+      return true;
+    }
+    // ---- BSF / BSR (32/64, register or LOAD_E* memory source)
+    case BX_IA_BSF_GqEq: case BX_IA_BSF_GdEd: case BX_IA_BSR_GqEq: case BX_IA_BSR_GdEd: {
+      unsigned size = (ia == BX_IA_BSF_GqEq || ia == BX_IA_BSR_GqEq) ? 8 : 4;
+      bool fwd = (ia == BX_IA_BSF_GqEq || ia == BX_IA_BSF_GdEd);
+      BxExecutePtr_tR hr = (ia == BX_IA_BSF_GqEq) ? &BX_CPU_C::BSF_GqEqR : (ia == BX_IA_BSF_GdEd) ? &BX_CPU_C::BSF_GdEdR :
+                           (ia == BX_IA_BSR_GqEq) ? &BX_CPU_C::BSR_GqEqR : &BX_CPU_C::BSR_GdEdR;
+      if (R) { if (!realHandler(k, hr)) return false; }
+      else { if (!realHandler(k, size == 8 ? &BX_CPU_C::LOAD_Eq : &BX_CPU_C::LOAD_Ed) || i->execute2() != hr) return false; }
+      uint32_t op2 = t0, res = t1;
+      if (R) { if (size == 8) regGet(src); else pushReg32(src); }
+      else { pushEA(k); em->set(t3); emitRead(k, size == 8 ? MK_RD_LIN : MK_RD_VIRT, seg, size, t3); }
+      em->set(op2);
+      // both outcomes touch the flags (assert_ZF reads the prior state), only one writes dst
+      lfLoad(); regEnsureLoaded(dst);
+      em->get(op2); em->op(I64_EQZ);
+      iff();
+        // assert_ZF(): aux ^= ((result >> 63) & 1) << SD; aux ^= (result & 255) << PDB; result = 0
+        em->get(L_lfa); em->get(L_lfr); em->i64c(63); em->op(I64_SHR_U); em->i64c(1); em->op(I64_AND); em->op(I64_XOR);
+        em->get(L_lfr); em->i64c(255); em->op(I64_AND); em->i64c(8); em->op(I64_SHL); em->op(I64_XOR); em->set(L_lfa);
+        em->i64c(0); em->set(L_lfr);
+      els();
+        if (size == 8) { em->get(op2); em->op(fwd ? I64_CTZ : I64_CLZ); }
+        else { em->get(op2); em->op(I32_WRAP_I64); em->op(fwd ? I32_CTZ : I32_CLZ); em->op(I64_EXTEND_I32_U); }
+        em->set(res);
+        if (!fwd) { em->i64c(size * 8 - 1); em->get(res); em->op(I64_SUB); em->set(res); }   // BSR: index of the highest set bit = bits-1-clz
+        // SET_FLAGS_OSZAPC_LOGIC(res) then clear_ZF(): result |= 0x100
+        em->get(res); if (size == 4) em->op(I64_EXTEND32_S); em->i64c(0x100); em->op(I64_OR); em->set(L_lfr);
+        em->i64c(0); em->set(L_lfa);
+        em->get(res); regSetFromStack(dst);   // 32-bit: BX_WRITE_32BIT_REGZ (res < 32 -> already zero-extended)
+      endb();
+      lfMarkSet(); cs.regDirty[dst] = true;
+      return true;
+    }
+    // ---- INC/DEC r/m8: SET_FLAGS_OSZAP_{ADD,SUB}_8(op1 -/+ 1, 0, op1)
+    case BX_IA_INC_Eb: case BX_IA_DEC_Eb: {
+      bool dec = (ia == BX_IA_DEC_Eb);
