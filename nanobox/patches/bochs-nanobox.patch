+    case SK_MOVQ_EqVq:
+      em->i32c(0); em->mem(I64_LOAD, xmmAddr(i->src()), 3); regSetFromStack(dst);
+      return true;
+    case SK_VPBROADCASTB: {
+      unsigned s = i->src();
+      if (d.ld == SL_WB) s = emitSimdLoadPrefix(k, d, vl, s);
