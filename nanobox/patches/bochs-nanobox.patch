+    }
+
+    // ---- ROL/ROR by immediate, register destination
+    case BX_IA_ROL_EqIb: case BX_IA_ROL_EdIb: case BX_IA_ROR_EqIb: case BX_IA_ROR_EdIb: {
+      if (!R) return false;
+      unsigned size = (ia == BX_IA_ROL_EqIb || ia == BX_IA_ROR_EqIb) ? 8 : 4;
