+      int kind = (ia == BX_IA_SHL_EwIb || ia == BX_IA_SHL_EwI1 || ia == BX_IA_SHL_Ew || ia == BX_IA_SHL_EbIb || ia == BX_IA_SHL_EbI1 || ia == BX_IA_SHL_Eb) ? 0 :
+                 (ia == BX_IA_SHR_EwIb || ia == BX_IA_SHR_EwI1 || ia == BX_IA_SHR_Ew || ia == BX_IA_SHR_EbIb || ia == BX_IA_SHR_EbI1 || ia == BX_IA_SHR_Eb) ? 1 : 2;
+      bool useCL = (ia == BX_IA_SHL_Ew || ia == BX_IA_SHR_Ew || ia == BX_IA_SAR_Ew || ia == BX_IA_SHL_Eb || ia == BX_IA_SHR_Eb || ia == BX_IA_SAR_Eb);
