+      switch (op) {
+        case A_ADD: em->op(I64_ADD); break;
+        case A_SUB: em->op(I64_SUB); break;
+        case A_AND: em->op(I64_AND); break;
+        case A_OR:  em->op(I64_OR);  break;
+        case A_XOR: em->op(I64_XOR); break;
