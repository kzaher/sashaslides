+  // region mode (reg != NULL): the function holds reg->nblocks blocks; block j's instruction k
+  // lives at linear address L_base + b[j].boff + off[k], where L_base is the entry block's start
+  Region *reg;
+  unsigned curBlock;
+  Bit32s boff;           // current block's offset from the entry block start (0 for single traces; negative in the previous page)
+  int dispatchDepth;     // depth just inside the dispatch loop
+  uint32_t L_cur;        // block index for the dispatch br_table
+  uint32_t L_regp;       // region descriptor pointer (loaded from the entry descriptor in the prologue)
+  // A3: registers/flags stay in wasm locals across in-region transitions. Every block j has a fixed
+  // entry state D_j = the registers/flags it touches (found in a dry-run pass); each transition
