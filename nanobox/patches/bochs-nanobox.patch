+  // linear address of an access whose offset is in `off_l`: for segments without a base the
+  // offset IS the linear address, so the copy into T[5] (2 ops on every memory access) is skipped
+  uint32_t laLocal(unsigned seg, uint32_t off_l) {
+    if (seg < SEG_FS) return off_l;
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    return T[5];
+  }
+  // Read `size` bytes for instruction k. Offset (i64) is in local `off_l`; kind selects the slow
+  // path accessor. Result: i64 zero-extended value on the stack.
+  void emitRead(unsigned k, MemKind kind, unsigned seg, unsigned size, uint32_t off_l) {
+    const uint32_t la = laLocal(seg, off_l);
+    blk(I64);
+      blk();
+        tlbProbe(la, size, 1, 0);
+        pushHostAddr(la, nanobox_tlbfold && size > 1); em->mem(loadOp(size), 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      const char *sig; uint32_t f = accessorRead(kind, size, sig);
+      em->i32c(seg);
+      if (kind == MK_RD_LIN || kind == MK_RMW_LIN) em->get(la); else em->get(off_l);
+      em->call(fn(f, sig));
+      if (size != 8) em->op(I64_EXTEND_I32_U);
+    endb();
+    needAsyncCheck = true;
+  }
+  void profSlow() {
+    if (nanobox_jit_level >= 3) { em->i32c(0); em->i32c(0); em->mem(I64_LOAD, ADDR(nanobox_stats.jit_slow), 3); em->i64c(1); em->op(I64_ADD); em->mem(I64_STORE, ADDR(nanobox_stats.jit_slow), 3); }
+  }
+  // Write value in local val_l (i64) with `size` bytes at offset off_l for instruction k.
+  void emitWrite(unsigned k, MemKind kind, unsigned seg, unsigned size, uint32_t off_l, uint32_t val_l) {
+    const uint32_t la = laLocal(seg, off_l);
+    blk();
+      blk();
+        tlbProbe(la, size, 4, 0, size);
+        if (!nanobox_tlbfold) emitWriteStamp(la, size); else needAsyncCheck = true;
+        pushHostAddr(la, nanobox_tlbfold && size > 1); em->get(val_l); em->mem(storeOp(size), 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      const char *sig; uint32_t f = accessorWrite(kind, size, sig);
+      em->i32c(seg);
+      if (kind == MK_WR_LIN) em->get(la); else em->get(off_l);
+      em->get(val_l); if (size != 8) em->op(I32_WRAP_I64);
+      em->call(fn(f, sig));
+    endb();
+    needAsyncCheck = true;
+  }
+  // Stack read (stack_read_qword semantics): offset in off_l -> value (i64) on stack
+  bool aotNoStack() const { return nanobox_jit_aot != 0 && nanobox_jit_aot_nostack != 0; }
+  // CALL: (rsp_after, return VA) -> the host shadow stack. Two stores and an index bump, no TLB
+  // probe, no write stamp, and nothing written into emulated RAM.
+  void emitShadowPush(uint32_t rsp_l, uint32_t rip_l) {
+    uint32_t idx = T32[3];
+    em->i32c(0); em->mem(I32_LOAD, ADDR(nanobox_shadow_n), 2); em->set(idx);
+    em->get(idx); em->i32c(NB_SHADOW_MAX - 1); em->op(I32_LT_U);
+    iff();
+      em->get(idx); em->i32c(4); em->op(I32_SHL); em->i32c(ADDR(nanobox_shadow[0])); em->op(I32_ADD); em->set(idx);
+      em->get(idx); em->get(rsp_l); em->mem(I64_STORE, 0, 3);
+      em->get(idx); em->get(rip_l); em->mem(I64_STORE, 8, 3);
+      em->i32c(0); em->i32c(0); em->mem(I32_LOAD, ADDR(nanobox_shadow_n), 2); em->i32c(1); em->op(I32_ADD); em->mem(I32_STORE, ADDR(nanobox_shadow_n), 2);
+    endb();
+  }
+  // RET: take the top entry when the guest's rsp is the one the matching CALL left behind. A
+  // mismatch (the guest moved the stack under us: longjmp, an unwinder, a hand-rolled return) is
+  // counted and falls back to reading emulated RAM -- where, in this mode, the address was never
+  // written, so the counter is the signal that this program needs the pushes.
+  void emitShadowPop(unsigned k, uint32_t rsp_l, uint32_t out_l) {
+    uint32_t idx = T32[3];
+    em->i64c(0); em->set(out_l);
+    em->i32c(0); em->mem(I32_LOAD, ADDR(nanobox_shadow_n), 2); em->set(idx);
+    em->get(idx);
+    iff();
+      em->get(idx); em->i32c(1); em->op(I32_SUB); em->set(idx);
+      em->i32c(0); em->get(idx); em->mem(I32_STORE, ADDR(nanobox_shadow_n), 2);
+      em->get(idx); em->i32c(4); em->op(I32_SHL); em->i32c(ADDR(nanobox_shadow[0])); em->op(I32_ADD); em->set(idx);
+      em->get(idx); em->mem(I64_LOAD, 0, 3); em->get(rsp_l); em->op(I64_EQ);
+      iff();
+        em->get(idx); em->mem(I64_LOAD, 8, 3); em->set(out_l);
+      els();
+        em->i32c(0); em->i32c(0); em->mem(I64_LOAD, ADDR(nanobox_shadow_miss), 3); em->i64c(1); em->op(I64_ADD); em->mem(I64_STORE, ADDR(nanobox_shadow_miss), 3);
