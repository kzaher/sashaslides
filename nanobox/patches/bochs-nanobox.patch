+// per-opcode template statistics (which opcodes fall back), for the harness
+static Bit32u nanobox_fallback_count[BX_IA_LAST];
+static Bit32u nanobox_inline_count[BX_IA_LAST];
+// dynamic (execution) counts, only maintained when nanobox_jit_level >= 3 (profiling mode)
+static Bit64u nanobox_dyn_inline[BX_IA_LAST];
+static Bit64u nanobox_dyn_fallback[BX_IA_LAST];
+// static bytes of wasm emitted by the template of each opcode, summed over its compiled instances
+// (bytes track wasm ops closely enough to rank templates by cost: bytes/instance x executions)
+static Bit64u nanobox_tpl_bytes[BX_IA_LAST];
+// ---- emitted-byte accounting by PHASE (work/j/ops): which part of a site the bytes are in.
+// Phases nest (a probe inside a template inside a body); phPush/phPop attribute the bytes to the
+// innermost phase active when they were emitted, so the columns sum to the module's code size.
+enum { PH_OTHER = 0, PH_PROLOGUE, PH_PROBE_FAST, PH_PROBE_MISS, PH_SLOW, PH_SPILL, PH_EXIT,
+       PH_HANDLER, PH_DCALL, PH_ASYNC, PH_STAMP, PH_LINK, PH_ACCESS, PH_EA, PH_PROF,
+       PH_TRANS, PH_SPILL_COLD, PH_TAIL, PH_REG, PH_FLAGS, PH_CONFORM, PH_WRAP,
+       PH_SPILL_ASYNC, PH_N };
+static Bit64u nanobox_phase_bytes[PH_N];
+static Bit64u nanobox_phase_pass[PH_N];   // this pass only: added to the total when the pass is the final one
+// ---- the same phases, split by the GUEST OPCODE whose template emitted them (work/j/faultarm).
+// This is what answers "how many of MOV_GqEq's 120 bytes are the fault arm and how many are the
+// access?": the flat table above is a whole-module average and cannot. Pure accounting -- it emits
+// nothing, and every emitted byte is bit-identical with it compiled in.
+// Only the FINAL pass counts, exactly as above, so the pass is buffered as (opcode, phase, bytes)
+// records and replayed on a keeping flush rather than clearing a BX_IA_LAST x PH_N array per pass.
+#define NB_PHOP_NONE BX_IA_LAST
+static Bit64u nanobox_phase_op_bytes[BX_IA_LAST + 1][PH_N + 1];   // [.][PH_N] = instances counted on the FINAL pass only
+static unsigned nanobox_ph_ia = NB_PHOP_NONE;   // the opcode currently being emitted
+struct NbPhRec { Bit16u ia; Bit8u ph; Bit32u b; };
+#define NB_PHREC_MAX (1u << 16)
+static NbPhRec nanobox_ph_rec[NB_PHREC_MAX];
+static unsigned nanobox_ph_rec_n = 0;
+static Bit64u nanobox_ph_rec_drop = 0;
+static BX_CPP_INLINE void nanobox_phase_add(unsigned ph, Bit32u b)
+{
+  nanobox_phase_pass[ph] += b;
+  if (nanobox_ph_rec_n < NB_PHREC_MAX) { NbPhRec &r = nanobox_ph_rec[nanobox_ph_rec_n++]; r.ia = (Bit16u) nanobox_ph_ia; r.ph = (Bit8u) ph; r.b = b; }
+  else nanobox_ph_rec_drop += b;
+}
+// one guest instruction of `ia` emitted on this pass. --tpl-bytes' instance count is bumped on
+// EVERY pass, so bytes/site from it is a pass-1+pass-2 sum (10.9 MB against the 7.3 MB installed);
+// the phase table needs a final-pass-only denominator to be comparable with itself.
+static BX_CPP_INLINE void nanobox_phase_inst(unsigned ia)
+{
+  if (nanobox_ph_rec_n < NB_PHREC_MAX) { NbPhRec &r = nanobox_ph_rec[nanobox_ph_rec_n++]; r.ia = (Bit16u) ia; r.ph = (Bit8u) PH_N; r.b = 1; }
+}
+static const char *nanobox_phase_name(unsigned i) {
+  static const char *nm[PH_N] = { "other", "prologue", "probe-fast", "probe-miss", "slow-arm", "spill",
+                                  "exit", "handler-step", "direct-call", "async-check", "write-stamp",
+                                  "link-epilogue", "access", "eff-addr", "profile-ctr",
+                                  "transition", "spill-fault", "common-tail",
+                                  "reg-load", "lazy-flags", "conform", "tpl-wrapper",
+                                  "spill-async" };
+  return i < PH_N ? nm[i] : "?";
+}
+static void nanobox_phase_flush(bool keep) {
+  for (unsigned i = 0; i < PH_N; i++) { if (keep) nanobox_phase_bytes[i] += nanobox_phase_pass[i]; nanobox_phase_pass[i] = 0; }
+  if (keep) for (unsigned j = 0; j < nanobox_ph_rec_n; j++) nanobox_phase_op_bytes[nanobox_ph_rec[j].ia][nanobox_ph_rec[j].ph] += nanobox_ph_rec[j].b;
+  nanobox_ph_rec_n = 0;
+}
+NB_EXPORT(nanobox_jit_phase_stat) double nanobox_jit_phase_stat(unsigned i) { return i < PH_N ? (double) nanobox_phase_bytes[i] : 0; }
+NB_EXPORT(nanobox_jit_phase_name) const char *nanobox_jit_phase_name(unsigned i) { return nanobox_phase_name(i); }
+NB_EXPORT(nanobox_jit_phase_n) unsigned nanobox_jit_phase_n(void) { return PH_N; }
+NB_EXPORT(nanobox_jit_phase_op) double nanobox_jit_phase_op(unsigned ia, unsigned ph)
+{ return (ia <= NB_PHOP_NONE && ph <= PH_N) ? (double) nanobox_phase_op_bytes[ia][ph] : 0; }
+NB_EXPORT(nanobox_jit_phase_drop) double nanobox_jit_phase_drop(void) { return (double) nanobox_ph_rec_drop; }
+NB_EXPORT(nanobox_jit_opstat) double nanobox_jit_opstat(unsigned ia, unsigned which)
+{
+  if (ia >= BX_IA_LAST) return 0;
+  switch (which) {
+    case 0: return nanobox_fallback_count[ia];
+    case 1: return nanobox_inline_count[ia];
+    case 2: return (double) nanobox_dyn_fallback[ia];
+    case 4: return (double) nanobox_tpl_bytes[ia];
+    default: return (double) nanobox_dyn_inline[ia];
+  }
+}
+NB_EXPORT(nanobox_jit_opname) const char *nanobox_jit_opname(unsigned ia)
+{
+  if (ia >= BX_IA_LAST) return "";
+  return get_bx_opcode_name((Bit16u) ia);
+}
+NB_EXPORT(nanobox_jit_nops) unsigned nanobox_jit_nops(void) { return BX_IA_LAST; }
