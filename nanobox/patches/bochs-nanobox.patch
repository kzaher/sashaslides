+      case BX_IA_TEST_RAXId: op = A_TEST; size = 8; form = 3; break;
+      case BX_IA_TEST_EdGd: op = A_TEST; size = 4; form = 1; break;
+      case BX_IA_TEST_EdId: case BX_IA_TEST_EdsIb: op = A_TEST; size = 4; form = 2; break;
+      case BX_IA_TEST_EAXId: op = A_TEST; size = 4; form = 3; break;
+      case BX_IA_TEST_EwGw: op = A_TEST; size = 2; form = 1; break;
+      case BX_IA_TEST_EwIw: case BX_IA_TEST_EwsIb: op = A_TEST; size = 2; form = 2; break;
+      case BX_IA_TEST_AXIw: op = A_TEST; size = 2; form = 3; break;
+      case BX_IA_TEST_EbGb: op = A_TEST; size = 1; form = 1; break;
+      case BX_IA_TEST_EbIb: op = A_TEST; size = 1; form = 2; break;
