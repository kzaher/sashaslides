+        em->set(op1);
+        if (size == 8) { em->get(op1); em->get(cnt); em->op(rol ? I64_ROTL : I64_ROTR); }
+        else { em->get(op1); em->op(I32_WRAP_I64); em->get(cnt); em->op(I32_WRAP_I64); em->op(rol ? I32_ROTL : I32_ROTR); em->op(I64_EXTEND_I32_U); }
