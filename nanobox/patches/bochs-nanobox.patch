+      if (d.kind == SK_MOVD_R) pushReg32(i->src()); else { pushEA(k); em->set(T[3]); emitRead(k, MK_RD_VIRT, seg, 4, T[3]); }
+      em->set(T[2]);
+      em->i32c(0); em->get(T[2]); em->mem(I64_STORE, xmmAddr(dst), 3);
+      em->i32c(0); em->i64c(0); em->mem(I64_STORE, xmmAddr(dst) + 8, 3);
+      if (vl) { em->i32c(0); em->v128_zero(); em->v128_store(xmmAddr(dst, 1), 4); }
+      return true;
+    }
+    case SK_MOVD_ST:
+      if (d.op == 0) { em->i32c(0); em->mem(I64_LOAD32_U, xmmAddr(i->src()), 2); regSetFromStack(dst); return true; }   // BX_WRITE_32BIT_REGZ
+      pushEA(k); em->set(T[3]); em->i32c(0); em->mem(I64_LOAD32_U, xmmAddr(i->src()), 2); em->set(T[2]);
+      emitWrite(k, MK_WR_VIRT, seg, 4, T[3], T[2]);
