+      unsigned size = (ia == BX_IA_ROL_Eq || ia == BX_IA_ROR_Eq) ? 8 : 4;
+      bool rol = (ia == BX_IA_ROL_Eq || ia == BX_IA_ROL_Ed);
+      uint32_t op1 = T[0], res = T[1], cnt = T[2]; uint32_t cf = T32[3], of = T32[4];
