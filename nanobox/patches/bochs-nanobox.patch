+  // Emit the DTLB probe for the linear address in local `la` and access `bit` (1=read, 4=write).
+  // On success leaves the TLB entry pointer in T32[0] and falls through; on failure branches to
+  // `slowDepth`.
+  void tlbProbe(uint32_t la, unsigned size, unsigned bit, uint32_t slowDepth, unsigned stampSize = 0) {
+    const bool fold = (nanobox_tlbfold != 0);
+    const uint32_t tagC = (bit == 4) ? C_tagW : C_tagR;
+    const uint32_t tagD = (bit == 4) ? D_tagW : D_tagR;
+    // Page cache: same page as the last successful probe, access fits the page, permission bit
+    // present, and no alignment check pending -> reuse (skips the TLB entry lookup entirely).
+    blk(); // O: ends after the full probe; a cache hit branches here directly
+      blk(); // A: cache checks; any failure leaves A and runs the full probe
+        if (fold) {
+          // one compare covers page identity + permission + acm (+ write-stamp freedom)
+          em->get(la); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_AND); em->get(tagC); em->op(I64_NE); em->br_if(0);
+          if (size > 1) { em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->tee(P_off); em->i32c(0x1000 - size); em->op(I32_GT_U); em->br_if(0); }
+        } else {
+          em->get(la); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_AND); em->get(C_lpf); em->op(I64_NE); em->br_if(0);
+          if (size > 1) {
+            em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->i32c(0x1000 - size); em->op(I32_GT_U); em->br_if(0);
+            acmGet(); em->i64c(size - 1); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0);
+          }
+          em->get(C_bits); em->i32c(bit); em->get(L_upl); em->op(I32_SHL); em->op(I32_AND); em->op(I32_EQZ); em->br_if(0);
+        }
+        profCount(&nanobox_flags_stats[FD_PROBE_C]);
+        em->br(1); // hit
+      endb();
+      if (nanobox_jit_probe2) {
+        // second entry: same page + span + permission -> swap it to the front and count it as a hit
+        blk();
+          if (fold) {
+            em->get(la); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_AND); em->get(tagD); em->op(I64_NE); em->br_if(0);
+            if (size > 1) { em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->tee(P_off); em->i32c(0x1000 - size); em->op(I32_GT_U); em->br_if(0); }
+          } else {
+            em->get(la); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_AND); em->get(D_lpf); em->op(I64_NE); em->br_if(0);
+            if (size > 1) {
+              em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->i32c(0x1000 - size); em->op(I32_GT_U); em->br_if(0);
+              acmGet(); em->i64c(size - 1); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0);
+            }
+            em->get(D_bits); em->i32c(bit); em->get(L_upl); em->op(I32_SHL); em->op(I32_AND); em->op(I32_EQZ); em->br_if(0);
+          }
+          swapProbeEntries();
+          profCount(&nanobox_flags_stats[FD_PROBE_D]);
+          em->br(1); // hit (entry 2 promoted)
+        endb();
+      }
+      profCount(&nanobox_flags_stats[FD_PROBE_FULL]);
