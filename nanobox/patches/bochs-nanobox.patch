+//  License along with this library; if not, write to the Free Software
+//  Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA B 02110-1301 USA
+//
+/////////////////////////////////////////////////////////////////////////
+
+#define NEED_CPU_REG_SHORTCUTS 1
+#include "bochs.h"
+#include "cpu.h"
+#define LOG_THIS BX_CPU_THIS_PTR
+
+#include "gui/siminterface.h"
+#include "param_names.h"
+#include "cpustats.h"
+#include "../nanobox_jit.h"
+
+#include "decoder/ia_opcodes.h"
+
+bxPageWriteStampTable pageWriteStampTable;
+bool nanobox_marks_private = false;
+
+extern int fetchDecode32(const Bit8u *fetchPtr, bool is_32, bxInstruction_c *i, unsigned remainingInPage);
+#if BX_SUPPORT_X86_64
+extern int fetchDecode64(const Bit8u *fetchPtr, bxInstruction_c *i, unsigned remainingInPage);
+#endif
+extern int assignHandler(bxInstruction_c *i, Bit32u fetchModeMask);
+
+void flushICaches(void)
+{
+  for (unsigned i=0; i<BX_SMP_PROCESSORS; i++) {
+    BX_CPU(i)->iCache.flushICacheEntries();
+    BX_CPU(i)->async_event |= BX_ASYNC_EVENT_STOP_TRACE;
+  }
+
+  pageWriteStampTable.resetWriteStamps();
+}
+
+extern "C" void nanobox_smc_account(Bit64u pAddr, Bit32u mask);
+void nanobox_jit_page_written(bx_phy_address pAddr, Bit32u mask);
+void handleSMC(bx_phy_address pAddr, Bit32u mask)
+{
+  INC_SMC_STAT(smc);
+  nanobox_smc_account(pAddr, mask); // nanobox: SMC profile
+  nanobox_jit_page_written(pAddr, mask); // nanobox: two-page regions attached to this page
+
+  // nanobox AOT: the trace stops only where the reference interpreter's would (its own marks); code
+  // decoded ahead by the JIT is invalidated below all the same
+  bool refHit = (pageWriteStampTable.getRefMapping(pAddr) & mask) != 0;
+  for (unsigned i=0; i<BX_SMP_PROCESSORS; i++) {
+    if (refHit) BX_CPU(i)->async_event |= BX_ASYNC_EVENT_STOP_TRACE;
+    BX_CPU(i)->iCache.handleSMC(pAddr, mask);
+  }
+}
+
+#if BX_SUPPORT_HANDLERS_CHAINING_SPEEDUPS
+
+void BX_CPU_C::BxEndTrace(bxInstruction_c *i)
+{
+  // do nothing, return to main cpu_loop
+}
+
+void genDummyICacheEntry(bxInstruction_c *i)
+{
+  i->setILen(0);
+  i->setIaOpcode(BX_INSERTED_OPCODE);
+  i->execute1 = &BX_CPU_C::BxEndTrace;
+}
+
+#endif
+
+extern unsigned nanobox_jit_aot;
+extern unsigned nanobox_jit_aot_detform;
+bxICacheEntry_c* BX_CPU_C::serveICacheMiss(Bit32u eipBiased, bx_phy_address pAddr)
+{
+  bxICacheEntry_c *entry = BX_CPU_THIS_PTR iCache.get_entry(pAddr, BX_CPU_THIS_PTR fetchModeMask);
+
+  BX_CPU_THIS_PTR iCache.alloc_trace(entry, pAddr);
+
+  // Cache miss. We weren't so lucky, but let's be optimistic - try to build
+  // trace from incoming instruction bytes stream !
+  entry->pAddr = pAddr;
+  entry->traceMask = 0;
+  entry->nbahead = nanobox_marks_private ? 1 : 0;   // nanobox AOT: decoded ahead of execution?
+
+  unsigned remainingInPage = BX_CPU_THIS_PTR eipPageWindowSize - eipBiased;
+  const Bit8u *fetchPtr = BX_CPU_THIS_PTR eipFetchPtr + eipBiased;
+  int ret;
+
+  bxInstruction_c *i = entry->i;
+
+  Bit32u pageOffset = PAGE_OFFSET((Bit32u) pAddr);
+  Bit32u traceMask = 0;
+
+#if BX_SUPPORT_SMP == 0
+  if (PPFOf(pAddr) == BX_CPU_THIS_PTR pAddrStackPage)
+    invalidate_stack_cache();
+#endif
+
+  // Don't allow traces longer than cpu_loop can execute
+  static unsigned quantum =
+#if BX_SUPPORT_SMP
+    (BX_SMP_PROCESSORS > 1) ? SIM->get_param_num(BXPN_SMP_QUANTUM)->get() :
+#endif
+    BX_MAX_TRACE_LENGTH;
+
+  for (unsigned n=0;n < quantum;n++)
+  {
+    // nanobox: the decoder only writes the fields an instruction needs; the rest of the pool slot
+    // keeps stale bytes from earlier decodes, which made the JIT's content keys (a hash of the
+    // decoded instruction) depend on execution history. Start from a clean slot.
+    memset((void *) i, 0, sizeof(bxInstruction_c));
+#if BX_SUPPORT_X86_64
+    if (BX_CPU_THIS_PTR cpu_mode == BX_MODE_LONG_64)
+      ret = fetchDecode64(fetchPtr, i, remainingInPage);
+    else
+#endif
+      ret = fetchDecode32(fetchPtr, BX_CPU_THIS_PTR sregs[BX_SEG_REG_CS].cache.u.segment.d_b, i, remainingInPage);
+
+    if (ret < 0) {
+      // Fetching instruction on segment/page boundary
+      if (n > 0) {
+         // The trace is already valid, it has several instructions inside,
+         // in this case just drop the boundary instruction and stop
+         // tracing.
+         break;
+      }
+      // First instruction is boundary fetch, leave the trace cache entry
+      // invalid for now because boundaryFetch() can fault
+      entry->pAddr = ~entry->pAddr;
+      entry->tlen = 1;
+      boundaryFetch(fetchPtr, remainingInPage, i);
+
+      // Add the instruction to trace cache
+      entry->pAddr = ~entry->pAddr;
+      entry->traceMask = 0x80000000; /* last line in page */
+      pageWriteStampTable.markICacheMask(entry->pAddr, entry->traceMask);
+      pageWriteStampTable.markICacheMask(BX_CPU_THIS_PTR pAddrFetchPage, 0x1);
+
+#if BX_SUPPORT_HANDLERS_CHAINING_SPEEDUPS
+      entry->tlen++; /* Add the inserted end of trace opcode */
+      genDummyICacheEntry(++i);
+#endif
+
+      BX_CPU_THIS_PTR iCache.commit_page_split_trace(BX_CPU_THIS_PTR pAddrFetchPage, entry);
+      nanobox_jit_after_decode(entry);
+      return entry;
+    }
+
+    ret = assignHandler(i, BX_CPU_THIS_PTR fetchModeMask);
+
+    // add instruction to the trace
+    unsigned iLen = i->ilen();
+    entry->tlen++;
+
+#ifdef BX_INSTR_STORE_OPCODE_BYTES
+    i->set_opcode_bytes(fetchPtr);
+#endif
+    BX_INSTR_OPCODE(BX_CPU_ID, i, fetchPtr, iLen,
+       BX_CPU_THIS_PTR sregs[BX_SEG_REG_CS].cache.u.segment.d_b, long64_mode());
+
+    i++;
+
+    traceMask |= 1 <<  (pageOffset >> 7);
+    traceMask |= 1 << ((pageOffset + iLen - 1) >> 7);
+
+    // continue to the next instruction
+    remainingInPage -= iLen;
+    if (ret != 0 /* stop trace indication */ || remainingInPage == 0) break;
+    pAddr += iLen;
+    pageOffset += iLen;
+    fetchPtr += iLen;
+
+    // try to find a trace starting from current pAddr and merge
+    // nanobox AOT (deterministic formation, bit 8): merging splices in whatever trace the iCache happens
+    // to hold at the next address, and when the two together reach BX_MAX_TRACE_LENGTH the result is a
+    // SHORTER trace than a fresh decode of the same bytes -- so the decoded trace at an address becomes
+    // a function of the cache's history. The default engine is untouched (identity depends on these
+    // boundaries).
+    if (remainingInPage >= 15 && !(nanobox_jit_aot && (nanobox_jit_aot_detform & 8))) { // avoid merging with page split trace
+      if (mergeTraces(entry, i, pAddr)) {
+          entry->traceMask |= traceMask;
+          pageWriteStampTable.markICacheMask(pAddr, entry->traceMask);
+          BX_CPU_THIS_PTR iCache.commit_trace(entry->tlen);
+          nanobox_jit_after_decode(entry);
+          return entry;
+      }
+    }
+  }
+
+//BX_INFO(("commit trace %08x len=%d mask %08x", (Bit32u) entry->pAddr, entry->tlen, pageWriteStampTable.getFineGranularityMapping(entry->pAddr)));
+
+  entry->traceMask |= traceMask;
+
+  pageWriteStampTable.markICacheMask(pAddr, entry->traceMask);
+
+#if BX_SUPPORT_HANDLERS_CHAINING_SPEEDUPS
+  entry->tlen++; /* Add the inserted end of trace opcode */
+  genDummyICacheEntry(i);
+#endif
+
+  BX_CPU_THIS_PTR iCache.commit_trace(entry->tlen);
+
+  nanobox_jit_after_decode(entry);
+  return entry;
+}
+
+bool BX_CPU_C::mergeTraces(bxICacheEntry_c *entry, bxInstruction_c *i, bx_phy_address pAddr)
+{
+  bxICacheEntry_c *e = BX_CPU_THIS_PTR iCache.find_entry(pAddr, BX_CPU_THIS_PTR fetchModeMask);
+
+  if (e != NULL)
+  {
+    // determine max amount of instruction to take from another entry
+    unsigned max_length = e->tlen;
+
+#if BX_SUPPORT_HANDLERS_CHAINING_SPEEDUPS
+    if (max_length + entry->tlen > BX_MAX_TRACE_LENGTH)
+        return 0;
+#else
+    if (max_length + entry->tlen > BX_MAX_TRACE_LENGTH)
+        max_length = BX_MAX_TRACE_LENGTH - entry->tlen;
+    if(max_length == 0) return 0;
+#endif
+
+    memcpy(i, e->i, sizeof(bxInstruction_c)*max_length);
+    entry->tlen += max_length;
+    BX_ASSERT(entry->tlen <= BX_MAX_TRACE_LENGTH);
+
+    entry->traceMask |= e->traceMask;
+
+    return 1;
+  }
+
+  return 0;
+}
+
+void BX_CPU_C::boundaryFetch(const Bit8u *fetchPtr, unsigned remainingInPage, bxInstruction_c *i)
+{
+  unsigned j, k;
+  Bit8u fetchBuffer[32];
+  int ret;
+
+  if (remainingInPage >= 15) {
+    BX_ERROR(("boundaryFetch #GP(0): too many instruction prefixes"));
+    exception(BX_GP_EXCEPTION, 0);
+  }
+
+  // Read all leftover bytes in current page up to boundary.
+  for (j=0; j<remainingInPage; j++) {
+    fetchBuffer[j] = *fetchPtr++;
+  }
+
+  // The 2nd chunk of the instruction is on the next page.
+  // Set RIP to the 0th byte of the 2nd page, and force a
+  // prefetch so direct access of that physical page is possible, and
+  // all the associated info is updated.
+  RIP += remainingInPage;
+  prefetch();
+
+  unsigned fetchBufferLimit = 15;
+  if (BX_CPU_THIS_PTR eipPageWindowSize < 15) {
+    BX_DEBUG(("boundaryFetch: small window size after prefetch=%d bytes, remainingInPage=%d bytes", BX_CPU_THIS_PTR eipPageWindowSize, remainingInPage));
+    fetchBufferLimit = BX_CPU_THIS_PTR eipPageWindowSize;
+  }
+
+  // We can fetch straight from the 0th byte, which is eipFetchPtr;
+  fetchPtr = BX_CPU_THIS_PTR eipFetchPtr;
+
+  // read leftover bytes in next page
+  for (k=0; k<fetchBufferLimit; k++, j++) {
+    fetchBuffer[j] = *fetchPtr++;
+  }
+
+  memset((void *) i, 0, sizeof(bxInstruction_c)); // nanobox: see above
+#if BX_SUPPORT_X86_64
+  if (BX_CPU_THIS_PTR cpu_mode == BX_MODE_LONG_64)
+    ret = fetchDecode64(fetchBuffer, i, remainingInPage+fetchBufferLimit);
+  else
+#endif
+    ret = fetchDecode32(fetchBuffer, BX_CPU_THIS_PTR sregs[BX_SEG_REG_CS].cache.u.segment.d_b, i, remainingInPage+fetchBufferLimit);
+
+  if (ret < 0) {
+    BX_INFO(("boundaryFetch #GP(0): failed to complete instruction decoding"));
+    exception(BX_GP_EXCEPTION, 0);
+  }
+
+  ret = assignHandler(i, BX_CPU_THIS_PTR fetchModeMask);
+
+  // Restore EIP since we fudged it to start at the 2nd page boundary.
+  RIP = BX_CPU_THIS_PTR prev_rip;
+
+  // Since we cross an instruction boundary, note that we need a prefetch()
+  // again on the next instruction.  Perhaps we can optimize this to
+  // eliminate the extra prefetch() since we do it above, but have to
+  // think about repeated instructions, etc.
+  // invalidate_prefetch_q();
+
+#ifdef BX_INSTR_STORE_OPCODE_BYTES
+  i->set_opcode_bytes(fetchBuffer);
+#endif
+
+  BX_INSTR_OPCODE(BX_CPU_ID, i, fetchBuffer, i->ilen(),
+      BX_CPU_THIS_PTR sregs[BX_SEG_REG_CS].cache.u.segment.d_b, long64_mode());
+}
diff --git a/bochs/nanobox.cc b/bochs/nanobox.cc
new file mode 100644
index 000000000..846714579
--- /dev/null
+++ b/bochs/nanobox.cc
@@ -0,0 +1,421 @@
+/////////////////////////////////////////////////////////////////////////
+// nanobox instrumentation exports.
+//
+// Small, side-effect-free accessors the JS harness calls through the wasm export table to read
+// guest RAM (in guest-physical order, honouring Bochs' lazily allocated block table), the CPU's
+// instruction count and a few engine statistics. Nothing here changes emulation semantics.
+/////////////////////////////////////////////////////////////////////////
+
+#include "bochs.h"
+#include "cpu/cpu.h"
+#include "memory/memory-bochs.h"
+#include "pc_system.h"
+
+#define NB_EXPORT(name) extern "C" __attribute__((export_name(#name), used))
+
+// friend-free access to the memory object's block table: MEM_C exposes what we need publicly.
+NB_EXPORT(nanobox_mem_len) double nanobox_mem_len(void)
+{
+  return (double) BX_MEM(0)->get_memory_len();
+}
+
+NB_EXPORT(nanobox_mem_block_size) unsigned nanobox_mem_block_size(void)
+{
+  return BX_MEM(0)->nanobox_block_size();
+}
+
+// host address of the given guest-physical block, or 0 if the guest never touched it (all zero).
+NB_EXPORT(nanobox_mem_block_ptr) Bit8u *nanobox_mem_block_ptr(unsigned idx)
+{
+  return BX_MEM(0)->nanobox_block_ptr(idx);
+}
+
+NB_EXPORT(nanobox_icount_lo) unsigned nanobox_icount_lo(void) { return (unsigned)(BX_CPU(0)->icount & 0xffffffff); }
+NB_EXPORT(nanobox_icount_hi) unsigned nanobox_icount_hi(void) { return (unsigned)(BX_CPU(0)->icount >> 32); }
+NB_EXPORT(nanobox_ticks_lo) unsigned nanobox_ticks_lo(void) { return (unsigned)(bx_pc_system.time_ticks() & 0xffffffff); }
+NB_EXPORT(nanobox_ticks_hi) unsigned nanobox_ticks_hi(void) { return (unsigned)(bx_pc_system.time_ticks() >> 32); }
+NB_EXPORT(nanobox_rip_lo) unsigned nanobox_rip_lo(void) { return (unsigned)(BX_CPU(0)->get_instruction_pointer() & 0xffffffff); }
+NB_EXPORT(nanobox_rip_hi) unsigned nanobox_rip_hi(void) { return (unsigned)(BX_CPU(0)->get_instruction_pointer() >> 32); }
+NB_EXPORT(nanobox_cpu_idle) unsigned nanobox_cpu_idle(void)
+{
+  return BX_CPU(0)->activity_state != BX_CPU_C::BX_ACTIVITY_STATE_ACTIVE;
+}
+
+NB_EXPORT(nanobox_stat) double nanobox_stat(unsigned idx)
+{
+  switch (idx) {
+    case 0: return (double) nanobox_stats.cpu_loop_entries;
+    case 1: return (double) nanobox_stats.longjmps;
+    case 2: return (double) nanobox_stats.traces;
+    case 3: return (double) nanobox_stats.jit_traces;
+    case 4: return (double) nanobox_stats.jit_compiled;
+    case 5: return (double) nanobox_stats.jit_loopbacks;
+    case 6: return (double) nanobox_stats.jit_links;
+    case 7: return (double) nanobox_stats.jit_slow;
+    case 8: case 9: case 10: case 11: case 12: case 13: case 14: case 15: return (double) nanobox_stats.link_fail[idx - 8];
+    case 16: return (double) nanobox_stats.jit_intrans;
+    case 17: return (double) nanobox_stats.interp_traces;
+    case 18: return (double) nanobox_stats.interp_icount;
+    case 19: { extern Bit64u nanobox_shadow_miss; return (double) nanobox_shadow_miss; }   // AOT nostack: RETs whose rsp did not match the shadow entry
+    default: return -1;
+  }
+}
+
+/////////////////////////////////////////////////////////////////////////
+// Instruction-address profile: how many guest instructions retired per 4 KiB page of linear
+// address space (plus the physical page behind it and the privilege level they ran at). Bochs
+// traces never cross a page (BX_TRACE_END at page ends), so one increment per executed trace
+// with the icount delta is exact. Open-addressing table, keyed by linear page; a full table drops.
+/////////////////////////////////////////////////////////////////////////
+
+unsigned nanobox_pages_on = 0;
+struct nb_page_rec { Bit64u lpage; Bit64u count; Bit64u ppage; Bit32u flags; Bit32u traces; };
+#define NB_PAGES_BITS 19
+#define NB_PAGES_N (1u << NB_PAGES_BITS)
+static nb_page_rec *nb_pages = NULL;
+static unsigned nb_pages_used = 0, nb_pages_dropped = 0;
+
+// focus page: per-offset histogram of trace starts (and instructions) inside ONE linear page
+static Bit64u nb_focus_lpage = ~0ull; static Bit64u *nb_focus_ins = NULL, *nb_focus_tr = NULL;
+NB_EXPORT(nanobox_focus_set) void nanobox_focus_set(double lpage)
+{
+  nb_focus_lpage = (Bit64u) lpage;
+  if (!nb_focus_ins) { nb_focus_ins = (Bit64u *) calloc(4096, sizeof(Bit64u)); nb_focus_tr = (Bit64u *) calloc(4096, sizeof(Bit64u)); }
+}
+// field 0: instructions retired by traces starting at this offset, 1: number of such traces
+NB_EXPORT(nanobox_focus_get) double nanobox_focus_get(unsigned off, unsigned field) { if (!nb_focus_ins || off >= 4096) return -1; return (double)(field ? nb_focus_tr[off] : nb_focus_ins[off]); }
+
+void nanobox_pages_account(Bit64u rip, Bit64u paddr, Bit64u n, unsigned user)
+{
+  if ((rip >> 12) == nb_focus_lpage) { nb_focus_ins[rip & 0xfff] += n; nb_focus_tr[rip & 0xfff]++; }
+  if (!nb_pages) { nb_pages = (nb_page_rec *) calloc(NB_PAGES_N, sizeof(nb_page_rec)); if (!nb_pages) { nanobox_pages_on = 0; return; } }
+  Bit64u lp = (rip >> 12) + 1; // +1: 0 marks an empty slot
+  Bit64u h = lp * 0x9E3779B97F4A7C15ull;
+  unsigned idx = (unsigned)(h >> (64 - NB_PAGES_BITS));
+  for (unsigned probe = 0; probe < 64; probe++, idx = (idx + 1) & (NB_PAGES_N - 1)) {
+    nb_page_rec *r = &nb_pages[idx];
+    if (r->lpage == lp) { r->count += n; r->traces++; r->flags |= user ? 1 : 2; if (r->ppage != (paddr >> 12)) { r->flags |= 4; r->ppage = paddr >> 12; } return; }
+    if (r->lpage == 0) {
+      if (nb_pages_used >= NB_PAGES_N - NB_PAGES_N / 8) break; // keep the table sparse enough to probe cheaply
+      r->lpage = lp; r->count = n; r->ppage = paddr >> 12; r->flags = user ? 1 : 2; r->traces = 1; nb_pages_used++; return;
+    }
+  }
+  nb_pages_dropped++;
+}
+
+NB_EXPORT(nanobox_pages_set) void nanobox_pages_set(unsigned on) { nanobox_pages_on = on; }
+NB_EXPORT(nanobox_pages_n) unsigned nanobox_pages_n(void) { return NB_PAGES_N; }
+NB_EXPORT(nanobox_pages_used) unsigned nanobox_pages_used(void) { return nb_pages_used; }
+NB_EXPORT(nanobox_pages_dropped) unsigned nanobox_pages_dropped(void) { return nb_pages_dropped; }
+// field: 0 linear page (rip>>12), 1 instruction count, 2 physical page (latest), 3 flags (1 user, 2 kernel, 4 remapped), 4 traces
+NB_EXPORT(nanobox_pages_get) double nanobox_pages_get(unsigned idx, unsigned field)
+{
+  if (!nb_pages || idx >= NB_PAGES_N || nb_pages[idx].lpage == 0) return -1;
+  const nb_page_rec *r = &nb_pages[idx];
+  switch (field) { case 0: return (double)(r->lpage - 1); case 1: return (double) r->count; case 2: return (double) r->ppage; case 3: return (double) r->flags; case 4: return (double) r->traces; }
+  return -1;
+}
+
+/////////////////////////////////////////////////////////////////////////
+// SMC profile: how often does the guest write into pages that hold executed code (handleSMC), per
+// physical page, with the tick of the first/last event. Answers "is kernel text frozen after boot?"
+/////////////////////////////////////////////////////////////////////////
+struct nb_smc_rec { Bit64u ppage; Bit64u count; Bit64u firstTick, lastTick; Bit32u masks; };
+#define NB_SMC_N 16384
+static nb_smc_rec *nb_smc = NULL; static unsigned nb_smc_used = 0; static Bit64u nb_smc_total = 0;
+extern "C" void nanobox_smc_account(Bit64u pAddr, Bit32u mask)
+{
+  nb_smc_total++;
+  if (!nb_smc) { nb_smc = (nb_smc_rec *) calloc(NB_SMC_N, sizeof(nb_smc_rec)); if (!nb_smc) return; }
+  Bit64u pp = (pAddr >> 12) + 1;
+  unsigned idx = (unsigned)((pp * 0x9E3779B97F4A7C15ull) >> 50) & (NB_SMC_N - 1);
+  for (unsigned probe = 0; probe < 64; probe++, idx = (idx + 1) & (NB_SMC_N - 1)) {
+    nb_smc_rec *r = &nb_smc[idx];
+    if (r->ppage == pp) { r->count++; r->lastTick = bx_pc_system.time_ticks(); r->masks |= mask; return; }
+    if (r->ppage == 0) { if (nb_smc_used >= NB_SMC_N - NB_SMC_N / 8) return; r->ppage = pp; r->count = 1; r->firstTick = r->lastTick = bx_pc_system.time_ticks(); r->masks = mask; nb_smc_used++; return; }
+  }
+}
+NB_EXPORT(nanobox_smc_total) double nanobox_smc_total(void) { return (double) nb_smc_total; }
+NB_EXPORT(nanobox_smc_n) unsigned nanobox_smc_n(void) { return NB_SMC_N; }
+// field 0: physical page, 1 count, 2 first tick, 3 last tick, 4 masks
+NB_EXPORT(nanobox_smc_get) double nanobox_smc_get(unsigned idx, unsigned field)
+{
+  if (!nb_smc || idx >= NB_SMC_N || nb_smc[idx].ppage == 0) return -1;
+  const nb_smc_rec *r = &nb_smc[idx];
+  switch (field) { case 0: return (double)(r->ppage - 1); case 1: return (double) r->count; case 2: return (double) r->firstTick; case 3: return (double) r->lastTick; case 4: return (double) r->masks; }
+  return -1;
+}
+
+/////////////////////////////////////////////////////////////////////////
+// Divergence finder: per-trace fingerprints of the CPU state, sent to the host through a hook slot
+// (see nanobox_jit.cc for the hook mechanism). Two deterministic runs (interpreter vs JIT) produce
+// identical streams up to the first diverging trace.
+/////////////////////////////////////////////////////////////////////////
+#include "cpu/icache.h"
+#include "cpu/decoder/ia_opcodes.h"
+#include <stdio.h>
+extern "C" { static void nanobox_hook_dbg_placeholder(const char *, unsigned) {} }
+typedef void (*hook_dbg_t)(const char *s, unsigned len);
+static hook_dbg_t volatile hook_dbg = nanobox_hook_dbg_placeholder;
+NB_EXPORT(nanobox_dbg_hook_slot) unsigned nanobox_dbg_hook_slot(void) { return (unsigned)(uintptr_t) hook_dbg; }
+
+unsigned nanobox_dbg_mode = 0;         // 0 off, 1 chained hash every `every` traces, 2 detail for traces in [from,to)
+Bit64u nanobox_dbg_every = 100000, nanobox_dbg_from = 0, nanobox_dbg_to = 0;
+static Bit64u nanobox_dbg_chain = 0xcbf29ce484222325ull;
+NB_EXPORT(nanobox_dbg_set) void nanobox_dbg_set(unsigned mode, double every, double from, double to)
+{
+  nanobox_dbg_mode = mode; nanobox_dbg_every = (Bit64u) every; nanobox_dbg_from = (Bit64u) from; nanobox_dbg_to = (Bit64u) to;
+}
+static inline Bit64u fnv64(Bit64u h, Bit64u v) { for (int i = 0; i < 8; i++) { h ^= (v >> (i * 8)) & 0xff; h *= 0x100000001b3ull; } return h; }
+static Bit64u nanobox_state_fingerprint(void)
+{
+  Bit64u h = 0xcbf29ce484222325ull;
+  for (unsigned r = 0; r < BX_GENERAL_REGISTERS + 1; r++) h = fnv64(h, BX_CPU(0)->gen_reg[r].rrx);
+  h = fnv64(h, BX_CPU(0)->oszapc.result); h = fnv64(h, BX_CPU(0)->oszapc.auxbits);
+  h = fnv64(h, BX_CPU(0)->prev_rip);
+  if (!(nanobox_dbg_mode & 4)) h = fnv64(h, BX_CPU(0)->icount); // mode bit 4: ignore icount (fast-string chunking differs between builds, guest-invisible)
+  h = fnv64(h, bx_pc_system.time_ticks());
+  h = fnv64(h, BX_CPU(0)->async_event); h = fnv64(h, BX_CPU(0)->eflags);
+  return h;
+}
+// called by cpu_loop after every trace (entry = the trace that just ran, may be a JIT'd one)
+void nanobox_dbg_trace(bxICacheEntry_c *entry, bool jitted)
+{
+  Bit64u idx = nanobox_stats.traces;
+  Bit64u fp = nanobox_state_fingerprint();
+  if ((nanobox_dbg_mode & 3) == 1) {
+    nanobox_dbg_chain = fnv64(nanobox_dbg_chain, fp);
+    if (idx % nanobox_dbg_every == 0) {
+      char buf[96]; int n = snprintf(buf, sizeof buf, "C %llu %016llx\n", (unsigned long long) idx, (unsigned long long) nanobox_dbg_chain);
+      hook_dbg(buf, n);
+    }
+  } else if ((nanobox_dbg_mode & 3) == 2 && idx >= nanobox_dbg_from && idx < nanobox_dbg_to) {
+    char buf[1024]; int n = snprintf(buf, sizeof buf, "T %llu %d fp=%016llx rip=%016llx prev=%016llx ic=%llu tk=%llu ae=%x lf=%016llx/%016llx pa=%llx tlen=%u:",
+      (unsigned long long) idx, jitted, (unsigned long long) fp,
+      (unsigned long long) BX_CPU(0)->gen_reg[BX_64BIT_REG_RIP].rrx, (unsigned long long) BX_CPU(0)->prev_rip,
+      (unsigned long long) BX_CPU(0)->icount, (unsigned long long) bx_pc_system.time_ticks(), BX_CPU(0)->async_event,
+      (unsigned long long) BX_CPU(0)->oszapc.result, (unsigned long long) BX_CPU(0)->oszapc.auxbits,
+      (unsigned long long) entry->pAddr, entry->tlen);
+    for (unsigned k = 0; k < entry->tlen && n < 900; k++) {
+      unsigned ia = entry->i[k].getIaOpcode();
+      if (ia == BX_INSERTED_OPCODE) break;
+      n += snprintf(buf + n, sizeof buf - n, " %s%s", get_bx_opcode_name(ia) + 6, entry->i[k].modC0() ? "" : "(M)");
+    }
+    n += snprintf(buf + n, sizeof buf - n, " |");
+    for (unsigned r = 0; r < 16 && n < 1000; r++) n += snprintf(buf + n, sizeof buf - n, " %llx", (unsigned long long) BX_CPU(0)->gen_reg[r].rrx);
+    if (n < 1022) { buf[n++] = '\n'; buf[n] = 0; }
+    hook_dbg(buf, n);
+  }
+}
+
+// log a compiled trace: "M <fnidx> <bytes> pa=... tlen=...: opcodes"
+void nanobox_dbg_compiled(bxICacheEntry_c *e, unsigned fn, unsigned len)
+{
+  char buf[1024]; int n = snprintf(buf, sizeof buf, "M %u %u seq=%llu pa=%llx tlen=%u:", fn, len, (unsigned long long) nanobox_stats.jit_compiled, (unsigned long long) e->pAddr, e->tlen);
+  for (unsigned k = 0; k < e->tlen && n < 900; k++) {
+    unsigned ia = e->i[k].getIaOpcode();
+    if (ia == BX_INSERTED_OPCODE) break;
+    n += snprintf(buf + n, sizeof buf - n, " %s%s", get_bx_opcode_name(ia) + 6, e->i[k].modC0() ? "" : "(M)");
+  }
+  if (n < 1022) { buf[n++] = '\n'; buf[n] = 0; }
+  hook_dbg(buf, n);
+}
+
+/////////////////////////////////////////////////////////////////////////
+// ORACLE (2026-08-19): the "heap + syscalls" correctness criterion.
+//
+// The RAM-identity oracle (test/identity.sh: ticks + SHA-256 of ALL guest RAM) is unchanged and
+// stays the default. This block adds the two pieces the second oracle needs, both OFF unless the
+// harness turns them on, so a build carrying them behaves exactly like one that does not:
+//
+//   1. nanobox_stackmap: which guest-PHYSICAL 4 KiB pages the CPU used as a CALL STACK, and when
+//      it last did so. Marked from BX_CPU_C::stackPrefetch(), the one place Bochs resolves the
+//      stack window to a physical page. Everything that reaches emulated memory through SS goes
+//      through the stack cache: PUSH/POP/CALL/RET/ENTER/LEAVE, the interrupt/exception frame
+//      pushes and IRET pops, task switches, and the decoder's SS-segment MOV specialisations
+//      (MOV64S_*, i.e. plain `mov ...(%rsp)/(%rbp)` frame slots). It is therefore the CPU's own
+//      definition of "stack", not a heuristic address range, and it covers kernel per-task stacks,
+//      IRQ/exception stacks, and every user thread stack the same way.
+//      A per-page 32-bit "last marked" sequence number is kept so the host can ask for the sticky
+//      set (ever a stack) or only the recently-live one (a page freed and recycled as heap stops
+//      being marked, and drops out of a windowed mask).
+//
+//   2. nanobox_sys: an ordered trace of the guest's syscalls -- number, six arguments, RIP, CPL at
+//      entry, the return value at SYSRET, and for write-like calls the bytes handed to the kernel.
+//      Hooked in BX_CPU_C::SYSCALL/SYSRET, which the JIT never inlines (it emits a call to the
+//      same execute1 handler), so the trace is identical in shape whether a trace was interpreted,
+//      JIT-compiled or AOT-compiled. Guest memory is read through dbg_xlate_linear2phy +
+//      dbg_fetch_mem: a passive page-table walk that cannot fault, cannot set A/D bits and cannot
+//      touch the TLB, so recording changes nothing the guest can observe.
+/////////////////////////////////////////////////////////////////////////
+
+// ---- 1. stack page map ----------------------------------------------------------------------
+unsigned nanobox_stackmap_on = 0;
+extern "C" void nanobox_stack_account(Bit64u ppf);
+static Bit32u *nb_stack_seq_of = NULL;      // per guest-physical page: last marking sequence (0 = never)
+static Bit64u nb_stack_npages = 0;
+static Bit32u nb_stack_seq = 0;
+static Bit64u nb_stack_marked = 0;          // distinct pages ever marked
+static Bit64u nb_stack_events = 0;
+
+// How close to RSP an SS-segment access has to be for the page to count as a CALL STACK page.
+// Bochs routes EVERY effective address whose base register is RSP or RBP through the stack cache
+// (the decoder's MOV64S_* forms), and kernel code built with -fomit-frame-pointer uses RBP as an
+// ordinary pointer -- so without this test a `mov (%rbp),%rax` into .rodata marks a rodata page as
+// "stack" and the mask would excuse a difference there. Requiring the access to land in
+// [RSP-4096, RSP+span) keeps pushes, the 128-byte red zone, frame slots and interrupt frames, and
+// rejects a base register that merely happens to be RBP. 0 = no test (the loose rule).
+Bit64u nanobox_stackmap_span = 128 * 1024;
+NB_EXPORT(nanobox_stackmap_span_set) void nanobox_stackmap_span_set(double span) { nanobox_stackmap_span = (Bit64u) span; }
+
+extern "C" void nanobox_stack_account_at(Bit64u ppf, Bit64u laddr)
+{
+  if (nanobox_stackmap_span) {
+    const Bit64u rsp = BX_CPU(0)->gen_reg[BX_64BIT_REG_RSP].rrx;
+    if ((Bit64u)(laddr - (rsp - 4096)) >= nanobox_stackmap_span + 4096) return;
+  }
+  nanobox_stack_account(ppf);
+}
+
+extern "C" void nanobox_stack_account(Bit64u ppf)
+{
+  if (!nb_stack_seq_of) {
+    nb_stack_npages = (Bit64u) BX_MEM(0)->get_memory_len() >> 12;
+    nb_stack_seq_of = (Bit32u *) calloc((size_t) nb_stack_npages + 1, sizeof(Bit32u));
+    if (!nb_stack_seq_of) { nanobox_stackmap_on = 0; return; }
+  }
+  Bit64u pg = ppf >> 12;
+  if (pg >= nb_stack_npages) return;
+  nb_stack_events++;
+  if (!nb_stack_seq_of[pg]) nb_stack_marked++;
+  nb_stack_seq_of[pg] = ++nb_stack_seq;
+}
+
+NB_EXPORT(nanobox_stackmap_set) void nanobox_stackmap_set(unsigned on) { nanobox_stackmap_on = on; }
+NB_EXPORT(nanobox_stackmap_n) double nanobox_stackmap_n(void) { return (double) nb_stack_npages; }
+NB_EXPORT(nanobox_stackmap_marked) double nanobox_stackmap_marked(void) { return (double) nb_stack_marked; }
+NB_EXPORT(nanobox_stackmap_events) double nanobox_stackmap_events(void) { return (double) nb_stack_events; }
+NB_EXPORT(nanobox_stackmap_seq) double nanobox_stackmap_seq(void) { return (double) nb_stack_seq; }
+// host pointer to the Bit32u[nanobox_stackmap_n()] sequence array (0 = the page was never a stack)
+NB_EXPORT(nanobox_stackmap_ptr) Bit32u *nanobox_stackmap_ptr(void) { return nb_stack_seq_of; }
+
+// ---- 2. syscall trace -----------------------------------------------------------------------
+extern "C" { static void nanobox_hook_sys_placeholder(const char *, unsigned) {} }
+static hook_dbg_t volatile hook_sys = nanobox_hook_sys_placeholder;
+NB_EXPORT(nanobox_sys_hook_slot) unsigned nanobox_sys_hook_slot(void) { return (unsigned)(uintptr_t) hook_sys; }
+
+unsigned nanobox_sys_on = 0;               // 0 off, bit0 trace calls, bit1 also capture write-like payloads
+static Bit64u nb_sys_n = 0;                // syscalls seen (also the sequence number in the trace)
+static Bit64u nb_sys_bytes = 0;            // payload bytes hashed
+static unsigned nb_sys_snip = 48;          // verbatim payload bytes per buffer (the rest is folded into the hash)
+
+NB_EXPORT(nanobox_sys_set) void nanobox_sys_set(unsigned mode, unsigned snip) { nanobox_sys_on = mode; if (snip) nb_sys_snip = snip > 240 ? 240 : snip; }
+NB_EXPORT(nanobox_sys_count) double nanobox_sys_count(void) { return (double) nb_sys_n; }
+NB_EXPORT(nanobox_sys_payload_bytes) double nanobox_sys_payload_bytes(void) { return (double) nb_sys_bytes; }
+
+// Passive read of guest linear memory: page-table walk only, no faults, no TLB, no A/D bits.
+// Returns the number of bytes actually read (short on the first unmapped page).
+static unsigned nb_read_linear(bx_address laddr, unsigned len, Bit8u *buf)
+{
+  unsigned done = 0;
+  while (done < len) {
+    bx_phy_address phy = 0;
+    if (!BX_CPU(0)->dbg_xlate_linear2phy(laddr + done, &phy)) break;
+    unsigned chunk = 4096 - (unsigned)((laddr + done) & 0xfff);
+    if (chunk > len - done) chunk = len - done;
+    if (!BX_MEM(0)->dbg_fetch_mem(BX_CPU(0), phy, chunk, buf + done)) break;
+    done += chunk;
+  }
+  return done;
+}
+
+// FNV-1a over a guest buffer, read passively; also copies the first nb_sys_snip bytes out.
+static Bit64u nb_hash_guest(bx_address laddr, Bit64u len, Bit8u *snip, unsigned *snipLen, Bit64u *got)
+{
+  Bit64u h = 0xcbf29ce484222325ull;
+  Bit8u page[4096];
+  Bit64u off = 0;
+  *snipLen = 0;
+  while (off < len) {
+    unsigned want = (unsigned)((len - off) > 4096 ? 4096 : (len - off));
+    unsigned n = nb_read_linear(laddr + off, want, page);
+    for (unsigned k = 0; k < n; k++) { h ^= page[k]; h *= 0x100000001b3ull; }
+    while (*snipLen < nb_sys_snip && *snipLen < off + n) { snip[*snipLen] = page[*snipLen - (unsigned) off]; (*snipLen)++; }
+    off += n;
+    if (n < want) break;                    // unmapped: stop, the length we managed is part of the trace
+  }
+  *got = off;
+  nb_sys_bytes += off;
+  return h;
+}
+
+static int nb_hex(char *out, const Bit8u *b, unsigned n)
+{
+  static const char *H = "0123456789abcdef";
+  for (unsigned k = 0; k < n; k++) { out[2 * k] = H[b[k] >> 4]; out[2 * k + 1] = H[b[k] & 15]; }
+  out[2 * n] = 0;
+  return (int) (2 * n);
+}
+
+// One "W" line per buffer handed to the kernel by a write-like call.
+static void nb_sys_payload(Bit64u seq, unsigned which, bx_address laddr, Bit64u len)
+{
+  if (!(nanobox_sys_on & 2) || !len) return;
+  if (len > (1u << 22)) len = 1u << 22;      // a single 4 MiB cap: guests do not write more per call here
+  Bit8u snip[256]; unsigned snipLen = 0; Bit64u got = 0;
+  Bit64u h = nb_hash_guest(laddr, len, snip, &snipLen, &got);
+  char buf[1024];
+  int n = snprintf(buf, sizeof buf, "W %llu %u len=%llu got=%llu h=%016llx b=",
+                   (unsigned long long) seq, which, (unsigned long long) len, (unsigned long long) got, (unsigned long long) h);
+  n += nb_hex(buf + n, snip, snipLen);
+  buf[n++] = '\n'; buf[n] = 0;
+  hook_sys(buf, n);
+}
+
+struct nb_iovec { Bit64u base, len; };
+
+// Called at the top of BX_CPU_C::SYSCALL, before any register is changed.
+extern "C" void nanobox_sys_enter(void)
+{
+  Bit64u seq = ++nb_sys_n;
+  BX_CPU_C *c = BX_CPU(0);
+  Bit64u nr = c->gen_reg[BX_64BIT_REG_RAX].rrx;
+  Bit64u a0 = c->gen_reg[BX_64BIT_REG_RDI].rrx, a1 = c->gen_reg[BX_64BIT_REG_RSI].rrx;
+  Bit64u a2 = c->gen_reg[BX_64BIT_REG_RDX].rrx, a3 = c->gen_reg[BX_64BIT_REG_R10].rrx;
+  Bit64u a4 = c->gen_reg[BX_64BIT_REG_R8].rrx,  a5 = c->gen_reg[BX_64BIT_REG_R9].rrx;
+  char buf[256];
+  int n = snprintf(buf, sizeof buf, "S %llu %llu %llx %llx %llx %llx %llx %llx rip=%llx\n",
+                   (unsigned long long) seq, (unsigned long long) nr,
+                   (unsigned long long) a0, (unsigned long long) a1, (unsigned long long) a2,
+                   (unsigned long long) a3, (unsigned long long) a4, (unsigned long long) a5,
+                   (unsigned long long) c->get_instruction_pointer());
+  hook_sys(buf, n);
+  if (!(nanobox_sys_on & 2)) return;
+  // write-like calls: the bytes the guest hands to the kernel, in call order
+  switch (nr) {
+    case 1:    /* write(fd, buf, count) */
+    case 18:   /* pwrite64(fd, buf, count, off) */
+    case 44:   /* sendto(fd, buf, len, ...) */
+      nb_sys_payload(seq, 0, (bx_address) a1, a2);
+      break;
+    case 20:   /* writev(fd, iov, iovcnt) */
+    case 296: { /* pwritev2 */
+      Bit64u cnt = a2 > 64 ? 64 : a2;
+      for (Bit64u k = 0; k < cnt; k++) {
+        nb_iovec v; if (nb_read_linear((bx_address)(a1 + k * 16), 16, (Bit8u *) &v) != 16) break;
+        nb_sys_payload(seq, (unsigned)(k + 1), (bx_address) v.base, v.len);
+      }
+      break;
+    }
+    default: break;
+  }
+}
+
+// Called at the top of BX_CPU_C::SYSRET, before RIP/RSP are restored: RAX still holds the result.
+extern "C" void nanobox_sys_exit(void)
+{
+  char buf[96];
+  int n = snprintf(buf, sizeof buf, "R %llu %llx\n", (unsigned long long) nb_sys_n,
+                   (unsigned long long) BX_CPU(0)->gen_reg[BX_64BIT_REG_RAX].rrx);
+  hook_sys(buf, n);
+}
diff --git a/bochs/nanobox_jit.cc b/bochs/nanobox_jit.cc
new file mode 100644
index 000000000..ff7ac5ad9
--- /dev/null
+++ b/bochs/nanobox_jit.cc
@@ -0,0 +1,6640 @@
+/////////////////////////////////////////////////////////////////////////
+// nanobox trace JIT: x86-64 iCache traces -> WebAssembly functions.
+//
+// Design (see nanobox/claude/README.md for the long version):
+//  * the unit of compilation is one Bochs iCache trace (up to 32 instructions, ending exactly
+//    where the interpreter's trace ends), so trace boundaries — and therefore the points at which
+//    Bochs syncs its clock and delivers interrupts — are exactly the interpreter's;
+//  * instructions without an inline template are executed by Bochs' own handler in
+//    "single-step" mode (BX_NEXT_INSTR returns after one instruction), so unsupported opcodes cost
+//    nothing in correctness;
+//  * templates reproduce the handlers' side effects bit for bit (Bochs' lazy-flags representation,
+//    prev_rip/RIP/icount bookkeeping, memory access paths incl. TLB fast path + SMC stamps);
+//  * guest GPRs / lazy flags live in wasm locals inside a trace and are written back ("spilled")
+//    before anything that could observe or modify them: handler calls, slow-path memory helpers
+//    (which may raise a guest exception = longjmp out of the trace) and trace exits;
+//  * the module is built here as raw bytes and instantiated by the host (JS) through a
+//    function-table hook, so no wasm imports are needed at link/wizer time.
+//
+// AOT MODE (TASKS.md R, 2026-08-18) -- runtime switch `nanobox_set_jit_aot(1)` (harness NANOBOX_AOT=1,
+// page ?aot=1 -> cfg.aot), default OFF = the engine above, byte for byte:
+//  * regions are function-scoped, formed from a STATIC CFG walk (direct targets, fall-through, the
+//    continuation after a direct CALL; never the callee), decoding successors AHEAD of execution
+//    (nanobox_decode_ahead), kernel regions spanning pages; every block is an entry point;
+//  * compile on FIRST touch (threshold 1) when no precompiled translation exists;
+//  * identity with the interpreter's trace boundaries is waived: forward in-region edges are plain
+//    jumps (timer/async/window tests only at loop back-edges, region exits, handler steps), icount is
+//    accounted per block; precise state at faults is unchanged (slow arms still spill);
+//  * direct conditions (nanobox_jit_flags bits 0|1) on.
+// Offline precompile API for the "precompile everything" driver (work/j/aotpre) -- see the block
+// above nanobox_aot_compile_function() near the end of this file:
+//   int nanobox_aot_compile_function(u32 linLo, u32 linHi, u32 len, u32 cpl, u32 flags)
+//     forms + compiles every region the runtime would form inside the function at [lin, lin+len)
+//     (flags bit 0: also linear-sweep the bytes the walk leaves uncovered), records them like normal
+//     installs (hook_note -> --jit-bundle-out); returns the count or -1 (JIT/AOT off), -2 (not
+//     mapped under the current CR3), -3 (not 64-bit mode). Preconditions: nanobox_set_jit(2+, *),
+//     nanobox_set_jit_aot(1), guest stopped between traces; call nanobox_jit_flush_batch() at the end.
+//   double nanobox_aot_stat(i): 0 functions, 1 compiled, 2 starts, 3 not mapped, 4 gap starts,
+//     5 already compiled, 6 runtime maybe_compile hits a pending batch, 7 runtime compile failed.
+//   Level-3/always counters: nanobox_stat(16) in-region transitions, (17) cpu_loop trace entries run
+//     by the interpreter (no jitfn), (18) the guest instructions they retired.
+/////////////////////////////////////////////////////////////////////////
+
+#define NEED_CPU_REG_SHORTCUTS 1
+#include "bochs.h"
+#include "cpu/cpu.h"
+#include "cpu/icache.h"
+#include "memory/memory-bochs.h"
+#include "cpu/decoder/ia_opcodes.h"
+#include "pc_system.h"
+#include "nanobox_jit.h"
+void nanobox_dbg_compiled(bxICacheEntry_c *e, unsigned fn, unsigned len);
+#include "nanobox_wasm.h"
+#include <stddef.h>
+
+// offsetof() on a struct with a constructor trips -Winvalid-offsetof; compute the offsets from a
+// dummy instance instead.
+static bx_TLB_entry nanobox_tlb_layout_probe;
+#define TLB_OFF(field) ((uint32_t)((uintptr_t)&nanobox_tlb_layout_probe.field - (uintptr_t)&nanobox_tlb_layout_probe))
+static bxICacheEntry_c nanobox_ice_layout_probe;
+#define ICE_OFF(field) ((uint32_t)((uintptr_t)&nanobox_ice_layout_probe.field - (uintptr_t)&nanobox_ice_layout_probe))
+static bxInstruction_c nanobox_ins_layout_probe;
+#define INS_ILEN_OFF ((uint32_t)((uintptr_t)&nanobox_ins_layout_probe.metaInfo.ilen - (uintptr_t)&nanobox_ins_layout_probe))
+
+unsigned nanobox_jit_level = 0;
+// TLB fast-path folding (permission + alignment-check + write-stamp freedom folded into the probe
+// cache tag). 1 = new path, 0 = the original explicit tests. A/B'd inside one build through
+// nanobox_set_jit_merge(1) (harness env NANOBOX_JIT_MERGE=1) so both arms share a binary.
+unsigned nanobox_tlbfold = 1;
+// Register-spill work (work/j/spill): bit 0 = shared per-body exit chain (one spill tail per block
+// body, exits jump into it), bit 1 = live-only dirtiness (a loop header / region block entry marks
+// only registers the loop / region WRITES as dirty; read-only ones are never stored), bit 2 = the
+// syncBefore() RIP/prev_rip/icount stores as one out-of-line call (size only, default OFF), bit 3 =
+// templates for the XCHG short forms (90+r). A/B inside one build through nanobox_set_jit_spill(mask)
+// (work/prof/spill-run.mjs: NANOBOX_SPILL=mask). Default: chain + live + xchg.
+// bit 4 = SIMD/AVX templates (VZEROUPPER, VPXOR/VPOR/VPAND/VPANDN, VPCMPEQB, VPMOVMSKB, VPSHUFB, PCMPISTRI,
+// VMOVDQU/VMOVDQA, VMOVD, VPBROADCASTB and the SSE twins), bit 5 = REP STOS/MOVS single-chunk fast paths,
+// bit 6 = misc ALU templates (LEAVE, MUL, BSF/BSR, DEC_Eb, BT/BTS memory forms). Default: all on.
+unsigned nanobox_jit_spill = 3 | 8 | 16 | 32 | 64;
+// Experiment: the trace -> link-function hop as a DIRECT `return_call` to an import (the link function's
+// table slot is known when a trace is compiled) instead of `return_call_indirect` through the table with
+// its bounds + type check. Both profiles say the two indirect tail calls per hop are where the time is
+// (TASKS.md P/Q: the shared link function alone is 28.7 % of steady-state time). Runtime switch so it can
+// be A/B'd in one binary; note a module compiled with it imports one more function (the link slot).
+unsigned nanobox_jit_linkdirect = 0;
+// Flags/probe work (work/j/flags, TASKS.md M Phase 1b), A/B inside one build through
+// nanobox_set_jit_flags(mask) (NANOBOX_FLAGS=mask / harness --flags):
+//   bit 0 = deferred lazy-flag materialisation (ADD/SUB/CMP/AND/OR/XOR/TEST keep op1/op2/res in
+//           locals; Bochs' lazy state is computed only where something can observe it, Jcc/SETcc/
+//           CMOVcc conditions come straight from the operands)   -- measured: no win, OFF
+//   bit 1 = flag entry classification of blocks / loop headers (KILL / SLOW)   -- with bit 0, OFF
+//   bit 2 = the DTLB probe cache travels through the link tail call as parameters (cpu_loop entries
+//           and handler steps still poison it)                                 -- ON
+//   bit 3 = forward in-region edges as a direct br to the target body's label  -- ON
+//   bit 4 = self-check of bit 0 against the interpreter's flags (debug)         -- OFF
+//   bit 5 = probe cache handed over through memory instead of parameters (alternative to bit 2) -- OFF
+//   bit 6 = with bit 2: the short 4-param signature (arg, C_tagR, C_tagW, C_host) instead of 11 -- ON
+unsigned nanobox_jit_flags = 4 | 8 | 64;
+unsigned nanobox_jit_threshold = 32;
+unsigned nanobox_jit_maxlen = 64;      // debug knob: only compile traces with at most this many instructions
+Bit8u nanobox_single_step = 0;
+Bit8u nanobox_trace_end = 0;
+
+/////////////////////////////////////////////////////////////////////////
+// Host hooks. The C++ side calls through *function pointers* that initially point at the
+// placeholders below; the JS host overwrites those function-table slots with trampolines into
+// JavaScript (nanobox_hook_slot() tells it which slots). No wasm imports involved, so wizer and
+// plain wasmtime runs work unchanged (they just never JIT).
+/////////////////////////////////////////////////////////////////////////
+extern "C" {
+static unsigned nanobox_hook_jit_install_placeholder(const void *, unsigned, const unsigned *, unsigned) { return 0; }
+static void nanobox_hook_jit_release_placeholder(unsigned) {}
+static void nanobox_hook_jit_release_all_placeholder(void) {}
+static unsigned nanobox_hook_jit_lookup_placeholder(unsigned, unsigned) { return 0; }
+static void nanobox_hook_jit_note_placeholder(unsigned, unsigned, unsigned) {}
+static unsigned nanobox_hook_jit_install_batch_placeholder(const void *, unsigned, const unsigned *, unsigned, unsigned, unsigned *) { return 0; }
+}
+typedef unsigned (*hook_install_t)(const void *wasm, unsigned len, const unsigned *importKeys, unsigned nimports);
+typedef void (*hook_release_t)(unsigned fn);
+typedef void (*hook_release_all_t)(void);
+typedef unsigned (*hook_lookup_t)(unsigned keyLo, unsigned keyHi);       // pre-computed translation for this content key? -> table index or 0
+typedef void (*hook_note_t)(unsigned fn, unsigned keyLo, unsigned keyHi); // "fn was compiled from the module with this content key" (lets the host dump bundles)
+static hook_install_t volatile hook_install = nanobox_hook_jit_install_placeholder;
+static hook_release_t volatile hook_release = nanobox_hook_jit_release_placeholder;
+static hook_release_all_t volatile hook_release_all = nanobox_hook_jit_release_all_placeholder;
+static hook_lookup_t volatile hook_lookup = nanobox_hook_jit_lookup_placeholder;
+static hook_note_t volatile hook_note = nanobox_hook_jit_note_placeholder;
+// batch install: module exports f0..f(nfuncs-1); the host writes their table indices to out[]; returns 1 on success
+typedef unsigned (*hook_install_batch_t)(const void *wasm, unsigned len, const unsigned *importKeys, unsigned nimports, unsigned nfuncs, unsigned *out);
+static hook_install_batch_t volatile hook_install_batch = nanobox_hook_jit_install_batch_placeholder;
+
+#define NB_EXPORT(name) extern "C" __attribute__((export_name(#name), used))
+
+// function-table slot of hook k (0 = install, 1 = release, 2 = release_all)
+NB_EXPORT(nanobox_hook_slot) unsigned nanobox_hook_slot(unsigned k)
+{
+  switch (k) {
+    case 0: return (unsigned)(uintptr_t) hook_install;
+    case 1: return (unsigned)(uintptr_t) hook_release;
+    case 2: return (unsigned)(uintptr_t) hook_release_all;
+    case 3: return (unsigned)(uintptr_t) hook_lookup;
+    case 4: return (unsigned)(uintptr_t) hook_note;
+    case 5: return (unsigned)(uintptr_t) hook_install_batch;
+    default: return 0;
+  }
+}
+NB_EXPORT(nanobox_set_jit) void nanobox_set_jit(unsigned level, unsigned threshold)
+{
+  nanobox_jit_level = level;
+  nanobox_jit_threshold = threshold ? threshold : 1;
+}
+NB_EXPORT(nanobox_get_jit) unsigned nanobox_get_jit(void) { return nanobox_jit_level; }
+NB_EXPORT(nanobox_set_jit_maxlen) void nanobox_set_jit_maxlen(unsigned n) { nanobox_jit_maxlen = n; }
+NB_EXPORT(nanobox_set_jit_spill) void nanobox_set_jit_spill(unsigned mask) { nanobox_jit_spill = mask; }
+NB_EXPORT(nanobox_set_jit_flags) void nanobox_set_jit_flags(unsigned mask) { nanobox_jit_flags = mask; }
+NB_EXPORT(nanobox_set_jit_linkdirect) void nanobox_set_jit_linkdirect(unsigned on) { nanobox_jit_linkdirect = on; }
+extern unsigned nanobox_jit_outline;
+NB_EXPORT(nanobox_set_jit_outline) void nanobox_set_jit_outline(unsigned mask) { nanobox_jit_outline = mask; }
+extern unsigned nanobox_jit_faultarm;
+NB_EXPORT(nanobox_set_jit_faultarm) void nanobox_set_jit_faultarm(unsigned mask) { nanobox_jit_faultarm = mask; }
+// ---- dedicated stack window (docs/aot-size-and-coverage.md plan item 6) -------------------------
+// PUSH/POP/CALL/RET pay the whole general memory-access machinery -- per-site probe tag, the
+// function-wide pair behind it, the outlined DTLB refill -- for a slot on the one page in the
+// machine whose identity the CPU already knows. NANOBOX_STACKTAG makes those sites read the CPU's
+// OWN stack window instead. Default 0 = the engine emits exactly what it emits today.
+//   bit 0  PUSH / POP / CALL / RET / ENTER / LEAVE (everything through emitStack{Read,Write})
+//   bit 1  ... and 8-byte SS-segment memory operands (`mov ...(%rsp)/(%rbp)` frame slots)
+extern unsigned nanobox_jit_stacktag;
+NB_EXPORT(nanobox_set_jit_stacktag) void nanobox_set_jit_stacktag(unsigned mask) { nanobox_jit_stacktag = mask; }
+// ---- two-tier emission (work/prof/tier.md) -----------------------------------------------------
+// Tier 0 is the COMPACT call form: a guest instruction is performed by a shared helper in the
+// engine, so a site costs a handful of wasm bytes instead of a full inline template with its own
+// address computation, probe cache, fault arm, spill and exits. Tier 1 is what ships today.
+extern unsigned nanobox_jit_tier;       // bitmask, see the definition below
+extern unsigned nanobox_jit_tier1_thr;  // executions after which a tier-0 translation is recompiled at tier 1 (0 = never)
+NB_EXPORT(nanobox_set_jit_tier) void nanobox_set_jit_tier(unsigned mask, unsigned promote)
+{ nanobox_jit_tier = mask; nanobox_jit_tier1_thr = promote; }
+extern Bit64u nanobox_tier_stats[4];
+NB_EXPORT(nanobox_jit_tier_stat) double nanobox_jit_tier_stat(unsigned i) { return i < 4 ? (double) nanobox_tier_stats[i] : 0; }
+// flags-work counters: static (compile-time sites) 0..15, dynamic (level 3) 16..31
+enum { FS_PENDING = 0, FS_DIRECT, FS_MAT_INLINE, FS_MAT_HELPER, FS_RT_CHECK, FS_EDGE_DROP, FS_EDGE_PASS, FS_EDGE_MAT, FS_COND_TOTAL, FS_COND_PENDING, FS_JCC_ALU, FS_JCC_ALU_DIRECT, FS_MAT_EXIT, FS_MAT_READ, FS_MAT_EDGE_RT, FS_BLOCKS_SLOW, FS_FWD_BR = 31,
+       FD_DIRECT = 16, FD_MAT_INLINE, FD_HELPER, FD_PENDING, FD_EDGE_DROP, FD_EDGE_PASS, FD_EDGE_MAT, FD_PROBE_FULL, FD_PROBE_C, FD_PROBE_D, FD_MAT_EXIT, FD_MAT_READ, FD_RT_CHECK, FD_FN_ENTRY, FD_LINK_TAGS, FD_31 };
+static Bit64u nanobox_flags_stats[32];
+Bit64u nanobox_probe_mem[4] = { (Bit64u) -1, (Bit64u) -1, 0, 0 };   // probe cache handed from a linking trace to the next (nanobox_jit_flags bit 5): tagR, tagW, host
+NB_EXPORT(nanobox_jit_flags_stat) double nanobox_jit_flags_stat(unsigned i) { return i < 32 ? (double) nanobox_flags_stats[i] : 0; }
+static Bit64u nanobox_spill_stats[4];   // [0] chain exits, [1] inline-fallback exits, [2] chain positions, [3] bodies
+NB_EXPORT(nanobox_jit_spill_stat) double nanobox_jit_spill_stat(unsigned i) { return i < 4 ? (double) nanobox_spill_stats[i] : 0; }
+
+// C++ helpers callable from JIT'd code (plain functions -> stable table indices)
+extern "C" {
+static void nanobox_helper_dec_write_stamp(Bit64u pAddr, unsigned len)
+{
+  pageWriteStampTable.decWriteStamp((bx_phy_address) pAddr, len);
+}
+static void nanobox_helper_dbg_loop(unsigned entry)
+{
+  nanobox_dbg_trace((bxICacheEntry_c *) (uintptr_t) entry, true);
+}
+// syncBefore() out of line (nanobox_jit_spill bit 2): RIP = end of the executing instruction,
+// prev_rip = its start, icount = instructions completed before it — the state a fault raised by
+// the accessor called next must see (exception() reads RIP/prev_rip/RSP from the CPU struct
+// BEFORE it longjmps, which is why the spill cannot move into a catch handler)
+static void nanobox_helper_sync(Bit64u rip, Bit64u prev, Bit64u ic)
+{
+  BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx = rip;
+  BX_CPU_THIS_PTR prev_rip = prev;
+  BX_CPU_THIS_PTR icount = ic;
+}
+// Handler-step prologue/epilogue out of line (nanobox_jit_outline bit 3): the sync above plus the
+// nanobox_trace_end clear in front of a Bochs handler, and the "did the trace end / did an async
+// event arrive" test behind it. Every non-templated instruction and every deopt arm inlined both.
+static void nanobox_helper_step_pre(Bit64u rip, Bit64u prev, Bit64u ic)
+{
+  BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx = rip;
+  BX_CPU_THIS_PTR prev_rip = prev;
+  BX_CPU_THIS_PTR icount = ic;
+  nanobox_trace_end = 0;
+}
+static unsigned nanobox_helper_step_post(void)
+{
+  return (unsigned) nanobox_trace_end | (unsigned) BX_CPU_THIS_PTR async_event;
+}
+// Deferred lazy flags (nanobox_jit_flags bit 0): materialise the pending state {kind, op1, op2,
+// res} straight into oszapc with Bochs' own macros (bit-identical to the handlers by
+// construction). kind = op (1 ADD, 2 SUB, 3 LOGIC) | sizecode << 2 | hasRes << 4; without hasRes
+// the result is recomputed (CMP/TEST never computed it).
+// self-check (nanobox_jit_flags bit 4): the interpreter's condition cc from the memory lazy state
+static unsigned nanobox_helper_cond(unsigned cc)
+{
+  unsigned v = 0;
+  switch (cc & ~1u) {
+    case 0: v = BX_CPU_THIS_PTR getB_OF(); break;
+    case 2: v = BX_CPU_THIS_PTR getB_CF(); break;
+    case 4: v = BX_CPU_THIS_PTR getB_ZF(); break;
+    case 6: v = BX_CPU_THIS_PTR getB_CF() | BX_CPU_THIS_PTR getB_ZF(); break;
+    case 8: v = BX_CPU_THIS_PTR getB_SF(); break;
+    case 10: v = BX_CPU_THIS_PTR getB_PF(); break;
+    case 12: v = BX_CPU_THIS_PTR getB_SF() ^ BX_CPU_THIS_PTR getB_OF(); break;
+    default: v = BX_CPU_THIS_PTR getB_ZF() | (BX_CPU_THIS_PTR getB_SF() ^ BX_CPU_THIS_PTR getB_OF()); break;
+  }
+  return (cc & 1) ? !v : v;
+}
+static Bit64u nanobox_flagbug_count = 0;
+static void nanobox_helper_flagbug(unsigned what, unsigned kind, unsigned cc, Bit64u op1, Bit64u op2, Bit64u res, Bit64u got, Bit64u want)
+{
+  if (nanobox_flagbug_count++ < 20)
+    fprintf(stderr, "[nanobox-flags] MISMATCH what=%u kind=%u cc=%u op1=%llx op2=%llx res=%llx got=%llx want=%llx rip=%llx\n", what, kind, cc,
+            (unsigned long long) op1, (unsigned long long) op2, (unsigned long long) res, (unsigned long long) got, (unsigned long long) want, (unsigned long long) BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx);
+}
+// Cold-path register spill out of line (nanobox_jit_outline bit 11). Every slow arm, deopt and
+// handler step stores its dirty guest registers one by one -- 9 wasm bytes each, the same sequence
+// at every site. The values are in wasm locals, so they travel as arguments; `mask` says which
+// registers they are (bit r = gen_reg[r], 16 = oszapc.result, 17 = oszapc.auxbits) and they arrive
+// in ascending bit order, exactly the order the inline stores ran in.
+static BX_CPP_INLINE void nanobox_spill_apply(Bit32u mask, const Bit64u *v)
+{
+  unsigned j = 0;
+  for (unsigned r = 0; r < 16; r++) if (mask & (1u << r)) BX_CPU_THIS_PTR gen_reg[r].rrx = v[j++];
+  if (mask & 0x10000) BX_CPU_THIS_PTR oszapc.result = v[j++];
+  if (mask & 0x20000) BX_CPU_THIS_PTR oszapc.auxbits = v[j++];
+}
+static void nanobox_spill2(Bit32u m, Bit64u a, Bit64u b)
+{ const Bit64u v[2] = { a, b }; nanobox_spill_apply(m, v); }
+static void nanobox_spill3(Bit32u m, Bit64u a, Bit64u b, Bit64u c)
+{ const Bit64u v[3] = { a, b, c }; nanobox_spill_apply(m, v); }
+static void nanobox_spill4(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d)
+{ const Bit64u v[4] = { a, b, c, d }; nanobox_spill_apply(m, v); }
+static void nanobox_spill5(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e)
+{ const Bit64u v[5] = { a, b, c, d, e }; nanobox_spill_apply(m, v); }
+static void nanobox_spill6(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f)
+{ const Bit64u v[6] = { a, b, c, d, e, f }; nanobox_spill_apply(m, v); }
+static void nanobox_spill7(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g)
+{ const Bit64u v[7] = { a, b, c, d, e, f, g }; nanobox_spill_apply(m, v); }
+static void nanobox_spill8(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h)
+{ const Bit64u v[8] = { a, b, c, d, e, f, g, h }; nanobox_spill_apply(m, v); }
+static void nanobox_spill9(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i)
+{ const Bit64u v[9] = { a, b, c, d, e, f, g, h, i }; nanobox_spill_apply(m, v); }
+static void nanobox_spill10(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j)
+{ const Bit64u v[10] = { a, b, c, d, e, f, g, h, i, j }; nanobox_spill_apply(m, v); }
+// NANOBOX_FAULTARM bit 0 widens the outlined range: 2 registers (12 emitted bytes against 18
+// inline) and 11-18 (the whole file plus the lazy-flag pair, which a deopt after a long template
+// reaches). The old range 3-10 was not a measured optimum, it was the set of helpers that existed.
+static void nanobox_spill11(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j, Bit64u k)
