+      em->mem(I32_LOAD, 0, 2);
+      iff();
+        profCount(&nanobox_stats.link_fail[6]);
+        em->get(W); em->i32c(size); em->call(fn(FNIDX(&nanobox_helper_dec_write_stamp), "li>v"));
+      endb();
+    endb();
+    needAsyncCheck = true; // handleSMC sets BX_ASYNC_EVENT_STOP_TRACE
+  }
