+static Bit64u nanobox_simd_stats[8];      // [0..] counters for the harness (level 3): 0 = pcmpistri helper calls, 1 = rep fast paths, 2 = rep deopts
+static Bit64u nanobox_pcmpistri_imm[256]; // level 3: PCMPISTRI imm8 histogram
