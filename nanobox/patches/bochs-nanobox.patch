+    // ---- prefetch hints: no architectural effect
+    case BX_IA_PREFETCHT0_Mb: case BX_IA_PREFETCHT1_Mb: case BX_IA_PREFETCHT2_Mb: case BX_IA_PREFETCHNTA_Mb: case BX_IA_PREFETCHW_Mb: case BX_IA_PREFETCH_Mb:
