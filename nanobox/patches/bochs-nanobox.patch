+      case BX_IA_##NAME##_EbGb: op = OPV; size = 1; form = 1; break; \
+      case BX_IA_##NAME##_EbIb: op = OPV; size = 1; form = 2; break; \
+      case BX_IA_##NAME##_ALIb: op = OPV; size = 1; form = 3; break;
