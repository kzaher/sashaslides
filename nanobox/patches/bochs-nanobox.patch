+  // ---------------------------------------------------------------- driver
+  // region mode: make block j the current block (instructions, offsets, entry copy)
+  int blockPage(unsigned j) { return (int) reg->b[j].page; }
+  void setBlock(unsigned j) {
+    curBlock = j; ins = reg->b[j].ins; n = reg->b[j].n; boff = reg->b[j].boff; e = &reg->b[j].ent;
+    off[0] = 0;
+    for (unsigned k = 0; k < n; k++) off[k + 1] = off[k] + ins[k].ilen();
+  }
+  bool compile() {
+    if (reg) { setBlock(0); regionKernel = (BX_CPU_THIS_PTR user_pl == 0); }
+    else {
+      for (n = 0; n < e->tlen; n++) {
+        if (ins[n].getIaOpcode() == BX_INSERTED_OPCODE) break;
+      }
+      off[0] = 0;
+      for (unsigned k = 0; k < n; k++) off[k + 1] = off[k] + ins[k].ilen();
+    }
+    if (n == 0 || n > nanobox_jit_maxlen) return false;
+    mode64 = (BX_CPU_THIS_PTR cpu_mode == BX_MODE_LONG_64);
+    // flag entry classes (depend on the instructions only)
+    for (unsigned j = 0; j <= NB_REGION_MAX_BLOCKS; j++) blockFlagEntry[j] = FE_OTHER;
+    if (reg) { for (unsigned j = 0; j < reg->nblocks; j++) { setBlock(j); blockFlagEntry[j] = (Bit8u) flagEntryClass(0); if (blockFlagEntry[j] == FE_SLOW) fsc(FS_BLOCKS_SLOW); } setBlock(0); }
+    else { blockFlagEntry[0] = (Bit8u) flagEntryClass(0); if (blockFlagEntry[0] == FE_SLOW) fsc(FS_BLOCKS_SLOW); }
