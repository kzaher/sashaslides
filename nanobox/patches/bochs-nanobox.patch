+    // the chain would have returned to cpu_loop: so do we.
+    zaddr(ADDR(nanobox_trace_end)); em->mem(I32_LOAD8_U, zoff(ADDR(nanobox_trace_end)), 0);
+    zaddr(ADDR(BX_CPU_THIS_PTR async_event)); em->mem(I32_LOAD, zoff(ADDR(BX_CPU_THIS_PTR async_event)), 2);
+    em->op(I32_OR);
+    }
