+  // ---------------------------------------------------------------- memory access
+  uint32_t accessorRead(MemKind kind, unsigned size, const char *&sig) {
+    sig = size == 8 ? "il>l" : "il>i";
+    switch (kind) {
+      case MK_RD_LIN:
+        return size == 8 ? FNIDX(&BX_CPU_C::read_linear_qword) : size == 4 ? FNIDX(&BX_CPU_C::read_linear_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::read_linear_word) : FNIDX(&BX_CPU_C::read_linear_byte);
+      case MK_RD_VIRT:
+        return size == 8 ? FNIDX(&BX_CPU_C::read_virtual_qword) : size == 4 ? FNIDX(&BX_CPU_C::read_virtual_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::read_virtual_word) : FNIDX(&BX_CPU_C::read_virtual_byte);
+      case MK_RMW_LIN:
+        return size == 8 ? FNIDX(&BX_CPU_C::read_RMW_linear_qword) : size == 4 ? FNIDX(&BX_CPU_C::read_RMW_linear_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::read_RMW_linear_word) : FNIDX(&BX_CPU_C::read_RMW_linear_byte);
+      case MK_RMW_VIRT:
+        return size == 8 ? FNIDX(&BX_CPU_C::read_RMW_virtual_qword) : size == 4 ? FNIDX(&BX_CPU_C::read_RMW_virtual_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::read_RMW_virtual_word) : FNIDX(&BX_CPU_C::read_RMW_virtual_byte);
+      default: sig = ""; return 0;
+    }
+  }
+  uint32_t accessorWrite(MemKind kind, unsigned size, const char *&sig) {
+    switch (kind) {
+      case MK_WR_LIN:
+        sig = size == 8 ? "ill>v" : "ili>v";
+        return size == 8 ? FNIDX(&BX_CPU_C::write_linear_qword) : size == 4 ? FNIDX(&BX_CPU_C::write_linear_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::write_linear_word) : FNIDX(&BX_CPU_C::write_linear_byte);
+      case MK_WR_VIRT:
+        sig = size == 8 ? "ill>v" : "ili>v";
+        return size == 8 ? FNIDX(&BX_CPU_C::write_virtual_qword) : size == 4 ? FNIDX(&BX_CPU_C::write_virtual_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::write_virtual_word) : FNIDX(&BX_CPU_C::write_virtual_byte);
+      case MK_RMW_LIN: case MK_RMW_VIRT:
+        sig = size == 8 ? "l>v" : "i>v";
+        return size == 8 ? FNIDX(&BX_CPU_C::write_RMW_linear_qword) : size == 4 ? FNIDX(&BX_CPU_C::write_RMW_linear_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::write_RMW_linear_word) : FNIDX(&BX_CPU_C::write_RMW_linear_byte);
+      default: sig = ""; return 0;
+    }
+  }
+  static Op loadOp(unsigned size) { return size == 8 ? I64_LOAD : size == 4 ? I64_LOAD32_U : size == 2 ? I64_LOAD16_U : I64_LOAD8_U; }
