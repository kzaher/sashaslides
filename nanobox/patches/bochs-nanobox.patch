+    if (h == &BX_CPU_C::VMOVAPS_VpsWpsR) { if (vl == BX_VL128 || vl == BX_VL256) d.kind = SK_VMOV_R; return d; }
+    if (h == &BX_CPU_C::VMOVUPS_VpsWpsM || h == &BX_CPU_C::VMOVAPS_VpsWpsM) { if (vl == BX_VL128 || vl == BX_VL256) { d.kind = SK_VMOV_LD; d.aligned = (h == &BX_CPU_C::VMOVAPS_VpsWpsM); } return d; }
+    if (h == &BX_CPU_C::VMOVUPS_WpsVpsM || h == &BX_CPU_C::VMOVAPS_WpsVpsM) { if (vl == BX_VL128 || vl == BX_VL256) { d.kind = SK_VMOV_ST; d.aligned = (h == &BX_CPU_C::VMOVAPS_WpsVpsM); } return d; }
+    if (h == &BX_CPU_C::MOVUPS_WpsVpsM || h == &BX_CPU_C::MOVAPS_WpsVpsM) { d.kind = SK_VMOV_ST; d.op = 1 /* 16 bytes regardless of VL */; d.aligned = (h == &BX_CPU_C::MOVAPS_WpsVpsM); return d; }
