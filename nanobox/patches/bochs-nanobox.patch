+    case BX_IA_CMOVO_GdEd: case BX_IA_CMOVNO_GdEd: case BX_IA_CMOVB_GdEd: case BX_IA_CMOVNB_GdEd: case BX_IA_CMOVZ_GdEd: case BX_IA_CMOVNZ_GdEd:
