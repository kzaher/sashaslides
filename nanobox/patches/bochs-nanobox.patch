+  // condition code -> i32 (0/1) on stack
+  void pushCond(unsigned cc) {
+    fsc(FS_COND_TOTAL);
+    if (cs.pfOp != PF_NONE) {
+      fsc(FS_COND_PENDING);
+      if (pushCondDirect(cc)) {
+        fsc(FS_DIRECT); profCount(&nanobox_flags_stats[FD_DIRECT]); usedLf = true;
