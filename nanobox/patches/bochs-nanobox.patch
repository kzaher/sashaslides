+  uint32_t C_lpf, C_host, C_bits, C_ppf, C_free;
+  uint32_t D_lpf, D_host, D_bits, D_ppf, D_free;   // second probe-cache entry (the previously used page)
+  // folded tags (nanobox_tlbfold): C_tagR/C_tagW hold the page's LPF only when a read /
+  // write of the current CPL is permitted on it, no alignment check is pending (acm == 0)
