+/////////////////////////////////////////////////////////////////////////
+// The dedicated stack window (NANOBOX_STACKTAG).
+//
+// x86 truth, not a heuristic: a page is a stack page iff BX_CPU_C::stackPrefetch() resolved the
+// stack window to it, and Bochs funnels PUSH/POP/CALL/RET/ENTER/LEAVE, interrupt and exception
+// frames, IRET and task switches through that one path. So the emitted fast path reads the CPU's
+// OWN window -- espPageBias / espPageWindowSize / espHostPtr, the three fields stack_read_qword
+// and stack_write_qword themselves use -- straight out of the CPU struct.
+//
+// That is also the whole invalidation story: the window is invalidated by invalidate_stack_cache(),
+// which paging.cc (TLB flush / CR3 / paging enable), proc_ctrl.cc (CR0/CR4), segment_ctrl_pro.cc
+// (SS loads), tasking.cc (task switch), vm8086.cc and -- for the write-stamp case --
+// serveICacheMiss() already call. There is NO new invalidation to invent and nothing to poison at
+// a handler step or a returning direct call, which is exactly what a per-site probe tag has to do.
+//
+// The two things the emitted form does NOT do are the #AC test and the write-stamp decrement;
+// stackPrefetch closes the window when either is live (see cpu/stack.cc), so such a page simply
+// never reaches the fast path and falls back to the ordinary stack accessor.
+//
+// Returns the page offset of the access (what the interpreter calls espBiased), or (Bit64u)-1 =
+// "this one needs the slow accessor".
+static Bit64u nanobox_stack_fill(Bit64u offset)
+{
+  // stackPrefetch raises #SS in its 16/32-bit segmented branch. Emitted code calls this without a
+  // sync in front of it, so only the flat branch -- which cannot fault -- may be entered here.
+  if (!(BX_CPU_THIS_PTR long64_mode() ||
+        (BX_CPU_THIS_PTR sregs[BX_SEG_REG_SS].cache.valid & SegAccessWOK4G))) return (Bit64u) -1;
+  BX_CPU_THIS_PTR stackPrefetch(offset, 8);
+  const Bit64u biased = offset + BX_CPU_THIS_PTR espPageBias;
+  return (biased < (Bit64u) BX_CPU_THIS_PTR espPageWindowSize) ? biased : (Bit64u) -1;
+}
