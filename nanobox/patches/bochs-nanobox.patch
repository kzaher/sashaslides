+} // namespace
+
+/////////////////////////////////////////////////////////////////////////
+// Compiled-trace cache. iCache entries are short-lived (the trace pool wraps every ~600K decoded
+// instructions and every entry is a direct-mapped slot), but the code they hold is not: the same
+// bytes get decoded into the same instruction stream again and again. Compiled functions are
+// therefore owned by this cache, keyed by a hash of the decoded instructions, and handed back to
+// any entry that decodes the same trace — no threshold wait, no recompilation.
+/////////////////////////////////////////////////////////////////////////
+#define JITCACHE_SIZE (1u << 18)
+#define JITCACHE_LIMIT (JITCACHE_SIZE / 2)
+struct JitCacheEntry { Bit64u key; Bit32u fn; Bit32u len; Bit32u mask; Region *region; }; // mask/region: only for region translations
+static JitCacheEntry jitcache[JITCACHE_SIZE];
+static unsigned jitcache_count = 0;
+static Bit64u jitcache_hits = 0, jitcache_clears = 0;
+
+static Bit64u nanobox_jit_hash(bxICacheEntry_c *e, unsigned &nreal)
+{
+  Bit64u h = 0xcbf29ce484222325ull ^ (nanobox_jit_level * 0x9E3779B97F4A7C15ull);
+  nreal = 0;
+  for (unsigned k = 0; k < e->tlen; k++) {
+    if (e->i[k].getIaOpcode() == BX_INSERTED_OPCODE) break;
+    nreal++;
+    // 8 bytes at a time (bxInstruction_c is a multiple of 8 bytes)
+    const Bit64u *p = (const Bit64u *) &e->i[k];
+    for (unsigned w = 0; w < sizeof(bxInstruction_c) / 8; w++) { h ^= p[w]; h *= 0x100000001b3ull; h ^= h >> 29; }
+  }
+  h ^= nreal;
+  return h ? h : 1;
+}
+static JitCacheEntry *nanobox_jit_cache_slot(Bit64u key)
+{
+  unsigned idx = (unsigned)(key ^ (key >> 29)) & (JITCACHE_SIZE - 1);
+  for (unsigned probe = 0; probe < JITCACHE_SIZE; probe++) {
+    JitCacheEntry *c = &jitcache[(idx + probe) & (JITCACHE_SIZE - 1)];
+    if (c->key == key || c->key == 0) return c;
+  }
+  return NULL;
+}
+static void nanobox_jit_batch_drop(void);
+static void nanobox_jit_cache_clear(void);
+static void nanobox_attach_pool_reset(void);
+static void nanobox_jit_cache_clear(void)
+{
+  nanobox_jit_batch_drop();
+  hook_release_all();
+  nanobox_link_fn = 0;
+  nanobox_attach_pool_reset();   // records point at the regions deleted below
+  for (unsigned i = 0; i < JITCACHE_SIZE; i++) if (jitcache[i].region) delete jitcache[i].region;
+  memset(jitcache, 0, sizeof(jitcache));
+  jitcache_count = 0;
+  jitcache_clears++;
+  // every iCache entry pointing at released code must forget it
+  for (unsigned n = 0; n < BxICacheEntries; n++) BX_CPU(0)->iCache.entry[n].jitfn = 0;
+}
+NB_EXPORT(nanobox_jit_cache_stat) double nanobox_jit_cache_stat(unsigned which)
+{
+  switch (which) { case 0: return jitcache_count; case 1: return (double) jitcache_hits; case 2: return (double) jitcache_clears; default: return 0; }
+}
+
+/////////////////////////////////////////////////////////////////////////
+// Region formation (AOT phase 0): a static control-flow walk from the entry over direct successors
+// (JMP/Jcc targets, fall-through, the continuation after a direct CALL -- never the callee), decoding
+// ahead of execution where the successor has not been decoded yet and, for kernel text (fixed
+// physical mapping), across page boundaries. Regions stop at RET / indirect transfers / SYSCALL and
+// the budgets. A trace decoded from address X is a function of the code bytes and the CPU mode only
+// (Bochs' mergeTraces preserves natural trace ends), so a trace decoded ahead is exactly the trace
+// the interpreter will run from X; the only history in the iCache that is guest-visible is the
+// write-stamp marks (STOP_TRACE placement), which the reference mapping keeps exact (icache.h).
+/////////////////////////////////////////////////////////////////////////
+extern Bit64u nanobox_aot_stats[16];
+unsigned nanobox_jit_region_max = NB_REGION_MAX_BLOCKS;   // regions on by default (--jit-region 1 turns them off) (nanobox_set_jit_region / --jit-region N / page ?region=N)
+// AOT mode (TASKS.md R; harness NANOBOX_AOT=1, page ?aot=1, cfg.aot): 0 = the shipping engine (trace
+// regions from decoded successors on the entry page +/-1, threshold as configured, every in-region
+// edge a full trace boundary). 1 = function-scope static regions (decode ahead over direct targets /
+// fall-through / CALL continuations, kernel multi-page), compile on FIRST touch (threshold 1) when
+// nothing precompiled exists, timer/async tests only at loop back-edges / region exits / handler
+// steps, direct conditions (nanobox_jit_flags bits 0|1) on. Identity with the interpreter's trace
+// boundaries is NOT kept in this mode by design; guest RAM may differ from the reference engine's.
+unsigned nanobox_jit_aot = 0;
+unsigned nanobox_jit_aot_ahead = 1;   // AOT: decode successors that are not in the iCache yet (0: only decoded ones join, as before)
+unsigned nanobox_jit_aot_minhot = 0;  // AOT: a decoded successor joins only if its slot has executed at least this often (0: any)
+unsigned nanobox_jit_aot_dedupe = 0;  // AOT: a successor that already carries a translation (member of another region / plain trace) is not copied in again (its edge stays an external link)
+// AOT: how many times a self-loop may take its back edge before it runs the full inter-trace sync
+// (guest timer, async_event, fetch window). Identity is waived under the flag, so the interrupt is
+// seen up to this many iterations late -- at 64 iterations of a 6-instruction loop that is <400 guest
+// instructions, well under a microsecond of guest time. 1 = the identity behaviour (check every time).
+unsigned nanobox_jit_aot_tick = 64;
+// AOT, on the user's instruction: a guest CALL need not write its return address into emulated RAM
+// and a guest RET need not read it back -- both are a TLB probe plus a memory access (~20 and ~15
+// wasm instructions) for a value the engine already knows. With this on, the pair is kept on a HOST
+// shadow stack instead: CALL records (rsp_after, return VA), RET takes the top entry when the guest's
+// rsp still matches it. RSP itself is still adjusted -- it is architecturally visible and the callee
+// addresses its locals through it; only the 8 bytes it points at are not written.
+//
+// THE HAZARD, stated plainly: guest code reads those bytes. Rust and C++ unwinders walk .eh_frame and
+// read return addresses off the stack on every panic; call/pop PIC idioms, setjmp/longjmp and a
+// kernel reading a user stack do the same. Those reads get whatever was in that memory before. The
+// mismatch counter (nanobox_stat 19) shows every RET whose rsp did not match the shadow entry --
+// non-zero means the guest is manipulating return addresses and this mode is not safe for it.
+// MEASURED 2026-08-18: with this on the guest does not survive its own boot -- the kernel changes
+// stacks constantly (interrupts, syscalls, context switches), so the shadow entry's rsp stops
+// matching, and the return address the guest then needs was never written. Storing the return
+// address is the floor; what can go is everything AROUND the store (see emitStackWrite under AOT).
+// Kept as a knob for experiments only; default OFF.
+unsigned nanobox_jit_aot_nostack = 0;
+NbShadowEnt nanobox_shadow[NB_SHADOW_MAX];
+unsigned nanobox_shadow_n = 0;
+Bit64u nanobox_shadow_miss = 0;
+NB_EXPORT(nanobox_set_jit_region) void nanobox_set_jit_region(unsigned maxBlocks) { nanobox_jit_region_max = maxBlocks; }
+// nanobox_set_jit_aot(1) after nanobox_set_jit(level, threshold): threshold -> 1 and the direct-condition
+// bits go on (nanobox_set_jit_flags / NANOBOX_FLAGS afterwards can still override the mask)
+NB_EXPORT(nanobox_set_jit_aot) void nanobox_set_jit_aot(unsigned on)
+{
+  nanobox_jit_aot = on;
+  // dedupe is ON in AOT mode: with every block an entry point, a successor that already carries a
+  // translation was being copied into each region that reaches it -- 652 MB of wasm for one codex
+  // boot, 193 k of the 216 k regions duplicates of code already translated. Turning it on measured
+  // 652 -> 304 MB and boot 28.6 -> 23.0 s with nothing else changed (TASKS.md R.2); the offline
+  // artifact holds one translation per block, which is what the runtime should attach to.
+  // NANOBOX_AOT_DEDUPE=0 restores the copying former for an A/B.
+  if (on) { nanobox_jit_threshold = 1; nanobox_jit_flags |= 1 | 2; nanobox_jit_aot_dedupe = 1; }
+  // the census counters live in the wizer snapshot too (the pre-init boot ran ~95 M interpreted traces
+  // with the JIT off): start them from zero for this run
+  nanobox_stats.interp_traces = 0; nanobox_stats.interp_icount = 0; nanobox_stats.jit_intrans = 0;
+  memset(nanobox_aot_stats, 0, sizeof(nanobox_aot_stats));
+}
+NB_EXPORT(nanobox_set_jit_aot_ahead) void nanobox_set_jit_aot_ahead(unsigned on) { nanobox_jit_aot_ahead = on; }
+NB_EXPORT(nanobox_set_jit_aot_minhot) void nanobox_set_jit_aot_minhot(unsigned n) { nanobox_jit_aot_minhot = n; }
+NB_EXPORT(nanobox_set_jit_aot_dedupe) void nanobox_set_jit_aot_dedupe(unsigned on) { nanobox_jit_aot_dedupe = on; }
+NB_EXPORT(nanobox_set_jit_aot_tick) void nanobox_set_jit_aot_tick(unsigned n) { nanobox_jit_aot_tick = n ? n : 1; }
+NB_EXPORT(nanobox_set_jit_aot_nostack) void nanobox_set_jit_aot_nostack(unsigned on) { nanobox_jit_aot_nostack = on; nanobox_shadow_n = 0; nanobox_shadow_miss = 0; }
+// 0 formed, 1 blocks, 2 compiled, 3 cache hits,
+// 4 traces decoded ahead, 5 decode-ahead skipped (iCache pool would flush / slot in use / no host page),
+// 6 regions dropped: a member entry changed while decoding ahead, 7 CALL continuations pulled in,
+// 8 successors rejected: not decoded (aot off), 9 blocks ending in a dynamic transfer (RET/indirect/syscall),
+// 10 blocks ending in a direct CALL, 11 successors outside the page window (aot off / user), 12 target
+// page not mapped executable / no frame, 13 block budget full, 14 instruction budget full,
+// 15 successor is a self-looping trace, 16 formation attempts, 17 attempts yielding one block,
+// 18 page budget full, 19 regions with >1 page, 20 pages total, 21 regions dropped by a write
+// (registry), 22 dead-region exits taken at a first execution, 23 first-execution marks,
+// 24 successors rejected as too cold (nanobox_jit_aot_minhot), 25 rejected as already translated (dedupe)
+NB_EXPORT(nanobox_jit_region_stat) double nanobox_jit_region_stat(unsigned i) { return i < 32 ? (double) nanobox_region_stats[i] : 0; }
+
+static unsigned nanobox_real_len(const bxICacheEntry_c *e)
+{
+  unsigned n = 0;
+  for (; n < e->tlen; n++) if (e->i[n].getIaOpcode() == BX_INSERTED_OPCODE) break;
+  return n;
+}
+// t[] must hold at least 3 entries
+static bool nanobox_direct_targets(const bxICacheEntry_c *e, unsigned n, Bit32u boff, Bit64s *t, unsigned &nt)
+{
+  // successors of the trace (offsets relative to the region entry); false if the trace ends
+  // with something whose successor is dynamic
+  nt = 0;
+  Bit32u len = 0; for (unsigned k = 0; k < n; k++) len += e->i[k].ilen();
+  const bxInstruction_c *l = &e->i[n - 1];
+  Bit64s fall = (Bit64s) boff + len;
+  Bit64s rel = (Bit64s)(Bit32s) l->Id();
+  switch (l->getIaOpcode()) {
+    case BX_IA_JMP_Jq: case BX_IA_JMP_Jbq: t[nt++] = fall + rel; return true;
+    case BX_IA_CALL_Jq:
+      // a region is one function: it ends at calls (the callee gets its own region), but the
+      // CONTINUATION belongs to this function -- the callee's RET lands in it through the
+      // continuation block's iCache entry (every block is an entry point)
+      if (nanobox_jit_aot) t[nt++] = fall;
+      return true;
+    case BX_IA_JO_Jq: case BX_IA_JNO_Jq: case BX_IA_JB_Jq: case BX_IA_JNB_Jq: case BX_IA_JZ_Jq: case BX_IA_JNZ_Jq:
+    case BX_IA_JBE_Jq: case BX_IA_JNBE_Jq: case BX_IA_JS_Jq: case BX_IA_JNS_Jq: case BX_IA_JP_Jq: case BX_IA_JNP_Jq:
+    case BX_IA_JL_Jq: case BX_IA_JNL_Jq: case BX_IA_JLE_Jq: case BX_IA_JNLE_Jq:
+    case BX_IA_JO_Jbq: case BX_IA_JNO_Jbq: case BX_IA_JB_Jbq: case BX_IA_JNB_Jbq: case BX_IA_JZ_Jbq: case BX_IA_JNZ_Jbq:
+    case BX_IA_JBE_Jbq: case BX_IA_JNBE_Jbq: case BX_IA_JS_Jbq: case BX_IA_JNS_Jbq: case BX_IA_JP_Jbq: case BX_IA_JNP_Jbq:
+    case BX_IA_JL_Jbq: case BX_IA_JNL_Jbq: case BX_IA_JLE_Jbq: case BX_IA_JNLE_Jbq:
+      t[nt++] = fall + rel; t[nt++] = fall; return true;
+    case BX_IA_RET_Op64: case BX_IA_RET_Op64_Iw: case BX_IA_RETF_Op64: case BX_IA_RETF_Op64_Iw: case BX_IA_JMP_Eq: case BX_IA_CALL_Eq:
+    case BX_IA_JMPF_Op64_Ep: case BX_IA_CALLF_Op64_Ep: case BX_IA_IRET_Op64: case BX_IA_SYSCALL: case BX_IA_SYSRET: case BX_IA_SYSENTER: case BX_IA_SYSEXIT: case BX_IA_HLT:
+      return true;
+    default:
+      t[nt++] = fall; return true; // trace ended by length/page/other trace-end op: fall-through
+  }
+}
+// Decode the trace at physical address `pa` (host bytes at `host` = the page's base) BEFORE it has ever
+// executed. Legal because guest code is frozen after boot (TASKS.md J3 census: 5238 code pages, zero
+// violating stores) -- and if it is not, the write reaches handleSMC through the marks this decode
+// makes and invalidates the entry and any region holding it. Restrictions:
+//  * the first instruction must not be able to run off the page: boundaryFetch() can fault;
+//  * decoding must not flush the iCache memory pool (that would invalidate every entry the caller is
+//    still holding), and must not reuse a slot the caller holds (`avoid`);
+//  * the marks it makes are private (fine granularity mapping only, not the reference mapping) and
+//    the entry is tagged nbahead: its first execution marks the reference mapping (icache.h).
+// serveICacheMiss() fetches through the CPU's fetch window; it is pointed at `host` for the call and
+// restored afterwards (the window is guest-invisible cache state and only read by fetches).
+static bxICacheEntry_c *nanobox_decode_ahead(bx_phy_address pa, const Bit8u *host, bxICacheEntry_c **avoid, unsigned navoid)
+{
+  unsigned off = (unsigned)(pa & 0xfff);
+  if (off > 4096 - 16) { nanobox_region_stats[5]++; return NULL; }
+  if (BX_CPU_THIS_PTR iCache.mpindex + BX_MAX_TRACE_LENGTH + 1 > BxICacheMemPool) { nanobox_region_stats[5]++; return NULL; }
+  bxICacheEntry_c *slot = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+  for (unsigned q = 0; q < navoid; q++) if (avoid[q] == slot) { nanobox_region_stats[5]++; return NULL; }
+  const Bit8u *savePtr = BX_CPU_THIS_PTR eipFetchPtr; Bit32u saveWin = BX_CPU_THIS_PTR eipPageWindowSize;
+  bx_phy_address savePage = BX_CPU_THIS_PTR pAddrFetchPage;
+  BX_CPU_THIS_PTR eipFetchPtr = host; BX_CPU_THIS_PTR eipPageWindowSize = 4096; BX_CPU_THIS_PTR pAddrFetchPage = pa & ~(bx_phy_address) 0xfff;
+  nanobox_marks_private = true;
+  bxICacheEntry_c *se = BX_CPU_THIS_PTR serveICacheMiss((Bit32u) off, pa);
+  nanobox_marks_private = false;
+  BX_CPU_THIS_PTR eipFetchPtr = savePtr; BX_CPU_THIS_PTR eipPageWindowSize = saveWin; BX_CPU_THIS_PTR pAddrFetchPage = savePage;
+  if (!se || se->pAddr != pa || se->tlen == 0) return NULL;
+  nanobox_region_stats[4]++;
+  return se;
+}
+// host address of a RAM page (NULL for MMIO/ROM/unallocated: never allocate a block for a decode --
+// the harness compares RAM block by block)
+// ---- offline byte source (TASKS.md R) --------------------------------------------------------
+// The offline translator has to read code the guest is not currently able to show it: a user program's
+// text lives behind ITS page tables, and the AOT session runs between traces, with whatever CR3 the
+// guest happened to leave installed (measured: 3000/3000 functions of codex reported "not mapped").
+// So the driver hands the bytes over itself -- straight out of the program's ELF -- and they are
+// mapped at a synthetic physical base that no guest RAM can occupy. Everything downstream (decode,
+// iCache, the region former) then works exactly as it does for resident memory, and the translation
+// that comes out is keyed by content, so the runtime finds it at whatever address the program is
+// loaded at in a later boot.
+#define NB_AOT_SRC_MAX   (1u << 20)                       // one window; functions are far smaller
+static const bx_phy_address NB_AOT_SRC_PHYS = (bx_phy_address) 1 << 40;   // 1 TiB: above any guest RAM
+static Bit8u nanobox_aot_srcbuf[NB_AOT_SRC_MAX] __attribute__((aligned(4096)));
+static bx_address nanobox_aot_src_lin = 0;                // page-aligned guest linear address of buf[0]
+static Bit64u nanobox_aot_src_len = 0;                    // 0 = no source: read guest RAM as usual
+static bool nanobox_aot_src_covers(bx_address lin)
+{
+  return nanobox_aot_src_len && lin >= nanobox_aot_src_lin && lin < nanobox_aot_src_lin + nanobox_aot_src_len;
+}
+// linear -> physical for the translator: the source window first, then the guest's own page tables
+static bool nanobox_aot_xlate(bx_address lin, bx_phy_address *pa)
+{
+  if (nanobox_aot_src_covers(lin)) { *pa = NB_AOT_SRC_PHYS + (bx_phy_address)(lin - nanobox_aot_src_lin); return true; }
+  return BX_CPU_THIS_PTR dbg_xlate_linear2phy(lin, pa);
+}
+static const Bit8u *nanobox_host_page(bx_phy_address page)
+{
+  if (nanobox_aot_src_len && page >= NB_AOT_SRC_PHYS && page < NB_AOT_SRC_PHYS + nanobox_aot_src_len)
+    return nanobox_aot_srcbuf + (page - NB_AOT_SRC_PHYS);
+  Bit32u bs = BX_MEM(0)->nanobox_block_size();
+  if (!BX_MEM(0)->nanobox_block_ptr((Bit32u)(page / bs))) return NULL;
+  return BX_MEM(0)->getHostMemAddr(BX_CPU_THIS, page, BX_EXECUTE);
+}
+// entryLin: the entry's linear address (cpu_loop calls right after RIP += ilen(first): RIP - ilen;
+// the offline AOT driver passes the address it translates)
+static Region *nanobox_form_region(bxICacheEntry_c *e, bx_address entryLin)
+{
+  if (nanobox_jit_region_max <= 1) return NULL;
+  nanobox_region_stats[16]++;
+  unsigned n0 = nanobox_real_len(e);
+  if (n0 == 0) return NULL;
+  bx_phy_address page = e->pAddr & ~(bx_phy_address) 0xfff;
+  Bit32u entryOff = (Bit32u)(e->pAddr & 0xfff);
+  bool kernel = (BX_CPU_THIS_PTR user_pl == 0);
+  Region *r = new Region();
+  r->npages = 1; r->pdelta[0] = 0; r->ppf[0] = e->pAddr >> 12; r->pmask[0] = 0;
+  const Bit8u *hostOf[NB_REGION_MAX_PAGES]; hostOf[0] = NULL;
+  unsigned totalInstr = 0;
+  // the entry's linear address (cpu_loop calls us right after RIP += ilen(first)): needed to find
+  // the physical page behind another linear page through the ITLB / page walk
+  bx_address entryPageLin = entryLin & ~(bx_address) 0xfff;
+  // BFS. Decode-ahead can evict a slot the walk already collected, so remember what each entry must
+  // still be (physical address + trace length) and revalidate before copying the bytes out.
+  bxICacheEntry_c *src[NB_REGION_MAX_BLOCKS]; Bit32s boffs[NB_REGION_MAX_BLOCKS]; unsigned bpage[NB_REGION_MAX_BLOCKS];
+  bx_phy_address pas[NB_REGION_MAX_BLOCKS]; unsigned lens[NB_REGION_MAX_BLOCKS];
+  src[0] = e; boffs[0] = 0; bpage[0] = 0; pas[0] = e->pAddr; lens[0] = e->tlen;
+  unsigned nb = 1, head = 0; bool decodedAhead = false;
+  while (head < nb) {
+    bxICacheEntry_c *be = src[head]; Bit32s bo = boffs[head]; head++;
+    unsigned n = nanobox_real_len(be);
+    if (n == 0) { delete r; return NULL; }
+    Bit64s t[4]; unsigned nt;
+    if (!nanobox_direct_targets(be, n, bo, t, nt)) continue;
+    { unsigned ia = be->i[n - 1].getIaOpcode();                       // census: why does this block end?
+      if (ia == BX_IA_CALL_Jq) nanobox_region_stats[10]++; else if (nt == 0) nanobox_region_stats[9]++; }
+    for (unsigned q = 0; q < nt; q++) {
+      if (nb >= nanobox_jit_region_max || nb >= NB_REGION_MAX_BLOCKS) { nanobox_region_stats[13]++; continue; }
+      Bit64s roff = t[q];
+      bool dup = false; for (unsigned j = 0; j < nb; j++) if ((Bit64s) boffs[j] == roff) { dup = true; break; }
+      if (dup) continue;
+      // which page does the target lie in?
+      bx_address lin = entryLin + (bx_address) roff;
+      Bit64s pd = (Bit64s)((lin & ~(bx_address) 0xfff) - entryPageLin) >> 12;
+      unsigned p = 0; bool found = false;
+      for (; p < r->npages; p++) if ((Bit64s) r->pdelta[p] == pd) { found = true; break; }
+      if (!found) {
+        if (!nanobox_jit_aot || (!kernel && (pd < -1 || pd > 1))) { nanobox_region_stats[11]++; continue; }
+        if (!nanobox_jit_aot && r->npages > 1) { nanobox_region_stats[11]++; continue; }   // legacy former: one adjacent page
+        if (r->npages >= NB_REGION_MAX_PAGES) { nanobox_region_stats[18]++; continue; }
+        // physical frame of the target's linear page: ITLB (executable at this CPL) or, for kernel
+        // text (mapping fixed after boot), a side-effect-free page walk
+        bx_address lin2 = lin & ~(bx_address) 0xfff;
+        bx_TLB_entry *tl = BX_ITLB_ENTRY_OF(lin2);
+        Bit64u frame = 0; const Bit8u *host = NULL;
+        if (!nanobox_aot_src_covers(lin2) && tl->lpf == LPFOf(lin2) && (tl->accessBits & (1u << BX_CPU_THIS_PTR user_pl))) { frame = tl->ppf >> 12; host = (const Bit8u *) tl->hostPageAddr; }
+        else if (nanobox_jit_aot) {
+          // (AOT mode: user pages too -- keeps the walk independent of the ITLB's state, so the offline
+          //  driver and the runtime form the same region; the transition still checks the ITLB + frame)
+          bx_phy_address phy = 0;
+          if (!nanobox_aot_xlate(lin2, &phy)) { nanobox_region_stats[12]++; continue; }
+          frame = phy >> 12;
+        } else { nanobox_region_stats[12]++; continue; }
+        if (!host) host = nanobox_host_page((bx_phy_address) frame << 12);
+        if (!host) { nanobox_region_stats[12]++; continue; }
+        p = r->npages++;
+        r->pdelta[p] = (Bit32s) pd; r->ppf[p] = frame; r->pmask[p] = 0; hostOf[p] = host;
+      }
+      bx_phy_address pa = ((bx_phy_address) r->ppf[p] << 12) + (bx_phy_address)(lin & 0xfff);
+      bxICacheEntry_c *se = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+      if (se->pAddr != pa || se->tlen == 0) {                // not decoded (never executed yet, or evicted)
+        if (!nanobox_jit_aot || !nanobox_jit_aot_ahead) { nanobox_region_stats[8]++; continue; }   // legacy former: the region ends here
+        const Bit8u *host = hostOf[p];
+        if (!host) { host = nanobox_host_page(page); hostOf[p] = host; }
+        if (!host) { nanobox_region_stats[5]++; continue; }
+        se = nanobox_decode_ahead(pa, host, src, nb);
+        if (!se) continue;
+        decodedAhead = true;
+      }
+      unsigned sn = nanobox_real_len(se);
+      if (sn == 0 || sn > nanobox_jit_maxlen) continue;
+      if (nanobox_jit_aot_minhot && *BX_CPU_THIS_PTR iCache.hotOf(se) < nanobox_jit_aot_minhot) { nanobox_region_stats[24]++; continue; } // cold successor: not worth the code
+      if (nanobox_jit_aot_dedupe && se->jitfn) { nanobox_region_stats[25]++; continue; }   // already compiled elsewhere: do not copy it into this region too
+      if (totalInstr + sn > NB_REGION_MAX_INSTR) { nanobox_region_stats[14]++; continue; }
+      // a trace that branches back to its own start is better off as a single-trace loop (registers
+      // stay in locals across iterations); inside a region it would go through the dispatch loop
+      { Bit64s st[4]; unsigned snt; nanobox_direct_targets(se, sn, 0, st, snt); bool self = false; for (unsigned q2 = 0; q2 < snt; q2++) if (st[q2] == 0) self = true; if (self) { nanobox_region_stats[15]++; continue; } }
+      totalInstr += sn;
+      src[nb] = se; boffs[nb] = (Bit32s) roff; bpage[nb] = p; pas[nb] = pa; lens[nb] = se->tlen; nb++;
+    }
+  }
+  if (nb == 1) { nanobox_region_stats[17]++; delete r; return NULL; }
+  if (decodedAhead) {
+    // a decode-ahead may have reused any iCache slot: every entry we are about to copy out (and the
+    // caller's own `e`) must still hold the trace we looked at
+    for (unsigned j = 0; j < nb; j++) {
+      if (src[j]->pAddr != pas[j] || src[j]->tlen != lens[j]) { nanobox_region_stats[6]++; delete r; return NULL; }
+    }
+    r->ahead = 1;
+  }
+  { // census: call continuations that landed inside
+    for (unsigned j = 0; j < nb; j++) {
+      unsigned nj = nanobox_real_len(src[j]);
+      if (!nj || src[j]->i[nj - 1].getIaOpcode() != BX_IA_CALL_Jq) continue;
+      Bit32u len = 0; for (unsigned q = 0; q < nj; q++) len += src[j]->i[q].ilen();
+      Bit64s cont = (Bit64s) boffs[j] + (Bit64s) len;
+      for (unsigned q = 0; q < nb; q++) if ((Bit64s) boffs[q] == cont) nanobox_region_stats[7]++;
+    }
+  }
+  r->nblocks = nb;
+  for (unsigned j = 0; j < nb; j++) {
+    RegionBlock &b = r->b[j];
+    b.ent = *src[j];
+    b.n = nanobox_real_len(src[j]);
+    // copy the whole trace incl. the inserted end marker (the fingerprint logger prints tlen entries)
+    b.ins = new bxInstruction_c[src[j]->tlen];
+    memcpy(b.ins, src[j]->i, src[j]->tlen * sizeof(bxInstruction_c));
+    b.ent.i = b.ins; b.ent.tlen = src[j]->tlen; b.ent.jitfn = 0; b.ent.nbahead = 0; b.ent.jitarg = 0;
+    b.boff = boffs[j]; b.page = bpage[j];
+    r->pmask[bpage[j]] |= src[j]->traceMask;
+    r->insptr[j] = b.ins; r->entptr[j] = &b.ent;
+    r->srcEntry[j] = src[j]; r->srcI[j] = src[j]->i;
+    r->entry[j].reg = r; r->entry[j].block = j; r->entry[j].delta = (Bit32u)(Bit32s)(boffs[j] + (Bit32s) src[j]->i[0].ilen());
+  }
+  r->mask = r->pmask[0];
+  // pages nothing landed in are dropped (keeps the descriptor and the key stable)
+  { unsigned np = 1; unsigned remap[NB_REGION_MAX_PAGES]; remap[0] = 0;
+    for (unsigned p = 1; p < r->npages; p++) {
+      bool used = false; for (unsigned j = 0; j < nb; j++) if (bpage[j] == p) used = true;
+      if (used) { remap[p] = np; r->pdelta[np] = r->pdelta[p]; r->ppf[np] = r->ppf[p]; r->pmask[np] = r->pmask[p]; np++; } else remap[p] = 0;
+    }
+    for (unsigned j = 0; j < nb; j++) r->b[j].page = remap[bpage[j]];
+    r->npages = np; }
+  if (r->npages > 1) { nanobox_region_stats[19]++; }
+  nanobox_region_stats[20] += r->npages;
+  // an entry that branches back to its own start is better off as a single-trace loop
+  { Bit64s t[4]; unsigned nt; nanobox_direct_targets(e, n0, 0, t, nt); for (unsigned q = 0; q < nt; q++) if (t[q] == 0) { delete r; return NULL; } }
+  // content key: the site (entry pAddr, CPL: the descriptor holds per-site state -- srcEntry,
+  // pending marks, page frames -- so a region is shared only by attaches at the same site) + page
+  // deltas + offsets + instructions of every block
+  Bit64u h = 0xcbf29ce484222325ull ^ (nanobox_jit_level * 0x9E3779B97F4A7C15ull) ^ 0x5245474e00000000ull ^ (Bit64u)(kernel ? 0x4b : 0x55); // 'REGN'
+  // AOT mode: the key is CONTENT ONLY. The site (entry pAddr) is what a precompiled artifact cannot
+  // know for user code -- a PIE lands on different physical pages in every boot -- so keying by it
+  // means the offline translation of codex/agy is never found again (measured: the deduped kernel
+  // bundle hit, the user code missed and 326 MB was recompiled at runtime, TASKS.md R.2). The code
+  // is position independent (page deltas, no absolute frames) and the per-site state lives in the
+  // EntryDesc built at the attach, not in the module, so two sites that decoded the same bytes may
+  // share one translation. The default engine keeps the site in the key (identity-preserving path).
+  if (!nanobox_jit_aot) { h ^= (Bit64u) e->pAddr * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29; }
+  for (unsigned p = 0; p < r->npages; p++) { h ^= (Bit64u)(Bit64s) r->pdelta[p] * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29; }
+  for (unsigned j = 0; j < nb; j++) {
+    h ^= (Bit64u)(Bit64s) r->b[j].boff * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29;
+    h ^= (Bit64u) r->b[j].page * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29;
+    for (unsigned k = 0; k < r->b[j].n; k++) {
+      const Bit64u *p = (const Bit64u *) &r->b[j].ins[k];
+      for (unsigned w = 0; w < sizeof(bxInstruction_c) / 8; w++) { h ^= p[w]; h *= 0x100000001b3ull; h ^= h >> 29; }
+    }
+  }
+  r->key = h ? h : 1;
+  nanobox_region_stats[0]++; nanobox_region_stats[1] += nb;
+  return r;
+}
+// Attach registry: (physical page -> region) records so that a write into ANY page of a region drops
+// the region (all member entries lose the translation; a running region leaves at its next transition
+// into a not-yet-executed block, see nanobox_region_first). Bochs' own flushSMC only reaches entries
+// hashed in the written page and only through their own (natural) traceMask -- member masks are NOT
+// widened any more, so the fine granularity mapping stays a superset of the reference mapping only by
+// the ahead-decoded chunks. Records are removed when the region is dropped; the pool is swept when
+// full, and if still full the JIT cache is cleared (which resets the registry).
+struct AttachRec { Bit64u ppage; Region *r; Bit32u mask; int next; };
+enum { NB_ATTACH_POOL = 131072, NB_ATTACH_BUCKETS = 8192 };
+static AttachRec *nb_attach = NULL; static int nb_attach_head[NB_ATTACH_BUCKETS]; static int nb_attach_free = -1; static bool nb_attach_init = false; static unsigned nb_attach_used = 0;
+static Bit32u nb_attach_epoch = 1;   // bumped on every reset: a region's records exist iff r->regEpoch == nb_attach_epoch (0 = never registered)
+static void nanobox_attach_pool_reset(void)
+{
+  if (!nb_attach) nb_attach = (AttachRec *) calloc(NB_ATTACH_POOL, sizeof(AttachRec));
+  for (int i = 0; i < NB_ATTACH_POOL; i++) nb_attach[i].next = (i + 1 < NB_ATTACH_POOL) ? i + 1 : -1;
+  nb_attach_free = 0; nb_attach_used = 0;
+  for (int b = 0; b < NB_ATTACH_BUCKETS; b++) nb_attach_head[b] = -1;
+  nb_attach_init = true;
+  if (++nb_attach_epoch == 0) nb_attach_epoch = 1;
+}
+static bool nanobox_attach_registered(const Region *r) { return nb_attach_init && r->regEpoch != 0 && r->regEpoch == nb_attach_epoch; }
+static unsigned nanobox_attach_bucket(Bit64u ppage) { return (unsigned)(ppage * 0x9E3779B97F4A7C15ull >> 51) & (NB_ATTACH_BUCKETS - 1); }
+static void nanobox_attach_unlink_region(Region *r)
+{
+  for (unsigned p = 0; p < r->npages; p++) {
+    int *pp = &nb_attach_head[nanobox_attach_bucket(r->ppf[p])];
+    while (*pp >= 0) {
+      AttachRec &a = nb_attach[*pp];
+      if (a.r == r) { int idx = *pp; *pp = a.next; a.next = nb_attach_free; nb_attach_free = idx; nb_attach_used--; }
+      else pp = &a.next;
+    }
+  }
+  r->regEpoch = 0;
+}
+static void nanobox_attach_sweep(void)
+{
+  for (int b = 0; b < NB_ATTACH_BUCKETS; b++) {
+    int *pp = &nb_attach_head[b];
+    while (*pp >= 0) {
+      AttachRec &a = nb_attach[*pp];
+      if (!nanobox_attach_registered(a.r)) { int idx = *pp; *pp = a.next; a.next = nb_attach_free; nb_attach_free = idx; nb_attach_used--; }
+      else pp = &a.next;
+    }
+  }
+}
+// members lose the translation; a running region notices at its next first-execution check
+static void nanobox_region_drop(Region *r)
+{
+  for (unsigned j = 0; j < r->nblocks; j++) {
+    bxICacheEntry_c *se = r->srcEntry[j];
+    if (se && se->pAddr == r->b[j].ent.pAddr && se->jitfn == r->fn && r->fn) { se->jitfn = 0; *BX_CPU_THIS_PTR iCache.hotOf(se) = 0; }
+  }
+  r->dead = 1;
+  if (nanobox_attach_registered(r)) nanobox_attach_unlink_region(r);
+}
+static bool nanobox_attach_register(Region *r)
+{
+  if (!nb_attach_init) nanobox_attach_pool_reset();
+  if (nanobox_attach_registered(r)) return true;
+  if (nb_attach_used + r->npages > NB_ATTACH_POOL) nanobox_attach_sweep();
+  if (nb_attach_used + r->npages > NB_ATTACH_POOL) return false;
+  for (unsigned p = 0; p < r->npages; p++) {
+    int idx = nb_attach_free; nb_attach_free = nb_attach[idx].next; nb_attach_used++;
+    AttachRec &a = nb_attach[idx];
+    a.ppage = r->ppf[p]; a.r = r; a.mask = r->pmask[p];
+    unsigned b = nanobox_attach_bucket(r->ppf[p]);
+    a.next = nb_attach_head[b]; nb_attach_head[b] = idx;
+    // the chunks are marked already (their decode did it); re-marking is private (never a reference mark)
+    nanobox_marks_private = true; pageWriteStampTable.markICacheMask((bx_phy_address) r->ppf[p] << 12, r->pmask[p]); nanobox_marks_private = false;
+  }
+  r->regEpoch = nb_attach_epoch;
+  return true;
+}
+// called from handleSMC() for every write into a page that carries code marks
+void nanobox_jit_page_written(bx_phy_address pAddr, Bit32u mask)
+{
+  if (!nb_attach_init || nb_attach_used == 0) return;
+  Bit64u pp = pAddr >> 12;
+  int *ptr = &nb_attach_head[nanobox_attach_bucket(pp)];
+  while (*ptr >= 0) {
+    AttachRec &a = nb_attach[*ptr];
+    if (a.ppage == pp && (a.mask & mask)) {
+      Region *r = a.r;
+      nanobox_region_stats[21]++;
+      nanobox_region_drop(r);   // unlinks all of r's records, possibly including *ptr: restart this bucket
+      ptr = &nb_attach_head[nanobox_attach_bucket(pp)];
+      continue;
+    }
+    ptr = &a.next;
+  }
+}
+// interpreter path: an entry decoded ahead executes for the first time -> the reference would decode it now
+void nanobox_jit_ahead_first(bxICacheEntry_c *e)
+{
+  e->nbahead = 0;
+  pageWriteStampTable.nanobox_ref_mark(e->pAddr, e->traceMask);
+  nanobox_region_stats[23]++;
+}
+// attach the region to entry e (block 0: regions are formed from e) and to every other member block
+// whose iCache entry still holds the same trace (validated by pAddr + content: the region may come
+// from the cache and the entries may have been re-decoded since)
+static void nanobox_region_attach(bxICacheEntry_c *e, unsigned fn, Bit32u mask, Region *r)
+{
+  (void) mask;
+  if (nanobox_attach_registered(r) && r->fn != fn) nanobox_attach_unlink_region(r);
+  r->fn = fn; r->dead = 0;
+  if (!nanobox_attach_register(r)) { nanobox_jit_cache_clear(); return; }   // (clears everything incl. e->jitfn)
+  for (unsigned j = 0; j < r->nblocks; j++) {
+    bx_phy_address pa = r->b[j].ent.pAddr;
+    bxICacheEntry_c *se = (r->srcEntry[j] == e || (j == 0 && e->pAddr == pa)) ? e : BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+    r->srcEntry[j] = se; r->pending[j] = 1;
+    if (se->pAddr != pa || se->tlen != r->b[j].ent.tlen) continue;
+    if (se != e && memcmp(se->i, r->b[j].ins, se->tlen * sizeof(bxInstruction_c)) != 0) continue; // a different trace lives there now
+    if (se->jitfn && se != e) continue; // already has its own translation
+    se->jitfn = fn; se->jitarg = (Bit32u)(uintptr_t) &r->entry[j];
+  }
+}
+
+// called by serveICacheMiss() once a trace has been decoded into `e`
+void nanobox_jit_after_decode(bxICacheEntry_c *e)
+{
+  // (the slot's hotness counter is deliberately kept: a re-decoded trace inherits it)
+  if (!nanobox_jit_level || nanobox_dbg_mode) return;
+  if (nanobox_marks_private) return;   // decoded ahead: no translation before its first execution has been seen (reference marks)
+  unsigned nreal;
+  Bit64u key = nanobox_jit_hash(e, nreal);
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  if (c && c->key == key && !c->region) { e->jitfn = c->fn; e->jitarg = (Bit32u)(uintptr_t) e->i; jitcache_hits++; }
+}
+
+
+/////////////////////////////////////////////////////////////////////////
+// Compile driver with batching. Hot traces are compiled into a shared module as they show up and
+// the module is handed to the host once it holds NB_BATCH functions (or has waited long enough):
+// V8's per-module cost (~60-100 us) then amortises over the batch, and the shared link function
+// keeps every function small.
+/////////////////////////////////////////////////////////////////////////
+enum { NB_BATCH = 32, NB_BATCH_MAX_TRACES_WAIT = 20000 };
+struct Pending { bxICacheEntry_c *e; bx_phy_address pAddr; bxInstruction_c *i; Region *reg; Bit64u key; unsigned local; };
+static Module *nb_batch = NULL;
+static Pending nb_pending[NB_BATCH];
+static unsigned nb_npending = 0;
+static Bit64u nb_batch_since = 0;
+static Bit64u nb_batch_since_interp = 0;   // AOT mode: interpreted cpu_loop traces when the batch was opened (bounded wait, see maybe_compile)
+Bit64u nanobox_aot_stats[16];   // 0 functions (precompile API), 1 regions/traces compiled, 2 starts, 3 not mapped, 4 gap starts, 5 already compiled, 6 maybe_compile: still pending in the batch, 7 maybe_compile: compile failed, 8 region cache/bundle hit, 9 region compiled (queued), 10 plain trace path, 11 cpu_loop: interpreted with hot < threshold, 12 cpu_loop: interpreted right after maybe_compile, 13 region compile_one false, 14 plain compile_one true
+static Bit64u nanobox_batch_stats[3]; // batches flushed, functions, stale entries at flush
+
+// does the host implement install_batch? (probe once: len 0 / nfuncs 0 -> a host answers 1, the placeholder 0)
+static int nb_batch_cap = -1;
+static bool nanobox_batching(void)
+{
+  if (nanobox_dbg_mode) return false;
+  if (nb_batch_cap < 0) nb_batch_cap = hook_install_batch(NULL, 0, NULL, 0, 0, NULL) ? 1 : 0;
+  return nb_batch_cap == 1;
+}
+
+// The link function's table index is baked into every trace module, so a pre-computed bundle is
+// only valid together with the link function it was recorded with: the host pins it under the
+// reserved content key LINK_KEY (ffffffff:ffffffff) — ask before installing, tell after.
+static bool nanobox_ensure_link_fn(void)
+{
+  if (nanobox_link_fn || nanobox_dbg_mode) return true;
+  unsigned pre = hook_lookup(0xffffffffu, 0xffffffffu);
+  if (pre) { nanobox_link_fn = pre; return true; }
+  Module lm;
+  static bxICacheEntry_c dummy;
+  TraceCompiler tc(&dummy, lm);
+  tc.emitLinkFn();
+  Buf bytes; lm.finish(bytes);
+  nanobox_link_fn = hook_install(bytes.p, bytes.n, lm.importKeys, lm.nimports);
+  if (nanobox_link_fn) hook_note(nanobox_link_fn, 0xffffffffu, 0xffffffffu);
+  return nanobox_link_fn != 0;
+}
+
+// give (or cache) a translation to entry e
+static void nanobox_jit_attach(bxICacheEntry_c *e, unsigned fn, Region *reg)
+{
+  if (reg) nanobox_region_attach(e, fn, reg->mask, reg); else { e->jitfn = fn; e->jitarg = (Bit32u)(uintptr_t) e->i; }
+}
+static void nanobox_jit_cache_put(Bit64u key, unsigned fn, unsigned len, Region *reg)
+{
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  if (jitcache_count >= JITCACHE_LIMIT || c == NULL) { nanobox_jit_cache_clear(); return; }  // (the fn was released with everything else)
+  if (c->key == key) return;
+  c->key = key; c->fn = fn; c->len = len; c->mask = reg ? reg->mask : 0; c->region = reg; jitcache_count++;
+}
+static void nanobox_jit_batch_drop(void)
+{
+  for (unsigned i = 0; i < nb_npending; i++) if (nb_pending[i].reg) delete nb_pending[i].reg;
+  nb_npending = 0;
+  if (nb_batch) { delete nb_batch; nb_batch = NULL; }
+}
+static void nanobox_jit_batch_flush(void)
+{
+  if (!nb_batch || nb_npending == 0) return;
+  Buf bytes; nb_batch->finish(bytes);
+  unsigned out[NB_BATCH];
+  unsigned ok = hook_install_batch(bytes.p, bytes.n, nb_batch->importKeys, nb_batch->nimports, nb_npending, out);
+  nanobox_batch_stats[0]++;
+  for (unsigned i = 0; i < nb_npending; i++) {
+    Pending &pd = nb_pending[i];
+    if (!ok || out[i] == 0) { if (pd.reg) delete pd.reg; if (pd.e->pAddr == pd.pAddr) *BX_CPU_THIS_PTR iCache.hotOf(pd.e) = 0; continue; }
+    unsigned fn = out[i];
+    hook_note(fn, (unsigned)(pd.key & 0xffffffffu), (unsigned)(pd.key >> 32));
+    nanobox_stats.jit_compiled++; nanobox_batch_stats[1]++;
+    if (pd.reg) nanobox_region_stats[2]++;
+    // the entry may have been evicted/re-decoded/flushed while the batch was open
+    if (pd.e->pAddr == pd.pAddr && pd.e->i == pd.i && pd.e->jitfn == 0) nanobox_jit_attach(pd.e, fn, pd.reg);
+    else nanobox_batch_stats[2]++;
+    // (a cache clear inside put releases everything installed so far, including fn: fine)
+    nanobox_jit_cache_put(pd.key, fn, 0, pd.reg);
+    if (jitcache_count == 0) { for (unsigned j = i + 1; j < nb_npending; j++) if (nb_pending[j].reg) delete nb_pending[j].reg; break; }
+  }
+  nb_npending = 0;
+  delete nb_batch; nb_batch = NULL;
+}
+NB_EXPORT(nanobox_jit_batch_stat) double nanobox_jit_batch_stat(unsigned i) { return i < 3 ? (double) nanobox_batch_stats[i] : 0; }
+NB_EXPORT(nanobox_jit_flush_batch) void nanobox_jit_flush_batch(void) { nanobox_jit_batch_flush(); }
+
+// try to give e a translation for (reg, key) without compiling: in-process cache or host bundle
+static bool nanobox_jit_try_cached(bxICacheEntry_c *e, Region *reg, Bit64u key)
+{
+  if (nanobox_dbg_mode) return false;
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  if (c && c->key == key) {
+    if (c->region && reg && (c->region->npages != reg->npages || memcmp(c->region->ppf, reg->ppf, sizeof(reg->ppf)) != 0)) return false; // same code, other page frames: needs its own descriptor -> compile
+    if (c->region) nanobox_region_attach(e, c->fn, c->mask, c->region); else { e->jitfn = c->fn; e->jitarg = (Bit32u)(uintptr_t) e->i; }
+    jitcache_hits++; if (reg) { nanobox_region_stats[3]++; delete reg; }
+    return true;
+  }
+  // pre-computed translation (bundle)? modules are position independent (the region descriptor
+  // travels in the call argument), so a bundle hit is attached exactly like a fresh compile
+  unsigned pre = hook_lookup((unsigned)(key & 0xffffffffu), (unsigned)(key >> 32));
+  if (pre) {
+    nanobox_jit_attach(e, pre, reg);
+    nanobox_jit_cache_put(key, pre, 0, reg);
+    if (jitcache_count == 0) { e->jitfn = 0; hook_release(pre); if (reg) delete reg; return true; }
+    if (reg) nanobox_region_stats[3]++;
+    return true;
+  }
+  return false;
+}
+
+// already queued in the open batch?
+static bool nanobox_jit_pending(bxICacheEntry_c *e)
+{
+  for (unsigned i = 0; i < nb_npending; i++) {
+    if (nb_pending[i].e == e && nb_pending[i].pAddr == e->pAddr) return true;
+    // AOT mode (threshold 1): a MEMBER block of a queued region reached before the batch is flushed
+    // would otherwise start an overlapping region of its own
+    if (nanobox_jit_aot && nb_pending[i].reg) {
+      Region *r = nb_pending[i].reg;
+      for (unsigned j = 1; j < r->nblocks; j++) if (r->b[j].ent.pAddr == e->pAddr) return true;
+    }
+  }
+  return false;
+}
+
+static bool nanobox_jit_compile_one(bxICacheEntry_c *e, Region *reg, Bit64u key)
+{
+  if (nanobox_jit_try_cached(e, reg, key)) return true;
+  if (!nanobox_ensure_link_fn()) { if (reg) delete reg; return false; }
+  if (!nanobox_batching()) {
+    Module sm;
+    TraceCompiler tc(e, sm);
+    tc.reg = reg;
+    if (!tc.compile()) { if (reg) delete reg; return false; }
+    Buf bytes; sm.finish(bytes);
+    unsigned fn = hook_install(bytes.p, bytes.n, sm.importKeys, sm.nimports);
+    if (fn == 0) { if (reg) delete reg; return false; }
+    hook_note(fn, (unsigned)(key & 0xffffffffu), (unsigned)(key >> 32));
+    nanobox_stats.jit_compiled++;
+    if (reg) nanobox_region_stats[2]++;
+    nanobox_jit_attach(e, fn, reg);
+    if (nanobox_dbg_mode) { nanobox_dbg_compiled(e, fn, bytes.n); return true; }  // dbg mode: no cache (region objects are leaked on purpose)
+    nanobox_jit_cache_put(key, fn, bytes.n, reg);
+    if (jitcache_count == 0) { e->jitfn = 0; }
+    return true;
+  }
+  // batched: compile into the open module, attach at flush time
+  if (!nb_batch) { nb_batch = new Module(); nb_batch_since = nanobox_stats.traces; nb_batch_since_interp = nanobox_stats.interp_traces; }
+  nb_batch->beginFunc();
+  TraceCompiler tc(e, *nb_batch);
+  tc.reg = reg;
+  if (!tc.compile()) { nb_batch->beginFunc(); if (reg) delete reg; return false; }
+  unsigned local = nb_batch->endFunc(nb_batch->funcTypeIdx);
+  Pending &pd = nb_pending[nb_npending++];
+  pd.e = e; pd.pAddr = e->pAddr; pd.i = e->i; pd.reg = reg; pd.key = key; pd.local = local;
+  if (nb_npending >= NB_BATCH || nb_batch->funcsFull() || nb_batch->importsFull() || nb_batch->codeSec.n > (1u << 18)) nanobox_jit_batch_flush();
+  return true;
+}
+
+// Page-eager mode (bundle recordings): when a trace gets hot, decode and compile every trace that
+// is statically reachable from it inside the same physical page (branch targets, fall-throughs,
+// callees, call continuations), so a bundle recorded from a run covers whole pages, not only the
+// paths taken. Decoding is host-only (iCache entries), so it does not change guest behaviour.
+unsigned nanobox_jit_eager = 0;
+unsigned nanobox_jit_probe2 = 1;   // two-entry probe cache in JIT'd traces (default on; nanobox_set_jit_probe2(0) for A/B)
+NB_EXPORT(nanobox_set_jit_probe2) void nanobox_set_jit_probe2(unsigned on) { nanobox_jit_probe2 = on; }
+unsigned nanobox_jit_merge = 0;    // merge runs of register pushes / pops into one probed span (experiment flag)
+// A/B switch inside one binary: the harness turns this on with NANOBOX_JIT_MERGE=1. In this tree
+// it selects the ORIGINAL TLB fast path (explicit permission / alignment-check / write-stamp
+// tests) instead of the folded-tag one, so both arms can be measured from the same build with the
+// same engine tag (and therefore the same .nbjb bundle keying).
+NB_EXPORT(nanobox_set_jit_merge) void nanobox_set_jit_merge(unsigned on) { nanobox_tlbfold = on ? 0 : 1; }
+NB_EXPORT(nanobox_set_jit_eager) void nanobox_set_jit_eager(unsigned on) { nanobox_jit_eager = on; }
+static Bit64u nb_swept[4096]; static unsigned nb_swept_n = 0; static Bit64u nanobox_eager_stats[2];
+NB_EXPORT(nanobox_jit_eager_stat) double nanobox_jit_eager_stat(unsigned i) { return i < 2 ? (double) nanobox_eager_stats[i] : 0; }
+static bool nanobox_page_swept(bx_phy_address page)
+{
+  Bit64u pp = page >> 12;
+  for (unsigned i = 0; i < nb_swept_n; i++) if (nb_swept[i] == pp) return true;
+  if (nb_swept_n < 4096) nb_swept[nb_swept_n++] = pp;
+  return false;
+}
+static void nanobox_jit_maybe_compile_inner(bxICacheEntry_c *e);
+static void nanobox_eager_sweep(bxICacheEntry_c *e)
+{
+  bx_phy_address page = e->pAddr & ~(bx_phy_address) 0xfff;
+  if (nanobox_page_swept(page)) return;
+  // this page is the current fetch page (we are executing e): eipBiased maps its offsets
+  bx_address pageLin = RIP - e->i[0].ilen(); pageLin &= ~(bx_address) 0xfff;
+  if ((BX_CPU_THIS_PTR pAddrFetchPage & ~(bx_phy_address) 0xfff) != page) return;
+  Bit8u seen[4096]; memset(seen, 0, sizeof seen);
+  Bit16u queue[4096]; unsigned qh = 0, qt = 0;
+  queue[qt++] = (Bit16u)(e->pAddr & 0xfff); seen[e->pAddr & 0xfff] = 1;
+  while (qh < qt) {
+    unsigned off = queue[qh++];
+    if (off > 4096 - 16) continue;   // a first instruction that may cross the page would make the decoder fetch the next page (can fault)
+    bx_phy_address pa = page + off;
+    bxICacheEntry_c *se = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+    if (se->pAddr != pa) {
+      Bit32u eipBiased = (Bit32u)((pageLin + off) + BX_CPU_THIS_PTR eipPageBias);
+      se = BX_CPU_THIS_PTR serveICacheMiss(eipBiased, pa);
+      if (!se || se->pAddr != pa) continue;
+      nanobox_eager_stats[0]++;
+    }
+    unsigned n = nanobox_real_len(se);
+    if (n == 0) continue;
+    if (!se->jitfn) { nanobox_jit_maybe_compile_inner(se); nanobox_eager_stats[1]++; }
+    // successors inside the page: direct targets + callee entry + continuation after a call
+    Bit64s t[3]; unsigned nt = 0;
+    nanobox_direct_targets(se, n, 0, t, nt);
+    Bit32u len = 0; for (unsigned k = 0; k < n; k++) len += se->i[k].ilen();
+    const bxInstruction_c *l = &se->i[n - 1];
+    if (l->getIaOpcode() == BX_IA_CALL_Jq) { t[nt++] = (Bit64s) len; t[nt++] = (Bit64s) len + (Bit64s)(Bit32s) l->Id(); }
+    for (unsigned q = 0; q < nt; q++) {
+      Bit64s so = (Bit64s) off + t[q];
+      if (so < 0 || so >= 4096 || seen[so]) continue;
+      seen[so] = 1; if (qt < 4096) queue[qt++] = (Bit16u) so;
+    }
+  }
+}
+
+void nanobox_jit_maybe_compile(bxICacheEntry_c *e)
+{
+  if (e->jitfn) return;
+  nanobox_jit_maybe_compile_inner(e);
+  if (nanobox_jit_eager && !nanobox_dbg_mode) nanobox_eager_sweep(e);
+}
+static void nanobox_jit_maybe_compile_at(bxICacheEntry_c *e, bx_address entryLin, Region **formed);
+static void nanobox_jit_maybe_compile_inner(bxICacheEntry_c *e)
+{
+  nanobox_jit_maybe_compile_at(e, RIP - e->i[0].ilen(), NULL);
+}
+// formed (optional, AOT driver): receives a COPY of the region descriptor formed for e (caller frees), NULL if none
+static void nanobox_jit_maybe_compile_at(bxICacheEntry_c *e, bx_address entryLin, Region **formed)
+{
+  if (formed) *formed = NULL;
+  if (e->jitfn) return;
+  if (nanobox_batching()) {
+    // an entry that is queued keeps calling here (its hot counter stays over the threshold): use
+    // those calls as flush ticks so a small batch does not wait forever
+    // (AOT mode, threshold 1: an entry -- or a member block of a queued region -- that runs again while
+    //  its batch is open runs INTERPRETED; nanobox_stats.traces barely advances when the rest of the
+    //  guest is JIT'd, so bound the wait by interpreted traces too, else a small batch starves the guest)
+    if (nb_npending && (nanobox_stats.traces - nb_batch_since > NB_BATCH_MAX_TRACES_WAIT ||
+                        (nanobox_jit_aot && nanobox_stats.interp_traces - nb_batch_since_interp > 256))) nanobox_jit_batch_flush();
+    if (nanobox_jit_pending(e)) { nanobox_aot_stats[6]++; return; }
+  }
+  // 1. region (entry + reachable traces in this page), unless the entry loops on itself (the
+  //    single-trace loop compile keeps registers in locals across iterations)
+  Region *reg = nanobox_form_region(e, entryLin);
+  if (reg && formed) { Region *c = new Region(); c->nblocks = reg->nblocks; for (unsigned j = 0; j < reg->nblocks; j++) { c->b[j].boff = reg->b[j].boff; c->b[j].n = reg->b[j].n; c->b[j].ins = new bxInstruction_c[reg->b[j].ent.tlen]; memcpy(c->b[j].ins, reg->b[j].ins, reg->b[j].ent.tlen * sizeof(bxInstruction_c)); c->b[j].ent = reg->b[j].ent; c->b[j].ent.i = c->b[j].ins; } *formed = c; }
+  if (reg) {
+    if (nanobox_jit_try_cached(e, reg, reg->key)) { nanobox_aot_stats[8]++; return; }
+    // region keys depend on which neighbours the iCache happens to hold; a pre-computed bundle
+    // recorded under other timing may still have the plain trace: prefer that over compiling
+    // (not in AOT mode: there the region IS the unit -- a missing precompiled region is compiled)
+    if (!nanobox_dbg_mode && !nanobox_jit_aot) {
+      unsigned nreal0 = 0; Bit64u tkey = nanobox_jit_hash(e, nreal0);
+      unsigned pre = hook_lookup((unsigned)(tkey & 0xffffffffu), (unsigned)(tkey >> 32));
+      if (pre) { delete reg; nanobox_jit_attach(e, pre, NULL); nanobox_jit_cache_put(tkey, pre, 0, NULL); if (jitcache_count == 0) { e->jitfn = 0; hook_release(pre); } return; }
+    }
+    if (nanobox_jit_compile_one(e, reg, reg->key)) { nanobox_aot_stats[9]++; return; }
+    nanobox_aot_stats[13]++;
+  }
+  // 2. plain trace
+  nanobox_aot_stats[10]++;
+  unsigned nreal = 0;
+  Bit64u key = nanobox_jit_hash(e, nreal);
+  if (!nanobox_jit_compile_one(e, NULL, key)) { *BX_CPU_THIS_PTR iCache.hotOf(e) = 0; nanobox_aot_stats[7]++; }
+  else nanobox_aot_stats[14]++;
+}
+
+/////////////////////////////////////////////////////////////////////////
+// AOT precompile API (TASKS.md R; consumed by the offline "precompile everything" driver, work/j/aotpre)
+//
+//   int nanobox_aot_compile_function(unsigned linLo, unsigned linHi, unsigned len, unsigned cpl, unsigned flags)
+//
+// Forms and compiles every region the RUNTIME former would form inside one guest function, and records
+// the translations exactly like normal installs (hook_note -> the harness' --jit-bundle-out bundle):
+//   * a region is formed from the function's first byte (lin = linHi:linLo) with the same static walk
+//     the runtime uses at first touch (direct targets / fall-through / CALL continuations, decode-ahead,
+//     budgets, page rules), then from every direct successor of a formed region that lies inside
+//     [lin, lin+len) and is not yet a member of one -- this is the order in which the runtime meets
+//     them (function entry first, then the blocks its regions exit to), so the content keys match;
+//   * flags bit 0: afterwards also start regions at every byte range inside the function the walk left
+//     uncovered (linear sweep from the end of the last covered block: blocks reached only through
+//     jump tables / indirect jumps). Spurious starts cost bundle bytes, never correctness (a region is
+//     keyed by its entry pAddr + content and only ever attached to an entry that decoded the same);
+//   * cpl selects the region class (0: kernel text, fixed mapping, regions may span pages; 3: user,
+//     entry page +/-1) and is applied to the CPU's user_pl for the duration of the call.
+// Returns the number of regions/traces compiled or found precompiled (>= 0), -1 when the JIT or AOT
+// mode is off (nanobox_set_jit(2+, *) and nanobox_set_jit_aot(1) first), -2 when the function's first
+// byte is not mapped under the current CR3 (translate the process' code with its CR3 live), -3 when
+// the CPU is not in 64-bit mode. Call between traces (from the host, with the guest stopped) and
+// nanobox_jit_flush_batch() once at the end of a sweep. Traces are decoded ahead into the iCache
+// (host-only state), nothing in guest RAM changes.
+/////////////////////////////////////////////////////////////////////////
+NB_EXPORT(nanobox_aot_stat) double nanobox_aot_stat(unsigned i) { return i < 16 ? (double) nanobox_aot_stats[i] : 0; }
+// The offline byte source: the host writes the program's own bytes into the buffer and says which
+// guest linear range they are. len 0 switches back to reading guest RAM.
+NB_EXPORT(nanobox_aot_srcbuf_addr) unsigned nanobox_aot_srcbuf_addr(void) { return (unsigned)(uintptr_t) nanobox_aot_srcbuf; }
+NB_EXPORT(nanobox_aot_srcbuf_size) unsigned nanobox_aot_srcbuf_size(void) { return NB_AOT_SRC_MAX; }
+NB_EXPORT(nanobox_aot_source) void nanobox_aot_source(unsigned linLo, unsigned linHi, unsigned len)
+{
+  nanobox_aot_src_lin = ((bx_address) linHi << 32) | (bx_address) linLo;
+  nanobox_aot_src_len = len > NB_AOT_SRC_MAX ? NB_AOT_SRC_MAX : len;
+  // entries decoded from an earlier window share the synthetic physical range: drop them so a new
+  // window cannot be read through a stale iCache entry
+  BX_CPU_THIS_PTR iCache.flushICacheEntries();
+}
+NB_EXPORT(nanobox_aot_compile_function) int nanobox_aot_compile_function(unsigned linLo, unsigned linHi, unsigned len, unsigned cpl, unsigned flags)
+{
+  if (!nanobox_jit_aot || nanobox_jit_level < 2 || nanobox_dbg_mode) return -1;
+  if (BX_CPU_THIS_PTR cpu_mode != BX_MODE_LONG_64) return -3;
+  bx_address lin = ((bx_address) linHi << 32) | (bx_address) linLo;
+  if (len == 0) len = 1;
+  { bx_phy_address phy = 0; if (!nanobox_aot_xlate(lin, &phy)) { nanobox_aot_stats[3]++; return -2; } }
+  nanobox_aot_stats[0]++;
+  Bit8u saveUpl = BX_CPU_THIS_PTR user_pl; BX_CPU_THIS_PTR user_pl = (cpl == 3) ? 1 : 0;
+  Bit8u *covered = (Bit8u *) calloc(len, 1);   // byte coverage of [lin, lin+len)
+  enum { QMAX = 8192 };
+  Bit32u *queue = (Bit32u *) malloc(QMAX * sizeof(Bit32u)); unsigned qh = 0, qt = 0;
+  Bit8u *started = (Bit8u *) calloc(len, 1);
+  auto push = [&](bx_address la) { if (la < lin || la >= lin + len) return; Bit32u o = (Bit32u)(la - lin); if (started[o] || qt >= QMAX) return; started[o] = 1; queue[qt++] = o; };
+  int done = 0;
+  push(lin);
+  for (;;) {
+    while (qh < qt) {
+      bx_address la = lin + queue[qh++];
+      nanobox_aot_stats[2]++;
+      bx_phy_address pa = 0;
+      if (!nanobox_aot_xlate(la, &pa)) { nanobox_aot_stats[3]++; continue; }
+      const Bit8u *host = nanobox_host_page(pa & ~(bx_phy_address) 0xfff);
+      if (!host) continue;
+      bxICacheEntry_c *e = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+      if (e->pAddr != pa || e->tlen == 0) { e = nanobox_decode_ahead(pa, host, NULL, 0); if (!e) continue; }
+      unsigned n = nanobox_real_len(e);
+      if (n == 0) continue;
+      Region *formed = NULL;
+      if (e->jitfn) nanobox_aot_stats[5]++;   // already translated (member of an earlier region, or a previous call): its own bytes + successors still drive the sweep
+      else { nanobox_jit_maybe_compile_at(e, la, &formed); if (e->jitfn || nanobox_jit_pending(e)) { done++; nanobox_aot_stats[1]++; } }
+      // coverage + successors: the trace itself, plus the region's other blocks when one was formed
+      { Bit32u blen = 0; for (unsigned k = 0; k < n; k++) blen += e->i[k].ilen();
+        for (Bit32u o = 0; o < blen; o++) if (la + o < lin + len) covered[la + o - lin] = 1;
+        Bit64s t[4]; unsigned nt = 0;
+        nanobox_direct_targets(e, n, 0, t, nt);
+        for (unsigned q = 0; q < nt; q++) push(la + (bx_address) t[q]); }
+      if (formed) {
+        for (unsigned j = 1; j < formed->nblocks; j++) {
+          bx_address bl = la + (bx_address)(Bit64s) formed->b[j].boff; Bit32u blen = 0;
+          if (bl >= lin && bl < lin + len) started[bl - lin] = 1;   // a member never starts a region of its own
+          for (unsigned k = 0; k < formed->b[j].n; k++) blen += formed->b[j].ins[k].ilen();
+          for (Bit32u o = 0; o < blen; o++) if (bl + o >= lin && bl + o < lin + len) covered[bl + o - lin] = 1;
+          Bit64s t[4]; unsigned nt = 0;
+          nanobox_direct_targets(&formed->b[j].ent, formed->b[j].n, 0, t, nt);
+          for (unsigned q = 0; q < nt; q++) push(bl + (bx_address) t[q]);
+        }
+        delete formed;
+      }
+    }
+    if (!(flags & 1)) break;
+    // linear sweep: the first uncovered byte after a covered run (or the function start) starts a region
+    bx_address gap = 0; bool found = false;
+    for (Bit32u o = 0; o < len; o++) {
+      if (covered[o] || started[o]) continue;
+      if (o == 0 || covered[o - 1]) { gap = lin + o; found = true; break; }
+    }
+    if (!found) break;
+    nanobox_aot_stats[4]++;
+    push(gap);
+    if (qh >= qt) break;   // could not be queued (started / queue full)
+  }
+  free(covered); free(queue); free(started);
+  BX_CPU_THIS_PTR user_pl = saveUpl;
+  return done;
+}
+
+void nanobox_jit_entry_invalidate(bxICacheEntry_c *e)
+{
+  // compiled code is owned by the cache (or, in dbg mode, by nobody in particular): just forget it.
+  // (dbg mode used to release the function here; a region function is shared by all its member
+  // entries, so releasing it for one would break the others -> dbg mode simply leaks translations)
+  e->jitfn = 0;
+  *BX_CPU_THIS_PTR iCache.hotOf(e) = 0;
+}
+
+void nanobox_jit_flush_all(void)
+{
+  if (nanobox_dbg_mode) hook_release_all();
+}
diff --git a/bochs/nanobox_jit.h b/bochs/nanobox_jit.h
new file mode 100644
index 000000000..0b1871ee2
--- /dev/null
+++ b/bochs/nanobox_jit.h
@@ -0,0 +1,52 @@
+/////////////////////////////////////////////////////////////////////////
+// nanobox trace JIT — public interface used by the CPU loop and the iCache.
+//
+// A JIT-compiled trace is a wasm function `void run(bxInstruction_c *trace)` that performs
+// exactly what Bochs' chained handlers would do for the iCache trace: it is entered after
+// cpu_loop already did `RIP += i->ilen()` for the first instruction, and it returns whenever the
+// handler chain would have returned to cpu_loop (trace end, taken branch / BX_NEXT_TRACE,
+// async_event, or — via longjmp — an exception).
+/////////////////////////////////////////////////////////////////////////
+
+#ifndef NANOBOX_JIT_H
+#define NANOBOX_JIT_H
+
+struct bxICacheEntry_c;
+class bxInstruction_c;
+
+// runtime configuration (set by the host through nanobox.cc exports before the CPU starts)
+extern unsigned nanobox_jit_level;      // 0 = interpreter only, 1 = handler-call JIT, 2+ = templates
+extern unsigned nanobox_jit_threshold;  // executions of a trace before it gets compiled
+
+// interpreter <-> JIT hand-shake (see BX_NEXT_INSTR / BX_NEXT_TRACE in cpu.h)
+extern Bit8u nanobox_single_step;       // 1 while a JIT'd trace single-steps a handler: BX_NEXT_INSTR returns instead of chaining
+extern Bit8u nanobox_trace_end;         // set by BX_NEXT_TRACE so the JIT knows the trace ended
+
+// (arg, probe cache: 6 x i64 tags/frames + 4 x i32 host/free — see TraceCompiler::jitFuncType)
+typedef void (*nanobox_jitfn_t)(bxInstruction_c *trace, Bit64u, Bit64u, Bit64u, Bit64u, Bit64u, Bit64u, unsigned, unsigned, unsigned, unsigned);
+typedef void (*nanobox_jitfn4_t)(bxInstruction_c *trace, Bit64u, Bit64u, unsigned);   // short signature (nanobox_jit_flags bit 6)
+extern unsigned nanobox_jit_flags;
+
+void nanobox_jit_maybe_compile(bxICacheEntry_c *e);   // compile e (called by cpu_loop when e got hot)
+void nanobox_jit_entry_invalidate(bxICacheEntry_c *e); // e is being reused/invalidated: drop its code
+void nanobox_jit_flush_all(void);                      // iCache flushed: drop everything
+void nanobox_jit_after_decode(bxICacheEntry_c *e);     // trace freshly decoded: attach cached code
+
+extern unsigned nanobox_dbg_mode;
+extern bxICacheEntry_c *nanobox_dbg_cur_entry;
+extern unsigned nanobox_pages_on;                       // instruction-address profile (nanobox.cc)
+void nanobox_pages_account(Bit64u rip, Bit64u paddr, Bit64u n, unsigned user);
+void nanobox_dbg_trace(bxICacheEntry_c *entry, bool jitted);
+
+extern Bit64u nanobox_probe_mem[4];
+BX_CPP_INLINE void nanobox_jit_call(bxICacheEntry_c *e)
+{
+  nanobox_stats.jit_traces++;
+  nanobox_probe_mem[0] = nanobox_probe_mem[1] = (Bit64u) -1;   // memory-resident probe cache (flags bit 5): only a linking trace may hand one over
+  nanobox_single_step = 1;
+  if (nanobox_jit_flags & 64) ((nanobox_jitfn4_t)(uintptr_t) e->jitfn)((bxInstruction_c *)(uintptr_t) e->jitarg, (Bit64u) -1, (Bit64u) -1, 0);
+  else ((nanobox_jitfn_t)(uintptr_t) e->jitfn)((bxInstruction_c *)(uintptr_t) e->jitarg, (Bit64u) -1, (Bit64u) -1, 0, (Bit64u) -1, (Bit64u) -1, 0, 0, 0, 0, 0);
+  nanobox_single_step = 0;
+}
+
+#endif
diff --git a/bochs/nanobox_wasm.h b/bochs/nanobox_wasm.h
new file mode 100644
index 000000000..65560d175
--- /dev/null
+++ b/bochs/nanobox_wasm.h
@@ -0,0 +1,262 @@
+/////////////////////////////////////////////////////////////////////////
+// nanobox: a tiny WebAssembly binary emitter used by the trace JIT.
+//
+// Builds a single-function module:
+//   (import "e" "m" (memory 0))                ; the engine's own linear memory
+//   (import "h" "<k>" (func ...))              ; helper functions (Bochs handlers / runtime)
+//   (func (export "r") (param i32) ...)        ; the compiled trace
+// The host instantiates it against the engine instance and drops the export into the engine's
+// function table so the C++ side can call it through a plain function pointer.
+/////////////////////////////////////////////////////////////////////////
+
+#ifndef NANOBOX_WASM_H
+#define NANOBOX_WASM_H
+
+#include <stdint.h>
+#include <string.h>
+#include <stdlib.h>
+
+namespace nbw {
+
+enum ValType : uint8_t { I32 = 0x7f, I64 = 0x7e, F32 = 0x7d, F64 = 0x7c, V128 = 0x7b, EXNREF = 0x69, VOID = 0x40 };
+
+// -- opcodes -----------------------------------------------------------------------------------
+enum Op : uint8_t {
+  UNREACHABLE = 0x00, NOP = 0x01, BLOCK = 0x02, LOOP = 0x03, IF = 0x04, ELSE = 0x05,
+  THROW = 0x08, RETHROW = 0x09, THROW_REF = 0x0a, END = 0x0b, BR = 0x0c, BR_IF = 0x0d, BR_TABLE = 0x0e,
+  RETURN = 0x0f, CALL = 0x10, CALL_INDIRECT = 0x11, RETURN_CALL = 0x12, RETURN_CALL_INDIRECT = 0x13, TRY_TABLE = 0x1f,
+  DROP = 0x1a, SELECT = 0x1b,
+  LOCAL_GET = 0x20, LOCAL_SET = 0x21, LOCAL_TEE = 0x22, GLOBAL_GET = 0x23, GLOBAL_SET = 0x24,
+  I32_LOAD = 0x28, I64_LOAD = 0x29, F32_LOAD = 0x2a, F64_LOAD = 0x2b,
+  I32_LOAD8_S = 0x2c, I32_LOAD8_U = 0x2d, I32_LOAD16_S = 0x2e, I32_LOAD16_U = 0x2f,
+  I64_LOAD8_S = 0x30, I64_LOAD8_U = 0x31, I64_LOAD16_S = 0x32, I64_LOAD16_U = 0x33, I64_LOAD32_S = 0x34, I64_LOAD32_U = 0x35,
+  I32_STORE = 0x36, I64_STORE = 0x37, F32_STORE = 0x38, F64_STORE = 0x39,
+  I32_STORE8 = 0x3a, I32_STORE16 = 0x3b, I64_STORE8 = 0x3c, I64_STORE16 = 0x3d, I64_STORE32 = 0x3e,
+  I32_CONST = 0x41, I64_CONST = 0x42, F32_CONST = 0x43, F64_CONST = 0x44,
+  I32_EQZ = 0x45, I32_EQ = 0x46, I32_NE = 0x47, I32_LT_S = 0x48, I32_LT_U = 0x49, I32_GT_S = 0x4a, I32_GT_U = 0x4b,
+  I32_LE_S = 0x4c, I32_LE_U = 0x4d, I32_GE_S = 0x4e, I32_GE_U = 0x4f,
+  I64_EQZ = 0x50, I64_EQ = 0x51, I64_NE = 0x52, I64_LT_S = 0x53, I64_LT_U = 0x54, I64_GT_S = 0x55, I64_GT_U = 0x56,
+  I64_LE_S = 0x57, I64_LE_U = 0x58, I64_GE_S = 0x59, I64_GE_U = 0x5a,
+  I32_CLZ = 0x67, I32_CTZ = 0x68, I32_POPCNT = 0x69, I32_ADD = 0x6a, I32_SUB = 0x6b, I32_MUL = 0x6c,
+  I32_DIV_S = 0x6d, I32_DIV_U = 0x6e, I32_REM_S = 0x6f, I32_REM_U = 0x70, I32_AND = 0x71, I32_OR = 0x72, I32_XOR = 0x73,
+  I32_SHL = 0x74, I32_SHR_S = 0x75, I32_SHR_U = 0x76, I32_ROTL = 0x77, I32_ROTR = 0x78,
+  I64_CLZ = 0x79, I64_CTZ = 0x7a, I64_POPCNT = 0x7b, I64_ADD = 0x7c, I64_SUB = 0x7d, I64_MUL = 0x7e,
+  I64_DIV_S = 0x7f, I64_DIV_U = 0x80, I64_REM_S = 0x81, I64_REM_U = 0x82, I64_AND = 0x83, I64_OR = 0x84, I64_XOR = 0x85,
+  I64_SHL = 0x86, I64_SHR_S = 0x87, I64_SHR_U = 0x88, I64_ROTL = 0x89, I64_ROTR = 0x8a,
+  I32_WRAP_I64 = 0xa7, I64_EXTEND_I32_S = 0xac, I64_EXTEND_I32_U = 0xad,
+  I32_EXTEND8_S = 0xc0, I32_EXTEND16_S = 0xc1, I64_EXTEND8_S = 0xc2, I64_EXTEND16_S = 0xc3, I64_EXTEND32_S = 0xc4,
+};
+// SIMD (128-bit) sub-opcodes, all behind the 0xfd prefix (Emit::simd / v128_load / v128_store)
+enum SimdOp : uint32_t {
+  V128_LOAD = 0x00, V128_LOAD8_SPLAT = 0x07, V128_STORE = 0x0b, V128_CONST = 0x0c,
+  I8X16_SWIZZLE = 0x0e, I8X16_SPLAT = 0x0f, I16X8_SPLAT = 0x10, I32X4_SPLAT = 0x11, I64X2_SPLAT = 0x12,
+  I8X16_EXTRACT_LANE_U = 0x16, I32X4_EXTRACT_LANE = 0x1b, I64X2_EXTRACT_LANE = 0x1d, I64X2_REPLACE_LANE = 0x1e,
+  I8X16_EQ = 0x23, I8X16_LT_S = 0x25, I16X8_EQ = 0x2d, I32X4_EQ = 0x37,
+  V128_NOT = 0x4d, V128_AND = 0x4e, V128_ANDNOT = 0x4f, V128_OR = 0x50, V128_XOR = 0x51, V128_BITSELECT = 0x52, V128_ANY_TRUE = 0x53,
+  I8X16_ALL_TRUE = 0x63, I8X16_BITMASK = 0x64, I8X16_SHR_U = 0x6d, I16X8_BITMASK = 0x84,
+};
+
+// -- growable byte buffer ---------------------------------------------------------------------------
+struct Buf {
+  uint8_t *p; uint32_t n, cap;
+  Buf() : p(NULL), n(0), cap(0) {}
+  ~Buf() { free(p); }
+  void reserve(uint32_t need) {
+    if (n + need <= cap) return;
+    uint32_t c = cap ? cap : 1024;
+    while (c < n + need) c *= 2;
+    p = (uint8_t *) realloc(p, c); cap = c;
+  }
+  void b8(uint32_t b) { reserve(1); p[n++] = (uint8_t) b; }
+  void raw(const void *src, uint32_t len) { reserve(len); memcpy(p + n, src, len); n += len; }
+  void uleb(uint32_t v) { do { uint8_t b = v & 0x7f; v >>= 7; if (v) b |= 0x80; b8(b); } while (v); }
+  void sleb32(int32_t v) { for (;;) { uint8_t b = v & 0x7f; v >>= 7; if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40))) { b8(b); return; } b8(b | 0x80); } }
+  void sleb64(int64_t v) { for (;;) { uint8_t b = v & 0x7f; v >>= 7; if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40))) { b8(b); return; } b8(b | 0x80); } }
+  // 5-byte fixed-width u32 (patchable)
+  void u32_fixed5(uint32_t v) { for (int i = 0; i < 5; i++) { uint8_t b = v & 0x7f; v >>= 7; if (i < 4) b |= 0x80; b8(b); } }
+  void patch_u32_fixed5(uint32_t at, uint32_t v) { for (int i = 0; i < 5; i++) { uint8_t b = v & 0x7f; v >>= 7; if (i < 4) b |= 0x80; p[at + i] = b; } }
+  void clear() { n = 0; }
+};
+
+// -- function types ---------------------------------------------------------------------------------
+struct FuncType {
+  uint8_t nparams, nresults;
+  ValType params[12];
+  ValType results[2];
+  bool operator==(const FuncType &o) const {
+    if (nparams != o.nparams || nresults != o.nresults) return false;
+    for (int i = 0; i < nparams; i++) if (params[i] != o.params[i]) return false;
+    for (int i = 0; i < nresults; i++) if (results[i] != o.results[i]) return false;
+    return true;
+  }
+};
+
+// -- module builder -------------------------------------------------------------------------------
+class Module {
+public:
+  enum { MAX_TYPES = 32, MAX_IMPORTS = 512 };
+  FuncType types[MAX_TYPES]; uint32_t ntypes;
+  struct Import { uint32_t typeIdx; uint32_t key; } imports[MAX_IMPORTS]; uint32_t nimports;
+  uint32_t importKeys[MAX_IMPORTS]; // e.g. Bochs function-table index of the imported function
+  Buf code;                          // CURRENT function body (locals + expr), filled by the emitter
+  Buf locals;                        // local declarations (count, type)*, run-length grouped
+  uint32_t nlocalDecls;
+  int32_t lastRunPos; uint8_t lastRunType; uint32_t lastRunCount;   // open run in `locals`
+  uint32_t nparams;                  // params of the exported function
+  uint32_t funcTypeIdx;
+  // finished functions (a module may hold many: batched traces): serialised bodies + their types
+  enum { MAX_FUNCS = 64 };
+  Buf codeSec;                       // concatenated (size-prefixed) bodies
+  uint32_t funcTypes[MAX_FUNCS]; uint32_t nfuncs;
+
+  Module() : ntypes(0), nimports(0), nlocalDecls(0), lastRunPos(-1), lastRunType(0), lastRunCount(0), nparams(0), funcTypeIdx(0), nfuncs(0) {}
+
+  // start a new function body (the emitter writes into code/locals)
+  void beginFunc() { code.clear(); locals.clear(); nlocalDecls = 0; lastRunPos = -1; lastRunCount = 0; }
+  // seal the current body as local function #nfuncs (function index nimports + nfuncs); returns its local index
+  uint32_t endFunc(uint32_t typeIdx) {
+    Buf body; body.uleb(nlocalDecls); body.raw(locals.p, locals.n); body.raw(code.p, code.n); body.b8(END);
+    codeSec.uleb(body.n); codeSec.raw(body.p, body.n);
+    funcTypes[nfuncs] = typeIdx;
+    beginFunc();
+    return nfuncs++;
+  }
+  bool funcsFull() const { return nfuncs >= MAX_FUNCS; }
+
+  uint32_t addType(const FuncType &t) {
+    for (uint32_t i = 0; i < ntypes; i++) if (types[i] == t) return i;
+    types[ntypes] = t; return ntypes++;
+  }
+  static FuncType ft(uint8_t np, const ValType *ps, uint8_t nr, const ValType *rs) {
+    FuncType t; t.nparams = np; t.nresults = nr;
+    for (int i = 0; i < np; i++) t.params[i] = ps[i];
+    for (int i = 0; i < nr; i++) t.results[i] = rs[i];
+    return t;
+  }
+  // returns the function index of the import (imports are numbered before the local function)
+  uint32_t addImport(uint32_t key, const FuncType &t) {
+    for (uint32_t i = 0; i < nimports; i++) if (imports[i].key == key && types[imports[i].typeIdx] == t) return i;
+    imports[nimports].typeIdx = addType(t); imports[nimports].key = key; importKeys[nimports] = key;
+    return nimports++;
+  }
+  bool importsFull() const { return nimports >= MAX_IMPORTS - 2; }
+  uint32_t localFuncIndex() const { return nimports; }
+
+  // Serialise the whole module into `out`.
+  void finish(Buf &out) {
+    out.clear();
+    static const uint8_t hdr[8] = { 0, 'a', 's', 'm', 1, 0, 0, 0 };
+    out.raw(hdr, 8);
+    Buf s;
+    // type section
+    s.clear(); s.uleb(ntypes);
+    for (uint32_t i = 0; i < ntypes; i++) {
+      s.b8(0x60); s.uleb(types[i].nparams); for (int k = 0; k < types[i].nparams; k++) s.b8(types[i].params[k]);
+      s.uleb(types[i].nresults); for (int k = 0; k < types[i].nresults; k++) s.b8(types[i].results[k]);
+    }
+    section(out, 1, s);
+    // import section: memory + function table + helpers
+    s.clear(); s.uleb(2 + nimports);
+    s.uleb(1); s.b8('e'); s.uleb(1); s.b8('m'); s.b8(0x02); s.b8(0x00); s.uleb(0); // memory, limits min 0
+    s.uleb(1); s.b8('e'); s.uleb(1); s.b8('t'); s.b8(0x01); s.b8(0x70); s.b8(0x00); s.uleb(0); // table funcref, min 0
+    for (uint32_t i = 0; i < nimports; i++) {
+      char name[12]; int len = 0; uint32_t v = i; char tmp[12]; int tl = 0;
+      do { tmp[tl++] = '0' + (v % 10); v /= 10; } while (v);
+      while (tl) name[len++] = tmp[--tl];
+      s.uleb(1); s.b8('h'); s.uleb(len); s.raw(name, len); s.b8(0x00); s.uleb(imports[i].typeIdx);
+    }
+    section(out, 2, s);
+    // functions: either the sealed ones (batch) or, if none was sealed, the current body as "r"
+    if (nfuncs == 0) {
+      s.clear(); s.uleb(1); s.uleb(funcTypeIdx); section(out, 3, s);
+      s.clear(); s.uleb(1); s.uleb(1); s.b8('r'); s.b8(0x00); s.uleb(localFuncIndex()); section(out, 7, s);
+      s.clear(); s.uleb(1);
+      Buf body; body.uleb(nlocalDecls); body.raw(locals.p, locals.n); body.raw(code.p, code.n); body.b8(END);
+      s.uleb(body.n); s.raw(body.p, body.n);
+      section(out, 10, s);
+      return;
+    }
+    s.clear(); s.uleb(nfuncs); for (uint32_t i = 0; i < nfuncs; i++) s.uleb(funcTypes[i]); section(out, 3, s);
+    // exports: sealed functions (a batch, even of one) are "f0".."fN-1"; the never-sealed single
+    // body above is "r" (the host's single-install path)
+    s.clear(); s.uleb(nfuncs);
+    for (uint32_t i = 0; i < nfuncs; i++) {
+      char name[12]; int len = 0; uint32_t v = i; char tmp[12]; int tl = 0;
+      do { tmp[tl++] = '0' + (v % 10); v /= 10; } while (v);
+      name[len++] = 'f'; while (tl) name[len++] = tmp[--tl];
+      s.uleb(len); s.raw(name, len);
+      s.b8(0x00); s.uleb(nimports + i);
+    }
+    section(out, 7, s);
+    s.clear(); s.uleb(nfuncs); s.raw(codeSec.p, codeSec.n); section(out, 10, s);
+  }
+private:
+  static void section(Buf &out, uint8_t id, const Buf &content) { out.b8(id); out.uleb(content.n); out.raw(content.p, content.n); }
+};
+
+// -- instruction emitter (writes into Module::code) ------------------------------------------------
+class Emit {
+public:
+  Module &m; Buf &c;
+  uint32_t nlocals; // total locals incl. params
+  Emit(Module &mod) : m(mod), c(mod.code), nlocals(mod.nparams) {}
+
+  // wasm allows (count, type) runs: declaring 54 locals one at a time costs 108 bytes per
+  // function, grouping the consecutive same-type ones costs a handful
+  uint32_t addLocal(ValType t) {
+    if (m.lastRunPos >= 0 && m.lastRunType == (uint8_t) t && m.lastRunCount < 127) {
+      m.locals.p[m.lastRunPos] = (uint8_t) (++m.lastRunCount);
+    } else {
+      m.lastRunPos = (int32_t) m.locals.n; m.locals.uleb(1); m.locals.b8(t);
+      m.lastRunType = (uint8_t) t; m.lastRunCount = 1; m.nlocalDecls++;
+    }
+    return nlocals++;
+  }
+
+  void op(Op o) { c.b8(o); }
+  void i32c(int32_t v) { c.b8(I32_CONST); c.sleb32(v); }
+  void i64c(int64_t v) { c.b8(I64_CONST); c.sleb64(v); }
+  void get(uint32_t l) { c.b8(LOCAL_GET); c.uleb(l); }
+  void set(uint32_t l) { c.b8(LOCAL_SET); c.uleb(l); }
+  void tee(uint32_t l) { c.b8(LOCAL_TEE); c.uleb(l); }
+  void mem(Op o, uint32_t offset, uint32_t align) { c.b8(o); c.uleb(align); c.uleb(offset); }
+  // SIMD: 0xfd prefix + LEB sub-opcode (+ memarg / lane index / 16 immediate bytes)
+  void simd(SimdOp o) { c.b8(0xfd); c.uleb((uint32_t) o); }
+  void v128_load(uint32_t offset, uint32_t align) { simd(V128_LOAD); c.uleb(align); c.uleb(offset); }
+  void v128_store(uint32_t offset, uint32_t align) { simd(V128_STORE); c.uleb(align); c.uleb(offset); }
+  void v128_load8_splat(uint32_t offset) { simd(V128_LOAD8_SPLAT); c.uleb(0); c.uleb(offset); }
+  void v128_const(const uint8_t *bytes16) { simd(V128_CONST); c.raw(bytes16, 16); }
+  void v128_zero() { static const uint8_t z[16] = { 0 }; v128_const(z); }
+  void lane(SimdOp o, uint32_t l) { simd(o); c.b8((uint8_t) l); }
+  // bulk memory: memory.fill (dst, val, len) / memory.copy (dst, src, len), memory 0
+  void memory_fill() { c.b8(0xfc); c.uleb(0x0b); c.b8(0x00); }
+  void memory_copy() { c.b8(0xfc); c.uleb(0x0a); c.b8(0x00); c.b8(0x00); }
+  // absolute-address load/store helpers: push i32.const 0 as base, offset = address
+  void ldabs(Op o, uint32_t addr, uint32_t align) { i32c(0); mem(o, addr, align); }
+  void stabs_begin() { i32c(0); }                    // then push value, then stabs_end
+  void stabs_end(Op o, uint32_t addr, uint32_t align) { mem(o, addr, align); }
+  void call(uint32_t f) { c.b8(CALL); c.uleb(f); }
+  void return_call(uint32_t f) { c.b8(RETURN_CALL); c.uleb(f); }
+  void call_indirect(uint32_t typeIdx) { c.b8(CALL_INDIRECT); c.uleb(typeIdx); c.uleb(0); }
+  void return_call_indirect(uint32_t typeIdx) { c.b8(RETURN_CALL_INDIRECT); c.uleb(typeIdx); c.uleb(0); }
+  void block(ValType t = VOID) { c.b8(BLOCK); c.b8(t); }
+  void loop(ValType t = VOID) { c.b8(LOOP); c.b8(t); }
+  void if_(ValType t = VOID) { c.b8(IF); c.b8(t); }
+  void else_() { c.b8(ELSE); }
+  void end() { c.b8(END); }
+  void br(uint32_t d) { c.b8(BR); c.uleb(d); }
+  void br_if(uint32_t d) { c.b8(BR_IF); c.uleb(d); }
+  void ret() { c.b8(RETURN); }
+  void unreachable() { c.b8(UNREACHABLE); }
+  void drop() { c.b8(DROP); }
+  void select() { c.b8(SELECT); }
+  // try_table (result void) with a single catch_all_ref -> label `depth`
+  void try_table_catch_all_ref(uint32_t labelDepth) { c.b8(TRY_TABLE); c.b8(VOID); c.uleb(1); c.b8(0x03); c.uleb(labelDepth); }
+  void throw_ref() { c.b8(THROW_REF); }
+  // br_table: n targets + default
+  void br_table(const uint32_t *targets, uint32_t n, uint32_t def) { c.b8(BR_TABLE); c.uleb(n); for (uint32_t i = 0; i < n; i++) c.uleb(targets[i]); c.uleb(def); }
+};
+
+} // namespace nbw
