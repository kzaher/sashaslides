+      return true;
+    }
+    for (unsigned k = 0; k < n; k++) {
+      if (m.importsFull()) return false;
+      bool last = (k + 1 == n);
+      bool done = false;
+      needAsyncCheck = false;
+      phIa(ins[k].getIaOpcode()); nanobox_phase_inst(ins[k].getIaOpcode());
+      flagsLive = !flagsDead[k];
+      // An aliased pending operand (a compare whose operands were left in their register locals) is
+      // only valid while those locals still hold them. Rather than track every path that can reload
+      // a register local from memory -- a cold path doing that is what hung call-heavy guest code --
+      // the alias lives for exactly ONE instruction: the consumer that immediately follows. Anything
+      // else stages it first, which costs the two copies the alias was avoiding and nothing more.
+      if ((cs.pfL1 || cs.pfL2) && k != aliasAt + 1) pfStageAliases();
+      if (useTemplates) {
+        unsigned run = stackRunLen(k);
+        if (run) {
+          bool runLast = (k + run == n);
+          for (unsigned i = 1; i < run; i++) nanobox_phase_inst(ins[k + i].getIaOpcode());
+          if (!emitStackRun(k, run)) return false;
+          k += run - 1;
+          if (runLast) exitFallthroughOrTransition(k);
+          continue;
+        }
+      }
+      if (useTemplates) {
+        uint32_t mark = m.code.n;
+        if (nanobox_jit_level >= 3) { // profiling mode: count executed inline instructions per opcode
+          Bit64u *ctr = &nanobox_dyn_inline[ins[k].getIaOpcode()];
+          zaddr(ADDR(*ctr)); zaddr(ADDR(*ctr)); em->mem(I64_LOAD, zoff(ADDR(*ctr)), 3); em->i64c(1); em->op(I64_ADD); em->mem(I64_STORE, zoff(ADDR(*ctr)), 3);
+        }
+        // each template runs inside its own block so it can `br` out of itself
+        // (used by the CL-count shifts when count == 0)
+        uint32_t markTpl = m.code.n;   // after the profiling counter: the template's own bytes
+        // the wrapper block exists so a template can `br` out of itself; almost none do, and 3
+        // bytes at every guest instruction is 4 % of everything emitted (nanobox_jit_outline bit 15).
+        // Pass 1 watches whether anything branched to it (or past it) and pass 2 leaves it out where
+        // nothing did -- relative branch depths inside are all computed from `depth`, so they follow.
+        const unsigned wk = (k < BX_MAX_TRACE_LENGTH) ? k : (unsigned) BX_MAX_TRACE_LENGTH;
+        const bool wrap = !wrapElide() || passNo == 1 || tplWrap[wk];
+        if (wrap) { PhScope _pw(this, PH_WRAP); blk(); em->watchOpen(); }
+        done = emitTemplate(k, last);
+        if (wrap) { PhScope _pw(this, PH_WRAP); if (em->watchClose() && passNo == 1) tplWrap[wk] = 1; endb(); }
+        if (!done) m.code.n = mark; // template declined before emitting anything: drop the wrapper
+        if (done) {
+          nanobox_inline_count[ins[k].getIaOpcode()]++;
+          nanobox_tpl_bytes[ins[k].getIaOpcode()] += m.code.n - markTpl;
+          if (needAsyncCheck && !last) {
+            // an instruction that may have raised an async event (MMIO, SMC, ...) ends the trace
+            // after completing, exactly like BX_NEXT_INSTR's check.
+            // `last` is exempt: exitFallthroughOrTransition() below commits the very same state
+            // and then tests async_event itself (link epilogue / emitTransition), so the check
+            // here would be a duplicate of the next one on an identical state.
+            PhScope _pa(this, PH_ASYNC);
+            zaddr(ADDR(BX_CPU_THIS_PTR async_event)); em->mem(I32_LOAD, zoff(ADDR(BX_CPU_THIS_PTR async_event)), 2);
+            CacheState s = snapshot();
+            iff(); coldExit = true; exitFallthrough(k); coldExit = false; endb();
+            restore(s);
+          }
+        }
+      }
+      if (!done) {
+        if (nanobox_jit_level >= 3) {
+          Bit64u *ctr = &nanobox_dyn_fallback[ins[k].getIaOpcode()];
+          zaddr(ADDR(*ctr)); zaddr(ADDR(*ctr)); em->mem(I64_LOAD, zoff(ADDR(*ctr)), 3); em->i64c(1); em->op(I64_ADD); em->mem(I64_STORE, zoff(ADDR(*ctr)), 3);
+        }
+        const uint32_t markH = m.code.n;
+        emitHandlerStep(k, last);
+        nanobox_fallback_count[ins[k].getIaOpcode()]++;
+        // a handler step is emitted code like any other: count it, so --tpl-bytes reports bytes per
+        // GUEST INSTRUCTION rather than bytes per templated instruction (nanobox_jit_tier bit 8)
+        if (nanobox_jit_tier & 256) { nanobox_inline_count[ins[k].getIaOpcode()]++; nanobox_tpl_bytes[ins[k].getIaOpcode()] += m.code.n - markH; }
+      } else if (last) {
+        exitFallthroughOrTransition(k);
+      }
+    }
+    phIa(NB_PHOP_NONE);
+    return true;
+  }
+};
