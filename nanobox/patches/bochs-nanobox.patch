+  void emitStackRead(unsigned k, uint32_t off_l) {
+        blk(I64);
+      blk();
+        tlbProbe(off_l, 8, 1, 0);
+        pushHostAddr(off_l, nanobox_tlbfold != 0); em->mem(I64_LOAD, 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->get(off_l); em->call(fn(FNIDX(&BX_CPU_C::stack_read_qword), "l>l"));
+    endb();
+    needAsyncCheck = true;
+  }
+  void emitStackWrite(unsigned k, uint32_t off_l, uint32_t val_l) {
+        blk();
+      blk();
+        tlbProbe(off_l, 8, 4, 0, 8);
+        if (!nanobox_tlbfold) emitWriteStamp(off_l, 8); else needAsyncCheck = true;
+        pushHostAddr(off_l, nanobox_tlbfold != 0); em->get(val_l); em->mem(I64_STORE, 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->get(off_l); em->get(val_l); em->call(fn(FNIDX(&BX_CPU_C::stack_write_qword), "ll>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+  // RMW read: value on stack (i64), host address (i32, 0 = slow path) left in T32[1]
+  void emitRMWRead(unsigned k, MemKind kind, unsigned seg, unsigned size, uint32_t off_l) {
+    const uint32_t la = laLocal(seg, off_l);
+    blk(I64);
+      blk();
+        tlbProbe(la, size, 4, 0, size);
+        if (!nanobox_tlbfold) emitWriteStamp(la, size); else needAsyncCheck = true;
+        pushHostAddr(la, nanobox_tlbfold && size > 1); em->tee(T32[1]); em->mem(loadOp(size), 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->i32c(0); em->set(T32[1]);
+      const char *sig; uint32_t f = accessorRead(kind, size, sig);
+      em->i32c(seg);
+      if (kind == MK_RMW_LIN) em->get(la); else em->get(off_l);
+      em->call(fn(f, sig));
+      if (size != 8) em->op(I64_EXTEND_I32_U);
+    endb();
+    needAsyncCheck = true;
+  }
+  void emitRMWWrite(MemKind kind, unsigned size, uint32_t val_l) {
+    em->get(T32[1]);
+    iff();
+      em->get(T32[1]); em->get(val_l); em->mem(storeOp(size), 0, 0);
+    els();
+      const char *sig; uint32_t f = accessorWrite(kind, size, sig);
+      em->get(val_l); if (size != 8) em->op(I32_WRAP_I64);
+      em->call(fn(f, sig));
+    endb();
+  }
