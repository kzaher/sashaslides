+      for (unsigned n = 0; n < 2; n++) {
+        em->i32c(0);
+        if (n < vl) { pushXmm(src1, n); pushXmm(s2, n); em->v128_const(m8f); em->simd(V128_AND); em->simd(I8X16_SWIZZLE); }
+        else em->v128_zero();
+        em->v128_store(xmmAddr(dst, n), 4);
+      }
+      return true;
+    }
+    case SK_VPMOVMSKB: case SK_PMOVMSKB: {
