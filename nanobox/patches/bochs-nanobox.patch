+    else { phAt[phTop] = m.code.n; }
+  }
+  void phPop() {
+    if (phTop <= 0) return;
+    if (m.code.n > phAt[phTop]) nanobox_phase_add(phSt[phTop], m.code.n - phAt[phTop]);
+    phTop--; phAt[phTop] = m.code.n;
+  }
+  void phFinish() { while (phTop > 0) phPop(); if (phTop == 0 && m.code.n > phAt[0]) { nanobox_phase_add(phSt[0], m.code.n - phAt[0]); phAt[0] = m.code.n; } }
+  // the opcode the phase records are attributed to; NB_PHOP_NONE outside a guest instruction
+  // (prologue, common tail, region glue). phFlushIa closes the open span so bytes never migrate.
+  void phIa(unsigned ia) {
+    if (phTop >= 0 && m.code.n > phAt[phTop]) { nanobox_phase_add(phSt[phTop], m.code.n - phAt[phTop]); phAt[phTop] = m.code.n; }
+    nanobox_ph_ia = ia;
+  }
+  struct PhScope { TraceCompiler *c; PhScope(TraceCompiler *cc, unsigned p) : c(cc) { c->phPush(p); } ~PhScope() { c->phPop(); } };
+  bool flagsPending() const { return (nanobox_jit_flags & 1) != 0; }
+  bool flagsFwdBr() const { return (nanobox_jit_flags & 8) != 0; }       // forward in-region edges as a direct br to the body label
+  bool flagsProbeLink() const { return (nanobox_jit_flags & 4) != 0; }   // probe cache passed through the link tail call
+  bool flagsProbeMem() const { return (nanobox_jit_flags & 32) != 0 && !flagsProbeLink(); }   // ... or through nanobox_probe_mem (written before the link, read at entry; cpu_loop poisons it)
+  bool flagsEntryClass() const { return (nanobox_jit_flags & 2) != 0; }
+  // AOT mode (nanobox_jit_aot, TASKS.md R): identity with the interpreter's trace boundaries is waived
+  // inside a region -- forward in-region edges carry no timer/async/window tests
+  // AOT mode waives identity for the whole translation, regions AND plain traces: a self-loop (the
+  // shape of every hot loop -- the former deliberately leaves it as a single trace, keeping registers
+  // in locals across iterations) is a trace, and it was still paying the identity-mode bookkeeping.
+  // The uses that need a region guard it themselves with `reg`.
