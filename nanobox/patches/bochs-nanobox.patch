+// ---------------------------------------------------------------------------------------------
+// Whole cold arms out of line (nanobox_jit_outline bits 17|18).
+//
+// A handler step and a memory slow arm both begin with the same three stores -- RIP = end of the
+// executing instruction, prev_rip = its start, icount = the instructions retired before it -- and
+// each of those was three wasm ops built from L_base / L_ic0 plus a constant. Passing the two
+// locals and the constants PACKED lets one call replace the sync, the instruction-pointer
+// arithmetic and the accessor / handler call behind it.
+//   p1 = the instruction's end offset from L_base (signed)
+//   p2 = ilen | k<<4 | (step: block<<9 | isRegion<<14) | (mem: seg<<9 | sizecode<<12 | kind<<14)
+extern "C" {
+static BX_CPP_INLINE void nanobox_cold_sync(Bit64u base, Bit64u ic0, Bit32s p1, Bit32u p2)
+{
+  const Bit64u ripEnd = base + (Bit64u)(Bit64s) p1;
+  BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx = ripEnd;
+  BX_CPU_THIS_PTR prev_rip = ripEnd - (p2 & 0xf);
+  BX_CPU_THIS_PTR icount = ic0 + ((p2 >> 4) & 0x1f);
+}
+// ---- tier 0: the compact call form (work/prof/tier.md) ----------------------------------------
+// One call performs a whole guest instruction. Everything the inline template carries per site --
+// the effective address, the probe cache, the fault arm, the register spill, the exit -- lives in
+// the engine instead, so the emitted site is `local.get 0; i32.const p; call; br_if`.
+//
+// Neither RIP nor icount travels in a parameter, which is what makes it four bytes smaller than the
+// cold arms above:
+//   * icount is ALREADY "instructions retired before this one" on entry -- BX_COMMIT_INSTRUCTION
+//     bumps it inside the handler that ran last, and cpu_loop has not bumped it for instruction 0 --
+//     so nanobox_cold_sync's `ic0 + k` would recompute exactly the value in memory. Skip it.
+//   * RIP is likewise already the END of the previous instruction, i.e. the START of this one, so
+//     the step is `prev_rip = RIP; RIP += ilen`. Instruction 0 is the exception: cpu_loop advanced
+//     RIP past it before entering, so it must not advance again (bit 15 of p says which).
+// A tier-0 body is straight-line -- any instruction that branches, faults or ends the trace returns
+// to cpu_loop -- so "the previous instruction left RIP at my start" holds at every site.
+//   p = ilen | k<<4 | 1<<15 (advance RIP)
+static unsigned nanobox_t0_step(Bit32u ptr, Bit32u p)
+{
+  const Bit64u ilen = p & 0xf;
+  if (p & 0x8000) {
+    BX_CPU_THIS_PTR prev_rip = BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx;
+    BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx += ilen;
+  } else {
+    BX_CPU_THIS_PTR prev_rip = BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx - ilen;
+  }
+  nanobox_trace_end = 0;
+  bxInstruction_c *i = ((bxICacheEntry_c *)(uintptr_t) ptr)->i + ((p >> 4) & 0x1f);
+  BX_CPU_CALL_METHOD(i->execute1, (i));
+  return (unsigned) nanobox_trace_end | (unsigned) BX_CPU_THIS_PTR async_event;
+}
+// Promotion (nanobox_jit_tier bit 1): a tier-0 function announces which entry is running so
+// cpu_loop can count it and recompile it at tier 1 once it is hot. It cannot happen here -- a
+// tier-1 compile decodes ahead and may recycle the trace-pool slots this function is executing out
+// of -- so the decision is deferred to the trace boundary, where every other compile happens.
+static void nanobox_t0_enter(Bit32u ptr) { nanobox_t0_running = (bxICacheEntry_c *)(uintptr_t) ptr; }
+// The FLOOR of the compact form (nanobox_jit_tier bit 2). Tier 0 observes nothing between guest
+// instructions, so it does not need one call per instruction at all: clearing nanobox_single_step
+// lets BX_NEXT_INSTR chain handler to handler exactly as cpu_loop's uncompiled path does, and the
+// whole trace becomes ONE call. This is the limit any "call a shared helper per site" design tends
+// to -- and it is, definitionally, the interpreter.
+static void nanobox_t0_trace(Bit32u ptr)
+{
+  bxInstruction_c *i = ((bxICacheEntry_c *)(uintptr_t) ptr)->i;
+  nanobox_single_step = 0;
+  BX_CPU_CALL_METHOD(i->execute1, (i));   // cpu_loop already did RIP += i->ilen()
+  nanobox_single_step = 1;
+}
+static unsigned nanobox_helper_step_all(Bit32u ptr, Bit64u base, Bit64u ic0, Bit32s p1, Bit32u p2)
+{
+  nanobox_cold_sync(base, ic0, p1, p2);
+  nanobox_trace_end = 0;
+  const unsigned k = (p2 >> 4) & 0x1f;
+  bxInstruction_c *i = (p2 & 0x4000) ? (((Region *)(uintptr_t) ptr)->insptr[(p2 >> 9) & 0x1f] + k)
+                                     : ((bxInstruction_c *)(uintptr_t) ptr + k);
+  BX_CPU_CALL_METHOD(i->execute1, (i));
+  return (unsigned) nanobox_trace_end | (unsigned) BX_CPU_THIS_PTR async_event;
+}
+enum { NB_SLOW_RD_LIN = 0, NB_SLOW_RD_VIRT, NB_SLOW_WR_LIN, NB_SLOW_WR_VIRT, NB_SLOW_STACK_RD, NB_SLOW_STACK_WR };
+static Bit64u nanobox_slow_rd(Bit64u la, Bit64u base, Bit64u ic0, Bit32s p1, Bit32u p2)
+{
+  nanobox_cold_sync(base, ic0, p1, p2);
+  if (nanobox_jit_level >= 3) nanobox_stats.jit_slow++;
+  const unsigned seg = (p2 >> 9) & 7, size = 1u << ((p2 >> 12) & 3), kind = (p2 >> 14) & 7;
+  if (kind == NB_SLOW_STACK_RD) return BX_CPU_THIS_PTR stack_read_qword(la);
+  if (kind == NB_SLOW_RD_LIN)
+    return size == 8 ? BX_CPU_THIS_PTR read_linear_qword(seg, la) :
+           size == 4 ? (Bit64u) BX_CPU_THIS_PTR read_linear_dword(seg, la) :
+           size == 2 ? (Bit64u) BX_CPU_THIS_PTR read_linear_word(seg, la) :
+                       (Bit64u) BX_CPU_THIS_PTR read_linear_byte(seg, la);
+  return size == 8 ? BX_CPU_THIS_PTR read_virtual_qword(seg, la) :
+         size == 4 ? (Bit64u) BX_CPU_THIS_PTR read_virtual_dword(seg, la) :
+         size == 2 ? (Bit64u) BX_CPU_THIS_PTR read_virtual_word(seg, la) :
+                     (Bit64u) BX_CPU_THIS_PTR read_virtual_byte(seg, la);
+}
+static void nanobox_slow_wr(Bit64u la, Bit64u val, Bit64u base, Bit64u ic0, Bit32s p1, Bit32u p2)
+{
+  nanobox_cold_sync(base, ic0, p1, p2);
+  if (nanobox_jit_level >= 3) nanobox_stats.jit_slow++;
+  const unsigned seg = (p2 >> 9) & 7, size = 1u << ((p2 >> 12) & 3), kind = (p2 >> 14) & 7;
+  if (kind == NB_SLOW_STACK_WR) { BX_CPU_THIS_PTR stack_write_qword(la, val); return; }
+  if (kind == NB_SLOW_WR_LIN) {
+    if (size == 8) BX_CPU_THIS_PTR write_linear_qword(seg, la, val);
+    else if (size == 4) BX_CPU_THIS_PTR write_linear_dword(seg, la, (Bit32u) val);
+    else if (size == 2) BX_CPU_THIS_PTR write_linear_word(seg, la, (Bit16u) val);
+    else BX_CPU_THIS_PTR write_linear_byte(seg, la, (Bit8u) val);
+    return;
+  }
+  if (size == 8) BX_CPU_THIS_PTR write_virtual_qword(seg, la, val);
+  else if (size == 4) BX_CPU_THIS_PTR write_virtual_dword(seg, la, (Bit32u) val);
+  else if (size == 2) BX_CPU_THIS_PTR write_virtual_word(seg, la, (Bit16u) val);
+  else BX_CPU_THIS_PTR write_virtual_byte(seg, la, (Bit8u) val);
+}
+}
