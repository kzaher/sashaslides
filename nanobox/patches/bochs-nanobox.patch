+    // nothing else touches those locals until the next ALU op (which kills the state anyway)
+    uint32_t op1 = P_op1, op2 = P_op2, res = P_res, ea = T[3];
+    bool writesDst = (op != A_CMP && op != A_TEST);
+    MemKind rdKind = (size == 8) ? MK_RD_LIN : MK_RD_VIRT;
+    MemKind rmwKind = (size == 8) ? MK_RMW_LIN : MK_RMW_VIRT;
+    // pending state of the previous ALU op: does its materialisation on the slow path of our
+    // memory read still find its operands intact? Yes: the memory operand is read FIRST, the
+    // register / immediate operand is set into P_op1/P_op2 only after it.
+    Bit64s imm = 0;
+    if (form == 2 || form == 3) imm = size == 8 ? (Bit64s)(Bit32s) i->Id() : size == 4 ? (Bit64s)(Bit64u) i->Id() : size == 2 ? (Bit64s) i->Iw() : (Bit64s) i->Ib();
+    // ADC/SBB: carry in FIRST — the operands overwrite the pending-flag locals, so a pending state
+    // must be fully materialised (loaded + dirty: a later slow-path spill stores a complete state)
+    // before they are set; reading CF earlier than the handler is unobservable (nothing in between
+    // writes flags, and a memory operand that faults leaves CF unread either way)
+    if (op == A_ADC || op == A_SBB) { lfLoad(); pushCF(); em->op(I64_EXTEND_I32_U); em->set(T[4]); }
