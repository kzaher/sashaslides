+struct TraceCompiler {
+  bxICacheEntry_c *e;
+  bxInstruction_c *ins;
+  unsigned n;            // number of real instructions in the trace
+  Module &m;             // the module this function is emitted into (shared by a batch)
+  Emit *em;
+  bool mode64;
+  Bit32u off[BX_MAX_TRACE_LENGTH + 2];
+  bool needAsyncCheck;   // current instruction had a path that may raise async_event
