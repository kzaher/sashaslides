+NB_EXPORT(nanobox_jit_simd_stat) double nanobox_jit_simd_stat(unsigned i) { return i < 8 ? (double) nanobox_simd_stats[i] : (i >= 256 && i < 512) ? (double) nanobox_pcmpistri_imm[i - 256] : 0; }
