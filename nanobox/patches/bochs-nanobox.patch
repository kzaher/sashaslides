+static void nanobox_spill12(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j, Bit64u k, Bit64u l)
+{ const Bit64u v[12] = { a, b, c, d, e, f, g, h, i, j, k, l }; nanobox_spill_apply(m, v); }
+static void nanobox_spill13(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j, Bit64u k, Bit64u l, Bit64u n)
+{ const Bit64u v[13] = { a, b, c, d, e, f, g, h, i, j, k, l, n }; nanobox_spill_apply(m, v); }
+static void nanobox_spill14(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j, Bit64u k, Bit64u l, Bit64u n, Bit64u o)
+{ const Bit64u v[14] = { a, b, c, d, e, f, g, h, i, j, k, l, n, o }; nanobox_spill_apply(m, v); }
+static void nanobox_spill15(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j, Bit64u k, Bit64u l, Bit64u n, Bit64u o, Bit64u q)
+{ const Bit64u v[15] = { a, b, c, d, e, f, g, h, i, j, k, l, n, o, q }; nanobox_spill_apply(m, v); }
+static void nanobox_spill16(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j, Bit64u k, Bit64u l, Bit64u n, Bit64u o, Bit64u q, Bit64u r)
+{ const Bit64u v[16] = { a, b, c, d, e, f, g, h, i, j, k, l, n, o, q, r }; nanobox_spill_apply(m, v); }
+static void nanobox_spill17(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j, Bit64u k, Bit64u l, Bit64u n, Bit64u o, Bit64u q, Bit64u r, Bit64u t)
+{ const Bit64u v[17] = { a, b, c, d, e, f, g, h, i, j, k, l, n, o, q, r, t }; nanobox_spill_apply(m, v); }
+static void nanobox_spill18(Bit32u m, Bit64u a, Bit64u b, Bit64u c, Bit64u d, Bit64u e, Bit64u f, Bit64u g, Bit64u h, Bit64u i, Bit64u j, Bit64u k, Bit64u l, Bit64u n, Bit64u o, Bit64u q, Bit64u r, Bit64u t, Bit64u u)
+{ const Bit64u v[18] = { a, b, c, d, e, f, g, h, i, j, k, l, n, o, q, r, t, u }; nanobox_spill_apply(m, v); }
+static unsigned nanobox_spill_fnidx(unsigned n)
+{
+  switch (n) {
