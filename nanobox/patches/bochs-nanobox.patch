+  // 16-byte load/store between an XMM register and memory: TLB fast path (no page split), else the
+  // Bochs accessor (which also does the alignment check / #GP for the aligned forms)
+  void emitReadXmm(unsigned k, unsigned seg, uint32_t off_l, unsigned xreg, bool aligned) {
+    uint32_t xaddr = ADDR(BX_CPU_THIS_PTR vmm[xreg]);
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        if (aligned) { em->get(T[5]); em->i64c(15); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+        tlbProbe(T[5], 16, 1, 0);
+        em->i32c(0); pushHostAddr(T[5], nanobox_tlbfold != 0); em->mem(I64_LOAD, 0, 0); em->mem(I64_STORE, xaddr, 3);
+        em->i32c(0); pushHostAddr(T[5], nanobox_tlbfold != 0); em->mem(I64_LOAD, 8, 0); em->mem(I64_STORE, xaddr + 8, 3);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->i32c(seg); em->get(off_l); em->i32c(xaddr);
+      em->call(fn(FNIDX(aligned ? &BX_CPU_C::read_virtual_xmmword_aligned : &BX_CPU_C::read_virtual_xmmword), "ili>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+  void emitWriteXmm(unsigned k, unsigned seg, uint32_t off_l, unsigned xreg, bool aligned) {
+    uint32_t xaddr = ADDR(BX_CPU_THIS_PTR vmm[xreg]);
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        if (aligned) { em->get(T[5]); em->i64c(15); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+        tlbProbe(T[5], 16, 4, 0, 16);
+        if (!nanobox_tlbfold) emitWriteStamp(T[5], 16); else needAsyncCheck = true;
+        pushHostAddr(T[5], nanobox_tlbfold != 0); em->i32c(0); em->mem(I64_LOAD, xaddr, 3); em->mem(I64_STORE, 0, 0);
+        pushHostAddr(T[5], nanobox_tlbfold != 0); em->i32c(0); em->mem(I64_LOAD, xaddr + 8, 3); em->mem(I64_STORE, 8, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->i32c(seg); em->get(off_l); em->i32c(xaddr);
+      em->call(fn(FNIDX(aligned ? &BX_CPU_C::write_virtual_xmmword_aligned : &BX_CPU_C::write_virtual_xmmword), "ili>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+
+  // ================================================================ SIMD templates (SSE / AVX)
+  // Dispatch is by HANDLER, not by opcode: an instruction's semantics is its handler applied to its
+  // decoded fields (dst/src1/src2/VL/Ib), so matching execute1 (and, for the LOAD_* memory-form
+  // prefixes, execute2) reproduces exactly what the interpreter would run — including the
+  // BxNoSSE/BxNoAVX substitution when the entry was decoded with SSE/AVX unavailable (no match).
+  // XMM/YMM registers live in BX_CPU_THIS_PTR vmm[] (32 bytes each, lane 1 = the YMM upper half);
+  // the memory forms first load into vmm[BX_VECTOR_TMP_REGISTER] exactly like LOAD_Wdq/LOADU_Wdq/
+  // LOAD_Vector/LOAD_Wb do, then run the register form on it.
+  enum SimdLoad { SL_NONE = 0, SL_WDQ_A, SL_WDQ_U, SL_VEC, SL_WB };
+  enum SimdKind { SK_NONE = 0, SK_VZEROUPPER, SK_AVX2OP, SK_VPSHUFB, SK_VPMOVMSKB, SK_PMOVMSKB, SK_SSE2OP, SK_PSHUFB, SK_PCMPISTRI,
+                  SK_VMOV_R, SK_VMOV_LD, SK_VMOV_ST, SK_MOVD_R, SK_MOVD_LD, SK_MOVD_ST, SK_MOVQ_EqVq, SK_VPBROADCASTB };
+  enum { VOP_XOR = 0, VOP_OR, VOP_AND, VOP_ANDN, VOP_CMPEQB };
+  struct SimdDesc { SimdKind kind; SimdLoad ld; int op; bool aligned; };
+  static bool isSimdLoad(BxExecutePtr_tR h, SimdLoad &ld) {
+    if (h == &BX_CPU_C::LOAD_Wdq) { ld = SL_WDQ_A; return true; }
+    if (h == &BX_CPU_C::LOADU_Wdq) { ld = SL_WDQ_U; return true; }
+    if (h == &BX_CPU_C::LOAD_Vector) { ld = SL_VEC; return true; }
+    if (h == &BX_CPU_C::LOAD_Wb) { ld = SL_WB; return true; }
+    return false;
+  }
+  SimdDesc simdClassify(unsigned k) {
+    SimdDesc d; d.kind = SK_NONE; d.ld = SL_NONE; d.op = 0; d.aligned = false;
+    bxInstruction_c *i = &ins[k];
+    BxExecutePtr_tR h = i->execute1;
+    if (isSimdLoad(h, d.ld)) h = i->execute2();
+    unsigned vl = i->getVL();
+    if (h == &BX_CPU_C::VZEROUPPER) { if (d.ld == SL_NONE) d.kind = SK_VZEROUPPER; return d; }
+    // VEX two-source: dst = op(src1, src2) per lane, VL128 clears the upper lane
+    if (h == &BX_CPU_C::VXORPS_VpsHpsWpsR) d.op = VOP_XOR;
+    else if (h == &BX_CPU_C::VORPS_VpsHpsWpsR) d.op = VOP_OR;
+    else if (h == &BX_CPU_C::VANDPS_VpsHpsWpsR) d.op = VOP_AND;
+    else if (h == &BX_CPU_C::VANDNPS_VpsHpsWpsR) d.op = VOP_ANDN;
+    else if (h == &BX_CPU_C::VPCMPEQB_VdqHdqWdqR) d.op = VOP_CMPEQB;
+    else d.op = -1;
+    if (d.op >= 0) {
+      if ((vl == BX_VL128 || vl == BX_VL256) && (d.ld == SL_NONE || d.ld == SL_WDQ_U || d.ld == SL_VEC)) d.kind = SK_AVX2OP;
+      return d;
+    }
+    if (h == &BX_CPU_C::VPSHUFB_VdqHdqWdqR) { if ((vl == BX_VL128 || vl == BX_VL256) && (d.ld == SL_NONE || d.ld == SL_WDQ_U || d.ld == SL_VEC)) d.kind = SK_VPSHUFB; return d; }
+    if (h == &BX_CPU_C::VPMOVMSKB_GdUdq) { if ((vl == BX_VL128 || vl == BX_VL256) && d.ld == SL_NONE) d.kind = SK_VPMOVMSKB; return d; }
+    if (h == &BX_CPU_C::PMOVMSKB_GdUdq) { if (d.ld == SL_NONE) d.kind = SK_PMOVMSKB; return d; }
+    // SSE two-operand: dst.lane0 = op(dst.lane0, src.lane0), upper lane untouched
+    if (h == &BX_CPU_C::XORPS_VpsWpsR) d.op = VOP_XOR;
+    else if (h == &BX_CPU_C::ORPS_VpsWpsR) d.op = VOP_OR;
+    else if (h == &BX_CPU_C::ANDPS_VpsWpsR) d.op = VOP_AND;
+    else if (h == &BX_CPU_C::ANDNPS_VpsWpsR) d.op = VOP_ANDN;
+    else if (h == &BX_CPU_C::PCMPEQB_VdqWdqR) d.op = VOP_CMPEQB;
+    else d.op = -1;
