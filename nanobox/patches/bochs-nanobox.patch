+      em->call(fn(FNIDX(&nanobox_helper_step_pre), "lll>v"));
+      csInvalidate();
+      pushInsPtr(k);
+      em->call(fn(FNIDX(ins[k].execute1), "i>v"));
+      em->call(fn(FNIDX(&nanobox_helper_step_post), ">i"));
+    } else {
+    syncBefore(k, true);
+    csInvalidate();
+    em->i32c(0); em->i32c(0); em->mem(I32_STORE8, ADDR(nanobox_trace_end), 0);
+    pushInsPtr(k);
+    em->call(fn(FNIDX(ins[k].execute1), "i>v"));
