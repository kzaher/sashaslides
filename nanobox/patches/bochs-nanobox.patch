+      pushOF(); em->set(T32[4]);
+      setFlagsOxxxxC(T32[4], T32[3]);
+      return true;
+    }
+
+    // ---- SSE 128-bit moves (memory forms) and reg-reg XORPS/PXOR. Only when the entry was decoded
+    //      with SSE enabled (otherwise the handler is BxNoSSE, which must raise #NM/#UD).
+    case BX_IA_MOVUPS_VpsWps: case BX_IA_MOVUPD_VpdWpd: case BX_IA_MOVDQU_VdqWdq: case BX_IA_MOVAPS_VpsWps: case BX_IA_MOVAPD_VpdWpd: case BX_IA_MOVDQA_VdqWdq: {
+      if (R) { // register copy: MOVAPS_VpsWpsR = BX_WRITE_XMM_REGZ(dst, src, VL=0)
+        if (!realHandler(k, &BX_CPU_C::MOVAPS_VpsWpsR)) return false;
+        uint32_t d = ADDR(BX_CPU_THIS_PTR vmm[dst]), sr = ADDR(BX_CPU_THIS_PTR vmm[src]);
+        for (unsigned q = 0; q < 2; q++) { em->i32c(0); em->i32c(0); em->mem(I64_LOAD, sr + 8 * q, 3); em->mem(I64_STORE, d + 8 * q, 3); }
+        return true;
+      }
+      bool aligned = (ia == BX_IA_MOVAPS_VpsWps || ia == BX_IA_MOVAPD_VpdWpd || ia == BX_IA_MOVDQA_VdqWdq);
+      BxExecutePtr_tR h = (ia == BX_IA_MOVUPS_VpsWps) ? &BX_CPU_C::MOVUPS_VpsWpsM : (ia == BX_IA_MOVUPD_VpdWpd) ? &BX_CPU_C::MOVUPS_VpsWpsM :
+                          (ia == BX_IA_MOVDQU_VdqWdq) ? &BX_CPU_C::MOVUPS_VpsWpsM : &BX_CPU_C::MOVAPS_VpsWpsM;
+      if (!realHandler(k, h)) return false;
+      pushEA(k); em->set(t3);
+      emitReadXmm(k, seg, t3, dst, aligned);
+      return true;
+    }
+    case BX_IA_MOVUPS_WpsVps: case BX_IA_MOVUPD_WpdVpd: case BX_IA_MOVDQU_WdqVdq: case BX_IA_MOVAPS_WpsVps: case BX_IA_MOVAPD_WpdVpd: case BX_IA_MOVDQA_WdqVdq: {
+      if (R) { // store forms with a register operand: MOVAPS_VpsWpsR with dst/src as decoded (dst = the "W" register)
+        if (!realHandler(k, &BX_CPU_C::MOVAPS_VpsWpsR)) return false;
+        uint32_t d = ADDR(BX_CPU_THIS_PTR vmm[dst]), sr = ADDR(BX_CPU_THIS_PTR vmm[src]);
+        for (unsigned q = 0; q < 2; q++) { em->i32c(0); em->i32c(0); em->mem(I64_LOAD, sr + 8 * q, 3); em->mem(I64_STORE, d + 8 * q, 3); }
+        return true;
+      }
+      bool aligned = (ia == BX_IA_MOVAPS_WpsVps || ia == BX_IA_MOVAPD_WpdVpd || ia == BX_IA_MOVDQA_WdqVdq);
+      BxExecutePtr_tR h = aligned ? &BX_CPU_C::MOVAPS_WpsVpsM : &BX_CPU_C::MOVUPS_WpsVpsM;
+      if (!realHandler(k, h)) return false;
+      pushEA(k); em->set(t3);
+      emitWriteXmm(k, seg, t3, src, aligned);
+      return true;
+    }
+    case BX_IA_XORPS_VpsWps: case BX_IA_XORPD_VpdWpd: case BX_IA_PXOR_VdqWdq: {
+      if (templSimd()) return emitTemplateSimd(k, i, last);   // handler-based SIMD templates (reg + memory forms)
+      if (!R) return false;
+      BxExecutePtr_tR h = (ia == BX_IA_XORPS_VpsWps) ? &BX_CPU_C::XORPS_VpsWpsR : &BX_CPU_C::XORPS_VpsWpsR;
+      if (!realHandler(k, h)) return false;
+      uint32_t d = ADDR(BX_CPU_THIS_PTR vmm[dst]), sr = ADDR(BX_CPU_THIS_PTR vmm[src]);
+      for (unsigned q = 0; q < 2; q++) { em->i32c(0); em->i32c(0); em->mem(I64_LOAD, d + 8 * q, 3); em->i32c(0); em->mem(I64_LOAD, sr + 8 * q, 3); em->op(I64_XOR); em->mem(I64_STORE, d + 8 * q, 3); }
+      return true;
+    }
+    case BX_IA_MOVQ_VdqEq: {
+      if (!R || !realHandler(k, &BX_CPU_C::MOVQ_VdqEqR)) return false;
+      uint32_t d = ADDR(BX_CPU_THIS_PTR vmm[dst]);
+      em->i32c(0); regGet(src); em->mem(I64_STORE, d, 3);
+      em->i32c(0); em->i64c(0); em->mem(I64_STORE, d + 8, 3);
+      return true;
+    }
+    default:
+      if (templSimd() && emitTemplateSimd(k, i, last)) return true;
+      if (templRep() && emitTemplateRep(k, i, ia, last)) return true;
+      if (templMisc() && emitTemplateMisc(k, i, ia, R, last)) return true;
+      return false;
+    }
+  }
+  // 16-byte load/store between an XMM register and memory: TLB fast path (no page split), else the
+  // Bochs accessor (which also does the alignment check / #GP for the aligned forms)
+  void emitReadXmm(unsigned k, unsigned seg, uint32_t off_l, unsigned xreg, bool aligned) {
+    uint32_t xaddr = ADDR(BX_CPU_THIS_PTR vmm[xreg]);
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        if (aligned) { em->get(T[5]); em->i64c(15); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+        tlbProbe(T[5], 16, 1, 0);
+        em->i32c(0); pushHostAddr(T[5], nanobox_tlbfold != 0); em->mem(I64_LOAD, 0, 0); em->mem(I64_STORE, xaddr, 3);
+        em->i32c(0); pushHostAddr(T[5], nanobox_tlbfold != 0); em->mem(I64_LOAD, 8, 0); em->mem(I64_STORE, xaddr + 8, 3);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->i32c(seg); em->get(off_l); em->i32c(xaddr);
+      em->call(fn(FNIDX(aligned ? &BX_CPU_C::read_virtual_xmmword_aligned : &BX_CPU_C::read_virtual_xmmword), "ili>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+  void emitWriteXmm(unsigned k, unsigned seg, uint32_t off_l, unsigned xreg, bool aligned) {
+    uint32_t xaddr = ADDR(BX_CPU_THIS_PTR vmm[xreg]);
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        if (aligned) { em->get(T[5]); em->i64c(15); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+        tlbProbe(T[5], 16, 4, 0, 16);
+        if (!nanobox_tlbfold) emitWriteStamp(T[5], 16); else needAsyncCheck = true;
+        pushHostAddr(T[5], nanobox_tlbfold != 0); em->i32c(0); em->mem(I64_LOAD, xaddr, 3); em->mem(I64_STORE, 0, 0);
+        pushHostAddr(T[5], nanobox_tlbfold != 0); em->i32c(0); em->mem(I64_LOAD, xaddr + 8, 3); em->mem(I64_STORE, 8, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->i32c(seg); em->get(off_l); em->i32c(xaddr);
+      em->call(fn(FNIDX(aligned ? &BX_CPU_C::write_virtual_xmmword_aligned : &BX_CPU_C::write_virtual_xmmword), "ili>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+
+  // ================================================================ SIMD templates (SSE / AVX)
+  // Dispatch is by HANDLER, not by opcode: an instruction's semantics is its handler applied to its
+  // decoded fields (dst/src1/src2/VL/Ib), so matching execute1 (and, for the LOAD_* memory-form
+  // prefixes, execute2) reproduces exactly what the interpreter would run — including the
+  // BxNoSSE/BxNoAVX substitution when the entry was decoded with SSE/AVX unavailable (no match).
+  // XMM/YMM registers live in BX_CPU_THIS_PTR vmm[] (32 bytes each, lane 1 = the YMM upper half);
+  // the memory forms first load into vmm[BX_VECTOR_TMP_REGISTER] exactly like LOAD_Wdq/LOADU_Wdq/
+  // LOAD_Vector/LOAD_Wb do, then run the register form on it.
+  enum SimdLoad { SL_NONE = 0, SL_WDQ_A, SL_WDQ_U, SL_VEC, SL_WB };
+  enum SimdKind { SK_NONE = 0, SK_VZEROUPPER, SK_AVX2OP, SK_VPSHUFB, SK_VPMOVMSKB, SK_PMOVMSKB, SK_SSE2OP, SK_PSHUFB, SK_PCMPISTRI,
+                  SK_VMOV_R, SK_VMOV_LD, SK_VMOV_ST, SK_MOVD_R, SK_MOVD_LD, SK_MOVD_ST, SK_MOVQ_EqVq, SK_VPBROADCASTB };
+  enum { VOP_XOR = 0, VOP_OR, VOP_AND, VOP_ANDN, VOP_CMPEQB };
+  struct SimdDesc { SimdKind kind; SimdLoad ld; int op; bool aligned; };
+  static bool isSimdLoad(BxExecutePtr_tR h, SimdLoad &ld) {
+    if (h == &BX_CPU_C::LOAD_Wdq) { ld = SL_WDQ_A; return true; }
+    if (h == &BX_CPU_C::LOADU_Wdq) { ld = SL_WDQ_U; return true; }
+    if (h == &BX_CPU_C::LOAD_Vector) { ld = SL_VEC; return true; }
+    if (h == &BX_CPU_C::LOAD_Wb) { ld = SL_WB; return true; }
+    return false;
+  }
+  SimdDesc simdClassify(unsigned k) {
+    SimdDesc d; d.kind = SK_NONE; d.ld = SL_NONE; d.op = 0; d.aligned = false;
+    bxInstruction_c *i = &ins[k];
+    BxExecutePtr_tR h = i->execute1;
+    if (isSimdLoad(h, d.ld)) h = i->execute2();
+    unsigned vl = i->getVL();
+    if (h == &BX_CPU_C::VZEROUPPER) { if (d.ld == SL_NONE) d.kind = SK_VZEROUPPER; return d; }
+    // VEX two-source: dst = op(src1, src2) per lane, VL128 clears the upper lane
+    if (h == &BX_CPU_C::VXORPS_VpsHpsWpsR) d.op = VOP_XOR;
+    else if (h == &BX_CPU_C::VORPS_VpsHpsWpsR) d.op = VOP_OR;
+    else if (h == &BX_CPU_C::VANDPS_VpsHpsWpsR) d.op = VOP_AND;
+    else if (h == &BX_CPU_C::VANDNPS_VpsHpsWpsR) d.op = VOP_ANDN;
+    else if (h == &BX_CPU_C::VPCMPEQB_VdqHdqWdqR) d.op = VOP_CMPEQB;
+    else d.op = -1;
+    if (d.op >= 0) {
+      if ((vl == BX_VL128 || vl == BX_VL256) && (d.ld == SL_NONE || d.ld == SL_WDQ_U || d.ld == SL_VEC)) d.kind = SK_AVX2OP;
+      return d;
+    }
+    if (h == &BX_CPU_C::VPSHUFB_VdqHdqWdqR) { if ((vl == BX_VL128 || vl == BX_VL256) && (d.ld == SL_NONE || d.ld == SL_WDQ_U || d.ld == SL_VEC)) d.kind = SK_VPSHUFB; return d; }
+    if (h == &BX_CPU_C::VPMOVMSKB_GdUdq) { if ((vl == BX_VL128 || vl == BX_VL256) && d.ld == SL_NONE) d.kind = SK_VPMOVMSKB; return d; }
+    if (h == &BX_CPU_C::PMOVMSKB_GdUdq) { if (d.ld == SL_NONE) d.kind = SK_PMOVMSKB; return d; }
+    // SSE two-operand: dst.lane0 = op(dst.lane0, src.lane0), upper lane untouched
+    if (h == &BX_CPU_C::XORPS_VpsWpsR) d.op = VOP_XOR;
+    else if (h == &BX_CPU_C::ORPS_VpsWpsR) d.op = VOP_OR;
+    else if (h == &BX_CPU_C::ANDPS_VpsWpsR) d.op = VOP_AND;
+    else if (h == &BX_CPU_C::ANDNPS_VpsWpsR) d.op = VOP_ANDN;
+    else if (h == &BX_CPU_C::PCMPEQB_VdqWdqR) d.op = VOP_CMPEQB;
+    else d.op = -1;
+    if (d.op >= 0) { if (d.ld == SL_NONE || d.ld == SL_WDQ_A || d.ld == SL_WDQ_U) d.kind = SK_SSE2OP; return d; }
+    if (h == &BX_CPU_C::PSHUFB_VdqWdqR) { if (d.ld == SL_NONE || d.ld == SL_WDQ_A || d.ld == SL_WDQ_U) d.kind = SK_PSHUFB; return d; }
+    if (h == &BX_CPU_C::PCMPISTRI_VdqWdqIbR) { if (d.ld == SL_NONE || d.ld == SL_WDQ_A || d.ld == SL_WDQ_U) d.kind = SK_PCMPISTRI; return d; }
+    if (d.ld != SL_NONE) return d;
+    // AVX moves
+    if (h == &BX_CPU_C::VMOVAPS_VpsWpsR) { if (vl == BX_VL128 || vl == BX_VL256) d.kind = SK_VMOV_R; return d; }
+    if (h == &BX_CPU_C::VMOVUPS_VpsWpsM || h == &BX_CPU_C::VMOVAPS_VpsWpsM) { if (vl == BX_VL128 || vl == BX_VL256) { d.kind = SK_VMOV_LD; d.aligned = (h == &BX_CPU_C::VMOVAPS_VpsWpsM); } return d; }
+    if (h == &BX_CPU_C::VMOVUPS_WpsVpsM || h == &BX_CPU_C::VMOVAPS_WpsVpsM) { if (vl == BX_VL128 || vl == BX_VL256) { d.kind = SK_VMOV_ST; d.aligned = (h == &BX_CPU_C::VMOVAPS_WpsVpsM); } return d; }
+    if (h == &BX_CPU_C::MOVUPS_WpsVpsM || h == &BX_CPU_C::MOVAPS_WpsVpsM) { d.kind = SK_VMOV_ST; d.op = 1 /* 16 bytes regardless of VL */; d.aligned = (h == &BX_CPU_C::MOVAPS_WpsVpsM); return d; }
+    // MOVD / MOVQ between GPR and XMM
+    if (h == &BX_CPU_C::MOVD_VdqEdR) { d.kind = SK_MOVD_R; return d; }
+    if (h == &BX_CPU_C::MOVSS_VssWssM) { d.kind = SK_MOVD_LD; return d; }
+    if (h == &BX_CPU_C::MOVD_EdVdR) { d.kind = SK_MOVD_ST; d.op = 0; return d; }
+    if (h == &BX_CPU_C::MOVSS_WssVssM) { d.kind = SK_MOVD_ST; d.op = 1; return d; }
+    if (h == &BX_CPU_C::MOVQ_EqVqR) { d.kind = SK_MOVQ_EqVq; return d; }
+    if (h == &BX_CPU_C::VPBROADCASTB_VdqWbR) { if (vl == BX_VL128 || vl == BX_VL256) d.kind = SK_VPBROADCASTB; return d; }
+    return d;
+  }
+  // classification with the LOAD prefixes allowed for the broadcast (LOAD_Wb) form
+  SimdDesc simdClassifyAll(unsigned k) {
+    SimdDesc d = simdClassify(k);
+    if (d.kind == SK_NONE) {
+      bxInstruction_c *i = &ins[k];
+      SimdLoad ld;
+      if (isSimdLoad(i->execute1, ld) && ld == SL_WB && i->execute2() == &BX_CPU_C::VPBROADCASTB_VdqWbR && (i->getVL() == BX_VL128 || i->getVL() == BX_VL256)) { d.kind = SK_VPBROADCASTB; d.ld = SL_WB; }
+    }
+    return d;
+  }
+  static uint32_t xmmAddr(unsigned r, unsigned lane = 0) { return ADDR(BX_CPU_THIS_PTR vmm[r]) + 16 * lane; }
+  void pushXmm(unsigned r, unsigned lane = 0) { em->i32c(0); em->v128_load(xmmAddr(r, lane), 4); }
+  // vector load into the CPU struct at dstAddr (16*chunks bytes): TLB fast path (no page split; the
+  // aligned forms additionally require the natural alignment so the accessor's #GP check cannot
+  // fire), else the Bochs accessor. alignMode: 0 = unaligned accessor, 1 = aligned accessor,
+  // 2 = LOAD_Wdq (aligned accessor unless MXCSR.MM, decided at run time on the slow path)
+  void emitReadVec(unsigned k, unsigned seg, uint32_t off_l, uint32_t dstAddr, unsigned size, int alignMode) {
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        if (alignMode) { em->get(T[5]); em->i64c(size - 1); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+        tlbProbe(T[5], size, 1, 0);
+        for (unsigned c = 0; c < size / 16; c++) { em->i32c(0); pushHostAddr(T[5], nanobox_tlbfold != 0); em->v128_load(16 * c, 0); em->v128_store(dstAddr + 16 * c, 4); }
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      uint32_t fu = (size == 32) ? FNIDX(&BX_CPU_C::read_virtual_ymmword) : FNIDX(&BX_CPU_C::read_virtual_xmmword);
+      uint32_t fa = (size == 32) ? FNIDX(&BX_CPU_C::read_virtual_ymmword_aligned) : FNIDX(&BX_CPU_C::read_virtual_xmmword_aligned);
+      if (alignMode == 2) {
+        zaddr(ADDR(BX_CPU_THIS_PTR mxcsr.mxcsr)); em->mem(I32_LOAD, zoff(ADDR(BX_CPU_THIS_PTR mxcsr.mxcsr)), 2); em->i32c((int32_t) MXCSR_MISALIGNED_EXCEPTION_MASK); em->op(I32_AND);
+        iff(); em->i32c(seg); em->get(off_l); em->i32c(dstAddr); em->call(fn(fu, "ili>v"));
+        els(); em->i32c(seg); em->get(off_l); em->i32c(dstAddr); em->call(fn(fa, "ili>v"));
+        endb();
+      } else {
+        em->i32c(seg); em->get(off_l); em->i32c(dstAddr); em->call(fn(alignMode ? fa : fu, "ili>v"));
+      }
+    endb();
+    needAsyncCheck = true;
+  }
+  void emitWriteVec(unsigned k, unsigned seg, uint32_t off_l, uint32_t srcAddr, unsigned size, bool aligned) {
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        if (aligned) { em->get(T[5]); em->i64c(size - 1); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+        tlbProbe(T[5], size, 4, 0, size);
+        if (!nanobox_tlbfold) emitWriteStamp(T[5], size); else needAsyncCheck = true;
+        for (unsigned c = 0; c < size / 16; c++) { pushHostAddr(T[5], nanobox_tlbfold != 0); em->i32c(0); em->v128_load(srcAddr + 16 * c, 4); em->v128_store(16 * c, 0); }
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      uint32_t f = (size == 32) ? (aligned ? FNIDX(&BX_CPU_C::write_virtual_ymmword_aligned) : FNIDX(&BX_CPU_C::write_virtual_ymmword))
+                                : (aligned ? FNIDX(&BX_CPU_C::write_virtual_xmmword_aligned) : FNIDX(&BX_CPU_C::write_virtual_xmmword));
+      em->i32c(seg); em->get(off_l); em->i32c(srcAddr); em->call(fn(f, "ili>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+  // memory-form prefix: load the W operand into the TMP vector register exactly like LOAD_* does;
+  // returns the register index holding the second source
+  unsigned emitSimdLoadPrefix(unsigned k, const SimdDesc &d, unsigned vl, unsigned regIfNone) {
+    if (d.ld == SL_NONE) return regIfNone;
+    unsigned seg = ins[k].seg();
+    pushEA(k); em->set(T[3]);
+    switch (d.ld) {
+      case SL_WDQ_A: emitReadVec(k, seg, T[3], xmmAddr(BX_VECTOR_TMP_REGISTER), 16, 2); break;
+      case SL_WDQ_U: emitReadVec(k, seg, T[3], xmmAddr(BX_VECTOR_TMP_REGISTER), 16, 0); break;
+      case SL_VEC:   emitReadVec(k, seg, T[3], xmmAddr(BX_VECTOR_TMP_REGISTER), vl == BX_VL256 ? 32 : 16, 0); break;
+      case SL_WB:    emitRead(k, MK_RD_VIRT, seg, 1, T[3]); em->set(T[2]); em->i32c(0); em->get(T[2]); em->mem(I64_STORE8, xmmAddr(BX_VECTOR_TMP_REGISTER), 0); break;
+      default: break;
+    }
+    return BX_VECTOR_TMP_REGISTER;
+  }
+  void emitVop(int op) {   // two v128 on the stack -> result
+    switch (op) {
+      case VOP_XOR: em->simd(V128_XOR); break;
+      case VOP_OR: em->simd(V128_OR); break;
+      case VOP_AND: em->simd(V128_AND); break;
+      case VOP_ANDN: em->simd(V128_ANDNOT); break;   // pushed as (op2, op1): op2 & ~op1 = xmm_andnps
+      default: em->simd(I8X16_EQ); break;
+    }
+  }
+  bool emitTemplateSimd(unsigned k, bxInstruction_c *i, bool last) {
+    (void) last;
+    SimdDesc d = simdClassifyAll(k);
+    if (d.kind == SK_NONE) return false;
+    unsigned dst = i->dst(), src1 = i->src1(), seg = i->seg(), vl = i->getVL();
+    switch (d.kind) {
+    case SK_VZEROUPPER:
+      // long64_mode(): all 16 upper lanes (templates only compile 64-bit traces)
+      em->v128_zero(); em->set(vloc(1));
+      for (unsigned r = 0; r < 16; r++) { em->i32c(0); em->get(V[1]); em->v128_store(xmmAddr(r, 1), 4); }
+      return true;
+    case SK_AVX2OP: {
+      unsigned s2 = emitSimdLoadPrefix(k, d, vl, i->src2());
+      for (unsigned n = 0; n < 2; n++) {
+        em->i32c(0);
+        if (n < vl) {
+          if (d.op == VOP_ANDN) { pushXmm(s2, n); pushXmm(src1, n); } else { pushXmm(src1, n); pushXmm(s2, n); }
+          emitVop(d.op);
+        } else em->v128_zero();
+        em->v128_store(xmmAddr(dst, n), 4);
+      }
+      return true;
+    }
+    case SK_VPSHUFB: {
+      unsigned s2 = emitSimdLoadPrefix(k, d, vl, i->src2());
+      static const uint8_t m8f[16] = { 0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f };
+      for (unsigned n = 0; n < 2; n++) {
+        em->i32c(0);
+        if (n < vl) { pushXmm(src1, n); pushXmm(s2, n); em->v128_const(m8f); em->simd(V128_AND); em->simd(I8X16_SWIZZLE); }
+        else em->v128_zero();
+        em->v128_store(xmmAddr(dst, n), 4);
+      }
+      return true;
+    }
+    case SK_VPMOVMSKB: case SK_PMOVMSKB: {
+      unsigned src = i->src();
+      pushXmm(src, 0); em->simd(I8X16_BITMASK);
