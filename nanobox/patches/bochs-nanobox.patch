+  uint32_t L_i, L_base, L_ic0, L_upl, L_acm, L_pob, L_cpu;
+  uint32_t L_stkb;   // NANOBOX_STACKTAG bit 2: base pointer to the CPU's stack-window fields
+  bool tier0;                              // compact call form (nanobox_jit_tier)
+  uint32_t L_reg[16];
+  uint32_t L_lfr, L_lfa;
+  CacheState cs;
+  uint32_t T[8];    // i64 temps for templates
+  uint32_t X[4];    // i64 scratch for flag computations
+  uint32_t W;       // i64 scratch for write-stamp pAddr
+  uint32_t K_stk;   // NANOBOX_STACKTAG: page offset of the stack access being emitted
+  uint32_t T32[6];  // i32 temps
+  uint32_t V[2];    // v128 temps (SIMD templates), declared on first use so modules without SIMD templates stay SIMD-free
