+      if (nanobox_jit_probe2) {
+        em->get(C_host); em->set(D_host); em->get(C_ppf); em->set(D_ppf); em->get(C_free); em->set(D_free);
+        if (fold) { em->get(C_tagR); em->set(D_tagR); em->get(C_tagW); em->set(D_tagW); }
+        else { em->get(C_lpf); em->set(D_lpf); em->get(C_bits); em->set(D_bits); }
+      }
+      em->get(T32[0]); em->mem(I32_LOAD, TLB_OFF(hostPageAddr), 2); em->set(C_host);
+      em->get(T32[0]); em->mem(I64_LOAD, TLB_OFF(ppf), 3); em->set(C_ppf);
+      em->get(C_ppf); em->op(I32_WRAP_I64); em->i32c(LPF_MASK_LO); em->op(I32_AND); em->i32c(10); em->op(I32_SHR_U);
+      em->i32c((uint32_t)(uintptr_t) pageWriteStampTable.nanobox_fgm()); em->op(I32_ADD); em->mem(I32_LOAD, 0, 2); em->op(I32_EQZ); em->set(C_free);
+      if (!fold) {
+        em->get(la); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_AND); em->set(C_lpf);
+        em->get(T32[0]); em->mem(I32_LOAD, TLB_OFF(accessBits), 2); em->set(C_bits);
+      } else {
+        // tag = (alignment check pending) ? -1 : la & LPF_MASK, then poisoned per direction by the
+        // TLB permission bits (and, for writes, by the page carrying iCache write stamps)
+        em->get(la); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_AND);
+        em->i64c(-1); acmGet(); em->op(I64_EQZ); em->op(SELECT); em->set(W);
+        em->get(T32[0]); em->mem(I32_LOAD, TLB_OFF(accessBits), 2); em->get(L_upl); em->op(I32_SHR_U); em->set(P_bits);
+        em->get(W); em->i64c(-1); em->get(P_bits); em->i32c(1); em->op(I32_AND); em->op(SELECT); em->set(C_tagR);
+        em->get(W); em->i64c(-1); em->get(C_free); em->op(SELECT);
+        em->i64c(-1); em->get(P_bits); em->i32c(4); em->op(I32_AND); em->op(SELECT); em->set(C_tagW);
+        if (size > 1) { em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->set(P_off); }
+        if (stampSize) emitWriteStamp(la, stampSize);   // hit path skipped it: C_tagW is poisoned for stamped pages
+      }
+    endb();
+  }
+  void swapProbeEntries() {
+    // C <-> D through the wasm stack (values pushed, then popped in reverse into the other set)
+    if (nanobox_tlbfold) {
+      em->get(C_tagR); em->get(D_tagR); em->set(C_tagR); em->set(D_tagR);
+      em->get(C_tagW); em->get(D_tagW); em->set(C_tagW); em->set(D_tagW);
+    } else {
+      em->get(C_lpf); em->get(D_lpf); em->set(C_lpf); em->set(D_lpf);
+      em->get(C_bits); em->get(D_bits); em->set(C_bits); em->set(D_bits);
+    }
+    em->get(C_host); em->get(D_host); em->set(C_host); em->set(D_host);
+    em->get(C_ppf); em->get(D_ppf); em->set(C_ppf); em->set(D_ppf);
+    em->get(C_free); em->get(D_free); em->set(C_free); em->set(D_free);
+  }
+  // Note: tlbProbe's two blocks are structured so that a full-probe failure branches to
+  // `slowDepth` as seen from the *caller* (hence +1 inside the extra block).
+  void tlbProbeFull(uint32_t la, unsigned size, unsigned bit, uint32_t slowDepth) {
+    // entry = &DTLB.entry[((lo32(la) + size-1) & tlb_mask) >> 12]
+    em->get(la); em->op(I32_WRAP_I64);
+    if (size > 1) { em->i32c(size - 1); em->op(I32_ADD); }
+    em->i32c((BX_DTLB_SIZE - 1) << 12); em->op(I32_AND);
+    unsigned esz = sizeof(bx_TLB_entry);
+    if ((esz & (esz - 1)) == 0) {
+      unsigned sh = 0; while ((1u << sh) < esz) sh++;
+      if (sh < 12) { em->i32c(12 - sh); em->op(I32_SHR_U); } else if (sh > 12) { em->i32c(sh - 12); em->op(I32_SHL); }
+    } else {
+      em->i32c(12); em->op(I32_SHR_U); em->i32c(esz); em->op(I32_MUL);
+    }
+    em->i32c(ADDR(BX_CPU_THIS_PTR DTLB.entry[0])); em->op(I32_ADD);
+    em->set(T32[0]);
+    // tag: entry->lpf == (la & (LPF_MASK | (acmask & (size-1))))
+    em->get(T32[0]); em->mem(I64_LOAD, TLB_OFF(lpf), 3);
+    em->get(la);
+    if (size > 1) { acmGet(); em->i64c(size - 1); em->op(I64_AND); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_OR); }
+    else em->i64c((Bit64s)(Bit64u) LPF_MASK);
+    em->op(I64_AND);
+    em->op(I64_NE); em->br_if(slowDepth);
+    // access bits: entry->accessBits & (bit << user_pl)
+    em->get(T32[0]); em->mem(I32_LOAD, TLB_OFF(accessBits), 2);
+    em->i32c(bit); em->get(L_upl); em->op(I32_SHL); em->op(I32_AND);
+    em->op(I32_EQZ); em->br_if(slowDepth);
+  }
+  // host address = entry->hostPageAddr + (la & 0xfff)  -> i32 on stack
+  void pushHostAddr(uint32_t la, bool haveOff = false) {
+    em->get(C_host);
+    if (haveOff) { em->get(P_off); em->op(I32_ADD); return; }
+    em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->op(I32_ADD);
+  }
+  // pageWriteStampTable.decWriteStamp(entry->ppf | pageOffset, size) with the cheap test inlined
+  void emitWriteStamp(uint32_t la, unsigned size) {
+    // page known to carry no iCache stamps (checked when it was probed; stamps are only added by
+    // serveICacheMiss, which cannot run during this trace) -> nothing to do
+    em->get(C_free); em->op(I32_EQZ);
+    iff();
+      em->get(C_ppf); em->get(la); em->i64c(0xfff); em->op(I64_AND); em->op(I64_OR); em->set(W); // pAddr
+      // fineGranularityMapping[pAddr >> 12] != 0 ?
+      em->get(W); em->op(I32_WRAP_I64); em->i32c(LPF_MASK_LO); em->op(I32_AND); em->i32c(10); em->op(I32_SHR_U);
