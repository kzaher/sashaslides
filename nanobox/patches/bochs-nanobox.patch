+    if (h == &BX_CPU_C::MOVD_VdqEdR) { d.kind = SK_MOVD_R; return d; }
+    if (h == &BX_CPU_C::MOVSS_VssWssM) { d.kind = SK_MOVD_LD; return d; }
+    if (h == &BX_CPU_C::MOVD_EdVdR) { d.kind = SK_MOVD_ST; d.op = 0; return d; }
+    if (h == &BX_CPU_C::MOVSS_WssVssM) { d.kind = SK_MOVD_ST; d.op = 1; return d; }
+    if (h == &BX_CPU_C::MOVQ_EqVqR) { d.kind = SK_MOVQ_EqVq; return d; }
