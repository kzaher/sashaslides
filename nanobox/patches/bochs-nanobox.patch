+      em->op(I64_EXTEND_I32_U); regSetFromStack(dst);   // BX_WRITE_32BIT_REGZ
+      return true;
+    }
+    case SK_SSE2OP: {
+      unsigned s2 = emitSimdLoadPrefix(k, d, vl, i->src());
+      em->i32c(0);
+      if (d.op == VOP_ANDN) { pushXmm(s2, 0); pushXmm(dst, 0); } else { pushXmm(dst, 0); pushXmm(s2, 0); }
+      emitVop(d.op);
+      em->v128_store(xmmAddr(dst, 0), 4);
+      return true;
+    }
+    case SK_PSHUFB: {
+      unsigned s2 = emitSimdLoadPrefix(k, d, vl, i->src());
+      static const uint8_t m8f[16] = { 0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f,0x8f };
+      em->i32c(0); pushXmm(dst, 0); pushXmm(s2, 0); em->v128_const(m8f); em->simd(V128_AND); em->simd(I8X16_SWIZZLE);
+      em->v128_store(xmmAddr(dst, 0), 4);
+      return true;
+    }
+    case SK_PCMPISTRI: {
+      unsigned s2 = emitSimdLoadPrefix(k, d, vl, i->src());
+      em->i32c(xmmAddr(dst)); em->i32c(xmmAddr(s2)); em->i32c(i->Ib());
+      em->call(fn(FNIDX(&nanobox_helper_pcmpistri), "iii>i")); em->set(T32[3]);
+      em->get(T32[3]); em->i32c(31); em->op(I32_AND); em->op(I64_EXTEND_I32_U); regSetFromStack(R_RCX);   // RCX = index
