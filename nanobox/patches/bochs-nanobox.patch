+  // unsigned high 64 bits of a*b -> local out (uses X[] scratch)
+  void emitMulhu(uint32_t a, uint32_t b, uint32_t out) {
+    uint32_t a0 = X[0], a1 = X[1], b0 = X[2], b1 = X[3];
+    em->get(a); em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); em->set(a0);
+    em->get(a); em->i64c(32); em->op(I64_SHR_U); em->set(a1);
+    em->get(b); em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); em->set(b0);
+    em->get(b); em->i64c(32); em->op(I64_SHR_U); em->set(b1);
+    // t = a0*b0; u = a1*b0 + (t>>32); v = a0*b1 + (u & 0xffffffff); hi = a1*b1 + (u>>32) + (v>>32)
+    em->get(a0); em->get(b0); em->op(I64_MUL); em->i64c(32); em->op(I64_SHR_U);
+    em->get(a1); em->get(b0); em->op(I64_MUL); em->op(I64_ADD); em->set(out); // u
+    em->get(a0); em->get(b1); em->op(I64_MUL); em->get(out); em->op(I32_WRAP_I64); em->op(I64_EXTEND_I32_U); em->op(I64_ADD); em->set(a0); // v
+    em->get(a1); em->get(b1); em->op(I64_MUL); em->get(out); em->i64c(32); em->op(I64_SHR_U); em->op(I64_ADD);
+    em->get(a0); em->i64c(32); em->op(I64_SHR_U); em->op(I64_ADD); em->set(out);
+  }
