@@ -474,4 +474,38 @@ void BX_CPP_AttrRegparmN(1) BX_CPU_C::PCMPISTRI_VdqWdqIbR(bxInstruction_c *i)
   BX_NEXT_INSTR(i);
 }
 
+
+// nanobox: PCMPISTRI's data path as a plain function for the trace JIT (the JIT applies RCX and
+// the flags itself). Same compare_strings/find_eos/aggregate as PCMPISTRI_VdqWdqIbR above.
+// Result: bits 0..4 = index for ECX, bit 8 = CF, bit 9 = ZF, bit 10 = SF, bit 11 = OF.
+Bit32u bx_nanobox_pcmpistri(const BxPackedXmmRegister *op1p, const BxPackedXmmRegister *op2p, Bit8u imm8)
+{
+  const BxPackedXmmRegister &op1 = *op1p, &op2 = *op2p;
+  Bit8u BoolRes[16][16];
+  compare_strings(BoolRes, op1, op2, imm8);
+  unsigned num_elements = (imm8 & 0x1) ? 8 : 16;
+  int index;
+
+  unsigned len1 = find_eos(op1, imm8);
+  unsigned len2 = find_eos(op2, imm8);
+  Bit16u result2 = aggregate(BoolRes, len1, len2, imm8);
+
+  if (imm8 & 0x40) {
+     for (index=num_elements-1; index>=0; index--)
+       if (result2 & (1<<index)) break;
+     if (index < 0) index = num_elements;
+  }
+  else {
+     for (index=0; index<(int)num_elements; index++)
+       if (result2 & (1<<index)) break;
+  }
+
+  Bit32u r = (Bit32u) index;
+  if (result2 != 0) r |= (1 << 8);
+  if (len2 < num_elements) r |= (1 << 9);
+  if (len1 < num_elements) r |= (1 << 10);
+  if (result2 & 0x1) r |= (1 << 11);
+  return r;
+}
+
