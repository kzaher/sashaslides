+  bool usedStk, usedStkTotal;   // NANOBOX_STACKTAG: does this unit have a stack site at all?
+  bool trimPrologue() const { return (nanobox_jit_outline & 512) != 0 && passNo == 2; }
+  bool needAcm() const { return !trimPrologue() || usedAcmTotal; }
+  bool needUpl() const { return !trimPrologue() || usedUplTotal; }
+  bool needSecondPair() const { return !trimPrologue() || usedInlineProbeTotal; }
+  uint32_t curHost;      // local holding the host page address left by the probe just emitted
+  // A private tag pays only where the site RUNS AGAIN before anything invalidates it: a site whose
+  // every re-execution crosses a handler step or a returning direct call sees the poison every time
+  // and buys one more failed compare per access. (Measured: giving every site a tag cost +15 % on
+  // the AOT call+ret benchmark -- its two stack accesses are exactly that shape.) So pass 1 records
+  // which block each site is in and which blocks invalidate, and eligibility is "the block lies on
+  // a cycle of the region's CFG none of whose blocks invalidates".
