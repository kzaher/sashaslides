+      if (kind == 0) {
+        em->get(op1); em->get(cnt); em->op(I64_SHL); em->i64c((1LL << bits) - 1); em->op(I64_AND); em->set(res);
+        em->get(op1); em->i64c(bits); em->get(cnt); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
