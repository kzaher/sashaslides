+// deferred lazy flags: PF_NONE = the Bochs state is in L_lfr/L_lfa and/or memory (lfLoaded/lfDirty
+// as usual); otherwise the TRUE flag state is {pfOp, pfSize, P_op1, P_op2, P_res(if pfRes)} and
+// neither the locals nor memory hold it (materialised on demand); pfRuntime = entered from an edge
+// that may carry such a state at run time: L_pfk holds its kind (0 = none), P_* its operands.
+enum { PF_NONE = 0, PF_ADD = 1, PF_SUB = 2, PF_LOGIC = 3 };
+struct CacheState {
+  bool regLoaded[16], regDirty[16];
+  bool lfLoaded, lfDirty, acmLoaded;
