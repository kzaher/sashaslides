+// ---- ADDRESS census (work/j/addropts, level 3 + NANOBOX_ADDRCENSUS=1) --------------------------
+// Every compiled data access already knows its linear address before it knows anything else --
+// dtlbLookup indexes the guest's own DTLB by it, the stack window biases it -- so a call in front
+// of those two sites sees EVERY access a compiled site makes, classified by where in the guest's
+// address space it lands. The question this answers: what share of the accesses lives in ONE
+// contiguous kernel window whose mapping is affine, because there "host = base + (la - lo)" is a
+// range check and an add and the 56 bytes of table probe are dead.
+// Nothing is emitted unless BOTH level >= 3 and the census is switched on, so the shipped engine is
+// byte-identical.
+unsigned nanobox_jit_addrcensus = 0;
+
+// ---- direct-map window (work/j/addropts, NANOBOX_DMAP, default 0) ------------------------------
+// bit 0 = identity host-block placement (memory/misc_mem.cc), bit 1 = the JIT emits the window arm.
+// Linux maps ALL of physical memory contiguously at PAGE_OFFSET, so inside that window a linear
+// address is `PAGE_OFFSET + phys` and, once the host arena is identity-placed, the host address is
+// `vector + phys` -- a range check and an add, with no DTLB entry, no lpf compare and no permission
+// test (the census measured 0 direct-map accesses at CPL 3, so the permission bits are uniform).
+// PAGE_OFFSET is a constant of the guest's layout (it boots nokaslr norandmaps) and was MEASURED,
+// not assumed: the address census' PGD histogram puts every kernel data access outside vmalloc /
+// vmemmap / kernel text in PGD 273 = 0xffff888000000000 and nowhere else in [273, 400].
+// It is 4 GB aligned, which is what lets the window test compare the top 32 bits of the address
+// and read the guest-physical address straight out of the low 32.
+#define NB_DMAP_BASE 0xffff888000000000ULL
+#define NB_DMAP_LOW  0x00100000u   // the window starts above the legacy 1 MB hole
+extern unsigned nanobox_mem_identity;
+unsigned nanobox_jit_dmap = 0;
+Bit64u nanobox_dmap_hits = 0, nanobox_dmap_miss = 0;
+NB_EXPORT(nanobox_jit_dmap_stat) double nanobox_jit_dmap_stat(unsigned i)
+{ return i == 0 ? (double) nanobox_dmap_hits : i == 1 ? (double) nanobox_dmap_miss : 0; }
+Bit64u nanobox_ac_unit_seq = 0;     // bumped inline by every compiled unit's prologue
+
+// Classes are STRUCTURAL (a PGD index range), not a guess at one base: the pgd histograms below
+// report the raw distribution so the boundaries can be checked against the run that used them.
+// The x86_64 4-level layout with nokaslr: direct map at PGD 273 (0xffff888000000000, 64 TB),
+// vmalloc at 402 (0xffffc90000000000, 32 TB), vmemmap at 468 (0xffffea0000000000, 1 TB), kernel
+// text/modules/fixmap in the top 2 GB of PGD 511.
+enum { AC_USER = 0, AC_DIRECT, AC_VMALLOC, AC_VMEMMAP, AC_KTEXT, AC_KMODULE, AC_KFIX, AC_KOTHER, AC_NONCANON, AC_CLASSES };
+enum { AC_RD = 0, AC_WR, AC_STK, AC_KINDS };
+
+static Bit64u nanobox_ac_cls[AC_CLASSES][AC_KINDS];
+static Bit64u nanobox_ac_pg4[AC_CLASSES];     // distinct 4 KB pages
+static Bit64u nanobox_ac_pg2m[AC_CLASSES];    // distinct 2 MB regions
+static Bit64u nanobox_ac_lo[AC_CLASSES], nanobox_ac_hi[AC_CLASSES];
+static Bit64u nanobox_ac_pgd_k[512], nanobox_ac_pgd_u[512];
+static Bit64u nanobox_ac_top[512];            // 4 MB buckets over 0xffffffff80000000 + 2 GB
+static Bit64u nanobox_ac_misc[16];
+enum { ACM_TOTAL = 0, ACM_FIRST, ACM_SAMEPREV, ACM_REVISIT, ACM_NEWPAGE, ACM_PEAK2M, ACM_CR3N,
+       ACM_CR3OVF, ACM_H4FILL, ACM_H2FILL, ACM_H4FULL, ACM_UNITS, ACM_WINDOWS,
+       // the same four locality buckets over the accesses that actually pay the table probe
+       // (kind != AC_STK), which is the population a hoisted entry pointer could serve
+       ACM_PFIRST, ACM_PSAMEPREV, ACM_PREVISIT, ACM_PNEWPAGE,
+       ACM_ROOTN, ACM_ROOTOVF, ACM_KERN_CPL3, ACM_DIRECT_CPL3, ACM_N };
+
+// Distinct-page sets: open addressing, key = page number + 1 (0 = empty). Sized for the boot's
+// working set (a codex boot touches O(100k) 4 KB pages), so the load factor stays under 1/8.
+#define AC_H4_BITS 20
+#define AC_H2_BITS 14
+#define AC_W2_BITS 12
+static Bit64u nanobox_ac_h4[1u << AC_H4_BITS];
+static Bit64u nanobox_ac_h2[1u << AC_H2_BITS];
+// peak live 2 MB regions: a generation-stamped set, re-generated every AC_WINDOW accesses
+#define AC_WINDOW (1u << 20)
+static Bit64u nanobox_ac_w2[1u << AC_W2_BITS];
+static Bit32u nanobox_ac_w2gen[1u << AC_W2_BITS];
+static Bit32u nanobox_ac_gen = 1;
+static Bit32u nanobox_ac_wlive = 0;
+
+// CR3 census: open-addressed so the count is real rather than capped. Linux with PCID puts the
+// PCID in the low 12 bits, so the full CR3 and the page-table ROOT (CR3>>12) are counted separately.
+#define AC_CR3_N 4096
+static Bit64u nanobox_ac_cr3[AC_CR3_N], nanobox_ac_cr3_n[AC_CR3_N];
+static Bit64u nanobox_ac_root[AC_CR3_N], nanobox_ac_root_n[AC_CR3_N];
+
+// locality within one compiled-unit invocation (nanobox_ac_unit_seq changes at every entry)
+static Bit64u nanobox_ac_seq_seen = 0, nanobox_ac_prev_page = 0;
+static Bit64u nanobox_ac_last4 = ~(Bit64u)0, nanobox_ac_last2 = ~(Bit64u)0;   // last key each set saw
+static unsigned nanobox_ac_cr3_last = 0;
+static Bit64u nanobox_ac_probe_pages[16], nanobox_ac_prev_probe = 0;
+static unsigned nanobox_ac_pnp = 0;
+static Bit64u nanobox_ac_unit_pages[16];
+static unsigned nanobox_ac_unit_np = 0;
+
+static unsigned nanobox_ac_classify(Bit64u la)
+{
+  if (la < 0x0000800000000000ULL) return AC_USER;
+  if (la < 0xffff800000000000ULL) return AC_NONCANON;
+  unsigned pgd = (unsigned)((la >> 39) & 0x1ff);
+  if (pgd >= 273 && pgd <= 400) return AC_DIRECT;
+  if (pgd >= 402 && pgd <= 465) return AC_VMALLOC;
+  if (pgd >= 468 && pgd <= 469) return AC_VMEMMAP;
+  if (la >= 0xffffffff80000000ULL) {
+    if (la >= 0xfffffffffe000000ULL) return AC_KFIX;        // fixmap / cpu_entry_area / vsyscall
+    if (la >= 0xffffffffa0000000ULL) return AC_KMODULE;
+    return AC_KTEXT;
+  }
+  return AC_KOTHER;
+}
+static Bit64u nanobox_ac_mix(Bit64u k) { k *= 0x9e3779b97f4a7c15ULL; return k ^ (k >> 29); }
+// Bump `key`'s slot in an open-addressed (keys, counts) pair; a key is stored as key+1 so 0 is empty.
+static unsigned nanobox_ac_bump(Bit64u *keys, Bit64u *counts, Bit64u key, Bit64u *distinct, Bit64u *overflow)
+{
+  Bit64u k = key + 1, i = nanobox_ac_mix(k) & (AC_CR3_N - 1);
+  for (unsigned probe = 0; probe < 64; probe++, i = (i + 1) & (AC_CR3_N - 1)) {
+    if (keys[i] == k) { counts[i]++; return (unsigned) i; }
+    if (keys[i] == 0) { keys[i] = k; counts[i] = 1; (*distinct)++; return (unsigned) i; }
+  }
+  (*overflow)++; return 0;
+}
+
+extern "C" {
+// One call in front of the address resolution of every compiled data access. `kind` is AC_RD /
+// AC_WR / AC_STK; `la` is the linear address the site is about to resolve.
+static void nanobox_helper_addr_census(Bit64u la, unsigned kind)
+{
+  unsigned cls = nanobox_ac_classify(la);
+  nanobox_ac_misc[ACM_TOTAL]++;
+  nanobox_ac_cls[cls][kind < AC_KINDS ? kind : AC_RD]++;
+  if (!nanobox_ac_lo[cls] || la < nanobox_ac_lo[cls]) nanobox_ac_lo[cls] = la;
+  if (la > nanobox_ac_hi[cls]) nanobox_ac_hi[cls] = la;
+  if (cls == AC_USER) nanobox_ac_pgd_u[(la >> 39) & 0x1ff]++;
+  else if (cls != AC_NONCANON) nanobox_ac_pgd_k[(la >> 39) & 0x1ff]++;
+  if (la >= 0xffffffff80000000ULL) nanobox_ac_top[(unsigned)((la - 0xffffffff80000000ULL) >> 22) & 0x1ff]++;
+
+  // The three sets below are the expensive part, so each is guarded by a one-word cache of the last
+  // key: consecutive accesses overwhelmingly repeat their page, and a repeat can add nothing.
+  Bit64u page = la >> 12;
+  if (page != nanobox_ac_last4) {
+    nanobox_ac_last4 = page;
+    Bit64u key = page + 1, i = nanobox_ac_mix(key) & ((1u << AC_H4_BITS) - 1);
+    for (unsigned probe = 0; probe < 64; probe++, i = (i + 1) & ((1u << AC_H4_BITS) - 1)) {
+      if (nanobox_ac_h4[i] == key) break;
+      if (nanobox_ac_h4[i] == 0) { nanobox_ac_h4[i] = key; nanobox_ac_pg4[cls]++; nanobox_ac_misc[ACM_H4FILL]++; break; }
+      if (probe == 63) nanobox_ac_misc[ACM_H4FULL]++;
+    }
+    Bit64u reg2m = la >> 21;
+    if (reg2m != nanobox_ac_last2) {
+      nanobox_ac_last2 = reg2m;
+      Bit64u k2 = reg2m + 1, i2 = nanobox_ac_mix(k2) & ((1u << AC_H2_BITS) - 1);
+      for (unsigned probe = 0; probe < 64; probe++, i2 = (i2 + 1) & ((1u << AC_H2_BITS) - 1)) {
+        if (nanobox_ac_h2[i2] == k2) break;
+        if (nanobox_ac_h2[i2] == 0) { nanobox_ac_h2[i2] = k2; nanobox_ac_pg2m[cls]++; nanobox_ac_misc[ACM_H2FILL]++; break; }
+      }
+      // peak distinct 2 MB regions live inside one window of AC_WINDOW accesses
+      Bit64u i3 = nanobox_ac_mix(k2) & ((1u << AC_W2_BITS) - 1);
+      for (unsigned probe = 0; probe < 32; probe++, i3 = (i3 + 1) & ((1u << AC_W2_BITS) - 1)) {
+        if (nanobox_ac_w2gen[i3] == nanobox_ac_gen && nanobox_ac_w2[i3] == k2) break;
+        if (nanobox_ac_w2gen[i3] != nanobox_ac_gen) { nanobox_ac_w2gen[i3] = nanobox_ac_gen; nanobox_ac_w2[i3] = k2; nanobox_ac_wlive++; break; }
+      }
+    }
+  }
+  if ((nanobox_ac_misc[ACM_TOTAL] & (AC_WINDOW - 1)) == 0) {
+    if (nanobox_ac_wlive > nanobox_ac_misc[ACM_PEAK2M]) nanobox_ac_misc[ACM_PEAK2M] = nanobox_ac_wlive;
+    nanobox_ac_wlive = 0; nanobox_ac_gen++; nanobox_ac_last2 = ~(Bit64u)0; nanobox_ac_misc[ACM_WINDOWS]++;
+  }
+
+  // A kernel address reached at CPL 3 would mean a window fast path cannot skip the permission
+  // test. (user_pl is 1 at CPL 3, which is exactly what the emitted accessBits test shifts by.)
+  if (cls != AC_USER && BX_CPU_THIS_PTR user_pl) {
+    nanobox_ac_misc[ACM_KERN_CPL3]++;
+    if (cls == AC_DIRECT) nanobox_ac_misc[ACM_DIRECT_CPL3]++;
+  }
+
+  // same-page locality inside one compiled-unit invocation. Counted twice: over every access, and
+  // over the table-probed accesses alone -- the stack window resolves its own address, so only the
+  // second population could reuse a hoisted DTLB entry pointer.
+  unsigned probed = (kind != AC_STK);
+  if (nanobox_ac_unit_seq != nanobox_ac_seq_seen) {
+    nanobox_ac_seq_seen = nanobox_ac_unit_seq; nanobox_ac_unit_np = 0; nanobox_ac_pnp = 0;
+    nanobox_ac_misc[ACM_FIRST]++;
+    nanobox_ac_unit_pages[nanobox_ac_unit_np++] = page;
+    if (probed) { nanobox_ac_misc[ACM_PFIRST]++; nanobox_ac_probe_pages[nanobox_ac_pnp++] = page; nanobox_ac_prev_probe = page; }
+  } else {
+    if (page == nanobox_ac_prev_page) nanobox_ac_misc[ACM_SAMEPREV]++;
+    else {
+      unsigned seen = 0;
+      for (unsigned j = 0; j < nanobox_ac_unit_np; j++) if (nanobox_ac_unit_pages[j] == page) { seen = 1; break; }
+      nanobox_ac_misc[seen ? ACM_REVISIT : ACM_NEWPAGE]++;
+      if (!seen && nanobox_ac_unit_np < 16) nanobox_ac_unit_pages[nanobox_ac_unit_np++] = page;
+    }
+    if (probed) {
+      if (!nanobox_ac_pnp) { nanobox_ac_misc[ACM_PFIRST]++; nanobox_ac_probe_pages[nanobox_ac_pnp++] = page; }
+      else if (page == nanobox_ac_prev_probe) nanobox_ac_misc[ACM_PSAMEPREV]++;
+      else {
+        unsigned seen = 0;
+        for (unsigned j = 0; j < nanobox_ac_pnp; j++) if (nanobox_ac_probe_pages[j] == page) { seen = 1; break; }
+        nanobox_ac_misc[seen ? ACM_PREVISIT : ACM_PNEWPAGE]++;
+        if (!seen && nanobox_ac_pnp < 16) nanobox_ac_probe_pages[nanobox_ac_pnp++] = page;
+      }
+      nanobox_ac_prev_probe = page;
+    }
+  }
+  nanobox_ac_prev_page = page;
+
+  { Bit64u cr3 = BX_CPU_THIS_PTR cr3;
+    if (nanobox_ac_cr3[nanobox_ac_cr3_last] == cr3 && nanobox_ac_cr3_n[nanobox_ac_cr3_last]) nanobox_ac_cr3_n[nanobox_ac_cr3_last]++;
+    else {
+      nanobox_ac_cr3_last = nanobox_ac_bump(nanobox_ac_cr3, nanobox_ac_cr3_n, cr3, &nanobox_ac_misc[ACM_CR3N], &nanobox_ac_misc[ACM_CR3OVF]);
+      nanobox_ac_bump(nanobox_ac_root, nanobox_ac_root_n, cr3 >> 12, &nanobox_ac_misc[ACM_ROOTN], &nanobox_ac_misc[ACM_ROOTOVF]);
+    } }
+}
+}
