+NB_EXPORT(nanobox_set_addrcensus) void nanobox_set_addrcensus(unsigned on) { nanobox_jit_addrcensus = on; }
+// NANOBOX_DMAP. Bit 0 must be set BEFORE the guest boots (it decides where each block lands the
+// first time it is touched); bit 1 is refused if any block is already placed compactly, because the
+// window's `vector + phys` would then name a different block than the one the guest wrote.
+NB_EXPORT(nanobox_set_jit_dmap) unsigned nanobox_set_jit_dmap(unsigned mask)
+{
+  Bit32u bs = BX_MEM(0)->nanobox_block_size();
+  Bit8u *vec = BX_MEM(0)->nanobox_vector();
+  Bit64u nblocks = bs ? BX_MEM(0)->nanobox_ram_len() / bs : 0;
+  // Refuse outright if ANY block is already placed compactly. Mixing the two placements is not a
+  // slow path, it is corruption: the compact allocator hands out `vector + used_blocks*block_size`
+  // while the identity one takes `vector + block*block_size`, and the two collide. That is exactly
+  // what happens on a Wizer-snapshotted engine, whose blocks were allocated before this call.
+  for (Bit64u i = 0; i < nblocks; i++) {
+    Bit8u *b = BX_MEM(0)->nanobox_block_ptr((Bit32u) i);
+    if (!b || b == vec + i * bs) continue;
+    nanobox_mem_identity = 0; nanobox_jit_dmap = 0;
+    return 0;
+  }
+  nanobox_mem_identity = (mask & 1) ? 1 : 0;
+  nanobox_jit_dmap = (mask & 1) ? mask : (mask & ~2u);
+  return nanobox_jit_dmap;
+}
+// sel: 0..2 accesses per class by kind (rd/wr/stk), 3 distinct 4 KB pages, 4 distinct 2 MB regions,
+// 5..8 the observed low/high address per class as (lo32, hi32) pairs, 9 kernel PGD histogram,
+// 10 user PGD histogram, 11 the 4 MB histogram of the top 2 GB, 12 the ACM_* scalars,
+// 13..15 the CR3 table (value lo32, value hi32, access count).
+NB_EXPORT(nanobox_jit_addrstat) double nanobox_jit_addrstat(unsigned sel, unsigned i)
+{
+  switch (sel) {
+    case 0: case 1: case 2: return i < AC_CLASSES ? (double) nanobox_ac_cls[i][sel] : 0;
+    case 3: return i < AC_CLASSES ? (double) nanobox_ac_pg4[i] : 0;
+    case 4: return i < AC_CLASSES ? (double) nanobox_ac_pg2m[i] : 0;
+    case 5: return i < AC_CLASSES ? (double) (Bit32u) nanobox_ac_lo[i] : 0;
+    case 6: return i < AC_CLASSES ? (double) (Bit32u) (nanobox_ac_lo[i] >> 32) : 0;
+    case 7: return i < AC_CLASSES ? (double) (Bit32u) nanobox_ac_hi[i] : 0;
+    case 8: return i < AC_CLASSES ? (double) (Bit32u) (nanobox_ac_hi[i] >> 32) : 0;
+    case 9: return i < 512 ? (double) nanobox_ac_pgd_k[i] : 0;
+    case 10: return i < 512 ? (double) nanobox_ac_pgd_u[i] : 0;
+    case 11: return i < 512 ? (double) nanobox_ac_top[i] : 0;
+    case 12: return i == ACM_UNITS ? (double) nanobox_ac_unit_seq : i < ACM_N ? (double) nanobox_ac_misc[i] : 0;
+    case 13: return i < AC_CR3_N && nanobox_ac_cr3[i] ? (double) (Bit32u) (nanobox_ac_cr3[i] - 1) : 0;
+    case 14: return i < AC_CR3_N && nanobox_ac_cr3[i] ? (double) (Bit32u) ((nanobox_ac_cr3[i] - 1) >> 32) : 0;
+    case 15: return i < AC_CR3_N ? (double) nanobox_ac_cr3_n[i] : 0;
+    default: return 0;
+  }
+}
+NB_EXPORT(nanobox_jit_addrstat_n) unsigned nanobox_jit_addrstat_n(unsigned sel)
+{ return sel <= 8 ? AC_CLASSES : sel <= 11 ? 512 : sel == 12 ? ACM_N : AC_CR3_N; }
