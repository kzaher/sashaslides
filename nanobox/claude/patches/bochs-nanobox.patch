@@ -106,6 +106,17 @@ void bx_slowdown_timer_c::timer_handler(void * this_ptr)
 
 void bx_slowdown_timer_c::handle_timer()
 {
+#ifdef NANOBOX_DETERMINISTIC
+  // nanobox: the guest-visible timer schedule must not depend on host time. Upstream re-arms this
+  // timer with a period that depends on whether the emulator is ahead of or behind wall-clock time
+  // (MAXmultiplier*Q vs Q) and sleeps when ahead; the period changes BX_SYNC_TIME points, hence
+  // trace boundaries, hence the exact instruction at which interrupts are taken -> guest RAM
+  // becomes a function of host speed (and every Wizer pre-boot snapshots a different state).
+  // Deterministic engine: fixed period, never sleep (the guest may run faster than real time).
+  bx_pc_system.deactivate_timer(s.timer_handle);
+  bx_pc_system.activate_timer(s.timer_handle,(Bit32u)s.Q,0);
+  return;
+#endif
   Bit64u total_emu_time = (bx_pc_system.time_usec()) - s.start_emulated_time;
   Bit64u wanttime = s.lasttime+s.Q;
   Bit64u totaltime = sectousec(time(NULL)) - s.start_time;
