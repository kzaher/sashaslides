+      setFlagsOxxxxC(T32[4], T32[3]);
+      return true;
+    }
+
+    // ---- SSE 128-bit moves (memory forms) and reg-reg XORPS/PXOR. Only when the entry was decoded
+    //      with SSE enabled (otherwise the handler is BxNoSSE, which must raise #NM/#UD).
+    case BX_IA_MOVUPS_VpsWps: case BX_IA_MOVUPD_VpdWpd: case BX_IA_MOVDQU_VdqWdq: case BX_IA_MOVAPS_VpsWps: case BX_IA_MOVAPD_VpdWpd: case BX_IA_MOVDQA_VdqWdq: {
+      if (R) { // register copy: MOVAPS_VpsWpsR = BX_WRITE_XMM_REGZ(dst, src, VL=0)
+        if (!realHandler(k, &BX_CPU_C::MOVAPS_VpsWpsR)) return false;
+        uint32_t d = ADDR(BX_CPU_THIS_PTR vmm[dst]), sr = ADDR(BX_CPU_THIS_PTR vmm[src]);
+        for (unsigned q = 0; q < 2; q++) { em->i32c(0); em->i32c(0); em->mem(I64_LOAD, sr + 8 * q, 3); em->mem(I64_STORE, d + 8 * q, 3); }
+        return true;
+      }
+      bool aligned = (ia == BX_IA_MOVAPS_VpsWps || ia == BX_IA_MOVAPD_VpdWpd || ia == BX_IA_MOVDQA_VdqWdq);
+      BxExecutePtr_tR h = (ia == BX_IA_MOVUPS_VpsWps) ? &BX_CPU_C::MOVUPS_VpsWpsM : (ia == BX_IA_MOVUPD_VpdWpd) ? &BX_CPU_C::MOVUPS_VpsWpsM :
+                          (ia == BX_IA_MOVDQU_VdqWdq) ? &BX_CPU_C::MOVUPS_VpsWpsM : &BX_CPU_C::MOVAPS_VpsWpsM;
+      if (!realHandler(k, h)) return false;
+      pushEA(k); em->set(t3);
+      emitReadXmm(k, seg, t3, dst, aligned);
+      return true;
+    }
+    case BX_IA_MOVUPS_WpsVps: case BX_IA_MOVUPD_WpdVpd: case BX_IA_MOVDQU_WdqVdq: case BX_IA_MOVAPS_WpsVps: case BX_IA_MOVAPD_WpdVpd: case BX_IA_MOVDQA_WdqVdq: {
+      if (R) { // store forms with a register operand: MOVAPS_VpsWpsR with dst/src as decoded (dst = the "W" register)
+        if (!realHandler(k, &BX_CPU_C::MOVAPS_VpsWpsR)) return false;
+        uint32_t d = ADDR(BX_CPU_THIS_PTR vmm[dst]), sr = ADDR(BX_CPU_THIS_PTR vmm[src]);
+        for (unsigned q = 0; q < 2; q++) { em->i32c(0); em->i32c(0); em->mem(I64_LOAD, sr + 8 * q, 3); em->mem(I64_STORE, d + 8 * q, 3); }
