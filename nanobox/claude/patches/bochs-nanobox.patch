+/////////////////////////////////////////////////////////////////////////
+// nanobox trace JIT: x86-64 iCache traces -> WebAssembly functions.
+//
+// Design (see nanobox/claude/README.md for the long version):
+//  * the unit of compilation is one Bochs iCache trace (up to 32 instructions, ending exactly
+//    where the interpreter's trace ends), so trace boundaries — and therefore the points at which
+//    Bochs syncs its clock and delivers interrupts — are exactly the interpreter's;
+//  * instructions without an inline template are executed by Bochs' own handler in
+//    "single-step" mode (BX_NEXT_INSTR returns after one instruction), so unsupported opcodes cost
+//    nothing in correctness;
+//  * templates reproduce the handlers' side effects bit for bit (Bochs' lazy-flags representation,
+//    prev_rip/RIP/icount bookkeeping, memory access paths incl. TLB fast path + SMC stamps);
+//  * guest GPRs / lazy flags live in wasm locals inside a trace and are written back ("spilled")
+//    before anything that could observe or modify them: handler calls, slow-path memory helpers
+//    (which may raise a guest exception = longjmp out of the trace) and trace exits;
+//  * the module is built here as raw bytes and instantiated by the host (JS) through a
+//    function-table hook, so no wasm imports are needed at link/wizer time.
+/////////////////////////////////////////////////////////////////////////
+
+#define NEED_CPU_REG_SHORTCUTS 1
+#include "bochs.h"
+#include "cpu/cpu.h"
+#include "cpu/icache.h"
+#include "cpu/decoder/ia_opcodes.h"
+#include "pc_system.h"
+#include "nanobox_jit.h"
+void nanobox_dbg_compiled(bxICacheEntry_c *e, unsigned fn, unsigned len);
+#include "nanobox_wasm.h"
+#include <stddef.h>
+
+// offsetof() on a struct with a constructor trips -Winvalid-offsetof; compute the offsets from a
+// dummy instance instead.
+static bx_TLB_entry nanobox_tlb_layout_probe;
+#define TLB_OFF(field) ((uint32_t)((uintptr_t)&nanobox_tlb_layout_probe.field - (uintptr_t)&nanobox_tlb_layout_probe))
+static bxICacheEntry_c nanobox_ice_layout_probe;
+#define ICE_OFF(field) ((uint32_t)((uintptr_t)&nanobox_ice_layout_probe.field - (uintptr_t)&nanobox_ice_layout_probe))
+static bxInstruction_c nanobox_ins_layout_probe;
+#define INS_ILEN_OFF ((uint32_t)((uintptr_t)&nanobox_ins_layout_probe.metaInfo.ilen - (uintptr_t)&nanobox_ins_layout_probe))
+
+unsigned nanobox_jit_level = 0;
+unsigned nanobox_jit_threshold = 32;
+unsigned nanobox_jit_maxlen = 64;      // debug knob: only compile traces with at most this many instructions
+Bit8u nanobox_single_step = 0;
+Bit8u nanobox_trace_end = 0;
+
+/////////////////////////////////////////////////////////////////////////
+// Host hooks. The C++ side calls through *function pointers* that initially point at the
+// placeholders below; the JS host overwrites those function-table slots with trampolines into
+// JavaScript (nanobox_hook_slot() tells it which slots). No wasm imports involved, so wizer and
+// plain wasmtime runs work unchanged (they just never JIT).
+/////////////////////////////////////////////////////////////////////////
+extern "C" {
+static unsigned nanobox_hook_jit_install_placeholder(const void *, unsigned, const unsigned *, unsigned) { return 0; }
+static void nanobox_hook_jit_release_placeholder(unsigned) {}
+static void nanobox_hook_jit_release_all_placeholder(void) {}
+static unsigned nanobox_hook_jit_lookup_placeholder(unsigned, unsigned) { return 0; }
+static void nanobox_hook_jit_note_placeholder(unsigned, unsigned, unsigned) {}
+static unsigned nanobox_hook_jit_install_batch_placeholder(const void *, unsigned, const unsigned *, unsigned, unsigned, unsigned *) { return 0; }
+}
+typedef unsigned (*hook_install_t)(const void *wasm, unsigned len, const unsigned *importKeys, unsigned nimports);
+typedef void (*hook_release_t)(unsigned fn);
+typedef void (*hook_release_all_t)(void);
+typedef unsigned (*hook_lookup_t)(unsigned keyLo, unsigned keyHi);       // pre-computed translation for this content key? -> table index or 0
+typedef void (*hook_note_t)(unsigned fn, unsigned keyLo, unsigned keyHi); // "fn was compiled from the module with this content key" (lets the host dump bundles)
+static hook_install_t volatile hook_install = nanobox_hook_jit_install_placeholder;
+static hook_release_t volatile hook_release = nanobox_hook_jit_release_placeholder;
+static hook_release_all_t volatile hook_release_all = nanobox_hook_jit_release_all_placeholder;
+static hook_lookup_t volatile hook_lookup = nanobox_hook_jit_lookup_placeholder;
+static hook_note_t volatile hook_note = nanobox_hook_jit_note_placeholder;
+// batch install: module exports f0..f(nfuncs-1); the host writes their table indices to out[]; returns 1 on success
+typedef unsigned (*hook_install_batch_t)(const void *wasm, unsigned len, const unsigned *importKeys, unsigned nimports, unsigned nfuncs, unsigned *out);
+static hook_install_batch_t volatile hook_install_batch = nanobox_hook_jit_install_batch_placeholder;
+
+#define NB_EXPORT(name) extern "C" __attribute__((export_name(#name), used))
+
+// function-table slot of hook k (0 = install, 1 = release, 2 = release_all)
+NB_EXPORT(nanobox_hook_slot) unsigned nanobox_hook_slot(unsigned k)
+{
+  switch (k) {
+    case 0: return (unsigned)(uintptr_t) hook_install;
+    case 1: return (unsigned)(uintptr_t) hook_release;
+    case 2: return (unsigned)(uintptr_t) hook_release_all;
+    case 3: return (unsigned)(uintptr_t) hook_lookup;
+    case 4: return (unsigned)(uintptr_t) hook_note;
+    case 5: return (unsigned)(uintptr_t) hook_install_batch;
+    default: return 0;
+  }
+}
+NB_EXPORT(nanobox_set_jit) void nanobox_set_jit(unsigned level, unsigned threshold)
+{
+  nanobox_jit_level = level;
+  nanobox_jit_threshold = threshold ? threshold : 1;
+}
+NB_EXPORT(nanobox_get_jit) unsigned nanobox_get_jit(void) { return nanobox_jit_level; }
+NB_EXPORT(nanobox_set_jit_maxlen) void nanobox_set_jit_maxlen(unsigned n) { nanobox_jit_maxlen = n; }
+
+// C++ helpers callable from JIT'd code (plain functions -> stable table indices)
+extern "C" {
+static void nanobox_helper_dec_write_stamp(Bit64u pAddr, unsigned len)
+{
+  pageWriteStampTable.decWriteStamp((bx_phy_address) pAddr, len);
+}
+static void nanobox_helper_dbg_loop(unsigned entry)
+{
+  nanobox_dbg_trace((bxICacheEntry_c *) (uintptr_t) entry, true);
+}
+}
+
+// per-opcode template statistics (which opcodes fall back), for the harness
+static Bit32u nanobox_fallback_count[BX_IA_LAST];
+static Bit32u nanobox_inline_count[BX_IA_LAST];
+// dynamic (execution) counts, only maintained when nanobox_jit_level >= 3 (profiling mode)
+static Bit64u nanobox_dyn_inline[BX_IA_LAST];
+static Bit64u nanobox_dyn_fallback[BX_IA_LAST];
+NB_EXPORT(nanobox_jit_opstat) double nanobox_jit_opstat(unsigned ia, unsigned which)
+{
+  if (ia >= BX_IA_LAST) return 0;
+  switch (which) {
+    case 0: return nanobox_fallback_count[ia];
+    case 1: return nanobox_inline_count[ia];
+    case 2: return (double) nanobox_dyn_fallback[ia];
+    default: return (double) nanobox_dyn_inline[ia];
+  }
+}
+NB_EXPORT(nanobox_jit_opname) const char *nanobox_jit_opname(unsigned ia)
+{
+  if (ia >= BX_IA_LAST) return "";
+  return get_bx_opcode_name((Bit16u) ia);
+}
+NB_EXPORT(nanobox_jit_nops) unsigned nanobox_jit_nops(void) { return BX_IA_LAST; }
+
+/////////////////////////////////////////////////////////////////////////
+// Trace compiler
+/////////////////////////////////////////////////////////////////////////
+// friend of bx_pc_system_c: the JIT inlines the fast path of BX_TICKN at trace boundaries
+class nanobox_pc_system_access {
+public:
+  static uint32_t countdownAddr() { return (uint32_t)(uintptr_t)&bx_pc_system.currCountdown; }
+};
+
+static void nanobox_jit_cache_clear(void);
+extern unsigned nanobox_jit_merge;
+static unsigned nanobox_link_fn = 0;   // table index of the shared trace-linking epilogue function (0 = not built)
+bxICacheEntry_c *nanobox_dbg_cur_entry = NULL; // dbg mode: the region block that ran last (cpu_loop only knows the region entry)
+
+namespace {
+
+using namespace nbw;
+
+#define ADDR(x) ((uint32_t)(uintptr_t)&(x))
+#define FNIDX(f) ((uint32_t)(uintptr_t)(f))
+
+const uint32_t LPF_MASK_LO = 0xfffff000u;
+enum { SEG_ES = 0, SEG_CS = 1, SEG_SS = 2, SEG_DS = 3, SEG_FS = 4, SEG_GS = 5 };
+enum { R_RAX = 0, R_RCX = 1, R_RDX = 2, R_RBX = 3, R_RSP = 4, R_RBP = 5, R_RSI = 6, R_RDI = 7 };
+enum { CC_O = 0, CC_NO, CC_B, CC_NB, CC_Z, CC_NZ, CC_BE, CC_NBE, CC_S, CC_NS, CC_P, CC_NP, CC_L, CC_NL, CC_LE, CC_NLE };
+
+// which Bochs accessor the slow path of a memory operation must call
+enum MemKind {
+  MK_RD_LIN,   // read_linear_X(seg, laddr)
+  MK_RD_VIRT,  // read_virtual_X(seg, offset)
+  MK_WR_LIN,   // write_linear_X(seg, laddr, val)
+  MK_WR_VIRT,  // write_virtual_X(seg, offset, val)
+  MK_RMW_LIN,  // read_RMW_linear_X(seg, laddr) ... write_RMW_linear_X(val)
+  MK_RMW_VIRT, // read_RMW_virtual_X(seg, offset) ... write_RMW_linear_X(val)
+};
+
+struct CacheState {
+  bool regLoaded[16], regDirty[16];
+  bool lfLoaded, lfDirty, acmLoaded;
+};
+
+// ---------------------------------------------------------------- regions
+// A region is one hot iCache trace (the entry) plus every trace it can reach through direct
+// control transfers (JMP/Jcc/CALL immediates, fall-through) inside the SAME physical page, all
+// compiled into one wasm function with a dispatch loop. Blocks are copied out of the iCache, so
+// the region does not depend on iCache entry lifetime; it depends only on the code bytes, which
+// Bochs' SMC machinery guards: the entry's traceMask is widened to the union of all block masks so
+// a write to any block flushes the entry (and with it the region's jitfn).
+enum { NB_REGION_MAX_BLOCKS = 24, NB_REGION_MAX_INSTR = 320 };
+struct RegionBlock {
+  bxICacheEntry_c ent;      // copy of the iCache entry (pAddr, traceMask, tlen; i -> ins)
+  bxInstruction_c *ins;     // owned copy of the decoded instructions
+  unsigned n;               // real instructions
+  Bit32s boff;              // offset of the block's first instruction from the region entry (negative for the previous page)
+};
+struct Region {
+  // The compiled function receives the address of this object as its parameter (entry->jitarg)
+  // and reads the per-block instruction pointers from `insptr`, so the module itself contains no
+  // absolute addresses of the copies -> the same module serves any region with the same content
+  // (in-process cache hits and pre-computed bundles).
+  bxInstruction_c *insptr[NB_REGION_MAX_BLOCKS];
+  bxICacheEntry_c *entptr[NB_REGION_MAX_BLOCKS];   // for the divergence finder's fingerprint hook
+  // Every block is an entry point: block j's iCache entry gets jitarg = &entry[j] = {this region,
+  // block index, RIP delta (boff_j + ilen of its first instruction)}; the prologue derives L_base
+  // and the initial dispatch target from it.
+  struct EntryDesc { struct Region *reg; Bit32u block; Bit32u delta; };
+  EntryDesc entry[NB_REGION_MAX_BLOCKS];
+  bxICacheEntry_c *srcEntry[NB_REGION_MAX_BLOCKS];   // the iCache entries the blocks were taken from (validated by pAddr/i before use)
+  bxInstruction_c *srcI[NB_REGION_MAX_BLOCKS];
+  unsigned nblocks;
+  RegionBlock b[NB_REGION_MAX_BLOCKS];
+  Bit32u mask;              // union of the blocks' traceMasks in the entry's page (128-byte chunks)
+  Bit64u key;               // content key (blocks' offsets + instructions)
+  // a region may span the entry's page and ONE adjacent linear page (functions straddling a page
+  // boundary): ppf2 = physical page frame of that page at formation (0 = single page), pageDelta =
+  // +1/-1, mask2 = SMC mask there. Cross-page transitions verify at run time that the linear
+  // neighbour still maps to ppf2 (ITLB) and switch the fetch window like prefetch() would.
+  Bit64u ppf2; Bit32u mask2; int pageDelta;
+  Region() : nblocks(0), mask(0), key(0), ppf2(0), mask2(0), pageDelta(0) { for (unsigned j = 0; j < NB_REGION_MAX_BLOCKS; j++) { insptr[j] = NULL; entptr[j] = NULL; srcEntry[j] = NULL; srcI[j] = NULL; entry[j].reg = NULL; entry[j].block = 0; entry[j].delta = 0; } }
+  ~Region() { for (unsigned j = 0; j < nblocks; j++) delete[] b[j].ins; }
+};
+static Region nanobox_region_layout_probe;
+#define REGION_OFF(field) ((uint32_t)((uintptr_t)&nanobox_region_layout_probe.field - (uintptr_t)&nanobox_region_layout_probe))
+
+struct TraceCompiler {
+  bxICacheEntry_c *e;
+  bxInstruction_c *ins;
+  unsigned n;            // number of real instructions in the trace
+  Module &m;             // the module this function is emitted into (shared by a batch)
+  Emit *em;
+  bool mode64;
+  Bit32u off[BX_MAX_TRACE_LENGTH + 2];
+  bool needAsyncCheck;   // current instruction had a path that may raise async_event
+
+  // locals
+  uint32_t L_i, L_base, L_ic0, L_upl, L_acm;
+  uint32_t L_reg[16];
+  uint32_t L_lfr, L_lfa;
+  CacheState cs;
+  uint32_t T[8];    // i64 temps for templates
+  uint32_t X[4];    // i64 scratch for flag computations
+  uint32_t W;       // i64 scratch for write-stamp pAddr
+  uint32_t T32[6];  // i32 temps
+  // last successful DTLB probe (page cache): lpf, host page address, access bits, physical page
+  // frame and "no icache stamp on this page" flag. Reset at trace entry and after handler steps.
+  uint32_t C_lpf, C_host, C_bits, C_ppf, C_free;
+
+  int depth;             // structured-control nesting depth (blocks/ifs/loops currently open)
+  int loopDepth;         // depth value just inside the trace loop (-1 = no loop emitted)
+  int bodyDepth;         // depth value just inside the body block (exits `br` there, then link)
+  bool linkOK;           // emit the trace-linking epilogue
+  bool selfLoopOK;       // may compile "branch to own start" as an in-function loop
+  bool usedReg[16], usedLf; // registers / flags touched anywhere in the trace (pass 1 result)
+  bool headerReg[16], headerLf; // loop header set: kept in locals across iterations (pass 2)
+  bool flagsLive;        // do the flags written by the current instruction need to be computed?
+  bool flagsDead[BX_MAX_TRACE_LENGTH + 2];
+
+  // region mode (reg != NULL): the function holds reg->nblocks blocks; block j's instruction k
+  // lives at linear address L_base + b[j].boff + off[k], where L_base is the entry block's start
+  Region *reg;
+  unsigned curBlock;
+  Bit32s boff;           // current block's offset from the entry block start (0 for single traces; negative in the previous page)
+  int dispatchDepth;     // depth just inside the dispatch loop
+  uint32_t L_cur;        // block index for the dispatch br_table
+  uint32_t L_regp;       // region descriptor pointer (loaded from the entry descriptor in the prologue)
+  // A3: registers/flags stay in wasm locals across in-region transitions. Every block j has a fixed
+  // entry state D_j = the registers/flags it touches (found in a dry-run pass); each transition
+  // into j spills what j does not track and loads what j needs; block bodies are compiled with
+  // D_j loaded (and treated as possibly-stale-in-memory, so every exit stores it).
+  bool regionPass2;      // false: dry run collecting D_j (transitions spill everything, as before)
+  bool regionKernel;     // region compiled for CPL0 code: kernel text mapping is fixed after boot (measured: 3 SMC events after boot), skip the frame check on cross-page transitions
+  bool blockUsedReg[NB_REGION_MAX_BLOCKS][16], blockUsedLf[NB_REGION_MAX_BLOCKS];
+  bool conforming;       // loads emitted by conformTo() must not count as "used by this block"
+
+  TraceCompiler(bxICacheEntry_c *entry, Module &mod) : e(entry), ins(entry->i), n(0), m(mod), em(NULL), needAsyncCheck(false), depth(0), loopDepth(-1), bodyDepth(-1), linkOK(false), selfLoopOK(false),
+    reg(NULL), curBlock(0), boff(0), dispatchDepth(-1), L_cur(0), regionPass2(false), regionKernel(false), conforming(false) {}
+  // instruction pointer of instruction k of the current block (what the handler gets)
+  void pushInsPtr(unsigned k) {
+    if (reg) { em->get(L_regp); em->mem(I32_LOAD, REGION_OFF(insptr[curBlock]), 2); if (k) { em->i32c((int32_t)(k * sizeof(bxInstruction_c))); em->op(I32_ADD); } return; }
+    em->get(L_i); if (k) { em->i32c((int32_t)(k * sizeof(bxInstruction_c))); em->op(I32_ADD); }
+  }
+  // region-relative offset -> block index, or -1
+  int regionBlockAt(Bit64s roff) {
+    if (!reg) return -1;
+    for (unsigned j = 0; j < reg->nblocks; j++) if ((Bit64s) reg->b[j].boff == roff) return (int) j;
+    return -1;
+  }
+  void csReset() { for (unsigned r = 0; r < 16; r++) cs.regLoaded[r] = cs.regDirty[r] = false; cs.lfLoaded = cs.lfDirty = false; cs.acmLoaded = false; }
+  // compile-time state at the entry of block j (pass 2): D_j loaded and possibly stale in memory
+  void csSetEntry(unsigned j) {
+    for (unsigned r = 0; r < 16; r++) cs.regLoaded[r] = cs.regDirty[r] = blockUsedReg[j][r];
+    cs.lfLoaded = cs.lfDirty = blockUsedLf[j]; cs.acmLoaded = false;
+  }
+  // make the runtime state match D_j from the current compile-time state (pass 2); pass 1: spill all
+  void conformTo(unsigned j) {
+    if (!regionPass2) { spillAll(false); return; }
+    conforming = true;
+    for (unsigned r = 0; r < 16; r++) {
+      if (cs.regDirty[r] && !blockUsedReg[j][r]) { em->i32c(0); em->get(L_reg[r]); em->mem(I64_STORE, regAddr(r), 3); }
+      if (blockUsedReg[j][r] && !cs.regLoaded[r]) { em->i32c(0); em->mem(I64_LOAD, regAddr(r), 3); em->set(L_reg[r]); }
+    }
+    if (cs.lfDirty && !blockUsedLf[j]) {
+      em->i32c(0); em->get(L_lfr); em->mem(I64_STORE, ADDR(BX_CPU_THIS_PTR oszapc.result), 3);
+      em->i32c(0); em->get(L_lfa); em->mem(I64_STORE, ADDR(BX_CPU_THIS_PTR oszapc.auxbits), 3);
+    }
+    if (blockUsedLf[j] && !cs.lfLoaded) {
+      em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR oszapc.result), 3); em->set(L_lfr);
+      em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR oszapc.auxbits), 3); em->set(L_lfa);
+    }
+    conforming = false;
+    csSetEntry(j);
+  }
+  // commit RIP/prev_rip/icount after instruction k with the next RIP = region offset roff, and spill
+  // everything: used on the rare paths that leave the region from inside a transition
+  void commitAndSpill(unsigned k, Bit64s roff) {
+    spillAll(false);
+    em->i32c(0); pushRegionVA(roff); em->mem(I64_STORE, ADDR(BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx), 3);
+    em->i32c(0); pushRegionVA(roff); em->mem(I64_STORE, ADDR(BX_CPU_THIS_PTR prev_rip), 3);
+    em->i32c(0); em->get(L_ic0); em->i64c(k + 1); em->op(I64_ADD); em->mem(I64_STORE, ADDR(BX_CPU_THIS_PTR icount), 3);
+  }
+
+  void blk(ValType t = VOID) { em->block(t); depth++; }
+  void iff(ValType t = VOID) { em->if_(t); depth++; }
+  void els() { em->else_(); }
+  void lp(ValType t = VOID) { em->loop(t); depth++; }
+  void endb() { em->end(); depth--; }
+
+  // ---------------------------------------------------------------- import helpers
+  uint32_t fn(uint32_t fnidx, const char *sig) {
+    // sig: params then '>' then results, using i=i32 l=i64 v=void
+    ValType ps[6], rs[2]; int np = 0, nr = 0; bool res = false;
+    for (const char *p = sig; *p; p++) {
+      if (*p == '>') { res = true; continue; }
+      if (*p == 'v') continue;
+      ValType t = (*p == 'i') ? I32 : I64;
+      if (res) rs[nr++] = t; else ps[np++] = t;
+    }
+    return m.addImport(fnidx, Module::ft(np, ps, nr, rs));
+  }
+
+  // ---------------------------------------------------------------- state cache
+  uint32_t regAddr(unsigned r) { return ADDR(BX_CPU_THIS_PTR gen_reg[r].rrx); }
+  void regEnsureLoaded(unsigned r) {
+    if (!conforming) usedReg[r] = true;
+    if (!cs.regLoaded[r]) { em->i32c(0); em->mem(I64_LOAD, regAddr(r), 3); em->set(L_reg[r]); cs.regLoaded[r] = true; }
+  }
+  void regGet(unsigned r) { regEnsureLoaded(r); em->get(L_reg[r]); }
+  void regSetFromStack(unsigned r) { usedReg[r] = true; em->set(L_reg[r]); cs.regLoaded[r] = true; cs.regDirty[r] = true; }
+  // 32-bit result (i64 with garbage upper bits on stack) -> zero-extended register write
+  void regSet32FromStack(unsigned r) { em->i64c(0xffffffffLL); em->op(I64_AND); regSetFromStack(r); }
+  // emit stores of dirty state; `clear` says whether the compile-time dirty bits are cleared
+  // (false inside conditional paths that rejoin the main flow)
+  void spillAll(bool clear) {
+    for (unsigned r = 0; r < 16; r++) if (cs.regDirty[r]) {
+      em->i32c(0); em->get(L_reg[r]); em->mem(I64_STORE, regAddr(r), 3);
+      if (clear) cs.regDirty[r] = false;
+    }
+    if (cs.lfDirty) {
+      em->i32c(0); em->get(L_lfr); em->mem(I64_STORE, ADDR(BX_CPU_THIS_PTR oszapc.result), 3);
+      em->i32c(0); em->get(L_lfa); em->mem(I64_STORE, ADDR(BX_CPU_THIS_PTR oszapc.auxbits), 3);
+      if (clear) cs.lfDirty = false;
+    }
+  }
+  void invalidateAll() {
+    for (unsigned r = 0; r < 16; r++) cs.regLoaded[r] = cs.regDirty[r] = false;
+    cs.lfLoaded = cs.lfDirty = false; cs.acmLoaded = false;
+    // the probe cache lives in locals; a handler may have flushed the TLB
+    if (em) { em->i64c(-1); em->set(C_lpf); }
+  }
+  CacheState snapshot() { return cs; }
+  void restore(const CacheState &s) { cs = s; }
+
+  void lfLoad() {
+    if (!conforming) usedLf = true;
+    if (cs.lfLoaded) return;
+    em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR oszapc.result), 3); em->set(L_lfr);
+    em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR oszapc.auxbits), 3); em->set(L_lfa);
+    cs.lfLoaded = true;
+  }
+  void lfMarkSet() { usedLf = true; cs.lfLoaded = true; cs.lfDirty = true; }
+
+  void acmGet() {
+    if (!cs.acmLoaded) { em->i32c(0); em->mem(I64_LOAD32_U, ADDR(BX_CPU_THIS_PTR alignment_check_mask), 2); em->set(L_acm); cs.acmLoaded = true; }
+    em->get(L_acm);
+  }
+
+  // RIP-related constants
+  void pushVA(Bit32u traceOffset) { em->get(L_base); Bit64s o = (Bit64s) boff + traceOffset; if (o) { em->i64c(o); em->op(I64_ADD); } }
+  void pushRegionVA(Bit64s roff) { em->get(L_base); if (roff) { em->i64c(roff); em->op(I64_ADD); } }
+
