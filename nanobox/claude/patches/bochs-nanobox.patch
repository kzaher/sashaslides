+      uint32_t d = ADDR(BX_CPU_THIS_PTR vmm[dst]), sr = ADDR(BX_CPU_THIS_PTR vmm[src]);
+      for (unsigned q = 0; q < 2; q++) { em->i32c(0); em->i32c(0); em->mem(I64_LOAD, d + 8 * q, 3); em->i32c(0); em->mem(I64_LOAD, sr + 8 * q, 3); em->op(I64_XOR); em->mem(I64_STORE, d + 8 * q, 3); }
+      return true;
+    }
+    case BX_IA_MOVQ_VdqEq: {
+      if (!R || !realHandler(k, &BX_CPU_C::MOVQ_VdqEqR)) return false;
