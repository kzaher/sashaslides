+        emitStackWrite(k, t2, t1);
+        em->get(t2); regSetFromStack(R_RSP);
+      }
+      em->get(t0); exitWithRipOnStack(k);
+      return true;
+    }
+
+    // ---- PUSHF: push_64(read_eflags() & 0x00fcffff)
+    case BX_IA_PUSHF_Fq: {
+      spillAll(true); // force_flags() reads the lazy flags from memory
+      em->call(fn(FNIDX(&BX_CPU_C::read_eflags), "v>i"));
+      em->i32c(0x00fcffff); em->op(I32_AND); em->op(I64_EXTEND_I32_U); em->set(t1);
+      regGet(R_RSP); em->i64c(8); em->op(I64_SUB); em->set(t2);
