+  // ---------------------------------------------------------------- lazy flags
+  // Given locals op1, op2, res (i64, values zero-extended to their size), set oszapc for an
+  // ADD (sub=false) or SUB (sub=true) of `size` bytes, exactly like SET_FLAGS_OSZAPC_{ADD,SUB}_n
+  // (or the OSZAP variants that preserve CF when preserveCF is set).
+  void setFlagsArith(unsigned size, uint32_t op1, uint32_t op2, uint32_t res, bool sub, bool preserveCF) {
+    if (!flagsLive) return;
+    if (preserveCF) lfLoad(); // need old auxbits
+    // carries
+    if (!sub) { // (op1 & op2) | ((op1 | op2) & ~res)
+      em->get(op1); em->get(op2); em->op(I64_AND);
+      em->get(op1); em->get(op2); em->op(I64_OR); em->get(res); em->i64c(-1); em->op(I64_XOR); em->op(I64_AND);
+      em->op(I64_OR);
+    } else {    // (~op1 & op2) | ((~op1 ^ op2) & res)
+      em->get(op1); em->i64c(-1); em->op(I64_XOR); em->get(op2); em->op(I64_AND);
+      em->get(op1); em->i64c(-1); em->op(I64_XOR); em->get(op2); em->op(I64_XOR); em->get(res); em->op(I64_AND);
+      em->op(I64_OR);
+    }
+    if (size < 8) { em->i64c((1LL << (size * 8)) - 1); em->op(I64_AND); } // Bochs computes carries in the operand width
+    em->set(X[0]); // carries
+    // result (sign extended)
+    em->get(res);
+    if (size == 4) em->op(I64_EXTEND32_S); else if (size == 2) em->op(I64_EXTEND16_S); else if (size == 1) em->op(I64_EXTEND8_S);
+    em->set(L_lfr);
+    // temp
+    switch (size) {
+      case 8: em->get(X[0]); em->i64c(8); em->op(I64_AND); em->get(X[0]); em->i64c(62); em->op(I64_SHR_U); em->i64c(30); em->op(I64_SHL); em->op(I64_OR); break;
+      case 4: em->get(X[0]); em->i64c(0xFFFF00FEu); em->op(I64_AND); break;
+      case 2: em->get(X[0]); em->i64c(8); em->op(I64_AND); em->get(X[0]); em->i64c(16); em->op(I64_SHL); em->op(I64_OR); break;
+      case 1: em->get(X[0]); em->i64c(8); em->op(I64_AND); em->get(X[0]); em->i64c(24); em->op(I64_SHL); em->op(I64_OR); break;
+    }
+    if (preserveCF) {
+      // delta_c = (auxbits ^ temp) & CF; delta_c ^= delta_c >> 1; aux = (Bit32u)(temp ^ delta_c)
+      em->set(X[1]); // temp
+      em->get(L_lfa); em->get(X[1]); em->op(I64_XOR); em->i64c(0x80000000LL); em->op(I64_AND); em->set(X[2]);
+      em->get(X[2]); em->get(X[2]); em->i64c(1); em->op(I64_SHR_U); em->op(I64_XOR); em->set(X[2]);
+      em->get(X[1]); em->get(X[2]); em->op(I64_XOR);
+    }
+    em->i64c(0xffffffffLL); em->op(I64_AND);
+    em->set(L_lfa);
+    lfMarkSet();
+  }
+  // SET_FLAGS_OSZAPC_LOGIC_n(res)
+  void setFlagsLogic(unsigned size, uint32_t res) {
+    if (!flagsLive) return;
+    em->get(res);
+    if (size == 4) em->op(I64_EXTEND32_S); else if (size == 2) em->op(I64_EXTEND16_S); else if (size == 1) em->op(I64_EXTEND8_S);
+    em->set(L_lfr);
+    em->i64c(0); em->set(L_lfa);
+    lfMarkSet();
+  }
+  // oszapc.set_flags_OxxxxC(of, cf) with of/cf as i32 (0/1) in locals
+  void setFlagsOxxxxC(uint32_t of32, uint32_t cf32) {
+    if (!flagsLive) return;
+    lfLoad();
+    em->get(L_lfa); em->i64c(~0xC0000000LL); em->op(I64_AND);
+    em->get(of32); em->get(cf32); em->op(I32_XOR); em->op(I64_EXTEND_I32_U); em->i64c(30); em->op(I64_SHL); em->op(I64_OR);
+    em->get(cf32); em->op(I64_EXTEND_I32_U); em->i64c(31); em->op(I64_SHL); em->op(I64_OR);
+    em->set(L_lfa); lfMarkSet();
+  }
+  void assertFlagsOxxxxC() {
+    if (!flagsLive) return;
+    lfLoad();
+    em->get(L_lfa); em->i64c(~0xC0000000LL); em->op(I64_AND); em->i64c(0x80000000LL); em->op(I64_OR); em->set(L_lfa); lfMarkSet();
+  }
+  // condition code -> i32 (0/1) on stack
+  void pushCond(unsigned cc) {
+    lfLoad();
+    switch (cc & ~1u) {
+      case CC_O: pushOF(); break;
+      case CC_B: pushCF(); break;
+      case CC_Z: pushZF(); break;
+      case CC_BE: pushCF(); pushZF(); em->op(I32_OR); break;
+      case CC_S: pushSF(); break;
+      case CC_P: pushPF(); break;
+      case CC_L: pushSF(); pushOF(); em->op(I32_XOR); break;
+      case CC_LE: pushZF(); pushSF(); pushOF(); em->op(I32_XOR); em->op(I32_OR); break;
+    }
+    if (cc & 1) em->op(I32_EQZ);
+  }
+  void pushZF() { em->get(L_lfr); em->op(I64_EQZ); }
+  void pushSF() { em->get(L_lfr); em->i64c(63); em->op(I64_SHR_U); em->get(L_lfa); em->op(I64_XOR); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); }
+  void pushCF() { em->get(L_lfa); em->i64c(31); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); }
+  void pushOF() { em->get(L_lfa); em->i64c(0x40000000LL); em->op(I64_ADD); em->i64c(31); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); }
+  void pushPF() {
+    // temp = (255 & result) ^ (255 & (aux >> 8)); temp = (temp ^ (temp >> 4)) & 0xF; (0x9669 >> temp) & 1
+    em->get(L_lfr); em->op(I32_WRAP_I64); em->i32c(255); em->op(I32_AND);
+    em->get(L_lfa); em->i64c(8); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(255); em->op(I32_AND);
+    em->op(I32_XOR); em->set(T32[2]);
+    em->i32c(0x9669); em->get(T32[2]); em->get(T32[2]); em->i32c(4); em->op(I32_SHR_U); em->op(I32_XOR); em->i32c(0xF); em->op(I32_AND);
+    em->op(I32_SHR_U); em->i32c(1); em->op(I32_AND);
+  }
+
+  // ---------------------------------------------------------------- register pieces
+  void pushReg8(unsigned r, bool ext) {
+    if ((r & 4) == 0 || ext) { regGet(r); em->i64c(0xff); em->op(I64_AND); }
+    else { regGet(r - 4); em->i64c(8); em->op(I64_SHR_U); em->i64c(0xff); em->op(I64_AND); }
+  }
+  void writeReg8(unsigned r, bool ext, uint32_t v) {
+    if ((r & 4) == 0 || ext) {
+      regGet(r); em->i64c(~0xffLL); em->op(I64_AND); em->get(v); em->i64c(0xff); em->op(I64_AND); em->op(I64_OR); regSetFromStack(r);
+    } else {
+      regGet(r - 4); em->i64c(~0xff00LL); em->op(I64_AND); em->get(v); em->i64c(0xff); em->op(I64_AND); em->i64c(8); em->op(I64_SHL); em->op(I64_OR); regSetFromStack(r - 4);
+    }
+  }
+  void pushReg16(unsigned r) { regGet(r); em->i64c(0xffff); em->op(I64_AND); }
+  void writeReg16(unsigned r, uint32_t v) { regGet(r); em->i64c(~0xffffLL); em->op(I64_AND); em->get(v); em->i64c(0xffff); em->op(I64_AND); em->op(I64_OR); regSetFromStack(r); }
+  void pushReg32(unsigned r) { regGet(r); em->i64c(0xffffffffLL); em->op(I64_AND); }
+  void pushRegSz(unsigned r, unsigned size, bool ext) {
+    if (size == 8) regGet(r); else if (size == 4) pushReg32(r); else if (size == 2) pushReg16(r); else pushReg8(r, ext);
+  }
+  // write local v (low `size` bytes significant) to register r with x86 merge semantics
+  void writeRegSz(unsigned r, unsigned size, bool ext, uint32_t v) {
+    if (size == 8) { em->get(v); regSetFromStack(r); }
+    else if (size == 4) { em->get(v); regSet32FromStack(r); }
+    else if (size == 2) writeReg16(r, v);
+    else writeReg8(r, ext, v);
+  }
+
+  // IsCanonical(x) for value in local v -> i32
+  void pushIsCanonical(uint32_t v) {
+    em->get(v); em->i64c(BX_LIN_ADDRESS_WIDTH - 1); em->op(I64_SHR_S); em->i64c(1); em->op(I64_ADD); em->i64c(2); em->op(I64_LT_U);
+  }
