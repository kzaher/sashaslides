+    switch (kind) {
+      case MK_WR_LIN:
+        sig = size == 8 ? "ill>v" : "ili>v";
+        return size == 8 ? FNIDX(&BX_CPU_C::write_linear_qword) : size == 4 ? FNIDX(&BX_CPU_C::write_linear_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::write_linear_word) : FNIDX(&BX_CPU_C::write_linear_byte);
