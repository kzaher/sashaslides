+        else { pushRegSz(src, size, false); em->set(T[4]); emitRMWWrite(rmwKind, size, T[4]); }
+      els();
+        if (!R) emitRMWWrite(rmwKind, size, op1);
+        writeRegSz(R_RAX, size, false, op1);
+      endb();
+      // dirty on both paths (writeRegSz on one path marked them; the other path may not have)
+      if (R) { cs.regDirty[dst] = true; } cs.regDirty[R_RAX] = true;
+      return true;
+    }
+
+    // ---- BTS/BTR/BTC by immediate, register destination
+    case BX_IA_BTS_EqIb: case BX_IA_BTS_EdIb: case BX_IA_BTR_EqIb: case BX_IA_BTR_EdIb: case BX_IA_BTC_EqIb: case BX_IA_BTC_EdIb: {
+      if (!R) return false;
+      unsigned size = (ia == BX_IA_BTS_EqIb || ia == BX_IA_BTR_EqIb || ia == BX_IA_BTC_EqIb) ? 8 : 4;
+      unsigned bit = i->Ib() & (size * 8 - 1);
+      lfLoad();
+      if (size == 8) regGet(dst); else pushReg32(dst);
+      em->set(t0);
+      em->get(t0); em->i64c(bit); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(T32[3]);
+      em->get(t0); em->i64c(1LL << bit);
+      if (ia == BX_IA_BTS_EqIb || ia == BX_IA_BTS_EdIb) em->op(I64_OR);
+      else if (ia == BX_IA_BTR_EqIb || ia == BX_IA_BTR_EdIb) { em->drop(); em->i64c(~(1LL << bit)); em->op(I64_AND); }
+      else em->op(I64_XOR);
+      if (size == 4) { em->i64c(0xffffffffLL); em->op(I64_AND); }
