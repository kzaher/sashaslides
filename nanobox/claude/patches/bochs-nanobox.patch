+      if (R) regGet(dst); else { pushEA(k); em->set(t3); emitRead(k, MK_RD_VIRT, seg, 8, t3); }
+      em->set(t0);
+      pushIsCanonical(t0); em->op(I32_EQZ);
+      iff(); emitDeoptAndReturn(k, last); endb();
