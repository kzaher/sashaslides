+      case BX_IA_TEST_EbGb: op = A_TEST; size = 1; form = 1; break;
+      case BX_IA_TEST_EbIb: op = A_TEST; size = 1; form = 2; break;
+      case BX_IA_TEST_ALIb: op = A_TEST; size = 1; form = 3; break;
+      default: return false;
+    }
+    #undef ALU_CASE
+    unsigned dst = (form == 3) ? R_RAX : i->dst(), src = i->src(), seg = i->seg();
+    bool ext = i->extend8bitL();
+    if (form == 3) R = true;
+    uint32_t op1 = T[0], op2 = T[1], res = T[2], ea = T[3];
+    bool writesDst = (op != A_CMP && op != A_TEST);
+    MemKind rdKind = (size == 8) ? MK_RD_LIN : MK_RD_VIRT;
+    MemKind rmwKind = (size == 8) ? MK_RMW_LIN : MK_RMW_VIRT;
+    // op2
+    if (form == 2 || form == 3) {
+      Bit64s imm = size == 8 ? (Bit64s)(Bit32s) i->Id() : size == 4 ? (Bit64s)(Bit64u) i->Id() : size == 2 ? (Bit64s) i->Iw() : (Bit64s) i->Ib();
+      em->i64c(imm); em->set(op2);
+    }
+    else if (form == 1) { pushRegSz(src, size, ext); em->set(op2); }
+    // op1 / memory forms
+    if (R) {
+      if (form == 0) { pushRegSz(src, size, ext); em->set(op2); }
+      pushRegSz(dst, size, ext);
+      em->set(op1);
+    } else if (form == 0) {
+      pushEA(k); em->set(ea); emitRead(k, rdKind, seg, size, ea); em->set(op2);
+      pushRegSz(dst, size, ext);
+      em->set(op1);
+    } else {
+      pushEA(k); em->set(ea);
+      if (writesDst) emitRMWRead(k, rmwKind, seg, size, ea);
+      else emitRead(k, rdKind, seg, size, ea);
+      em->set(op1);
+    }
+    // compute
+    if (op == A_ADC || op == A_SBB) { lfLoad(); pushCF(); em->op(I64_EXTEND_I32_U); em->set(T[4]); } // carry in (before the flags are overwritten)
+    em->get(op1); em->get(op2);
+    switch (op) {
+      case A_ADD: em->op(I64_ADD); break;
+      case A_ADC: em->op(I64_ADD); em->get(T[4]); em->op(I64_ADD); break;   // sum = op1 + op2 + CF; flags: SET_FLAGS_OSZAPC_ADD(op1, op2, sum)
+      case A_SBB: em->get(T[4]); em->op(I64_ADD); em->op(I64_SUB); break;   // diff = op1 - (op2 + CF); flags: SET_FLAGS_OSZAPC_SUB(op1, op2, diff)
+      case A_SUB: case A_CMP: em->op(I64_SUB); break;
+      case A_AND: case A_TEST: em->op(I64_AND); break;
+      case A_OR: em->op(I64_OR); break;
+      case A_XOR: em->op(I64_XOR); break;
+    }
+    if (size < 8) { em->i64c((1LL << (size * 8)) - 1); em->op(I64_AND); }
+    em->set(res);
+    // write back
+    if (writesDst) {
+      if (R || form == 0) writeRegSz(dst, size, ext, res);
+      else emitRMWWrite(rmwKind, size, res);
+    }
+    // flags
+    if (op == A_ADD || op == A_ADC) setFlagsArith(size, op1, op2, res, false, false);
+    else if (op == A_SUB || op == A_CMP || op == A_SBB) setFlagsArith(size, op1, op2, res, true, false);
+    else setFlagsLogic(size, res);
+    return true;
+  }
+
+  // ---- INC/DEC/NEG/NOT
+  bool emitUnary(unsigned k, bxInstruction_c *i, unsigned ia, bool R) {
+    unsigned size = (ia == BX_IA_INC_Eq || ia == BX_IA_DEC_Eq || ia == BX_IA_NEG_Eq || ia == BX_IA_NOT_Eq) ? 8 : 4;
+    bool inc = (ia == BX_IA_INC_Eq || ia == BX_IA_INC_Ed), dec = (ia == BX_IA_DEC_Eq || ia == BX_IA_DEC_Ed);
+    bool neg = (ia == BX_IA_NEG_Eq || ia == BX_IA_NEG_Ed);
+    unsigned dst = i->dst(), seg = i->seg();
+    uint32_t op1 = T[0], op2 = T[1], res = T[2], ea = T[3];
+    MemKind rmwKind = (size == 8) ? MK_RMW_LIN : MK_RMW_VIRT;
+    if (R) { if (size == 8) regGet(dst); else pushReg32(dst); em->set(op1); }
+    else { pushEA(k); em->set(ea); emitRMWRead(k, rmwKind, seg, size, ea); em->set(op1); }
+    if (inc || dec) {
+      em->get(op1); em->i64c(1); em->op(inc ? I64_ADD : I64_SUB);
+      if (size == 4) { em->i64c(0xffffffffLL); em->op(I64_AND); }
+      em->set(res);
+      em->i64c(0); em->set(op2);
+      if (R) { em->get(res); regSetFromStack(dst); } else emitRMWWrite(rmwKind, size, res);
+      // INC: SET_FLAGS_OSZAP_ADD_n(rrx-1, 0, rrx); DEC: SET_FLAGS_OSZAP_SUB_n(rrx+1, 0, rrx)
+      setFlagsArith(size, op1, op2, res, dec, true);
+    } else if (neg) {
+      // op1 = -(Bit64s)op1; write; SET_FLAGS_OSZAPC_SUB_n(0, orig, -orig)
+      em->i64c(0); em->get(op1); em->op(I64_SUB);
+      if (size == 4) { em->i64c(0xffffffffLL); em->op(I64_AND); }
+      em->set(res);
+      if (R) { em->get(res); regSetFromStack(dst); } else emitRMWWrite(rmwKind, size, res);
+      em->get(op1); em->set(op2);   // orig
+      em->i64c(0); em->set(op1);
+      setFlagsArith(size, op1, op2, res, true, false);
+    } else { // NOT
+      em->get(op1); em->i64c(-1); em->op(I64_XOR);
+      if (size == 4) { em->i64c(0xffffffffLL); em->op(I64_AND); }
+      em->set(res);
+      if (R) { em->get(res); regSetFromStack(dst); } else emitRMWWrite(rmwKind, size, res);
+    }
+    return true;
+  }
+
+  // ---- shifts (register destination)
+  bool emitShift(unsigned k, bxInstruction_c *i, unsigned ia) {
+    unsigned size; int kind; // 0=shl 1=shr 2=sar
+    bool useCL;
+    switch (ia) {
+      case BX_IA_SHL_Eq: size = 8; kind = 0; useCL = true; break;
+      case BX_IA_SHL_EqIb: case BX_IA_SHL_EqI1: size = 8; kind = 0; useCL = false; break;
+      case BX_IA_SHR_Eq: size = 8; kind = 1; useCL = true; break;
+      case BX_IA_SHR_EqIb: case BX_IA_SHR_EqI1: size = 8; kind = 1; useCL = false; break;
+      case BX_IA_SAR_Eq: size = 8; kind = 2; useCL = true; break;
+      case BX_IA_SAR_EqIb: case BX_IA_SAR_EqI1: size = 8; kind = 2; useCL = false; break;
+      case BX_IA_SHL_Ed: size = 4; kind = 0; useCL = true; break;
+      case BX_IA_SHL_EdIb: case BX_IA_SHL_EdI1: size = 4; kind = 0; useCL = false; break;
+      case BX_IA_SHR_Ed: size = 4; kind = 1; useCL = true; break;
+      case BX_IA_SHR_EdIb: case BX_IA_SHR_EdI1: size = 4; kind = 1; useCL = false; break;
+      case BX_IA_SAR_Ed: size = 4; kind = 2; useCL = true; break;
+      case BX_IA_SAR_EdIb: case BX_IA_SAR_EdI1: size = 4; kind = 2; useCL = false; break;
+      default: return false;
+    }
+    unsigned dst = i->dst();
+    uint32_t op1 = T[0], res = T[1], cnt = T[2]; uint32_t cf = T32[3], of = T32[4];
+    unsigned mask = (size == 8) ? 0x3f : 0x1f;
+    // count
+    if (useCL) { regGet(R_RCX); em->i64c(mask); em->op(I64_AND); em->set(cnt); }
+    else {
+      unsigned c = i->Ib() & mask;
+      if (c == 0) { // flags untouched; 32-bit forms still zero-extend the destination
+        if (size == 4) { pushReg32(dst); regSetFromStack(dst); }
+        return true;
+      }
+      em->i64c(c); em->set(cnt);
+    }
+    // 32-bit forms clear the upper half of the register even for a zero count
+    if (useCL && size == 4) { pushReg32(dst); regSetFromStack(dst); }
+    // count == 0: nothing happens (incl. flags). The update is runtime-conditional, so make sure
+    // the cached locals hold the current values on the not-taken path: load them first, update
+    // inside the `if`, and mark them dirty for both paths.
+    if (useCL) { lfLoad(); regEnsureLoaded(dst); em->get(cnt); em->i64c(0); em->op(I64_NE); iff(); }
+    if (size == 8) regGet(dst); else pushReg32(dst);
+    em->set(op1);
+    if (kind == 0) {
+      // result = op1 << count; cf = (op1 >> (bits - count)) & 1; of = cf ^ (result >> (bits-1))
+      em->get(op1); em->get(cnt); em->op(I64_SHL); if (size == 4) { em->i64c(0xffffffffLL); em->op(I64_AND); } em->set(res);
+      em->get(op1); em->i64c(size * 8); em->get(cnt); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+      em->get(res); em->i64c(size * 8 - 1); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->get(cf); em->op(I32_XOR); em->set(of);
+    } else if (kind == 1) {
+      // result = op1 >> count; cf = (op1 >> (count-1)) & 1; of = ((result << 1) ^ result) >> (bits-1)
+      em->get(op1); em->get(cnt); em->op(I64_SHR_U); em->set(res);
+      em->get(op1); em->get(cnt); em->i64c(1); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+      em->get(res); em->i64c(1); em->op(I64_SHL); em->get(res); em->op(I64_XOR); em->i64c(size * 8 - 1); em->op(I64_SHR_U);
+      em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND);
+      em->set(of);
+    } else {
+      // result = (signed)op1 >> count; cf = (op1 >> (count-1)) & 1; of = 0
+      em->get(op1); if (size == 4) em->op(I64_EXTEND32_S); em->get(cnt); em->op(I64_SHR_S); if (size == 4) { em->i64c(0xffffffffLL); em->op(I64_AND); } em->set(res);
+      em->get(op1); em->get(cnt); em->i64c(1); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+      em->i32c(0); em->set(of);
+    }
+    em->get(res); regSetFromStack(dst);
+    setFlagsLogic(size, res);
+    setFlagsOxxxxC(of, cf);
+    if (useCL) endb();
+    return true;
+  }
+
+  // ---- IMUL (2 and 3 operand forms)
+  bool emitImul(unsigned k, bxInstruction_c *i, unsigned ia, bool R) {
+    unsigned size = (ia == BX_IA_IMUL_GqEq || ia == BX_IA_IMUL_GqEqId || ia == BX_IA_IMUL_GqEqsIb) ? 8 : 4;
+    bool imm = (ia == BX_IA_IMUL_GqEqId || ia == BX_IA_IMUL_GqEqsIb || ia == BX_IA_IMUL_GdEdId || ia == BX_IA_IMUL_GdEdsIb);
+    unsigned dst = i->dst(), src = i->src(), seg = i->seg();
+    uint32_t a = T[0], b = T[1], lo = T[2], hi = T[3];
+    // operand E (register or memory via LOAD_Eq/LOAD_Ed)
+    if (R) { if (size == 8) regGet(src); else pushReg32(src); }
+    else { pushEA(k); em->set(T[4]); emitRead(k, size == 8 ? MK_RD_LIN : MK_RD_VIRT, seg, size, T[4]); }
+    em->set(a);
+    if (imm) { em->i64c((Bit64s)(Bit32s) i->Id()); em->set(b); }
+    else { if (size == 8) regGet(dst); else pushReg32(dst); em->set(b); }
+    if (size == 4) {
+      // 32x32 -> 64 signed product
+      em->get(a); em->op(I64_EXTEND32_S); em->get(b); em->op(I64_EXTEND32_S); em->op(I64_MUL); em->set(lo);
+      em->get(lo); em->i64c(0xffffffffLL); em->op(I64_AND); em->set(a);
+      em->get(a); regSetFromStack(dst);
+      setFlagsLogic(4, a);
+      em->get(lo); em->get(lo); em->op(I64_EXTEND32_S); em->op(I64_NE);
+      iff(); assertFlagsOxxxxC(); endb();
+    } else {
+      // signed 64x64 -> 128: lo = a*b; hi = mulhs(a,b)
+      em->get(a); em->get(b); em->op(I64_MUL); em->set(lo);
+      emitMulhs(a, b, hi);
+      em->get(lo); regSetFromStack(dst);
+      setFlagsLogic(8, lo);
+      // if ((Bit64u)hi + (lo >> 63) != 0) assert_flags_OxxxxC
+      em->get(hi); em->get(lo); em->i64c(63); em->op(I64_SHR_U); em->op(I64_ADD); em->i64c(0); em->op(I64_NE);
+      iff(); assertFlagsOxxxxC(); endb();
+    }
+    return true;
+  }
+  // signed high 64 bits of a*b -> local out (uses X[] scratch)
+  void emitMulhs(uint32_t a, uint32_t b, uint32_t out) {
+    uint32_t a0 = X[0], a1 = X[1], b0 = X[2], b1 = X[3];
+    em->get(a); em->i64c(0xffffffffLL); em->op(I64_AND); em->set(a0);
+    em->get(a); em->i64c(32); em->op(I64_SHR_U); em->set(a1);
+    em->get(b); em->i64c(0xffffffffLL); em->op(I64_AND); em->set(b0);
+    em->get(b); em->i64c(32); em->op(I64_SHR_U); em->set(b1);
+    // t = a0*b0; u = a1*b0 + (t>>32); v = a0*b1 + (u & 0xffffffff); hi = a1*b1 + (u>>32) + (v>>32)
+    em->get(a0); em->get(b0); em->op(I64_MUL); em->i64c(32); em->op(I64_SHR_U);
+    em->get(a1); em->get(b0); em->op(I64_MUL); em->op(I64_ADD); em->set(out); // u
+    em->get(a0); em->get(b1); em->op(I64_MUL); em->get(out); em->i64c(0xffffffffLL); em->op(I64_AND); em->op(I64_ADD); em->set(a0); // v
+    em->get(a1); em->get(b1); em->op(I64_MUL); em->get(out); em->i64c(32); em->op(I64_SHR_U); em->op(I64_ADD);
+    em->get(a0); em->i64c(32); em->op(I64_SHR_U); em->op(I64_ADD); em->set(out);
+    // signed correction: hi -= (a<0 ? b : 0) + (b<0 ? a : 0)
+    em->get(out);
+    em->get(b); em->i64c(0); em->get(a); em->i64c(63); em->op(I64_SHR_S); em->op(I32_WRAP_I64); em->select(); em->op(I64_SUB);
+    em->get(a); em->i64c(0); em->get(b); em->i64c(63); em->op(I64_SHR_S); em->op(I32_WRAP_I64); em->select(); em->op(I64_SUB);
+    em->set(out);
+  }
+
+  // ---------------------------------------------------------------- driver
+  // region mode: make block j the current block (instructions, offsets, entry copy)
+  int blockPage(unsigned j) { Bit64s o = (Bit64s) reg->b[j].boff + (Bit64s)(reg->b[0].ent.pAddr & 0xfff); return o < 0 ? -1 : o >= 4096 ? 1 : 0; }
+  void setBlock(unsigned j) {
+    curBlock = j; ins = reg->b[j].ins; n = reg->b[j].n; boff = reg->b[j].boff; e = &reg->b[j].ent;
+    off[0] = 0;
+    for (unsigned k = 0; k < n; k++) off[k + 1] = off[k] + ins[k].ilen();
+  }
+  bool compile() {
+    if (reg) { setBlock(0); regionKernel = (BX_CPU_THIS_PTR user_pl == 0); }
+    else {
+      for (n = 0; n < e->tlen; n++) {
+        if (ins[n].getIaOpcode() == BX_INSERTED_OPCODE) break;
+      }
+      off[0] = 0;
+      for (unsigned k = 0; k < n; k++) off[k + 1] = off[k] + ins[k].ilen();
+    }
+    if (n == 0 || n > nanobox_jit_maxlen) return false;
+    mode64 = (BX_CPU_THIS_PTR cpu_mode == BX_MODE_LONG_64);
+    for (unsigned r = 0; r < 16; r++) usedReg[r] = headerReg[r] = false;
+    usedLf = headerLf = false;
+    // pass 1: discover which registers/flags the trace touches (needed to build a loop header)
+    if (!compilePass()) return false;
+    if (reg) {
+      // pass 2 for regions: block entry states D_j are known now; transitions keep them in locals
+      m.beginFunc();
+      depth = 0; loopDepth = -1; bodyDepth = -1; dispatchDepth = -1;
+      regionPass2 = true;
+      setBlock(0);           // the prologue derives L_base from block 0's first instruction
+      if (!compilePass()) return false;
+      return true;
+    }
+    if (loopWanted) {
+      // pass 2: recompile with the loop header keeping those in locals across iterations
+      for (unsigned r = 0; r < 16; r++) headerReg[r] = usedReg[r];
+      headerLf = usedLf;
+      m.beginFunc();
+      depth = 0; loopDepth = -1; bodyDepth = -1;
+      if (!compilePass()) return false;
+    }
+    return true;
+  }
+  bool loopWanted;
+  void declareLocals() {
+    L_i = 0;
+    L_base = em->addLocal(I64); L_ic0 = em->addLocal(I64); L_upl = em->addLocal(I32); L_acm = em->addLocal(I64);
+    for (unsigned r = 0; r < 16; r++) L_reg[r] = em->addLocal(I64);
+    L_lfr = em->addLocal(I64); L_lfa = em->addLocal(I64);
+    for (unsigned t = 0; t < 8; t++) T[t] = em->addLocal(I64);
+    for (unsigned t = 0; t < 4; t++) X[t] = em->addLocal(I64);
+    W = em->addLocal(I64);
+    for (unsigned t = 0; t < 6; t++) T32[t] = em->addLocal(I32);
+    C_lpf = em->addLocal(I64); C_host = em->addLocal(I32); C_bits = em->addLocal(I32); C_ppf = em->addLocal(I64); C_free = em->addLocal(I32);
+    L_cur = em->addLocal(I32);
+    L_regp = em->addLocal(I32);
+  }
+  // The trace-linking epilogue as a function of its own (shared by every trace: it is ~600 bytes
+  // of code that used to be duplicated per trace, dominating module size and compile time). Traces
+  // tail-call it after committing their state; it tail-calls the next trace.
+  void emitLinkFn() {
+    ValType p[1] = { I32 };
+    m.nparams = 1;
+    m.funcTypeIdx = m.addType(Module::ft(1, p, 0, NULL));
+    Emit emit(m); em = &emit;
+    declareLocals();
+    emitLinkEpilogue();
+    em->ret();
+  }
+  bool compilePass() {
+    loopWanted = false;
+    ValType p[1] = { I32 };
+    m.nparams = 1;
+    m.funcTypeIdx = m.addType(Module::ft(1, p, 0, NULL));
+    Emit emit(m); em = &emit;
+    declareLocals();
+    invalidateAll();
+
+    bool useTemplates = (nanobox_jit_level >= 2) && mode64;
+    // prologue: base = RIP - ilen(0); ic0 = icount; upl = user_pl
+    // (region: the call argument is an entry descriptor {region, block, delta}: base = RIP - delta,
+    //  the dispatch starts at `block`)
+    em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR gen_reg[BX_64BIT_REG_RIP].rrx), 3);
+    if (reg) {
+      em->get(L_i); em->mem(I32_LOAD, 0, 2); em->set(L_regp);
+      em->get(L_i); em->mem(I32_LOAD, 4, 2); em->set(L_cur);
+      em->get(L_i); em->mem(I32_LOAD, 8, 2); em->op(I64_EXTEND_I32_S); em->op(I64_SUB); em->set(L_base); // delta is signed (blocks in the previous page)
+    } else {
+      em->i64c(ins[0].ilen()); em->op(I64_SUB); em->set(L_base);
+    }
+    em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR icount), 3); em->set(L_ic0);
+    em->i32c(0); em->mem(I32_LOAD8_U, ADDR(BX_CPU_THIS_PTR user_pl), 0); em->set(L_upl);
+    // Does the trace branch back to its own start? Then compile it as a loop (see emitLoopBack).
+    // (regions: back-edges are ordinary in-region transitions through the dispatch loop)
+    selfLoopOK = useTemplates && !reg;
+    bool hasSelfBranch = false;
+    if (selfLoopOK) {
+      for (unsigned k = 0; k < n; k++) {
+        unsigned ia = ins[k].getIaOpcode();
+        bool isJ = false;
+        switch (ia) {
+          case BX_IA_JMP_Jq: case BX_IA_JMP_Jbq:
+          case BX_IA_JO_Jq: case BX_IA_JNO_Jq: case BX_IA_JB_Jq: case BX_IA_JNB_Jq: case BX_IA_JZ_Jq: case BX_IA_JNZ_Jq:
+          case BX_IA_JBE_Jq: case BX_IA_JNBE_Jq: case BX_IA_JS_Jq: case BX_IA_JNS_Jq: case BX_IA_JP_Jq: case BX_IA_JNP_Jq:
+          case BX_IA_JL_Jq: case BX_IA_JNL_Jq: case BX_IA_JLE_Jq: case BX_IA_JNLE_Jq:
+          case BX_IA_JO_Jbq: case BX_IA_JNO_Jbq: case BX_IA_JB_Jbq: case BX_IA_JNB_Jbq: case BX_IA_JZ_Jbq: case BX_IA_JNZ_Jbq:
+          case BX_IA_JBE_Jbq: case BX_IA_JNBE_Jbq: case BX_IA_JS_Jbq: case BX_IA_JNS_Jbq: case BX_IA_JP_Jbq: case BX_IA_JNP_Jbq:
+          case BX_IA_JL_Jbq: case BX_IA_JNL_Jbq: case BX_IA_JLE_Jbq: case BX_IA_JNLE_Jbq: isJ = true; break;
+        }
+        if (isJ && (Bit64s)(Bit32s) ins[k].Id() + (Bit64s) off[k + 1] == 0) hasSelfBranch = true;
+      }
+    }
+    linkOK = useTemplates && !nanobox_dbg_mode;
+    if (linkOK) { blk(); bodyDepth = depth; }
+    if (useTemplates) {
+      // BX_NEXT_INSTR checks async_event after *every* instruction, so a trace entered with a
+      // pending async event (e.g. right after STI) executes exactly one instruction. Templates
+      // only check after instructions that can raise events, so handle that case up front by
+      // running the first instruction through its handler (which returns after one step).
+      em->i32c(0); em->mem(I32_LOAD, ADDR(BX_CPU_THIS_PTR async_event), 2);
+      CacheState s0 = snapshot();
+      iff();
+      if (reg) {
+        // one stub per possible entry block
+        uint32_t targets[NB_REGION_MAX_BLOCKS];
+        for (unsigned j = 0; j < reg->nblocks; j++) { blk(); targets[j] = j; }
+        em->get(L_cur); em->br_table(targets, reg->nblocks, reg->nblocks - 1);
+        for (unsigned j = 0; j < reg->nblocks; j++) {
+          endb();
+          setBlock(j); csReset();
+          emitHandlerStep(0, n == 1); em->ret();
+        }
+        setBlock(0); csReset();
+      } else {
+        emitHandlerStep(0, n == 1); em->ret();
+      }
+      endb();
+      restore(s0);
+    }
+    if (hasSelfBranch) {
+      loopWanted = true;
+      // loop header: header registers/flags are loaded here and considered dirty
+      bool anyHeader = false;
+      for (unsigned r = 0; r < 16; r++) if (headerReg[r]) { regEnsureLoaded(r); cs.regDirty[r] = true; anyHeader = true; }
+      if (headerLf) { lfLoad(); cs.lfDirty = true; }
+      (void) anyHeader;
+      lp(); loopDepth = depth;
+    }
+    if (reg) {
+      if (nanobox_dbg_mode) { em->i32c(0); em->get(L_regp); em->get(L_cur); em->i32c(4); em->op(I32_MUL); em->op(I32_ADD); em->mem(I32_LOAD, REGION_OFF(entptr[0]), 2); em->mem(I32_STORE, ADDR(nanobox_dbg_cur_entry), 2); }
+      if (regionPass2) {
+        // region entry: the entry block expects its D_j in locals; entry block is dynamic -> one
+        // conform stub per block (each ends by falling into the dispatch loop with L_cur set)
+        blk(); // E
+        uint32_t targets[NB_REGION_MAX_BLOCKS];
+        for (unsigned j = 0; j < reg->nblocks; j++) { blk(); targets[j] = j; }
+        em->get(L_cur); em->br_table(targets, reg->nblocks, reg->nblocks - 1);
+        for (unsigned j = 0; j < reg->nblocks; j++) {
+          endb();
+          csReset(); conformTo(j); em->br(reg->nblocks - 1 - j); // to E
+        }
+        endb(); // E
+        csReset();
+      }
+      // dispatch loop: block bodies live between the ends of nested labels; br_table selects
+      lp(); dispatchDepth = depth;
+      uint32_t targets[NB_REGION_MAX_BLOCKS];
+      for (unsigned j = 0; j < reg->nblocks; j++) { blk(); targets[j] = j; }
+      em->get(L_cur); em->br_table(targets, reg->nblocks, reg->nblocks - 1);
+      for (unsigned j = 0; j < reg->nblocks; j++) {
+        endb();               // closes label j: block j's body follows
+        setBlock(j); needAsyncCheck = false;
+        if (regionPass2) csSetEntry(j); else { csReset(); for (unsigned r = 0; r < 16; r++) usedReg[r] = false; usedLf = false; }
+        computeFlagLiveness();
+        if (!compileBlockBody(useTemplates)) return false;
+        if (!regionPass2) { for (unsigned r = 0; r < 16; r++) blockUsedReg[j][r] = usedReg[r]; blockUsedLf[j] = usedLf; }
+        em->ret();            // a body always ends with an exit/transition; this only closes the type
+      }
+      endb(); dispatchDepth = -1;    // the loop
+    } else {
+      computeFlagLiveness();
+      if (!compileBlockBody(useTemplates)) return false;
+    }
+    if (hasSelfBranch) { em->ret(); endb(); loopDepth = -1; }
+    if (linkOK) { em->ret(); endb(); bodyDepth = -1; em->i32c(0); em->i32c((int32_t) nanobox_link_fn); em->return_call_indirect(m.funcTypeIdx); }
+    return true;
+  }
+  // ---- merged stack runs (experiment, nanobox_jit_merge): N consecutive register pushes (or pops)
+  // become one span check + one TLB probe + one write-stamp check + N plain stores (loads) and one
+  // RSP update. Anything the fast path cannot guarantee to be equivalent to N individual
+  // instructions (span crossing a page, alignment-check-relevant misalignment, TLB miss, a stack
+  // page carrying code marks, POP into RSP) deopts to the interpreter at the FIRST instruction of
+  // the run, which then executes the run instruction by instruction with Bochs' exact semantics.
+  bool isRegPush(unsigned k) { unsigned ia = ins[k].getIaOpcode(); return (ia == BX_IA_PUSH_Eq && ins[k].modC0()) || ia == BX_IA_PUSH_Op64_Id || ia == BX_IA_PUSH_Op64_sIb; }
+  bool isRegPop(unsigned k) { return ins[k].getIaOpcode() == BX_IA_POP_Eq && ins[k].modC0() && ins[k].dst() != R_RSP; }
+  unsigned stackRunLen(unsigned k) {
+    if (!nanobox_jit_merge || !mode64) return 0;
+    unsigned cnt = 0;
+    if (isRegPush(k)) { while (k + cnt < n && cnt < 8 && isRegPush(k + cnt)) cnt++; }
+    else if (isRegPop(k)) { while (k + cnt < n && cnt < 8 && isRegPop(k + cnt)) cnt++; }
+    return cnt >= 2 ? cnt : 0;
+  }
+  bool emitStackRun(unsigned k, unsigned cnt) {
+    bool push = isRegPush(k);
+    unsigned span = 8 * cnt;
+    uint32_t rsp0 = T[6], la = T[7];   // T[5] is used by the per-instruction slow paths below
+    regGet(R_RSP); em->set(rsp0);
+    if (push) { em->get(rsp0); em->i64c(span); em->op(I64_SUB); em->set(la); } else { em->get(rsp0); em->set(la); }
+    for (unsigned i = 0; i < cnt; i++) if (ins[k + i].getIaOpcode() == BX_IA_PUSH_Eq) regEnsureLoaded(ins[k + i].dst());
+    CacheState s0 = snapshot();
+    blk();   // F: done
+     blk();  // P: any failed condition lands after this block -> per-instruction slow path
+      // whole span inside one page; qword aligned as far as the alignment-check mask cares
+      em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->i32c(0x1000 - span); em->op(I32_GT_U); em->br_if(0);
+      acmGet(); em->get(la); em->i64c(7); em->op(I64_AND); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0);
+      tlbProbe(la, 8, push ? 4 : 1, 0);
+      if (push) { em->get(C_free); em->op(I32_EQZ); em->br_if(0); } // stack page carries code marks: per-instruction path does the SMC dance
+      for (unsigned i = 0; i < cnt; i++) {
+        unsigned kk = k + i;
+        if (push) {
+          // push i writes at rsp0 - 8(i+1) = la + 8(cnt-1-i)
+          pushHostAddr(la); if (cnt - 1 - i) { em->i32c(8 * (cnt - 1 - i)); em->op(I32_ADD); }
+          if (ins[kk].getIaOpcode() == BX_IA_PUSH_Eq) regGet(ins[kk].dst()); else em->i64c((Bit64s)(Bit32s) ins[kk].Id());
+          em->mem(I64_STORE, 0, 0);
+        } else {
+          pushHostAddr(la); if (i) { em->i32c(8 * i); em->op(I32_ADD); }
+          em->mem(I64_LOAD, 0, 0); regSetFromStack(ins[kk].dst());
+        }
+      }
+      if (push) { em->get(la); regSetFromStack(R_RSP); } else { em->get(rsp0); em->i64c(span); em->op(I64_ADD); regSetFromStack(R_RSP); }
+      em->br(1);
+     endb();
+     CacheState sFast = snapshot();
+     restore(s0);
+     // slow path: the run instruction by instruction through Bochs' stack accessors (exact
+     // semantics incl. #PF / #SS / SMC), RIP/icount committed before each one
+     profSlow();
+     for (unsigned i = 0; i < cnt; i++) {
+       unsigned kk = k + i;
+       syncBefore(kk, false);
+       if (push) {
+         em->get(rsp0); em->i64c(8 * (i + 1)); em->op(I64_SUB); em->set(T[5]);
+         em->get(T[5]);
+         if (ins[kk].getIaOpcode() == BX_IA_PUSH_Eq) regGet(ins[kk].dst()); else em->i64c((Bit64s)(Bit32s) ins[kk].Id());
+         em->call(fn(FNIDX(&BX_CPU_C::stack_write_qword), "ll>v"));
+         em->get(T[5]); regSetFromStack(R_RSP);
+       } else {
+         em->get(rsp0); if (i) { em->i64c(8 * i); em->op(I64_ADD); }
+         em->call(fn(FNIDX(&BX_CPU_C::stack_read_qword), "l>l"));
+         regSetFromStack(ins[kk].dst());
+         em->get(rsp0); em->i64c(8 * (i + 1)); em->op(I64_ADD); regSetFromStack(R_RSP);
+       }
+     }
+    endb();
+    // both paths must leave the same compile-time cache state (they touch the same registers)
+    if (memcmp(&sFast, &cs, sizeof cs) != 0) return false;
+    needAsyncCheck = true;
+    for (unsigned i = 0; i < cnt; i++) nanobox_inline_count[ins[k + i].getIaOpcode()]++;
+    return true;
+  }
+  bool compileBlockBody(bool useTemplates) {
+    for (unsigned k = 0; k < n; k++) {
+      if (m.importsFull()) return false;
+      bool last = (k + 1 == n);
+      bool done = false;
+      needAsyncCheck = false;
+      flagsLive = !flagsDead[k];
+      if (useTemplates) {
+        unsigned run = stackRunLen(k);
+        if (run) {
+          bool runLast = (k + run == n);
+          if (!emitStackRun(k, run)) return false;
+          k += run - 1;
+          if (runLast) exitFallthroughOrTransition(k);
+          continue;
+        }
+      }
+      if (useTemplates) {
+        uint32_t mark = m.code.n;
+        if (nanobox_jit_level >= 3) { // profiling mode: count executed inline instructions per opcode
+          Bit64u *ctr = &nanobox_dyn_inline[ins[k].getIaOpcode()];
+          em->i32c(0); em->i32c(0); em->mem(I64_LOAD, ADDR(*ctr), 3); em->i64c(1); em->op(I64_ADD); em->mem(I64_STORE, ADDR(*ctr), 3);
+        }
+        // each template runs inside its own block so it can `br` out of itself
+        // (used by the CL-count shifts when count == 0)
+        blk();
+        done = emitTemplate(k, last);
+        endb();
+        if (!done) m.code.n = mark; // template declined before emitting anything: drop the wrapper
+        if (done) {
+          nanobox_inline_count[ins[k].getIaOpcode()]++;
+          if (needAsyncCheck) {
+            // an instruction that may have raised an async event (MMIO, SMC, ...) ends the trace
+            // after completing, exactly like BX_NEXT_INSTR's check
+            em->i32c(0); em->mem(I32_LOAD, ADDR(BX_CPU_THIS_PTR async_event), 2);
+            CacheState s = snapshot();
+            iff(); exitFallthrough(k); endb();
+            restore(s);
+          }
+        }
+      }
+      if (!done) {
+        if (nanobox_jit_level >= 3) {
+          Bit64u *ctr = &nanobox_dyn_fallback[ins[k].getIaOpcode()];
+          em->i32c(0); em->i32c(0); em->mem(I64_LOAD, ADDR(*ctr), 3); em->i64c(1); em->op(I64_ADD); em->mem(I64_STORE, ADDR(*ctr), 3);
+        }
+        emitHandlerStep(k, last);
+        nanobox_fallback_count[ins[k].getIaOpcode()]++;
+      } else if (last) {
+        exitFallthroughOrTransition(k);
+      }
+    }
+    return true;
+  }
+};
+
+} // namespace
+
+/////////////////////////////////////////////////////////////////////////
+// Compiled-trace cache. iCache entries are short-lived (the trace pool wraps every ~600K decoded
+// instructions and every entry is a direct-mapped slot), but the code they hold is not: the same
+// bytes get decoded into the same instruction stream again and again. Compiled functions are
+// therefore owned by this cache, keyed by a hash of the decoded instructions, and handed back to
+// any entry that decodes the same trace — no threshold wait, no recompilation.
+/////////////////////////////////////////////////////////////////////////
+#define JITCACHE_SIZE (1u << 18)
+#define JITCACHE_LIMIT (JITCACHE_SIZE / 2)
+struct JitCacheEntry { Bit64u key; Bit32u fn; Bit32u len; Bit32u mask; Region *region; }; // mask/region: only for region translations
+static JitCacheEntry jitcache[JITCACHE_SIZE];
+static unsigned jitcache_count = 0;
+static Bit64u jitcache_hits = 0, jitcache_clears = 0;
+
+static Bit64u nanobox_jit_hash(bxICacheEntry_c *e, unsigned &nreal)
+{
+  Bit64u h = 0xcbf29ce484222325ull ^ (nanobox_jit_level * 0x9E3779B97F4A7C15ull);
+  nreal = 0;
+  for (unsigned k = 0; k < e->tlen; k++) {
+    if (e->i[k].getIaOpcode() == BX_INSERTED_OPCODE) break;
+    nreal++;
+    // 8 bytes at a time (bxInstruction_c is a multiple of 8 bytes)
+    const Bit64u *p = (const Bit64u *) &e->i[k];
+    for (unsigned w = 0; w < sizeof(bxInstruction_c) / 8; w++) { h ^= p[w]; h *= 0x100000001b3ull; h ^= h >> 29; }
+  }
+  h ^= nreal;
+  return h ? h : 1;
+}
+static JitCacheEntry *nanobox_jit_cache_slot(Bit64u key)
+{
+  unsigned idx = (unsigned)(key ^ (key >> 29)) & (JITCACHE_SIZE - 1);
+  for (unsigned probe = 0; probe < JITCACHE_SIZE; probe++) {
+    JitCacheEntry *c = &jitcache[(idx + probe) & (JITCACHE_SIZE - 1)];
+    if (c->key == key || c->key == 0) return c;
+  }
+  return NULL;
+}
+static void nanobox_jit_batch_drop(void);
+static void nanobox_jit_cache_clear(void);
+static void nanobox_jit_cache_clear(void)
+{
+  nanobox_jit_batch_drop();
+  hook_release_all();
+  nanobox_link_fn = 0;
+  for (unsigned i = 0; i < JITCACHE_SIZE; i++) if (jitcache[i].region) delete jitcache[i].region;
+  memset(jitcache, 0, sizeof(jitcache));
+  jitcache_count = 0;
+  jitcache_clears++;
+  // every iCache entry pointing at released code must forget it
+  for (unsigned n = 0; n < BxICacheEntries; n++) BX_CPU(0)->iCache.entry[n].jitfn = 0;
+}
+NB_EXPORT(nanobox_jit_cache_stat) double nanobox_jit_cache_stat(unsigned which)
+{
+  switch (which) { case 0: return jitcache_count; case 1: return (double) jitcache_hits; case 2: return (double) jitcache_clears; default: return 0; }
+}
+
+/////////////////////////////////////////////////////////////////////////
+// Region formation: BFS over direct successors inside the entry's physical page, using the traces
+// the iCache currently holds (a trace decoded from address X is a function of the code bytes and
+// the CPU mode only, so it is exactly the trace the interpreter runs from X).
+/////////////////////////////////////////////////////////////////////////
+unsigned nanobox_jit_region_max = NB_REGION_MAX_BLOCKS;   // regions on by default (--jit-region 1 turns them off) (nanobox_set_jit_region / --jit-region N / page ?region=N) until registers stay live across in-region transitions (TASKS.md A3): without that they do not beat plain traces on the kernel-heavy startups
+NB_EXPORT(nanobox_set_jit_region) void nanobox_set_jit_region(unsigned maxBlocks) { nanobox_jit_region_max = maxBlocks; }
+static Bit64u nanobox_region_stats[4]; // formed, blocks, compiled, cache hits
+NB_EXPORT(nanobox_jit_region_stat) double nanobox_jit_region_stat(unsigned i) { return i < 4 ? (double) nanobox_region_stats[i] : 0; }
+
+static unsigned nanobox_real_len(const bxICacheEntry_c *e)
+{
+  unsigned n = 0;
+  for (; n < e->tlen; n++) if (e->i[n].getIaOpcode() == BX_INSERTED_OPCODE) break;
+  return n;
+}
+static bool nanobox_direct_targets(const bxICacheEntry_c *e, unsigned n, Bit32u boff, Bit64s *t, unsigned &nt)
+{
+  // successors of the trace (offsets relative to the region entry); false if the trace ends
+  // with something whose successor is dynamic
+  nt = 0;
+  Bit32u len = 0; for (unsigned k = 0; k < n; k++) len += e->i[k].ilen();
+  const bxInstruction_c *l = &e->i[n - 1];
+  Bit64s fall = (Bit64s) boff + len;
+  Bit64s rel = (Bit64s)(Bit32s) l->Id();
+  switch (l->getIaOpcode()) {
+    case BX_IA_JMP_Jq: case BX_IA_JMP_Jbq: t[nt++] = fall + rel; return true;
+    case BX_IA_CALL_Jq: return true; // a region is one function: it ends at calls (the callee gets its own region)
+    case BX_IA_JO_Jq: case BX_IA_JNO_Jq: case BX_IA_JB_Jq: case BX_IA_JNB_Jq: case BX_IA_JZ_Jq: case BX_IA_JNZ_Jq:
+    case BX_IA_JBE_Jq: case BX_IA_JNBE_Jq: case BX_IA_JS_Jq: case BX_IA_JNS_Jq: case BX_IA_JP_Jq: case BX_IA_JNP_Jq:
+    case BX_IA_JL_Jq: case BX_IA_JNL_Jq: case BX_IA_JLE_Jq: case BX_IA_JNLE_Jq:
+    case BX_IA_JO_Jbq: case BX_IA_JNO_Jbq: case BX_IA_JB_Jbq: case BX_IA_JNB_Jbq: case BX_IA_JZ_Jbq: case BX_IA_JNZ_Jbq:
+    case BX_IA_JBE_Jbq: case BX_IA_JNBE_Jbq: case BX_IA_JS_Jbq: case BX_IA_JNS_Jbq: case BX_IA_JP_Jbq: case BX_IA_JNP_Jbq:
+    case BX_IA_JL_Jbq: case BX_IA_JNL_Jbq: case BX_IA_JLE_Jbq: case BX_IA_JNLE_Jbq:
+      t[nt++] = fall + rel; t[nt++] = fall; return true;
+    case BX_IA_RET_Op64: case BX_IA_RET_Op64_Iw: case BX_IA_RETF_Op64: case BX_IA_RETF_Op64_Iw: case BX_IA_JMP_Eq: case BX_IA_CALL_Eq:
+    case BX_IA_JMPF_Op64_Ep: case BX_IA_CALLF_Op64_Ep: case BX_IA_IRET_Op64: case BX_IA_SYSCALL: case BX_IA_SYSRET: case BX_IA_SYSENTER: case BX_IA_SYSEXIT: case BX_IA_HLT:
+      return true;
+    default:
+      t[nt++] = fall; return true; // trace ended by length/page/other trace-end op: fall-through
+  }
+}
+static Region *nanobox_form_region(bxICacheEntry_c *e)
+{
+  if (nanobox_jit_region_max <= 1) return NULL;
+  unsigned n0 = nanobox_real_len(e);
+  if (n0 == 0) return NULL;
+  bx_phy_address page = e->pAddr & ~(bx_phy_address) 0xfff;
+  Bit32u entryOff = (Bit32u)(e->pAddr & 0xfff);
+  Region *r = new Region();
+  unsigned totalInstr = 0;
+  // the entry's linear address (cpu_loop calls us right after RIP += ilen(first)): needed to find
+  // the physical page behind the adjacent linear page through the ITLB
+  bx_address entryLin = RIP - e->i[0].ilen();
+  // BFS
+  bxICacheEntry_c *src[NB_REGION_MAX_BLOCKS]; Bit32s boffs[NB_REGION_MAX_BLOCKS];
+  src[0] = e; boffs[0] = 0; unsigned nb = 1, head = 0;
+  while (head < nb) {
+    bxICacheEntry_c *be = src[head]; Bit32s bo = boffs[head]; head++;
+    unsigned n = nanobox_real_len(be);
+    if (n == 0) { delete r; return NULL; }
+    Bit64s t[2]; unsigned nt;
+    if (!nanobox_direct_targets(be, n, bo, t, nt)) continue;
+    for (unsigned q = 0; q < nt && nb < nanobox_jit_region_max && nb < NB_REGION_MAX_BLOCKS; q++) {
+      Bit64s roff = t[q];
+      Bit64s pageOff = (Bit64s) entryOff + roff;
+      bx_phy_address bpage = page;
+      if (pageOff < 0 || pageOff >= 4096) {
+        // one adjacent page allowed (functions straddling a boundary)
+        int delta = pageOff < 0 ? -1 : 1;
+        if (pageOff < -4096 || pageOff >= 8192) continue;
+        if (r->ppf2 == 0) {
+          bx_address lin2 = (entryLin & ~(bx_address) 0xfff) + (bx_address)((Bit64s) delta * 4096);
+          bx_TLB_entry *tl = BX_ITLB_ENTRY_OF(lin2);
+          if (tl->lpf != LPFOf(lin2) || !(tl->accessBits & (1u << BX_CPU_THIS_PTR user_pl))) continue; // not mapped/executable now
+          r->ppf2 = tl->ppf >> 12; r->pageDelta = delta;
+        } else if (delta != r->pageDelta) continue;
+        bpage = (bx_phy_address) r->ppf2 << 12;
+        pageOff -= (Bit64s) delta * 4096;
+      }
+      bool dup = false; for (unsigned j = 0; j < nb; j++) if ((Bit64s) boffs[j] == roff) { dup = true; break; }
+      if (dup) continue;
+      bx_phy_address pa = bpage + (bx_phy_address) pageOff;
+      bxICacheEntry_c *se = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+      if (se->pAddr != pa || se->tlen == 0) continue;       // not decoded (never executed yet, or evicted)
+      unsigned sn = nanobox_real_len(se);
+      if (sn == 0 || sn > nanobox_jit_maxlen) continue;
+      if (totalInstr + sn > NB_REGION_MAX_INSTR) continue;
+      // a trace that branches back to its own start is better off as a single-trace loop (registers
+      // stay in locals across iterations); inside a region it would go through the dispatch loop
+      { Bit64s st[2]; unsigned snt; nanobox_direct_targets(se, sn, 0, st, snt); bool self = false; for (unsigned q2 = 0; q2 < snt; q2++) if (st[q2] == 0) self = true; if (self) continue; }
+      totalInstr += sn;
+      src[nb] = se; boffs[nb] = (Bit32s) roff; nb++;
+    }
+  }
+  if (nb == 1) { delete r; return NULL; }
+  r->nblocks = nb;
+  for (unsigned j = 0; j < nb; j++) {
+    RegionBlock &b = r->b[j];
+    bool other = ((Bit64s) entryOff + boffs[j] < 0) || ((Bit64s) entryOff + boffs[j] >= 4096);
+    if (other) r->mask2 |= src[j]->traceMask;
+    b.ent = *src[j];
+    b.n = nanobox_real_len(src[j]);
+    // copy the whole trace incl. the inserted end marker (the fingerprint logger prints tlen entries)
+    b.ins = new bxInstruction_c[src[j]->tlen];
+    memcpy(b.ins, src[j]->i, src[j]->tlen * sizeof(bxInstruction_c));
+    b.ent.i = b.ins; b.ent.tlen = src[j]->tlen; b.ent.jitfn = 0; b.ent.hot = 0; b.ent.jitarg = 0;
+    b.boff = boffs[j];
+    if (!other) r->mask |= src[j]->traceMask;
+    r->insptr[j] = b.ins; r->entptr[j] = &b.ent;
+    r->srcEntry[j] = src[j]; r->srcI[j] = src[j]->i;
+    r->entry[j].reg = r; r->entry[j].block = j; r->entry[j].delta = (Bit32u)(Bit32s)(boffs[j] + (Bit32s) src[j]->i[0].ilen());
+  }
+  if (r->nblocks == 0) { delete r; return NULL; }
+  // no second-page block actually made it in? then it is a plain one-page region
+  if (r->mask2 == 0) { r->ppf2 = 0; r->pageDelta = 0; }
+  // an entry that branches back to its own start is better off as a single-trace loop
+  { Bit64s t[2]; unsigned nt; nanobox_direct_targets(e, n0, 0, t, nt); for (unsigned q = 0; q < nt; q++) if (t[q] == 0) { delete r; return NULL; } }
+  // content key: offsets + instructions of every block
+  Bit64u h = 0xcbf29ce484222325ull ^ (nanobox_jit_level * 0x9E3779B97F4A7C15ull) ^ 0x5245474e00000000ull ^ (Bit64u)(r->pageDelta + 2); // 'REGN'
+  for (unsigned j = 0; j < nb; j++) {
+    h ^= (Bit64u)(Bit64s) r->b[j].boff * 0x9E3779B97F4A7C15ull; h *= 0x100000001b3ull; h ^= h >> 29;
+    for (unsigned k = 0; k < r->b[j].n; k++) {
+      const Bit64u *p = (const Bit64u *) &r->b[j].ins[k];
+      for (unsigned w = 0; w < sizeof(bxInstruction_c) / 8; w++) { h ^= p[w]; h *= 0x100000001b3ull; h ^= h >> 29; }
+    }
+  }
+  r->key = h ? h : 1;
+  nanobox_region_stats[0]++; nanobox_region_stats[1] += nb;
+  return r;
+}
+// attach a region translation to entry e: widen the entry's SMC mask to the union of the region's
+// blocks so a write to any of them flushes the entry (Bochs' own flushSMC path)
+// Second-page registry: a write into a region's OTHER page must drop the region too. Bochs' own
+// flushSMC only reaches entries hashed in the written page, so keep (page2 -> entry) records and
+// consult them from handleSMC. Records are validated by (entry->pAddr, entry->jitfn) so stale ones
+// are harmless; a full pool is swept, and if still full the JIT cache is cleared.
+struct AttachRec { Bit64u ppage; bxICacheEntry_c *entry; bx_phy_address entryPAddr; unsigned fn; Bit32u mask; int next; };
+enum { NB_ATTACH_POOL = 65536, NB_ATTACH_BUCKETS = 4096 };
+static AttachRec *nb_attach = NULL; static int nb_attach_head[NB_ATTACH_BUCKETS]; static int nb_attach_free = -1; static bool nb_attach_init = false; static unsigned nb_attach_used = 0;
+static void nanobox_attach_pool_init(void)
+{
+  nb_attach = (AttachRec *) calloc(NB_ATTACH_POOL, sizeof(AttachRec));
+  for (int i = 0; i < NB_ATTACH_POOL; i++) nb_attach[i].next = (i + 1 < NB_ATTACH_POOL) ? i + 1 : -1;
+  nb_attach_free = 0;
+  for (int b = 0; b < NB_ATTACH_BUCKETS; b++) nb_attach_head[b] = -1;
+  nb_attach_init = true;
+}
+static bool nanobox_attach_live(const AttachRec &a) { return a.entry->pAddr == a.entryPAddr && a.entry->jitfn == a.fn && a.entry->jitfn != 0; }
+static void nanobox_attach_sweep(void)
+{
+  for (int b = 0; b < NB_ATTACH_BUCKETS; b++) {
+    int *pp = &nb_attach_head[b];
+    while (*pp >= 0) {
+      AttachRec &a = nb_attach[*pp];
+      if (!nanobox_attach_live(a)) { int idx = *pp; *pp = a.next; a.next = nb_attach_free; nb_attach_free = idx; nb_attach_used--; }
+      else pp = &a.next;
+    }
+  }
+}
+static void nanobox_attach_page2(bxICacheEntry_c *e, unsigned fn, Region *r, Bit64u otherPage, Bit32u otherMask)
+{
+  if (!nb_attach_init) nanobox_attach_pool_init();
+  if (nb_attach_free < 0) nanobox_attach_sweep();
+  if (nb_attach_free < 0) { nanobox_jit_cache_clear(); return; }   // (clears everything incl. e->jitfn)
+  int idx = nb_attach_free; nb_attach_free = nb_attach[idx].next; nb_attach_used++;
+  AttachRec &a = nb_attach[idx];
+  a.ppage = otherPage; a.entry = e; a.entryPAddr = e->pAddr; a.fn = fn; a.mask = otherMask;
+  unsigned b = (unsigned)(otherPage * 0x9E3779B97F4A7C15ull >> 52) & (NB_ATTACH_BUCKETS - 1);
+  a.next = nb_attach_head[b]; nb_attach_head[b] = idx;
+  pageWriteStampTable.markICacheMask((bx_phy_address) otherPage << 12, otherMask);
+  (void) r;
+}
+// called from handleSMC() for every write into a page that carries code marks
+void nanobox_jit_page_written(bx_phy_address pAddr, Bit32u mask)
+{
+  if (!nb_attach_init || nb_attach_used == 0) return;
+  Bit64u pp = pAddr >> 12;
+  unsigned b = (unsigned)(pp * 0x9E3779B97F4A7C15ull >> 52) & (NB_ATTACH_BUCKETS - 1);
+  int *ptr = &nb_attach_head[b];
+  while (*ptr >= 0) {
+    AttachRec &a = nb_attach[*ptr];
+    if (a.ppage == pp && (a.mask & mask)) {
+      if (nanobox_attach_live(a)) { a.entry->jitfn = 0; a.entry->hot = 0; }
+      int idx = *ptr; *ptr = a.next; a.next = nb_attach_free; nb_attach_free = idx; nb_attach_used--;
+    } else ptr = &a.next;
+  }
+}
+// attach one member entry: jitarg = its entry descriptor; SMC mask widened to the union of the
+// blocks in ITS page; if the region has a second page, register it there too
+static void nanobox_region_attach_entry(bxICacheEntry_c *se, unsigned j, unsigned fn, Region *r)
+{
+  se->jitfn = fn; se->jitarg = (Bit32u)(uintptr_t) &r->entry[j];
+  bool other = r->ppf2 && ((se->pAddr >> 12) == r->ppf2);
+  Bit32u m = other ? r->mask2 : r->mask;
+  if (m & ~se->traceMask) { se->traceMask |= m; pageWriteStampTable.markICacheMask(se->pAddr, se->traceMask); }
+  if (r->ppf2) {
+    // a write into the OTHER page must drop this entry too (Bochs' flushSMC only scans entries of the written page)
+    Bit64u otherPage = other ? (r->b[0].ent.pAddr >> 12) : r->ppf2;
+    nanobox_attach_page2(se, fn, r, otherPage, other ? r->mask : r->mask2);
+  }
+}
+// attach the region to entry e (block 0 or whichever block e is) and to every other member block
+// whose iCache entry still holds the same trace (validated by pAddr + instruction pointer, or by
+// content when the region came from the cache/bundle and the entries are looked up by address)
+static void nanobox_region_attach(bxICacheEntry_c *e, unsigned fn, Bit32u mask, Region *r)
+{
+  (void) mask;
+  bx_phy_address page0 = e->pAddr - (bx_phy_address)(Bit64s) 0; // e is block 0 when attaching a fresh/cached region
+  // find which block e is (block 0 normally)
+  unsigned je = 0;
+  for (unsigned j = 0; j < r->nblocks; j++) if (r->srcEntry[j] == e) { je = j; break; }
+  bx_phy_address entryPA = e->pAddr; Bit32s entryOff = (Bit32s)(entryPA & 0xfff) - r->b[je].boff; // page offset of block 0
+  page0 = (entryPA & ~(bx_phy_address) 0xfff);
+  for (unsigned j = 0; j < r->nblocks; j++) {
+    bxICacheEntry_c *se;
+    Bit64s pageOff = (Bit64s) entryOff + r->b[j].boff;
+    bx_phy_address pa;
+    if (pageOff >= 0 && pageOff < 4096) pa = page0 + (bx_phy_address) pageOff;
+    else if (r->ppf2) pa = ((bx_phy_address) r->ppf2 << 12) + (bx_phy_address)(pageOff - (Bit64s) r->pageDelta * 4096);
+    else continue;
+    se = (j == je) ? e : BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+    if (se->pAddr != pa || se->tlen != r->b[j].ent.tlen) continue;
+    if (se != e && memcmp(se->i, r->b[j].ins, se->tlen * sizeof(bxInstruction_c)) != 0) continue; // a different trace lives there now
+    if (se->jitfn && se != e) continue; // already has its own translation
+    nanobox_region_attach_entry(se, j, fn, r);
+  }
+}
+
+// called by serveICacheMiss() once a trace has been decoded into `e`
+void nanobox_jit_after_decode(bxICacheEntry_c *e)
+{
+  e->hot = 0;
+  if (!nanobox_jit_level || nanobox_dbg_mode) return;
+  unsigned nreal;
+  Bit64u key = nanobox_jit_hash(e, nreal);
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  if (c && c->key == key && !c->region) { e->jitfn = c->fn; e->jitarg = (Bit32u)(uintptr_t) e->i; jitcache_hits++; }
+}
+
+
+/////////////////////////////////////////////////////////////////////////
+// Compile driver with batching. Hot traces are compiled into a shared module as they show up and
+// the module is handed to the host once it holds NB_BATCH functions (or has waited long enough):
+// V8's per-module cost (~60-100 us) then amortises over the batch, and the shared link function
+// keeps every function small.
+/////////////////////////////////////////////////////////////////////////
+enum { NB_BATCH = 32, NB_BATCH_MAX_TRACES_WAIT = 20000 };
+struct Pending { bxICacheEntry_c *e; bx_phy_address pAddr; bxInstruction_c *i; Region *reg; Bit64u key; unsigned local; };
+static Module *nb_batch = NULL;
+static Pending nb_pending[NB_BATCH];
+static unsigned nb_npending = 0;
+static Bit64u nb_batch_since = 0;
+static Bit64u nanobox_batch_stats[3]; // batches flushed, functions, stale entries at flush
+
+// does the host implement install_batch? (probe once: len 0 / nfuncs 0 -> a host answers 1, the placeholder 0)
+static int nb_batch_cap = -1;
+static bool nanobox_batching(void)
+{
+  if (nanobox_dbg_mode) return false;
+  if (nb_batch_cap < 0) nb_batch_cap = hook_install_batch(NULL, 0, NULL, 0, 0, NULL) ? 1 : 0;
+  return nb_batch_cap == 1;
+}
+
+// The link function's table index is baked into every trace module, so a pre-computed bundle is
+// only valid together with the link function it was recorded with: the host pins it under the
+// reserved content key LINK_KEY (ffffffff:ffffffff) — ask before installing, tell after.
+static bool nanobox_ensure_link_fn(void)
+{
+  if (nanobox_link_fn || nanobox_dbg_mode) return true;
+  unsigned pre = hook_lookup(0xffffffffu, 0xffffffffu);
+  if (pre) { nanobox_link_fn = pre; return true; }
+  Module lm;
+  static bxICacheEntry_c dummy;
+  TraceCompiler tc(&dummy, lm);
+  tc.emitLinkFn();
+  Buf bytes; lm.finish(bytes);
+  nanobox_link_fn = hook_install(bytes.p, bytes.n, lm.importKeys, lm.nimports);
+  if (nanobox_link_fn) hook_note(nanobox_link_fn, 0xffffffffu, 0xffffffffu);
+  return nanobox_link_fn != 0;
+}
+
+// give (or cache) a translation to entry e
+static void nanobox_jit_attach(bxICacheEntry_c *e, unsigned fn, Region *reg)
+{
+  if (reg) nanobox_region_attach(e, fn, reg->mask, reg); else { e->jitfn = fn; e->jitarg = (Bit32u)(uintptr_t) e->i; }
+}
+static void nanobox_jit_cache_put(Bit64u key, unsigned fn, unsigned len, Region *reg)
+{
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  if (jitcache_count >= JITCACHE_LIMIT || c == NULL) { nanobox_jit_cache_clear(); return; }  // (the fn was released with everything else)
+  if (c->key == key) return;
+  c->key = key; c->fn = fn; c->len = len; c->mask = reg ? reg->mask : 0; c->region = reg; jitcache_count++;
+}
+static void nanobox_jit_batch_drop(void)
+{
+  for (unsigned i = 0; i < nb_npending; i++) if (nb_pending[i].reg) delete nb_pending[i].reg;
+  nb_npending = 0;
+  if (nb_batch) { delete nb_batch; nb_batch = NULL; }
+}
+static void nanobox_jit_batch_flush(void)
+{
+  if (!nb_batch || nb_npending == 0) return;
+  Buf bytes; nb_batch->finish(bytes);
+  unsigned out[NB_BATCH];
+  unsigned ok = hook_install_batch(bytes.p, bytes.n, nb_batch->importKeys, nb_batch->nimports, nb_npending, out);
+  nanobox_batch_stats[0]++;
+  for (unsigned i = 0; i < nb_npending; i++) {
+    Pending &pd = nb_pending[i];
+    if (!ok || out[i] == 0) { if (pd.reg) delete pd.reg; if (pd.e->pAddr == pd.pAddr) pd.e->hot = 0; continue; }
+    unsigned fn = out[i];
+    hook_note(fn, (unsigned)(pd.key & 0xffffffffu), (unsigned)(pd.key >> 32));
+    nanobox_stats.jit_compiled++; nanobox_batch_stats[1]++;
+    if (pd.reg) nanobox_region_stats[2]++;
+    // the entry may have been evicted/re-decoded/flushed while the batch was open
+    if (pd.e->pAddr == pd.pAddr && pd.e->i == pd.i && pd.e->jitfn == 0) nanobox_jit_attach(pd.e, fn, pd.reg);
+    else nanobox_batch_stats[2]++;
+    // (a cache clear inside put releases everything installed so far, including fn: fine)
+    nanobox_jit_cache_put(pd.key, fn, 0, pd.reg);
+    if (jitcache_count == 0) { for (unsigned j = i + 1; j < nb_npending; j++) if (nb_pending[j].reg) delete nb_pending[j].reg; break; }
+  }
+  nb_npending = 0;
+  delete nb_batch; nb_batch = NULL;
+}
+NB_EXPORT(nanobox_jit_batch_stat) double nanobox_jit_batch_stat(unsigned i) { return i < 3 ? (double) nanobox_batch_stats[i] : 0; }
+NB_EXPORT(nanobox_jit_flush_batch) void nanobox_jit_flush_batch(void) { nanobox_jit_batch_flush(); }
+
+// try to give e a translation for (reg, key) without compiling: in-process cache or host bundle
+static bool nanobox_jit_try_cached(bxICacheEntry_c *e, Region *reg, Bit64u key)
+{
+  if (nanobox_dbg_mode) return false;
+  JitCacheEntry *c = nanobox_jit_cache_slot(key);
+  if (c && c->key == key) {
+    if (c->region && reg && c->region->ppf2 && c->region->ppf2 != reg->ppf2) return false; // same code, other second page: needs its own descriptor -> compile
+    if (c->region) nanobox_region_attach(e, c->fn, c->mask, c->region); else { e->jitfn = c->fn; e->jitarg = (Bit32u)(uintptr_t) e->i; }
+    jitcache_hits++; if (reg) { nanobox_region_stats[3]++; delete reg; }
+    return true;
+  }
+  // pre-computed translation (bundle)? modules are position independent (the region descriptor
+  // travels in the call argument), so a bundle hit is attached exactly like a fresh compile
+  unsigned pre = hook_lookup((unsigned)(key & 0xffffffffu), (unsigned)(key >> 32));
+  if (pre) {
+    nanobox_jit_attach(e, pre, reg);
+    nanobox_jit_cache_put(key, pre, 0, reg);
+    if (jitcache_count == 0) { e->jitfn = 0; hook_release(pre); if (reg) delete reg; return true; }
+    if (reg) nanobox_region_stats[3]++;
+    return true;
+  }
+  return false;
+}
+
+// already queued in the open batch?
+static bool nanobox_jit_pending(bxICacheEntry_c *e)
+{
+  for (unsigned i = 0; i < nb_npending; i++) if (nb_pending[i].e == e && nb_pending[i].pAddr == e->pAddr) return true;
+  return false;
+}
+
+static bool nanobox_jit_compile_one(bxICacheEntry_c *e, Region *reg, Bit64u key)
+{
+  if (nanobox_jit_try_cached(e, reg, key)) return true;
+  if (!nanobox_ensure_link_fn()) { if (reg) delete reg; return false; }
+  if (!nanobox_batching()) {
+    Module sm;
+    TraceCompiler tc(e, sm);
+    tc.reg = reg;
+    if (!tc.compile()) { if (reg) delete reg; return false; }
+    Buf bytes; sm.finish(bytes);
+    unsigned fn = hook_install(bytes.p, bytes.n, sm.importKeys, sm.nimports);
+    if (fn == 0) { if (reg) delete reg; return false; }
+    hook_note(fn, (unsigned)(key & 0xffffffffu), (unsigned)(key >> 32));
+    nanobox_stats.jit_compiled++;
+    if (reg) nanobox_region_stats[2]++;
+    nanobox_jit_attach(e, fn, reg);
+    if (nanobox_dbg_mode) { nanobox_dbg_compiled(e, fn, bytes.n); return true; }  // dbg mode: no cache (region objects are leaked on purpose)
+    nanobox_jit_cache_put(key, fn, bytes.n, reg);
+    if (jitcache_count == 0) { e->jitfn = 0; }
+    return true;
+  }
+  // batched: compile into the open module, attach at flush time
+  if (!nb_batch) { nb_batch = new Module(); nb_batch_since = nanobox_stats.traces; }
+  nb_batch->beginFunc();
+  TraceCompiler tc(e, *nb_batch);
+  tc.reg = reg;
+  if (!tc.compile()) { nb_batch->beginFunc(); if (reg) delete reg; return false; }
+  unsigned local = nb_batch->endFunc(nb_batch->funcTypeIdx);
+  Pending &pd = nb_pending[nb_npending++];
+  pd.e = e; pd.pAddr = e->pAddr; pd.i = e->i; pd.reg = reg; pd.key = key; pd.local = local;
+  if (nb_npending >= NB_BATCH || nb_batch->funcsFull() || nb_batch->importsFull() || nb_batch->codeSec.n > (1u << 18)) nanobox_jit_batch_flush();
+  return true;
+}
+
+// Page-eager mode (bundle recordings): when a trace gets hot, decode and compile every trace that
+// is statically reachable from it inside the same physical page (branch targets, fall-throughs,
+// callees, call continuations), so a bundle recorded from a run covers whole pages, not only the
+// paths taken. Decoding is host-only (iCache entries), so it does not change guest behaviour.
+unsigned nanobox_jit_eager = 0;
+unsigned nanobox_jit_merge = 0;    // merge runs of register pushes / pops into one probed span (experiment flag)
+NB_EXPORT(nanobox_set_jit_merge) void nanobox_set_jit_merge(unsigned on) { nanobox_jit_merge = on; }
+NB_EXPORT(nanobox_set_jit_eager) void nanobox_set_jit_eager(unsigned on) { nanobox_jit_eager = on; }
+static Bit64u nb_swept[4096]; static unsigned nb_swept_n = 0; static Bit64u nanobox_eager_stats[2];
+NB_EXPORT(nanobox_jit_eager_stat) double nanobox_jit_eager_stat(unsigned i) { return i < 2 ? (double) nanobox_eager_stats[i] : 0; }
+static bool nanobox_page_swept(bx_phy_address page)
+{
+  Bit64u pp = page >> 12;
+  for (unsigned i = 0; i < nb_swept_n; i++) if (nb_swept[i] == pp) return true;
+  if (nb_swept_n < 4096) nb_swept[nb_swept_n++] = pp;
+  return false;
+}
+static void nanobox_jit_maybe_compile_inner(bxICacheEntry_c *e);
+static void nanobox_eager_sweep(bxICacheEntry_c *e)
+{
+  bx_phy_address page = e->pAddr & ~(bx_phy_address) 0xfff;
+  if (nanobox_page_swept(page)) return;
+  // this page is the current fetch page (we are executing e): eipBiased maps its offsets
+  bx_address pageLin = RIP - e->i[0].ilen(); pageLin &= ~(bx_address) 0xfff;
+  if ((BX_CPU_THIS_PTR pAddrFetchPage & ~(bx_phy_address) 0xfff) != page) return;
+  Bit8u seen[4096]; memset(seen, 0, sizeof seen);
+  Bit16u queue[4096]; unsigned qh = 0, qt = 0;
+  queue[qt++] = (Bit16u)(e->pAddr & 0xfff); seen[e->pAddr & 0xfff] = 1;
+  while (qh < qt) {
+    unsigned off = queue[qh++];
+    if (off > 4096 - 16) continue;   // a first instruction that may cross the page would make the decoder fetch the next page (can fault)
+    bx_phy_address pa = page + off;
+    bxICacheEntry_c *se = BX_CPU_THIS_PTR iCache.get_entry(pa, BX_CPU_THIS_PTR fetchModeMask);
+    if (se->pAddr != pa) {
+      Bit32u eipBiased = (Bit32u)((pageLin + off) + BX_CPU_THIS_PTR eipPageBias);
+      se = BX_CPU_THIS_PTR serveICacheMiss(eipBiased, pa);
+      if (!se || se->pAddr != pa) continue;
+      nanobox_eager_stats[0]++;
+    }
+    unsigned n = nanobox_real_len(se);
+    if (n == 0) continue;
+    if (!se->jitfn) { nanobox_jit_maybe_compile_inner(se); nanobox_eager_stats[1]++; }
+    // successors inside the page: direct targets + callee entry + continuation after a call
+    Bit64s t[3]; unsigned nt = 0;
+    nanobox_direct_targets(se, n, 0, t, nt);
+    Bit32u len = 0; for (unsigned k = 0; k < n; k++) len += se->i[k].ilen();
+    const bxInstruction_c *l = &se->i[n - 1];
+    if (l->getIaOpcode() == BX_IA_CALL_Jq) { t[nt++] = (Bit64s) len; t[nt++] = (Bit64s) len + (Bit64s)(Bit32s) l->Id(); }
+    for (unsigned q = 0; q < nt; q++) {
+      Bit64s so = (Bit64s) off + t[q];
+      if (so < 0 || so >= 4096 || seen[so]) continue;
+      seen[so] = 1; if (qt < 4096) queue[qt++] = (Bit16u) so;
+    }
+  }
+}
+
+void nanobox_jit_maybe_compile(bxICacheEntry_c *e)
+{
+  if (e->jitfn) return;
+  nanobox_jit_maybe_compile_inner(e);
+  if (nanobox_jit_eager && !nanobox_dbg_mode) nanobox_eager_sweep(e);
+}
+static void nanobox_jit_maybe_compile_inner(bxICacheEntry_c *e)
+{
+  if (e->jitfn) return;
+  if (nanobox_batching()) {
+    // an entry that is queued keeps calling here (its hot counter stays over the threshold): use
+    // those calls as flush ticks so a small batch does not wait forever
+    if (nb_npending && nanobox_stats.traces - nb_batch_since > NB_BATCH_MAX_TRACES_WAIT) nanobox_jit_batch_flush();
+    if (nanobox_jit_pending(e)) return;
+  }
+  // 1. region (entry + reachable traces in this page), unless the entry loops on itself (the
+  //    single-trace loop compile keeps registers in locals across iterations)
+  Region *reg = nanobox_form_region(e);
+  if (reg) {
+    if (nanobox_jit_try_cached(e, reg, reg->key)) return;
+    // region keys depend on which neighbours the iCache happens to hold; a pre-computed bundle
+    // recorded under other timing may still have the plain trace: prefer that over compiling
+    if (!nanobox_dbg_mode) {
+      unsigned nreal0 = 0; Bit64u tkey = nanobox_jit_hash(e, nreal0);
+      unsigned pre = hook_lookup((unsigned)(tkey & 0xffffffffu), (unsigned)(tkey >> 32));
+      if (pre) { delete reg; nanobox_jit_attach(e, pre, NULL); nanobox_jit_cache_put(tkey, pre, 0, NULL); if (jitcache_count == 0) { e->jitfn = 0; hook_release(pre); } return; }
+    }
+    if (nanobox_jit_compile_one(e, reg, reg->key)) return;
+  }
+  // 2. plain trace
+  unsigned nreal = 0;
+  Bit64u key = nanobox_jit_hash(e, nreal);
+  if (!nanobox_jit_compile_one(e, NULL, key)) e->hot = 0;
+}
+
+void nanobox_jit_entry_invalidate(bxICacheEntry_c *e)
+{
+  // compiled code is owned by the cache (or, in dbg mode, by nobody in particular): just forget it.
+  // (dbg mode used to release the function here; a region function is shared by all its member
+  // entries, so releasing it for one would break the others -> dbg mode simply leaks translations)
+  e->jitfn = 0;
+  e->hot = 0;
+}
+
+void nanobox_jit_flush_all(void)
+{
+  if (nanobox_dbg_mode) hook_release_all();
+}
diff --git a/bochs/nanobox_jit.h b/bochs/nanobox_jit.h
new file mode 100644
index 000000000..881178f18
--- /dev/null
+++ b/bochs/nanobox_jit.h
@@ -0,0 +1,46 @@
+/////////////////////////////////////////////////////////////////////////
+// nanobox trace JIT — public interface used by the CPU loop and the iCache.
+//
+// A JIT-compiled trace is a wasm function `void run(bxInstruction_c *trace)` that performs
+// exactly what Bochs' chained handlers would do for the iCache trace: it is entered after
+// cpu_loop already did `RIP += i->ilen()` for the first instruction, and it returns whenever the
+// handler chain would have returned to cpu_loop (trace end, taken branch / BX_NEXT_TRACE,
+// async_event, or — via longjmp — an exception).
+/////////////////////////////////////////////////////////////////////////
+
+#ifndef NANOBOX_JIT_H
+#define NANOBOX_JIT_H
+
+struct bxICacheEntry_c;
+class bxInstruction_c;
+
+// runtime configuration (set by the host through nanobox.cc exports before the CPU starts)
+extern unsigned nanobox_jit_level;      // 0 = interpreter only, 1 = handler-call JIT, 2+ = templates
+extern unsigned nanobox_jit_threshold;  // executions of a trace before it gets compiled
+
+// interpreter <-> JIT hand-shake (see BX_NEXT_INSTR / BX_NEXT_TRACE in cpu.h)
+extern Bit8u nanobox_single_step;       // 1 while a JIT'd trace single-steps a handler: BX_NEXT_INSTR returns instead of chaining
+extern Bit8u nanobox_trace_end;         // set by BX_NEXT_TRACE so the JIT knows the trace ended
+
+typedef void (*nanobox_jitfn_t)(bxInstruction_c *trace);
+
+void nanobox_jit_maybe_compile(bxICacheEntry_c *e);   // compile e (called by cpu_loop when e got hot)
+void nanobox_jit_entry_invalidate(bxICacheEntry_c *e); // e is being reused/invalidated: drop its code
+void nanobox_jit_flush_all(void);                      // iCache flushed: drop everything
+void nanobox_jit_after_decode(bxICacheEntry_c *e);     // trace freshly decoded: attach cached code
+
+extern unsigned nanobox_dbg_mode;
+extern bxICacheEntry_c *nanobox_dbg_cur_entry;
+extern unsigned nanobox_pages_on;                       // instruction-address profile (nanobox.cc)
+void nanobox_pages_account(Bit64u rip, Bit64u paddr, Bit64u n, unsigned user);
+void nanobox_dbg_trace(bxICacheEntry_c *entry, bool jitted);
+
+BX_CPP_INLINE void nanobox_jit_call(bxICacheEntry_c *e)
+{
+  nanobox_stats.jit_traces++;
+  nanobox_single_step = 1;
+  ((nanobox_jitfn_t)(uintptr_t) e->jitfn)((bxInstruction_c *)(uintptr_t) e->jitarg);
+  nanobox_single_step = 0;
+}
+
+#endif
diff --git a/bochs/nanobox_wasm.h b/bochs/nanobox_wasm.h
new file mode 100644
index 000000000..c6aebdb37
--- /dev/null
+++ b/bochs/nanobox_wasm.h
@@ -0,0 +1,230 @@
+/////////////////////////////////////////////////////////////////////////
+// nanobox: a tiny WebAssembly binary emitter used by the trace JIT.
+//
+// Builds a single-function module:
+//   (import "e" "m" (memory 0))                ; the engine's own linear memory
+//   (import "h" "<k>" (func ...))              ; helper functions (Bochs handlers / runtime)
+//   (func (export "r") (param i32) ...)        ; the compiled trace
+// The host instantiates it against the engine instance and drops the export into the engine's
+// function table so the C++ side can call it through a plain function pointer.
+/////////////////////////////////////////////////////////////////////////
+
+#ifndef NANOBOX_WASM_H
+#define NANOBOX_WASM_H
+
+#include <stdint.h>
+#include <string.h>
+#include <stdlib.h>
+
+namespace nbw {
+
+enum ValType : uint8_t { I32 = 0x7f, I64 = 0x7e, F32 = 0x7d, F64 = 0x7c, EXNREF = 0x69, VOID = 0x40 };
+
+// -- opcodes -----------------------------------------------------------------------------------
+enum Op : uint8_t {
+  UNREACHABLE = 0x00, NOP = 0x01, BLOCK = 0x02, LOOP = 0x03, IF = 0x04, ELSE = 0x05,
+  THROW = 0x08, RETHROW = 0x09, THROW_REF = 0x0a, END = 0x0b, BR = 0x0c, BR_IF = 0x0d, BR_TABLE = 0x0e,
+  RETURN = 0x0f, CALL = 0x10, CALL_INDIRECT = 0x11, RETURN_CALL = 0x12, RETURN_CALL_INDIRECT = 0x13, TRY_TABLE = 0x1f,
+  DROP = 0x1a, SELECT = 0x1b,
+  LOCAL_GET = 0x20, LOCAL_SET = 0x21, LOCAL_TEE = 0x22, GLOBAL_GET = 0x23, GLOBAL_SET = 0x24,
+  I32_LOAD = 0x28, I64_LOAD = 0x29, F32_LOAD = 0x2a, F64_LOAD = 0x2b,
+  I32_LOAD8_S = 0x2c, I32_LOAD8_U = 0x2d, I32_LOAD16_S = 0x2e, I32_LOAD16_U = 0x2f,
+  I64_LOAD8_S = 0x30, I64_LOAD8_U = 0x31, I64_LOAD16_S = 0x32, I64_LOAD16_U = 0x33, I64_LOAD32_S = 0x34, I64_LOAD32_U = 0x35,
+  I32_STORE = 0x36, I64_STORE = 0x37, F32_STORE = 0x38, F64_STORE = 0x39,
+  I32_STORE8 = 0x3a, I32_STORE16 = 0x3b, I64_STORE8 = 0x3c, I64_STORE16 = 0x3d, I64_STORE32 = 0x3e,
+  I32_CONST = 0x41, I64_CONST = 0x42, F32_CONST = 0x43, F64_CONST = 0x44,
+  I32_EQZ = 0x45, I32_EQ = 0x46, I32_NE = 0x47, I32_LT_S = 0x48, I32_LT_U = 0x49, I32_GT_S = 0x4a, I32_GT_U = 0x4b,
+  I32_LE_S = 0x4c, I32_LE_U = 0x4d, I32_GE_S = 0x4e, I32_GE_U = 0x4f,
+  I64_EQZ = 0x50, I64_EQ = 0x51, I64_NE = 0x52, I64_LT_S = 0x53, I64_LT_U = 0x54, I64_GT_S = 0x55, I64_GT_U = 0x56,
+  I64_LE_S = 0x57, I64_LE_U = 0x58, I64_GE_S = 0x59, I64_GE_U = 0x5a,
+  I32_CLZ = 0x67, I32_CTZ = 0x68, I32_POPCNT = 0x69, I32_ADD = 0x6a, I32_SUB = 0x6b, I32_MUL = 0x6c,
+  I32_DIV_S = 0x6d, I32_DIV_U = 0x6e, I32_REM_S = 0x6f, I32_REM_U = 0x70, I32_AND = 0x71, I32_OR = 0x72, I32_XOR = 0x73,
+  I32_SHL = 0x74, I32_SHR_S = 0x75, I32_SHR_U = 0x76, I32_ROTL = 0x77, I32_ROTR = 0x78,
+  I64_CLZ = 0x79, I64_CTZ = 0x7a, I64_POPCNT = 0x7b, I64_ADD = 0x7c, I64_SUB = 0x7d, I64_MUL = 0x7e,
+  I64_DIV_S = 0x7f, I64_DIV_U = 0x80, I64_REM_S = 0x81, I64_REM_U = 0x82, I64_AND = 0x83, I64_OR = 0x84, I64_XOR = 0x85,
+  I64_SHL = 0x86, I64_SHR_S = 0x87, I64_SHR_U = 0x88, I64_ROTL = 0x89, I64_ROTR = 0x8a,
+  I32_WRAP_I64 = 0xa7, I64_EXTEND_I32_S = 0xac, I64_EXTEND_I32_U = 0xad,
+  I32_EXTEND8_S = 0xc0, I32_EXTEND16_S = 0xc1, I64_EXTEND8_S = 0xc2, I64_EXTEND16_S = 0xc3, I64_EXTEND32_S = 0xc4,
+};
+
+// -- growable byte buffer ---------------------------------------------------------------------------
+struct Buf {
+  uint8_t *p; uint32_t n, cap;
+  Buf() : p(NULL), n(0), cap(0) {}
+  ~Buf() { free(p); }
+  void reserve(uint32_t need) {
+    if (n + need <= cap) return;
+    uint32_t c = cap ? cap : 1024;
+    while (c < n + need) c *= 2;
+    p = (uint8_t *) realloc(p, c); cap = c;
+  }
+  void b8(uint32_t b) { reserve(1); p[n++] = (uint8_t) b; }
+  void raw(const void *src, uint32_t len) { reserve(len); memcpy(p + n, src, len); n += len; }
+  void uleb(uint32_t v) { do { uint8_t b = v & 0x7f; v >>= 7; if (v) b |= 0x80; b8(b); } while (v); }
+  void sleb32(int32_t v) { for (;;) { uint8_t b = v & 0x7f; v >>= 7; if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40))) { b8(b); return; } b8(b | 0x80); } }
+  void sleb64(int64_t v) { for (;;) { uint8_t b = v & 0x7f; v >>= 7; if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40))) { b8(b); return; } b8(b | 0x80); } }
+  // 5-byte fixed-width u32 (patchable)
+  void u32_fixed5(uint32_t v) { for (int i = 0; i < 5; i++) { uint8_t b = v & 0x7f; v >>= 7; if (i < 4) b |= 0x80; b8(b); } }
+  void patch_u32_fixed5(uint32_t at, uint32_t v) { for (int i = 0; i < 5; i++) { uint8_t b = v & 0x7f; v >>= 7; if (i < 4) b |= 0x80; p[at + i] = b; } }
+  void clear() { n = 0; }
+};
+
+// -- function types ---------------------------------------------------------------------------------
+struct FuncType {
+  uint8_t nparams, nresults;
+  ValType params[6];
+  ValType results[2];
+  bool operator==(const FuncType &o) const {
+    if (nparams != o.nparams || nresults != o.nresults) return false;
+    for (int i = 0; i < nparams; i++) if (params[i] != o.params[i]) return false;
+    for (int i = 0; i < nresults; i++) if (results[i] != o.results[i]) return false;
+    return true;
+  }
+};
+
+// -- module builder -------------------------------------------------------------------------------
+class Module {
+public:
+  enum { MAX_TYPES = 32, MAX_IMPORTS = 512 };
+  FuncType types[MAX_TYPES]; uint32_t ntypes;
+  struct Import { uint32_t typeIdx; uint32_t key; } imports[MAX_IMPORTS]; uint32_t nimports;
+  uint32_t importKeys[MAX_IMPORTS]; // e.g. Bochs function-table index of the imported function
+  Buf code;                          // CURRENT function body (locals + expr), filled by the emitter
+  Buf locals;                        // local declarations (count, type)*
+  uint32_t nlocalDecls;
+  uint32_t nparams;                  // params of the exported function
+  uint32_t funcTypeIdx;
+  // finished functions (a module may hold many: batched traces): serialised bodies + their types
+  enum { MAX_FUNCS = 64 };
+  Buf codeSec;                       // concatenated (size-prefixed) bodies
+  uint32_t funcTypes[MAX_FUNCS]; uint32_t nfuncs;
+
+  Module() : ntypes(0), nimports(0), nlocalDecls(0), nparams(0), funcTypeIdx(0), nfuncs(0) {}
+
+  // start a new function body (the emitter writes into code/locals)
+  void beginFunc() { code.clear(); locals.clear(); nlocalDecls = 0; }
+  // seal the current body as local function #nfuncs (function index nimports + nfuncs); returns its local index
+  uint32_t endFunc(uint32_t typeIdx) {
+    Buf body; body.uleb(nlocalDecls); body.raw(locals.p, locals.n); body.raw(code.p, code.n); body.b8(END);
+    codeSec.uleb(body.n); codeSec.raw(body.p, body.n);
+    funcTypes[nfuncs] = typeIdx;
+    beginFunc();
+    return nfuncs++;
+  }
+  bool funcsFull() const { return nfuncs >= MAX_FUNCS; }
+
+  uint32_t addType(const FuncType &t) {
+    for (uint32_t i = 0; i < ntypes; i++) if (types[i] == t) return i;
+    types[ntypes] = t; return ntypes++;
+  }
+  static FuncType ft(uint8_t np, const ValType *ps, uint8_t nr, const ValType *rs) {
+    FuncType t; t.nparams = np; t.nresults = nr;
+    for (int i = 0; i < np; i++) t.params[i] = ps[i];
+    for (int i = 0; i < nr; i++) t.results[i] = rs[i];
+    return t;
+  }
+  // returns the function index of the import (imports are numbered before the local function)
+  uint32_t addImport(uint32_t key, const FuncType &t) {
+    for (uint32_t i = 0; i < nimports; i++) if (imports[i].key == key && types[imports[i].typeIdx] == t) return i;
+    imports[nimports].typeIdx = addType(t); imports[nimports].key = key; importKeys[nimports] = key;
+    return nimports++;
+  }
+  bool importsFull() const { return nimports >= MAX_IMPORTS - 2; }
+  uint32_t localFuncIndex() const { return nimports; }
+
+  // Serialise the whole module into `out`.
+  void finish(Buf &out) {
+    out.clear();
+    static const uint8_t hdr[8] = { 0, 'a', 's', 'm', 1, 0, 0, 0 };
+    out.raw(hdr, 8);
+    Buf s;
+    // type section
+    s.clear(); s.uleb(ntypes);
+    for (uint32_t i = 0; i < ntypes; i++) {
+      s.b8(0x60); s.uleb(types[i].nparams); for (int k = 0; k < types[i].nparams; k++) s.b8(types[i].params[k]);
+      s.uleb(types[i].nresults); for (int k = 0; k < types[i].nresults; k++) s.b8(types[i].results[k]);
+    }
+    section(out, 1, s);
+    // import section: memory + function table + helpers
+    s.clear(); s.uleb(2 + nimports);
+    s.uleb(1); s.b8('e'); s.uleb(1); s.b8('m'); s.b8(0x02); s.b8(0x00); s.uleb(0); // memory, limits min 0
+    s.uleb(1); s.b8('e'); s.uleb(1); s.b8('t'); s.b8(0x01); s.b8(0x70); s.b8(0x00); s.uleb(0); // table funcref, min 0
+    for (uint32_t i = 0; i < nimports; i++) {
+      char name[12]; int len = 0; uint32_t v = i; char tmp[12]; int tl = 0;
+      do { tmp[tl++] = '0' + (v % 10); v /= 10; } while (v);
+      while (tl) name[len++] = tmp[--tl];
+      s.uleb(1); s.b8('h'); s.uleb(len); s.raw(name, len); s.b8(0x00); s.uleb(imports[i].typeIdx);
+    }
+    section(out, 2, s);
+    // functions: either the sealed ones (batch) or, if none was sealed, the current body as "r"
+    if (nfuncs == 0) {
+      s.clear(); s.uleb(1); s.uleb(funcTypeIdx); section(out, 3, s);
+      s.clear(); s.uleb(1); s.uleb(1); s.b8('r'); s.b8(0x00); s.uleb(localFuncIndex()); section(out, 7, s);
+      s.clear(); s.uleb(1);
+      Buf body; body.uleb(nlocalDecls); body.raw(locals.p, locals.n); body.raw(code.p, code.n); body.b8(END);
+      s.uleb(body.n); s.raw(body.p, body.n);
+      section(out, 10, s);
+      return;
+    }
+    s.clear(); s.uleb(nfuncs); for (uint32_t i = 0; i < nfuncs; i++) s.uleb(funcTypes[i]); section(out, 3, s);
+    // exports: sealed functions (a batch, even of one) are "f0".."fN-1"; the never-sealed single
+    // body above is "r" (the host's single-install path)
+    s.clear(); s.uleb(nfuncs);
+    for (uint32_t i = 0; i < nfuncs; i++) {
+      char name[12]; int len = 0; uint32_t v = i; char tmp[12]; int tl = 0;
+      do { tmp[tl++] = '0' + (v % 10); v /= 10; } while (v);
+      name[len++] = 'f'; while (tl) name[len++] = tmp[--tl];
+      s.uleb(len); s.raw(name, len);
+      s.b8(0x00); s.uleb(nimports + i);
+    }
+    section(out, 7, s);
+    s.clear(); s.uleb(nfuncs); s.raw(codeSec.p, codeSec.n); section(out, 10, s);
+  }
+private:
+  static void section(Buf &out, uint8_t id, const Buf &content) { out.b8(id); out.uleb(content.n); out.raw(content.p, content.n); }
+};
+
+// -- instruction emitter (writes into Module::code) ------------------------------------------------
+class Emit {
+public:
+  Module &m; Buf &c;
+  uint32_t nlocals; // total locals incl. params
+  Emit(Module &mod) : m(mod), c(mod.code), nlocals(mod.nparams) {}
+
+  uint32_t addLocal(ValType t) { m.locals.uleb(1); m.locals.b8(t); m.nlocalDecls++; return nlocals++; }
+
+  void op(Op o) { c.b8(o); }
+  void i32c(int32_t v) { c.b8(I32_CONST); c.sleb32(v); }
+  void i64c(int64_t v) { c.b8(I64_CONST); c.sleb64(v); }
+  void get(uint32_t l) { c.b8(LOCAL_GET); c.uleb(l); }
+  void set(uint32_t l) { c.b8(LOCAL_SET); c.uleb(l); }
+  void tee(uint32_t l) { c.b8(LOCAL_TEE); c.uleb(l); }
+  void mem(Op o, uint32_t offset, uint32_t align) { c.b8(o); c.uleb(align); c.uleb(offset); }
+  // absolute-address load/store helpers: push i32.const 0 as base, offset = address
+  void ldabs(Op o, uint32_t addr, uint32_t align) { i32c(0); mem(o, addr, align); }
+  void stabs_begin() { i32c(0); }                    // then push value, then stabs_end
+  void stabs_end(Op o, uint32_t addr, uint32_t align) { mem(o, addr, align); }
+  void call(uint32_t f) { c.b8(CALL); c.uleb(f); }
+  void call_indirect(uint32_t typeIdx) { c.b8(CALL_INDIRECT); c.uleb(typeIdx); c.uleb(0); }
+  void return_call_indirect(uint32_t typeIdx) { c.b8(RETURN_CALL_INDIRECT); c.uleb(typeIdx); c.uleb(0); }
+  void block(ValType t = VOID) { c.b8(BLOCK); c.b8(t); }
+  void loop(ValType t = VOID) { c.b8(LOOP); c.b8(t); }
+  void if_(ValType t = VOID) { c.b8(IF); c.b8(t); }
+  void else_() { c.b8(ELSE); }
+  void end() { c.b8(END); }
+  void br(uint32_t d) { c.b8(BR); c.uleb(d); }
+  void br_if(uint32_t d) { c.b8(BR_IF); c.uleb(d); }
+  void ret() { c.b8(RETURN); }
+  void unreachable() { c.b8(UNREACHABLE); }
+  void drop() { c.b8(DROP); }
+  void select() { c.b8(SELECT); }
+  // try_table (result void) with a single catch_all_ref -> label `depth`
+  void try_table_catch_all_ref(uint32_t labelDepth) { c.b8(TRY_TABLE); c.b8(VOID); c.uleb(1); c.b8(0x03); c.uleb(labelDepth); }
+  void throw_ref() { c.b8(THROW_REF); }
+  // br_table: n targets + default
+  void br_table(const uint32_t *targets, uint32_t n, uint32_t def) { c.b8(BR_TABLE); c.uleb(n); for (uint32_t i = 0; i < n; i++) c.uleb(targets[i]); c.uleb(def); }
+};
+
+} // namespace nbw
+
+#endif
