+  // Run instruction k through its Bochs handler in single-step mode, then apply the
+  // BX_NEXT_INSTR/BX_NEXT_TRACE continuation semantics. Leaves all caches invalidated.
+  void emitHandlerStep(unsigned k, bool last) {
+    profCount(&nanobox_stats.link_fail[7]);
+    syncBefore(k, true);
+    invalidateAll();
+    em->i32c(0); em->i32c(0); em->mem(I32_STORE8, ADDR(nanobox_trace_end), 0);
+    pushInsPtr(k);
+    em->call(fn(FNIDX(ins[k].execute1), "i>v"));
+    // the handler committed (prev_rip/icount). If it ended the trace or raised an async event,
+    // the chain would have returned to cpu_loop: so do we.
+    em->i32c(0); em->mem(I32_LOAD8_U, ADDR(nanobox_trace_end), 0);
+    em->i32c(0); em->mem(I32_LOAD, ADDR(BX_CPU_THIS_PTR async_event), 2);
+    em->op(I32_OR);
+    if (last) { em->drop(); profCount(&nanobox_stats.link_fail[5]); }
+    else {
+      iff(); profCount(&nanobox_stats.link_fail[5]); em->ret(); endb();
+      // Handlers may advance icount by more than one (repeat() counts each iteration), so
+      // rebase our "icount at trace entry" so that ic0 + j stays exact for the instructions after.
+      em->i32c(0); em->mem(I64_LOAD, ADDR(BX_CPU_THIS_PTR icount), 3); em->i64c(k + 1); em->op(I64_SUB); em->set(L_ic0);
+    }
+  }
+  // "deopt" on a non-rejoining path: run the handler and return; compile-time cache state is
+  // restored afterwards by the caller via snapshot/restore
+  void emitDeoptAndReturn(unsigned k, bool last) {
+    CacheState s = snapshot();
+    emitHandlerStep(k, last);
+    em->ret();
+    restore(s);
+  }
+
+  // ---------------------------------------------------------------- templates
+  enum { SZ_B = 1, SZ_W = 2, SZ_D = 4, SZ_Q = 8 };
+
+  // Try to emit an inline template for instruction k. Returns false if none applies (nothing
+  // emitted in that case). `last` = k is the last real instruction of the trace.
+  bool emitTemplate(unsigned k, bool last) {
+    bxInstruction_c *i = &ins[k];
+    unsigned ia = i->getIaOpcode();
+    bool R = i->modC0();
+    unsigned dst = i->dst(), src = i->src();
+    unsigned seg = i->seg();
+    uint32_t t0 = T[0], t1 = T[1], t2 = T[2];
+
+    switch (ia) {
+
+    // ================= NOP / zero idioms
+    case BX_IA_NOP:
+      return true;
+    case BX_IA_XOR_GqEq_ZERO_IDIOM: case BX_IA_SUB_GqEq_ZERO_IDIOM: case BX_IA_XOR_EqGq_ZERO_IDIOM: case BX_IA_SUB_EqGq_ZERO_IDIOM:
+    case BX_IA_XOR_GdEd_ZERO_IDIOM: case BX_IA_SUB_GdEd_ZERO_IDIOM: case BX_IA_XOR_EdGd_ZERO_IDIOM: case BX_IA_SUB_EdGd_ZERO_IDIOM:
