+    // ---- XADD (32/64, register or memory destination)
+    case BX_IA_XADD_EqGq: case BX_IA_XADD_EdGd: {
+      unsigned size = (ia == BX_IA_XADD_EqGq) ? 8 : 4;
+      uint32_t op1 = T[0], op2 = T[1], sum = T[2], ea = T[3];
+      MemKind rmwKind = (size == 8) ? MK_RMW_LIN : MK_RMW_VIRT;
+      pushRegSz(src, size, false); em->set(op2);
+      if (R) { pushRegSz(dst, size, false); em->set(op1); }
+      else { pushEA(k); em->set(ea); emitRMWRead(k, rmwKind, seg, size, ea); em->set(op1); }
+      em->get(op1); em->get(op2); em->op(I64_ADD); if (size == 4) { em->i64c(0xffffffffLL); em->op(I64_AND); } em->set(sum);
+      if (R) { writeRegSz(src, size, false, op1); writeRegSz(dst, size, false, sum); } // dst last (src may be dst)
+      else { emitRMWWrite(rmwKind, size, sum); writeRegSz(src, size, false, op1); }
+      setFlagsArith(size, op1, op2, sum, false, false);
+      return true;
+    }
+
+    // ---- CMPXCHG (32/64, register or memory destination)
+    case BX_IA_CMPXCHG_EqGq: case BX_IA_CMPXCHG_EdGd: {
+      unsigned size = (ia == BX_IA_CMPXCHG_EqGq) ? 8 : 4;
+      uint32_t op1 = T[0], acc = T[1], diff = T[2], ea = T[3];
+      MemKind rmwKind = (size == 8) ? MK_RMW_LIN : MK_RMW_VIRT;
+      if (R) { pushRegSz(dst, size, false); em->set(op1); }
+      else { pushEA(k); em->set(ea); emitRMWRead(k, rmwKind, seg, size, ea); em->set(op1); }
