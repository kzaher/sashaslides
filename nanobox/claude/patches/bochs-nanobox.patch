+      em->set(t1);
+      pushReg32(dst); em->set(t2);            // BX_CLEAR_64BIT_HIGH(dst) always
+      em->get(t1); em->get(t2); pushCond(cc); em->select(); regSetFromStack(dst);
+      return true;
+    }
+
+    // ================= XCHG (register form)
+    case BX_IA_XCHG_EqGq:
+      if (!R) return false;
+      regGet(dst); em->set(t0); regGet(src); regSetFromStack(dst); em->get(t0); regSetFromStack(src);
+      return true;
+    case BX_IA_XCHG_EdGd:
+      if (!R) return false;
+      pushReg32(dst); em->set(t0); pushReg32(src); regSetFromStack(dst); em->get(t0); regSetFromStack(src);
+      return true;
+
+    default:
+      return emitTemplateMore(k, i, ia, R, last);
+    }
+  }
+
+  // ---------------------------------------------------------------- more templates
+  // (the top dynamic fallbacks of the agent-CLI startups; each mirrors its Bochs handler exactly)
+  bool realHandler(unsigned k, BxExecutePtr_tR h) { return ins[k].execute1 == h; }
+  bool emitTemplateMore(unsigned k, bxInstruction_c *i, unsigned ia, bool R, bool last) {
+    unsigned dst = i->dst(), src = i->src(), seg = i->seg();
+    uint32_t t0 = T[0], t1 = T[1], t2 = T[2], t3 = T[3];
+    (void) last;
+    switch (ia) {
+
+    // ---- 16/8-bit shifts, register destination
+    case BX_IA_SHL_EwIb: case BX_IA_SHL_EwI1: case BX_IA_SHR_EwIb: case BX_IA_SHR_EwI1: case BX_IA_SAR_EwIb: case BX_IA_SAR_EwI1:
+    case BX_IA_SHL_Ew: case BX_IA_SHR_Ew: case BX_IA_SAR_Ew:
+    case BX_IA_SHL_EbIb: case BX_IA_SHL_EbI1: case BX_IA_SHR_EbIb: case BX_IA_SHR_EbI1: case BX_IA_SAR_EbIb: case BX_IA_SAR_EbI1:
+    case BX_IA_SHL_Eb: case BX_IA_SHR_Eb: case BX_IA_SAR_Eb: {
+      if (!R) return false;
+      unsigned size = (ia == BX_IA_SHL_EwIb || ia == BX_IA_SHL_EwI1 || ia == BX_IA_SHR_EwIb || ia == BX_IA_SHR_EwI1 || ia == BX_IA_SAR_EwIb || ia == BX_IA_SAR_EwI1 ||
+                       ia == BX_IA_SHL_Ew || ia == BX_IA_SHR_Ew || ia == BX_IA_SAR_Ew) ? 2 : 1;
+      int kind = (ia == BX_IA_SHL_EwIb || ia == BX_IA_SHL_EwI1 || ia == BX_IA_SHL_Ew || ia == BX_IA_SHL_EbIb || ia == BX_IA_SHL_EbI1 || ia == BX_IA_SHL_Eb) ? 0 :
+                 (ia == BX_IA_SHR_EwIb || ia == BX_IA_SHR_EwI1 || ia == BX_IA_SHR_Ew || ia == BX_IA_SHR_EbIb || ia == BX_IA_SHR_EbI1 || ia == BX_IA_SHR_Eb) ? 1 : 2;
+      bool useCL = (ia == BX_IA_SHL_Ew || ia == BX_IA_SHR_Ew || ia == BX_IA_SAR_Ew || ia == BX_IA_SHL_Eb || ia == BX_IA_SHR_Eb || ia == BX_IA_SAR_Eb);
+      bool ext = i->extend8bitL();
+      uint32_t op1 = T[0], res = T[1], cnt = T[2]; uint32_t cf = T32[3], of = T32[4];
+      unsigned bits = size * 8;
+      if (useCL) { regGet(R_RCX); em->i64c(0x1f); em->op(I64_AND); em->set(cnt); }
+      else { unsigned c = i->Ib() & 0x1f; if (c == 0) return true; em->i64c(c); em->set(cnt); }  // count 0: nothing at all (no zero-extension for 16/8-bit)
+      if (useCL) { lfLoad(); regEnsureLoaded(size == 1 && (dst & 4) && !ext ? dst - 4 : dst); em->get(cnt); em->i64c(0); em->op(I64_NE); iff(); }
+      pushRegSz(dst, size, ext); em->set(op1);
+      if (kind == 0) {
+        em->get(op1); em->get(cnt); em->op(I64_SHL); em->i64c((1LL << bits) - 1); em->op(I64_AND); em->set(res);
+        em->get(op1); em->i64c(bits); em->get(cnt); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+        em->get(res); em->i64c(bits - 1); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->get(cf); em->op(I32_XOR); em->set(of);
+      } else if (kind == 1) {
+        em->get(op1); em->get(cnt); em->op(I64_SHR_U); em->set(res);
+        em->get(op1); em->get(cnt); em->i64c(1); em->op(I64_SUB); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+        em->get(res); em->i64c(1); em->op(I64_SHL); em->get(res); em->op(I64_XOR); em->i64c(bits - 1); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(of);
+      } else {
+        em->get(op1); em->op(size == 2 ? I64_EXTEND16_S : I64_EXTEND8_S); em->set(op1); // signed operand
+        em->get(op1); em->get(cnt); em->op(I64_SHR_S); em->i64c((1LL << bits) - 1); em->op(I64_AND); em->set(res);
+        em->get(op1); em->get(cnt); em->i64c(1); em->op(I64_SUB); em->op(I64_SHR_S); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+        em->i32c(0); em->set(of);
+      }
+      writeRegSz(dst, size, ext, res);
+      setFlagsLogic(size, res);
+      setFlagsOxxxxC(of, cf);
+      if (useCL) endb();
+      return true;
+    }
+
+    // ---- ROL/ROR by immediate, register destination
+    case BX_IA_ROL_EqIb: case BX_IA_ROL_EdIb: case BX_IA_ROR_EqIb: case BX_IA_ROR_EdIb: {
+      if (!R) return false;
+      unsigned size = (ia == BX_IA_ROL_EqIb || ia == BX_IA_ROR_EqIb) ? 8 : 4;
+      bool rol = (ia == BX_IA_ROL_EqIb || ia == BX_IA_ROL_EdIb);
