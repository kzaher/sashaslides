+      uint32_t op1 = T[0], res = T[1]; uint32_t cf = T32[3], of = T32[4];
+      if (size == 8) regGet(dst); else pushReg32(dst);
+      em->set(op1);
+      if (size == 8) { em->get(op1); em->i64c(cnt); em->op(rol ? I64_ROTL : I64_ROTR); }
+      else { em->get(op1); em->op(I32_WRAP_I64); em->i32c(cnt); em->op(rol ? I32_ROTL : I32_ROTR); em->op(I64_EXTEND_I32_U); }
+      em->set(res);
+      em->get(res); regSetFromStack(dst);
+      unsigned top = size * 8 - 1;
+      if (rol) { // cf = bit0; of = bit0 ^ bit(top)
+        em->get(res); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+        em->get(res); em->i64c(top); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->get(cf); em->op(I32_XOR); em->set(of);
+      } else {   // cf = bit(top); of = bit(top-1) ^ bit(top)
+        em->get(res); em->i64c(top); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->set(cf);
+        em->get(res); em->i64c(top - 1); em->op(I64_SHR_U); em->op(I32_WRAP_I64); em->i32c(1); em->op(I32_AND); em->get(cf); em->op(I32_XOR); em->set(of);
