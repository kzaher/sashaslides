+        em->get(la); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_AND); em->get(C_lpf); em->op(I64_NE); em->br_if(0);
+        if (size > 1) {
+          em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->i32c(0x1000 - size); em->op(I32_GT_U); em->br_if(0);
+          acmGet(); em->i64c(size - 1); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0);
+        }
+        em->get(C_bits); em->i32c(bit); em->get(L_upl); em->op(I32_SHL); em->op(I32_AND); em->op(I32_EQZ); em->br_if(0);
+        em->br(1); // hit
+      endb();
+      tlbProbeFull(la, size, bit, slowDepth + 1);
+      // remember this page
+      em->get(la); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_AND); em->set(C_lpf);
+      em->get(T32[0]); em->mem(I32_LOAD, TLB_OFF(hostPageAddr), 2); em->set(C_host);
+      em->get(T32[0]); em->mem(I32_LOAD, TLB_OFF(accessBits), 2); em->set(C_bits);
+      em->get(T32[0]); em->mem(I64_LOAD, TLB_OFF(ppf), 3); em->set(C_ppf);
+      em->get(C_ppf); em->op(I32_WRAP_I64); em->i32c(LPF_MASK_LO); em->op(I32_AND); em->i32c(10); em->op(I32_SHR_U);
+      em->i32c((uint32_t)(uintptr_t) pageWriteStampTable.nanobox_fgm()); em->op(I32_ADD); em->mem(I32_LOAD, 0, 2); em->op(I32_EQZ); em->set(C_free);
+    endb();
+  }
+  // Note: tlbProbe's two blocks are structured so that a full-probe failure branches to
+  // `slowDepth` as seen from the *caller* (hence +1 inside the extra block).
+  void tlbProbeFull(uint32_t la, unsigned size, unsigned bit, uint32_t slowDepth) {
+    // entry = &DTLB.entry[((lo32(la) + size-1) & tlb_mask) >> 12]
+    em->get(la); em->op(I32_WRAP_I64);
+    if (size > 1) { em->i32c(size - 1); em->op(I32_ADD); }
+    em->i32c((BX_DTLB_SIZE - 1) << 12); em->op(I32_AND);
+    unsigned esz = sizeof(bx_TLB_entry);
+    if ((esz & (esz - 1)) == 0) {
+      unsigned sh = 0; while ((1u << sh) < esz) sh++;
+      if (sh < 12) { em->i32c(12 - sh); em->op(I32_SHR_U); } else if (sh > 12) { em->i32c(sh - 12); em->op(I32_SHL); }
+    } else {
+      em->i32c(12); em->op(I32_SHR_U); em->i32c(esz); em->op(I32_MUL);
+    }
+    em->i32c(ADDR(BX_CPU_THIS_PTR DTLB.entry[0])); em->op(I32_ADD);
+    em->set(T32[0]);
+    // tag: entry->lpf == (la & (LPF_MASK | (acmask & (size-1))))
+    em->get(T32[0]); em->mem(I64_LOAD, TLB_OFF(lpf), 3);
+    em->get(la);
+    if (size > 1) { acmGet(); em->i64c(size - 1); em->op(I64_AND); em->i64c((Bit64s)(Bit64u) LPF_MASK); em->op(I64_OR); }
+    else em->i64c((Bit64s)(Bit64u) LPF_MASK);
+    em->op(I64_AND);
+    em->op(I64_NE); em->br_if(slowDepth);
+    // access bits: entry->accessBits & (bit << user_pl)
+    em->get(T32[0]); em->mem(I32_LOAD, TLB_OFF(accessBits), 2);
+    em->i32c(bit); em->get(L_upl); em->op(I32_SHL); em->op(I32_AND);
+    em->op(I32_EQZ); em->br_if(slowDepth);
+  }
+  // host address = entry->hostPageAddr + (la & 0xfff)  -> i32 on stack
+  void pushHostAddr(uint32_t la) {
+    em->get(C_host);
+    em->get(la); em->op(I32_WRAP_I64); em->i32c(0xfff); em->op(I32_AND); em->op(I32_ADD);
+  }
+  // pageWriteStampTable.decWriteStamp(entry->ppf | pageOffset, size) with the cheap test inlined
+  void emitWriteStamp(uint32_t la, unsigned size) {
+    // page known to carry no iCache stamps (checked when it was probed; stamps are only added by
+    // serveICacheMiss, which cannot run during this trace) -> nothing to do
+    em->get(C_free); em->op(I32_EQZ);
+    iff();
+      em->get(C_ppf); em->get(la); em->i64c(0xfff); em->op(I64_AND); em->op(I64_OR); em->set(W); // pAddr
+      // fineGranularityMapping[pAddr >> 12] != 0 ?
+      em->get(W); em->op(I32_WRAP_I64); em->i32c(LPF_MASK_LO); em->op(I32_AND); em->i32c(10); em->op(I32_SHR_U);
+      em->i32c((uint32_t)(uintptr_t) pageWriteStampTable.nanobox_fgm()); em->op(I32_ADD);
+      em->mem(I32_LOAD, 0, 2);
+      iff();
+        profCount(&nanobox_stats.link_fail[6]);
+        em->get(W); em->i32c(size); em->call(fn(FNIDX(&nanobox_helper_dec_write_stamp), "li>v"));
+      endb();
+    endb();
+    needAsyncCheck = true; // handleSMC sets BX_ASYNC_EVENT_STOP_TRACE
+  }
+
+  // Read `size` bytes for instruction k. Offset (i64) is in local `off_l`; kind selects the slow
+  // path accessor. Result: i64 zero-extended value on the stack.
+  void emitRead(unsigned k, MemKind kind, unsigned seg, unsigned size, uint32_t off_l) {
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk(I64);
+      blk();
+        tlbProbe(T[5], size, 1, 0);
+        pushHostAddr(T[5]); em->mem(loadOp(size), 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      const char *sig; uint32_t f = accessorRead(kind, size, sig);
+      em->i32c(seg);
+      if (kind == MK_RD_LIN || kind == MK_RMW_LIN) em->get(T[5]); else em->get(off_l);
+      em->call(fn(f, sig));
+      if (size != 8) em->op(I64_EXTEND_I32_U);
+    endb();
+    needAsyncCheck = true;
+  }
+  void profSlow() {
+    if (nanobox_jit_level >= 3) { em->i32c(0); em->i32c(0); em->mem(I64_LOAD, ADDR(nanobox_stats.jit_slow), 3); em->i64c(1); em->op(I64_ADD); em->mem(I64_STORE, ADDR(nanobox_stats.jit_slow), 3); }
+  }
+  // Write value in local val_l (i64) with `size` bytes at offset off_l for instruction k.
+  void emitWrite(unsigned k, MemKind kind, unsigned seg, unsigned size, uint32_t off_l, uint32_t val_l) {
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        tlbProbe(T[5], size, 4, 0);
+        emitWriteStamp(T[5], size);
+        pushHostAddr(T[5]); em->get(val_l); em->mem(storeOp(size), 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      const char *sig; uint32_t f = accessorWrite(kind, size, sig);
+      em->i32c(seg);
+      if (kind == MK_WR_LIN) em->get(T[5]); else em->get(off_l);
+      em->get(val_l); if (size != 8) em->op(I32_WRAP_I64);
+      em->call(fn(f, sig));
+    endb();
+    needAsyncCheck = true;
+  }
+  // Stack read (stack_read_qword semantics): offset in off_l -> value (i64) on stack
+  void emitStackRead(unsigned k, uint32_t off_l) {
+    em->get(off_l); em->set(T[5]);
+    blk(I64);
+      blk();
+        tlbProbe(T[5], 8, 1, 0);
+        pushHostAddr(T[5]); em->mem(I64_LOAD, 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->get(off_l); em->call(fn(FNIDX(&BX_CPU_C::stack_read_qword), "l>l"));
+    endb();
+    needAsyncCheck = true;
+  }
+  void emitStackWrite(unsigned k, uint32_t off_l, uint32_t val_l) {
+    em->get(off_l); em->set(T[5]);
+    blk();
+      blk();
+        tlbProbe(T[5], 8, 4, 0);
+        emitWriteStamp(T[5], 8);
+        pushHostAddr(T[5]); em->get(val_l); em->mem(I64_STORE, 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->get(off_l); em->get(val_l); em->call(fn(FNIDX(&BX_CPU_C::stack_write_qword), "ll>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+  // RMW read: value on stack (i64), host address (i32, 0 = slow path) left in T32[1]
+  void emitRMWRead(unsigned k, MemKind kind, unsigned seg, unsigned size, uint32_t off_l) {
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk(I64);
+      blk();
+        tlbProbe(T[5], size, 4, 0);
+        emitWriteStamp(T[5], size);
+        pushHostAddr(T[5]); em->tee(T32[1]); em->mem(loadOp(size), 0, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->i32c(0); em->set(T32[1]);
+      const char *sig; uint32_t f = accessorRead(kind, size, sig);
+      em->i32c(seg);
+      if (kind == MK_RMW_LIN) em->get(T[5]); else em->get(off_l);
+      em->call(fn(f, sig));
+      if (size != 8) em->op(I64_EXTEND_I32_U);
+    endb();
+    needAsyncCheck = true;
+  }
+  void emitRMWWrite(MemKind kind, unsigned size, uint32_t val_l) {
+    em->get(T32[1]);
+    iff();
+      em->get(T32[1]); em->get(val_l); em->mem(storeOp(size), 0, 0);
+    els();
+      const char *sig; uint32_t f = accessorWrite(kind, size, sig);
+      em->get(val_l); if (size != 8) em->op(I32_WRAP_I64);
+      em->call(fn(f, sig));
+    endb();
+  }
