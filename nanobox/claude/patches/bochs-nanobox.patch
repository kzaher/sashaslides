+      em->i32c(0); regGet(src); em->mem(I64_STORE, d, 3);
+      em->i32c(0); em->i64c(0); em->mem(I64_STORE, d + 8, 3);
+      return true;
+    }
+    default:
+      return false;
+    }
+  }
+  // 16-byte load/store between an XMM register and memory: TLB fast path (no page split), else the
+  // Bochs accessor (which also does the alignment check / #GP for the aligned forms)
+  void emitReadXmm(unsigned k, unsigned seg, uint32_t off_l, unsigned xreg, bool aligned) {
+    uint32_t xaddr = ADDR(BX_CPU_THIS_PTR vmm[xreg]);
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        if (aligned) { em->get(T[5]); em->i64c(15); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+        tlbProbe(T[5], 16, 1, 0);
+        em->i32c(0); pushHostAddr(T[5]); em->mem(I64_LOAD, 0, 0); em->mem(I64_STORE, xaddr, 3);
+        em->i32c(0); pushHostAddr(T[5]); em->mem(I64_LOAD, 8, 0); em->mem(I64_STORE, xaddr + 8, 3);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->i32c(seg); em->get(off_l); em->i32c(xaddr);
+      em->call(fn(FNIDX(aligned ? &BX_CPU_C::read_virtual_xmmword_aligned : &BX_CPU_C::read_virtual_xmmword), "ili>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+  void emitWriteXmm(unsigned k, unsigned seg, uint32_t off_l, unsigned xreg, bool aligned) {
+    uint32_t xaddr = ADDR(BX_CPU_THIS_PTR vmm[xreg]);
+    em->get(off_l); pushLaddrFromOffset(seg); em->set(T[5]);
+    blk();
+      blk();
+        if (aligned) { em->get(T[5]); em->i64c(15); em->op(I64_AND); em->i64c(0); em->op(I64_NE); em->br_if(0); }
+        tlbProbe(T[5], 16, 4, 0);
+        emitWriteStamp(T[5], 16);
+        pushHostAddr(T[5]); em->i32c(0); em->mem(I64_LOAD, xaddr, 3); em->mem(I64_STORE, 0, 0);
+        pushHostAddr(T[5]); em->i32c(0); em->mem(I64_LOAD, xaddr + 8, 3); em->mem(I64_STORE, 8, 0);
+        em->br(1);
+      endb();
+      syncBefore(k, false); profSlow();
+      em->i32c(seg); em->get(off_l); em->i32c(xaddr);
+      em->call(fn(FNIDX(aligned ? &BX_CPU_C::write_virtual_xmmword_aligned : &BX_CPU_C::write_virtual_xmmword), "ili>v"));
+    endb();
+    needAsyncCheck = true;
+  }
+
+  static unsigned jccCond(unsigned ia) {
+    switch (ia) {
+      case BX_IA_JO_Jq: case BX_IA_JO_Jbq: return CC_O;     case BX_IA_JNO_Jq: case BX_IA_JNO_Jbq: return CC_NO;
+      case BX_IA_JB_Jq: case BX_IA_JB_Jbq: return CC_B;     case BX_IA_JNB_Jq: case BX_IA_JNB_Jbq: return CC_NB;
+      case BX_IA_JZ_Jq: case BX_IA_JZ_Jbq: return CC_Z;     case BX_IA_JNZ_Jq: case BX_IA_JNZ_Jbq: return CC_NZ;
+      case BX_IA_JBE_Jq: case BX_IA_JBE_Jbq: return CC_BE;  case BX_IA_JNBE_Jq: case BX_IA_JNBE_Jbq: return CC_NBE;
+      case BX_IA_JS_Jq: case BX_IA_JS_Jbq: return CC_S;     case BX_IA_JNS_Jq: case BX_IA_JNS_Jbq: return CC_NS;
