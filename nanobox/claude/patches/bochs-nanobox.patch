+    em->get(delta); em->i32c(0); em->mem(I32_LOAD, nanobox_pc_system_access::countdownAddr(), 2); em->op(I32_GE_U);
+    { CacheState s = snapshot(); iff(); pushVA(0); exitWithRipOnStack(k); endb(); restore(s); }
+    // currCountdown -= delta; icount_last_sync = now
+    em->i32c(0); em->i32c(0); em->mem(I32_LOAD, nanobox_pc_system_access::countdownAddr(), 2); em->get(delta); em->op(I32_SUB); em->mem(I32_STORE, nanobox_pc_system_access::countdownAddr(), 2);
