+    sig = size == 8 ? "il>l" : "il>i";
+    switch (kind) {
+      case MK_RD_LIN:
+        return size == 8 ? FNIDX(&BX_CPU_C::read_linear_qword) : size == 4 ? FNIDX(&BX_CPU_C::read_linear_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::read_linear_word) : FNIDX(&BX_CPU_C::read_linear_byte);
+      case MK_RD_VIRT:
+        return size == 8 ? FNIDX(&BX_CPU_C::read_virtual_qword) : size == 4 ? FNIDX(&BX_CPU_C::read_virtual_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::read_virtual_word) : FNIDX(&BX_CPU_C::read_virtual_byte);
+      case MK_RMW_LIN:
+        return size == 8 ? FNIDX(&BX_CPU_C::read_RMW_linear_qword) : size == 4 ? FNIDX(&BX_CPU_C::read_RMW_linear_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::read_RMW_linear_word) : FNIDX(&BX_CPU_C::read_RMW_linear_byte);
+      case MK_RMW_VIRT:
+        return size == 8 ? FNIDX(&BX_CPU_C::read_RMW_virtual_qword) : size == 4 ? FNIDX(&BX_CPU_C::read_RMW_virtual_dword) :
+               size == 2 ? FNIDX(&BX_CPU_C::read_RMW_virtual_word) : FNIDX(&BX_CPU_C::read_RMW_virtual_byte);
+      default: sig = ""; return 0;
+    }
+  }
