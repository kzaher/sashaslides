# Trim the Docker build context. Excludes only heavy/irrelevant things that NO
# build needs — safe for every Dockerfile built from the repo root.
**/node_modules
.git
.github
.claude
.agent
dist
**/*.log
.sxs-*
.fork-*
.npm-cache*
# drawio webapp IS needed (self-hosted editor at /drawio), but its .git history and
# non-webapp source trees are not — keep only src/main/webapp in the build context.
deps/drawio/.git
deps/drawio/etc
deps/drawio/src/main/mxgraph
**/__pycache__
**/*.pyc
.venv
# Never built from nor served by the site image (deploy/publish.sh SITE_EXCLUDES lists the same).
renderer/html2slides/e2e
renderer/structured-prompts
