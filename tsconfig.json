{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "*.ts",
    "types/**/*.d.ts",
    "renderer/**/*.ts",
    "structured-prompting/**/*.ts",
    "analysis/**/*.ts",
    "presentations/**/*.ts",
    "sashaslides/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    ".claude/worktrees",
    "**/dist",
    "**/build",
    "structured-prompting/src/client/**"
  ]
}
