{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "*.ts",
    "types/**/*.d.ts",
    "renderer/**/*.ts",
    "structured-prompting/**/*.ts",
    "presentations/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    ".claude/worktrees",
    "**/dist",
    "**/build",
    "structured-prompting/src/client/**",
    // The reverse round trip imports the Sasha engine's .tsx renderer, which needs the engine's
    // JSX setting; it is checked by its own project, renderer/html2slides/reverse/tsconfig.json.
    "renderer/html2slides/reverse/**",
    "renderer/html2slides/reverse-roundtrip.ts"
  ]
}
