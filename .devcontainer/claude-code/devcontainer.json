{
  "name": "Sasha Slides",
  "build": {
    "dockerfile": "Dockerfile",
    "options": ["--platform=linux/amd64"]
  },
  "forwardPorts": [9222, 5900, 6080, 3456, 3457, 3460, 3461, 3500],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Desktop",
      "onAutoForward": "notify"
    },
    "3456": { "label": "SxS rating — basics", "onAutoForward": "notify" },
    "3457": { "label": "SxS rating — complex", "onAutoForward": "notify" },
    "3460": { "label": "SxS rating — baked basics", "onAutoForward": "silent" },
    "3461": { "label": "SxS rating — baked complex", "onAutoForward": "silent" },
    "3500": { "label": "html2slides bundle", "onAutoForward": "silent" }
  },
  "mounts": [
    "source=polybot-chrome-profile,target=/home/node/chrome-profile,type=volume",
    "source=sashaslides-overlays,target=/overlays,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/home/node/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/Projects/claude,target=/p/claude,type=bind",
    "source=${localEnv:HOME}/Projects/codepit/codepit-vscode/.deploy/codepit.codepit-vscode-0.1.0,target=/opt/codepit-ext,type=bind"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "sudo chown node:node /overlays 2>/dev/null || true; bash /opt/codepit-ext/register-extension.sh; bash .devcontainer/claude-code/setup-claude.sh; bash .devcontainer/start-chrome.sh &",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "runArgs": ["--shm-size=2g", "--platform=linux/amd64", "--cap-add=SYS_ADMIN", "--security-opt=apparmor=unconfined"],
  "remoteUser": "node"
}
